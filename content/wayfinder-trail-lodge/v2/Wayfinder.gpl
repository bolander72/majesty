// Wayfinder v2: original lantern survey, field aid and waystation support.
// One 8-second native scheduler thread for the single-player kingdom.
// This private candidate must be compiled and verified before publication.

expression #WayfinderSupportInterval 8000
expression #WayfinderSurveyRadius 448
expression #WayfinderAidRadius 96
expression #WayfinderAidAmount 4
expression #TrailLodgeSupplyRadius 160
expression #TrailLodgeSupplyAmount 2

function wayfinder_start_support (agent source)
declare
    agent palace, controller;
begin
    palace = $GetPalace(source);
    if ($isdead(palace))
        return;
    controller = $RetrieveAgent("WayfinderSupportV2");
    if (controller == $NullAgent())
        begin
            controller = $CreateAgent("WayfinderSupportV2", "WayfinderSupportV2");
            controller = $RetrieveAgent("WayfinderSupportV2");
            if ($ValidFunction(controller's "VictoryCondition"))
                $NewThread(controller's "VictoryCondition", #WayfinderSupportInterval);
        end
end

function wayfinder_lodge_birth (agent lodge)
declare
begin
    $Guild_Birth(lodge);
    $wayfinder_start_support(lodge);
end

function wayfinder_field_aid (agent guide)
declare
    list companions;
    agent candidate, injured;
    integer i, missing, largest;
begin
    if ($GetAttribute(guide, #ATTRIB_ExperienceLevel) < 2)
        return;
    $ListObjects(guide, "hero", #WayfinderAidRadius, companions, #MyPlayer, #NoHiddenMap);
    largest = 0;
    injured = $NullAgent();
    i = 1;
    while (i <= $ListSize(companions)) do
        begin
            candidate = $ListMember(companions, i);
            if (candidate != guide)
            if ($isdead(candidate) == FALSE)
            if ($InsideBuilding(candidate) == FALSE)
                begin
                    missing = $GetAttribute(candidate, #ATTRIB_MaxHP) - $GetAttribute(candidate, #ATTRIB_HP);
                    if (missing > largest)
                        begin
                            largest = missing;
                            injured = candidate;
                        end
                end
            i = i + 1;
        end
    if (injured != $NullAgent())
        $Heal(guide, injured, #WayfinderAidAmount);
end

function wayfinder_support_tick ()
declare
    list heroes, buildings, lodges, palaces;
    agent hero, lodge, controller, palace;
    integer i, j;
    boolean supplied;
begin
    // Match the native quest scheduler's verified no-argument callback shape.
    // Resolve live world references on each pulse, including after restoration.
    controller = $RetrieveAgent("WayfinderSupportV2");
    if (controller == $NullAgent())
        return;
    controller's "Done_setup" = controller's "Done_setup" + 1;
    palaces = $ListPalaces();
    controller's "Quest_Number" = $ListSize(palaces);
    if ($ListSize(palaces) != 1)
        return;
    palace = $ListMember(palaces, 1);
    if ($isdead(palace))
        begin
            $KillThread($wayfinder_support_tick);
            return;
        end
    $ListObjects(palace, "hero", -1, heroes, #MyPlayer, #NoHiddenMap, #InsideOtherUnits);
    $ListObjects(palace, "building", -1, buildings, #MyPlayer, #NoHiddenMap, #ATTRIB_FirstStageBuilt, 1);
    lodges = $ListTitles(buildings, "Trail_Lodge");
    i = 1;
    while (i <= $ListSize(heroes)) do
        begin
            hero = $ListMember(heroes, i);
            if ($isdead(hero) == FALSE)
            if ($InsideBuilding(hero) == FALSE)
                begin
                    if (hero's "title" == "Wayfinder")
                        begin
                            $RevealArea(hero, $LocationOf(hero), #WayfinderSurveyRadius);
                            // Field aid happens every other survey: 16 seconds.
                            if (controller's "Done_setup" % 2 == 0)
                                $wayfinder_field_aid(hero);
                        end
                    // Each friendly hero gets one supply pulse, even when
                    // multiple completed Lodges overlap. Indoor units and
                    // unfinished/destroyed/enemy Lodges cannot supply them.
                    supplied = FALSE;
                    j = 1;
                    while (j <= $ListSize(lodges)) do
                        begin
                            lodge = $ListMember(lodges, j);
                            if ($isdead(lodge) == FALSE)
                            if ($DistanceBetweenAgents(hero, lodge) <= #TrailLodgeSupplyRadius)
                                supplied = TRUE;
                            j = j + 1;
                        end
                    if (supplied)
                        $Heal(palace, hero, #TrailLodgeSupplyAmount);
                end
            i = i + 1;
        end
end

function wayfinder_tree (agent thisagent)
declare
begin
    // Adopt the melee role in restored v1 worlds without deleting equipment.
    thisagent's "attacktype" = 1;
    thisagent's "attack_action" = "basic_attack";
    if ($HasAttribute("special_attack_action", thisagent))
        thisagent's "special_attack_action" = "basic_attack";
    $wayfinder_start_support(thisagent);
    if ($check_nearby(thisagent) == False)
    if ($Check_rewards(thisagent, FALSE) == False)
    if ($Defend_home(thisagent) == False)
    if ($rest(thisagent) == False)
    if ($Purchase_equipment(thisagent) == False)
    if ($explore_map(thisagent, 98) == False)
    if ($Combat_wandering(thisagent, 35) == False)
    if ($Go_home(thisagent, 25) == False)
        begin
            $SpecifyIntent(thisagent, #intent_wandering);
            thisagent's "counter" = 0;
            thisagent's "activescript" = $hero_wander;
        end
end
