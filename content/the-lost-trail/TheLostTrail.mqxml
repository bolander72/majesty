<Majesty>
  <Quest id="{8BC7C549-E5A2-4D0F-A726-83B16BF19E42}">
    <Name>TheLostTrail</Name>
    <DisplayName lang="en_US">The Lost Trail</DisplayName>
    <Description lang="en_US">
      <Short>Complete two Trail Lodges, keep four Wayfinders alive, and destroy every hostile lair. Your Palace must survive.</Short>
      <Long>The northern road has vanished beneath the forest, and creatures now nest along its forgotten course. Establish two Trail Lodges and recruit a company of Wayfinders to reclaim the route. Use exploration and attack rewards to guide your heroes through the wilderness. Victory requires both completed Lodges, four living Wayfinders, and no hostile lairs remaining, including those hidden by unexplored terrain.</Long>
    </Description>
    <Difficulty>Medium</Difficulty>
    <DataConfiguration>
      <Dataset base="MajestyExpansion">
        <Load>
          <CAM>Data/Wayfinder-units.cam</CAM>
          <CAM>Data/Wayfinder-interface.cam</CAM>
          <GPL><Target>Data/Wayfinder.bcd</Target></GPL>
          <GPL>
            <Target>Data/TheLostTrail.bcd</Target>
            <Source>GPL/TheLostTrail.gpl</Source>
          </GPL>
          <GPLSource>GPL</GPLSource>
          <Template>Quests/TheLostTrail.q</Template>
        </Load>
        <Unload><CAM/><GPL/><Constants/></Unload>
      </Dataset>
    </DataConfiguration>
  </Quest>
</Majesty>
