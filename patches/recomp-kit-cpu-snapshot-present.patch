+        return;
+    const uint32_t generation = ddraw_surface_generation(o->id);
+    CHECK(!host_d3d_has_surface_generation(o->id, generation));
+    uint8_t pixels[32]{}, mask[16]{};
+    for (int i = 0; i < 16; ++i)
+        mask[i] = i % 3 == 0;
+    HostBlitRecord record{};
+    record.dst = o->id;
+    record.dst_generation = generation;
+    record.dst_x = record.dst_y = 2;
+    record.w = record.h = 4;
+    record.cpu_bpp = 16;
+    record.cpu_pitch = 8;
+    record.cpu_pixels = pixels;
+    record.coverage = mask;
+    d3d_cpu_write(o, &record);
+    CHECK(!host_d3d_dirty_rect(o->id, generation, nullptr));
+    host_d3d_mark_dirty(o->id, generation, {0, 0, 8, 8});
+    record.dst_generation = generation + 1;
+    d3d_cpu_write(o, &record);
+    CHECK(host_d3d_dirty_rect(o->id, generation, nullptr));
+    record.dst_generation = generation;
+    d3d_cpu_write(o, &record);
+    HostD3DSurface surface{};
+    surface.id = o->id;
+    surface.width = surface.height = 8;
+    surface.pitch = o->pitch;
+    surface.bpp = 16;
+    surface.pixels = gm_ptr(o->pixels);
+    for (int y = 0; y < 8; ++y)
+        for (int x = 0; x < 8; ++x) {
+            const bool covered = x >= 2 && x < 6 && y >= 2 && y < 6 && mask[(y - 2) * 4 + x - 2];
+            HostDirtyRect r{x, y, x + 1, y + 1};
+            CHECK_EQ(host_d3d_make_coherent(&surface, generation, &r, HOST_READ_LOCK),
+                     covered ? 0 : 1);
+        }
+    CHECK(!host_d3d_dirty_rect(o->id, generation, nullptr));
+}
