+static void test_cpu_snapshot_frames() {
+    const char *v = recomp_env("DDRAW_CPU_SNAPSHOT_ONLY");
+    const bool had = v != nullptr;
+    const std::string old = v ? v : "";
+    os_setenv("RECOMP_DDRAW_CPU_SNAPSHOT_ONLY", "1");
+    rec_reset();
+    uint32_t primary = make_primary_chain_for_test();
+    ComObj *o = rec_obj(primary);
+    CHECK(o != nullptr);
+    if (o) {
+        reset_ddraw_for_test();
+        ddraw_set_present_callbacks(recorder_present_write, recorder_present_seal);
+        uint32_t desc = sc(0xa80);
+        gm_zero(desc, DDSD_SIZE);
+        wr32(desc, DDSD_SIZE);
+        auto frame = host_frame_current();
+        CHECK_EQ(call_method(primary, S_Lock, {0, desc, DDLOCK_WAIT, 0}), DD_OK);
+        wr8(o->pixels + 10 * o->pitch + 7, 17);
+        CHECK_EQ(call_method(primary, S_Unlock, {0}), DD_OK);
+        CHECK(host_frame_cpu_snapshot(frame));
+        CHECK_EQ(host_frame_record_count(frame), 0u);
+        CHECK(!g_presents.empty());
+        if (!g_presents.empty())
+            CHECK_EQ(g_presents.back().pixels[10 * g_presents.back().pitch + 7], 17);
+        pump_present_for_test();
+        CHECK(host_frame_current().id != frame.id);
+        // No-op locks must not become new content or create extra frames.
+        auto idle = host_frame_current();
+        CHECK_EQ(call_method(primary, S_Lock, {0, desc, DDLOCK_WAIT, 0}), DD_OK);
+        CHECK_EQ(call_method(primary, S_Unlock, {0}), DD_OK);
+        pump_present_for_test();
+        CHECK_EQ(host_frame_current().id, idle.id);
+        CHECK(!host_frame_cpu_snapshot(idle));
+        // Genuine texture resources retain exact records, even without a GPU.
+        uint32_t texture = rec_make_surface(8, 8, 8, DDSCAPS_TEXTURE);
+        ComObj *tex = rec_obj(texture);
+        CHECK(tex != nullptr);
+        if (tex) {
+            CHECK_EQ(call_method(texture, S_Lock, {0, desc, DDLOCK_WAIT, 0}), DD_OK);
+            wr8(tex->pixels, 31);
+            CHECK_EQ(call_method(texture, S_Unlock, {0}), DD_OK);
+            CHECK(host_frame_record_count(idle) > 0);
+            CHECK(!host_frame_cpu_snapshot(idle));
+        }
+        // The pointer remains writable after Unlock, and a later present
+        // must publish its changed byte as another complete image.
+        wr8(o->pixels + 12 * o->pitch + 9, 23);
+        ddraw_present(o);
+        CHECK(host_frame_cpu_snapshot(idle));
+        CHECK_EQ(host_frame_record_count(idle), tex ? 1u : 0u);
+        if (!g_presents.empty())
+            CHECK_EQ(g_presents.back().pixels[12 * g_presents.back().pitch + 9], 23);
+        // A device transition seals the CPU frame before any GPU work.
+        ddraw_note_device(1);
+        CHECK(host_frame_current().id != idle.id);
+        auto gpu_frame = host_frame_current();
+        CHECK_EQ(call_method(primary, S_Lock, {0, desc, DDLOCK_WAIT, 0}), DD_OK);
+        wr8(o->pixels + 14 * o->pitch + 10, 29);
+        CHECK_EQ(call_method(primary, S_Unlock, {0}), DD_OK);
+        CHECK(!host_frame_cpu_snapshot(gpu_frame));
+        CHECK(host_frame_record_count(gpu_frame) > 0);
+        ddraw_note_device(0);
+        pump_present_for_test();
+        ddraw_set_present_callbacks(nullptr, nullptr);
+    }
+    if (had)
+        os_setenv("RECOMP_DDRAW_CPU_SNAPSHOT_ONLY", old.c_str());
+    else
+        os_unsetenv("RECOMP_DDRAW_CPU_SNAPSHOT_ONLY");
+}
