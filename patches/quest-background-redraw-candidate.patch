--- a/browser_viewport.cpp
+++ b/browser_viewport.cpp
@@ -10,0 +11 @@
+#include "runtime/win32.h"
@@ -48,0 +50,51 @@
+
+// Private redraw candidate: the original quest marker callback changes the
+// Background widgets on mouse enter/leave. Request the window's own complete
+// invalidation after that change, preserving its controls and selected quest.
+// No device rebuild, geometry change or simulation write is involved.
+void repaint_quest_background(const PopModApi *api, pop_cpu_v1 *cpu,
+                              PopHookInvocation *inv, void *) {
+  uint32_t window = 0;
+  X86 *active = guest_current_context();
+  if (active && gm_valid(cpu->esp, 12)) {
+    const uint32_t widget = rd32(cpu->esp + 4);
+    const uint32_t event = rd32(cpu->esp + 8);
+    if ((event == 0x51 || event == 0x52) && widget && gm_valid(widget, 4)) {
+      const uint32_t table = rd32(widget);
+      if (table && gm_valid(table, 0x18) && rd32(table + 0x14)) {
+        X86 extra = *active;
+        extra.r[R_ECX] = widget;
+        window = guest_call(&extra, rd32(table + 0x14));
+        if (!gm_valid(window, 0x48) || rd32(window + 0x2c) != 0x30335041u)
+          window = 0;
+      }
+    }
+  }
+  if (mods_call_next(api, inv, cpu) != POP_OK)
+    return;
+  // The callback can change ownership. Refuse a disappeared/replaced window;
+  // the native return value and CPU registers remain those of the callback.
+  active = guest_current_context();
+  if (active && window && gm_valid(window, 0x48) &&
+      rd32(window + 0x2c) == 0x30335041u && rd32(window) &&
+      gm_valid(rd32(window), 0x58) && rd32(rd32(window) + 0x54)) {
+    X86 extra = *active;
+    extra.r[R_ECX] = window;
+    guest_call(&extra, rd32(rd32(window) + 0x54));
+  }
+}
+
+void install_quest_background_candidate() {
+  static bool attempted = false;
+  const char *enabled = recomp_env("BROWSER_QUEST_REDRAW");
+  if (attempted || !enabled || strcmp(enabled, "1"))
+    return;
+  attempted = true;
+  uint32_t hook = 0;
+  if (mods_hook_install_ex(MODS_OWNER_RUNTIME, 0x0044f430u, 0,
+                          repaint_quest_background, POP_HOOK_WRAP,
+                          POP_HOOK_NO_GAME_VIEW, nullptr, &hook) != POP_OK)
+    fprintf(stderr, "[quest-redraw] candidate hook unavailable\n");
+  else
+    fprintf(stderr, "[quest-redraw] opt-in candidate installed\n");
+}
@@ -777,0 +830 @@
+  install_quest_background_candidate();
