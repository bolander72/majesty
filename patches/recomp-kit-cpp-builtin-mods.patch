@@ -1,6 +1,6 @@
 # pop_builtin_mods(<target> [RESOURCES <dir>]): compile the game's core mods
 # into <target> for platforms that cannot load a plugin at run time (iOS, the
-# web). Each <mods/core>/<mod>/*.c is built with its entry points renamed to
+# web). Each <mods/core>/<mod>/*.{c,cpp} entry is built with its entry points renamed to
 # recomp_builtin_<stem>_{abi,init,exit}; a generated table lists them for the
 # loader (mods/builtin_mods.h), which finds a manifest's plugin by its stem.
 # RESOURCES, when given, is where the mods' manifests and assets are copied
@@ -11,7 +11,7 @@ function(pop_builtin_mods target)
   if(NOT EXISTS ${core})
     return()
   endif()
-  file(GLOB sources CONFIGURE_DEPENDS ${core}/*/*.c)
+  file(GLOB sources CONFIGURE_DEPENDS ${core}/*/*.c ${core}/*/*.cpp)
   set(table ${CMAKE_BINARY_DIR}/generated/${target}_builtin_mods.c)
   set(decls "")
   set(rows "")
@@ -19,12 +19,22 @@ function(pop_builtin_mods target)
     get_filename_component(stem ${src} NAME_WE)
     string(MAKE_C_IDENTIFIER ${stem} id)
     set(lib ${target}_mod_${id})
-    add_library(${lib} OBJECT ${src})
-    target_include_directories(${lib} PRIVATE ${POP_ROOT}/mods)
+    if(TARGET ${lib})
+      message(FATAL_ERROR "Duplicate builtin mod entry stem: ${stem}")
+    endif()
+    get_filename_component(module_dir ${src} DIRECTORY)
+    # Companion implementation files have no plugin entry points. Keeping
+    # them under support/ lets a C++ plugin retain portable parsers as separate
+    # translation units instead of textually including their implementation.
+    file(GLOB support CONFIGURE_DEPENDS ${module_dir}/support/*.c
+                                       ${module_dir}/support/*.cpp)
+    add_library(${lib} OBJECT ${src} ${support})
+    target_include_directories(${lib} PRIVATE ${POP_ROOT}/mods ${module_dir}
+                                              ${module_dir}/support)
     target_compile_definitions(${lib} PRIVATE pop_mod_abi=recomp_builtin_${id}_abi
                                               pop_mod_init=recomp_builtin_${id}_init
                                               pop_mod_exit=recomp_builtin_${id}_exit)
-    set_target_properties(${lib} PROPERTIES C_STANDARD 11)
+    set_target_properties(${lib} PROPERTIES C_STANDARD 11 CXX_STANDARD 17)
     pop_optimize(${lib} 1)
     target_sources(${target} PRIVATE $<TARGET_OBJECTS:${lib}>)
     string(APPEND decls "extern const PopModAbi recomp_builtin_${id}_abi;\n"
diff --git a/docs/testing.md b/docs/testing.md
index bb8776b..0ac3758 100644
--- a/docs/testing.md
+++ b/docs/testing.md
@@ -83,3 +83,17 @@ The initial publication additionally runs the source-only CI checks and local
 native suites built through CMake from the standalone checkout, and the Linux and
 Windows portable-layer suites in CI. Long campaign completion, multiplayer
 and sustained 4K120 remain unverified; publish measurements with their conditions.
+
+## Builtin C/C++ plugins
+
+`pop_builtin_mods` accepts one plugin entry translation unit per unique stem
+under `mods/core/<mod>`, using either `.c` or `.cpp`. Its ABI entry points retain
+C linkage through `pop_mod_api.h`. Optional `.c`/`.cpp` companions under the same
+mod's `support/` directory compile into that entry object target and are not
+registered as independent plugins. Portable core resource staging also retains `.bin` registries and `.tsv` route
+maps while excluding source and native libraries. Both directories are include paths; retain
+third-party notices when staging portable support sources. A duplicate entry
+stem fails configuration rather than producing ambiguous loader registrations.
+
+This capability only links the plugin. Game-backed browser play must separately
+qualify hooks, resources, native transactions and original saves/reloads.
