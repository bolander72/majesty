diff --git a/mods/tests/builtin_mods_test.c b/mods/tests/builtin_mods_test.c
new file mode 100644
index 0000000..1c6e9cb
--- /dev/null
+++ b/mods/tests/builtin_mods_test.c
@@ -0,0 +1,22 @@
+#include "builtin_mods.h"
+#include <assert.h>
+#include <string.h>
+
+int main(void) {
+    unsigned seen = 0;
+    for (const RecompBuiltinMod *mod = recomp_builtin_mods; mod->stem; ++mod) {
+        assert(mod->abi && mod->abi->api_version == POP_MOD_API_VERSION);
+        if (!strcmp(mod->stem, "c_entry")) {
+            assert(mod->init(0) == 3);
+            seen |= 1;
+        } else if (!strcmp(mod->stem, "cpp_entry")) {
+            assert(mod->init(0) == 7);
+            seen |= 2;
+        } else {
+            assert(!"support source registered as a plugin");
+        }
+        assert(mod->exit && mod->exit() == POP_OK);
+    }
+    assert(seen == 3);
+    return 0;
+}
