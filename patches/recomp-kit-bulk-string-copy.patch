+/* Arena-bounded REP MOVS can copy the whole span instead of running a
+ * translated load/store and updating every open dirty range per element.
+ * An overlap in the safe direction is memmove; an overlap whose writes feed
+ * later reads keeps the original x86 smear. An armed watch keeps its exact
+ * per-store values/backtraces.
+ * Reject wrap/null/arena boundaries before touching memory so their scalar
+ * path retains the original access/fault order and partial register updates.
+ * Caller owns the guest baton; neither path yields during the instruction. */
+static inline int rep_movs_bulk(X86 *c, uint32_t unit) {
+    const uint32_t count = c->r[R_ECX];
+    if (!count)
+        return 1;
+    const uint64_t bytes64 = (uint64_t)count * unit;
+    if (bytes64 < 32 || bytes64 > GUEST_SIZE || g_watch_len)
+        return 0;
+    const uint32_t bytes = (uint32_t)bytes64;
+    uint32_t src = c->r[R_ESI], dst = c->r[R_EDI];
+    if (c->eflags_df) {
+        const uint32_t back = bytes - unit;
+        if (src < back || dst < back)
+            return 0;
+        src -= back;
+        dst -= back;
+    }
+    if (src < GUEST_NULL_LIMIT || dst < GUEST_NULL_LIMIT || src > GUEST_SIZE - bytes ||
+        dst > GUEST_SIZE - bytes)
+        return 0;
+    const int overlap = src < dst + bytes && dst < src + bytes;
+    if (overlap && (src == dst || (c->eflags_df ? dst < src : dst > src)))
+        return 0;
+    if (overlap)
+        memmove(g_mem + dst, g_mem + src, bytes);
+    else
+        memcpy(g_mem + dst, g_mem + src, bytes);
+    for (uint32_t i = 0; i < g_dirty_count; ++i) {
+        RecompDirty *d = &g_dirty[i];
+        const uint32_t end = dst + bytes, range_end = d->base + d->len;
+        const uint32_t lo = dst > d->base ? dst : d->base;
+        const uint32_t hi = end < range_end ? end : range_end;
+        if (dst >= range_end || end <= d->base)
+            continue;
+        /* Match the first/last overlapping ELEMENT stores, not the whole
+         * copy: another lock may watch only an unaligned slice of this span. */
+        const uint32_t store_lo = dst + (lo - dst) / unit * unit;
+        const uint32_t store_hi = dst + ((hi - dst + unit - 1) / unit) * unit;
+        if (store_lo >= store_hi)
+            continue;
+        if (store_lo < d->lo)
+            d->lo = store_lo;
+        if (store_hi > d->hi)
+            d->hi = store_hi;
+    }
+    const uint32_t step = c->eflags_df ? 0u - bytes : bytes;
+    c->r[R_ESI] += step;
+    c->r[R_EDI] += step;
+    c->r[R_ECX] = 0;
+    return 1;
+}
