+def movs_setup(rng, unit, backwards):
+    """Zero/short/bulk counts, disjoint rows and overlapping x86 smear."""
+    count = rng.choice([0, 1, 7, 8, 16, 32, 64, 127, 256])
+    source = SCRATCH + 0x1000 + rng.randrange(16)
+    dest = source + rng.choice([-33, -7, -1, 0, 1, 7, 33, 0x1000])
+    step_back = (count - 1) * unit if backwards and count else 0
+    return {"regs": rand_regs(rng, ECX=count, ESI=source + step_back, EDI=dest + step_back),
+            "mem": [(SCRATCH, bytes(rng.getrandbits(8) for _ in range(0x3000)))]}
+
+
