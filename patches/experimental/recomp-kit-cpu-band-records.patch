+// Software CPU snapshots must replay the exact final pixels, including holes,
+// repeated writes and writes discovered through an import. The
+// exact-span path remains required as soon as a D3D device exists.
+static void test_cpu_band_records() {
+    os_setenv("RECOMP_DDRAW_CPU_BAND_RECORDS", "1");
+    rec_reset();
+    const auto dd = rec_dd();
+    CHECK_EQ(call_method(dd, DD_SetDisplayMode, {640, 480, 16}), DD_OK);
+    const auto rt = make_offscreen_for_test(17, 11, 16);
+    CHECK(rt != 0);
+    auto *o = rec_obj(rt);
+    CHECK(o != nullptr);
+    if (!o) {
+        os_unsetenv("RECOMP_DDRAW_CPU_BAND_RECORDS");
+        return;
+    }
+    fill_for_test(rt, 0);
+    const auto desc = sc(0xa80);
+    gm_zero(desc, DDSD_SIZE);
+    wr32(desc + DDSD_OFF_dwSize, DDSD_SIZE);
+    const auto start = host_frame_record_count(host_frame_current());
+    CHECK_EQ(call_method(rt, S_Lock, {0, desc, DDLOCK_WAIT, 0}), DD_OK);
+    wr16(o->pixels + 2 * o->pitch + 2, 0x1234);
+    wr16(o->pixels + 8 * o->pitch + 30, 0xabcd);
+    CHECK_EQ(call_method(rt, S_Unlock, {0}), DD_OK);
+    const auto frame = host_frame_current();
+    CHECK_EQ(host_frame_record_count(frame), start + 1);
+    const auto *r = host_frame_record(frame, start);
+    CHECK(r != nullptr);
+    if (r) {
+        CHECK_EQ(r->dst_x, 0);
+        CHECK_EQ(r->dst_y, 2);
+        CHECK_EQ(r->w, 17);
+        CHECK_EQ(r->h, 7);
+        CHECK_EQ(r->cpu_bpp, 16);
+        for (int y = 0; y < r->h; ++y)
+            for (int x = 0; x < r->w; ++x) {
+                CHECK_EQ(r->coverage[y * r->w + x], 1);
+                CHECK_EQ(memcmp(r->cpu_pixels + y * r->cpu_pitch + x * 2,
+                                gm_ptr(o->pixels + (y + 2) * o->pitch + x * 2), 2),
+                         0);
+            }
+    }
+    // An idle lock emits nothing and does not retain a new snapshot.
+    CHECK_EQ(call_method(rt, S_Lock, {0, desc, DDLOCK_WAIT, 0}), DD_OK);
+    CHECK_EQ(call_method(rt, S_Unlock, {0}), DD_OK);
+    CHECK_EQ(host_frame_record_count(frame), start + 1);
+    // The earlier payload is immutable after later guest changes.
+    CHECK_EQ(call_method(rt, S_Lock, {0, desc, DDLOCK_WAIT, 0}), DD_OK);
+    wr16(o->pixels + 2 * o->pitch + 2, 0x9876);
+    CHECK_EQ(call_method(rt, S_Unlock, {0}), DD_OK);
+    if (r) {
+        CHECK_EQ(r->cpu_pixels[2], 0x34);
+        CHECK_EQ(r->cpu_pixels[3], 0x12);
+    }
+    // An import can write raw surface bytes without translated dirty tracking.
+    const auto imported = host_frame_record_count(frame);
+    CHECK_EQ(call_method(rt, S_Lock, {0, desc, DDLOCK_WAIT, 0}), DD_OK);
+    gm_ptr(o->pixels + 5 * o->pitch + 12)[0] = 0x55;
+    call_shim(tramp("KERNEL32.dll", "GetTickCount"), {});
+    CHECK_EQ(call_method(rt, S_Unlock, {0}), DD_OK);
+    CHECK_EQ(host_frame_record_count(frame), imported + 1);
+    const auto *ir = host_frame_record(frame, imported);
