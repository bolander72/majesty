+// Emit exact half-open changed runs. SIMD compares whole pixels, including
+// unaligned inputs; no vector load reaches beyond the caller's row. Adjacent
+// runs crossing a vector/scalar boundary are joined before publication.
+template <unsigned Bytes, class Emit>
+void pixel_difference_runs(const uint8_t *before, const uint8_t *after, int width, Emit emit) {
+    int begin = -1, end = 0;
+    const auto append = [&](int first, int last) {
+        if (begin >= 0 && first != end) {
+            emit(begin, end);
+            begin = -1;
+        }
+        if (begin < 0)
+            begin = first;
+        end = last;
+    };
+    int x = 0;
+#ifdef __wasm_simd128__
+    if constexpr (Bytes != 3) {
+        constexpr unsigned lanes = 16 / Bytes, all = (1u << lanes) - 1;
+        for (; x <= width - int(lanes); x += lanes) {
+            const auto a = wasm_v128_load(before + size_t(x) * Bytes);
+            const auto b = wasm_v128_load(after + size_t(x) * Bytes);
+            unsigned equal;
+            if constexpr (Bytes == 1)
+                equal = wasm_i8x16_bitmask(wasm_i8x16_eq(a, b));
+            else if constexpr (Bytes == 2)
+                equal = wasm_i16x8_bitmask(wasm_i16x8_eq(a, b));
+            else
+                equal = wasm_i32x4_bitmask(wasm_i32x4_eq(a, b));
+            unsigned changed = ~equal & all;
+            while (changed) {
+                const unsigned first = __builtin_ctz(changed);
+                // shifted has at most 16 low bits, so its complement is
+                // nonzero even when the entire remaining vector differs.
+                const unsigned count = __builtin_ctz(~(changed >> first));
+                append(x + int(first), x + int(first + count));
+                changed &= ~(((1u << count) - 1) << first);
+            }
+        }
+    }
+#endif
+    for (; x < width; ++x) {
+        // The portable path skips unchanged words without alignment or
+        // aliasing assumptions. RGB24 uses pixel-wise comparison.
+        if constexpr (Bytes != 3) {
+            constexpr int step = 8 / Bytes;
+            if (x <= width - step) {
+                uint64_t a, b;
+                std::memcpy(&a, before + size_t(x) * Bytes, 8);
+                std::memcpy(&b, after + size_t(x) * Bytes, 8);
+                if (a == b) {
+                    x += step - 1;
+                    continue;
+                }
+            }
+        }
+        if (std::memcmp(before + size_t(x) * Bytes, after + size_t(x) * Bytes, Bytes))
+            append(x, x + 1);
+    }
+    if (begin >= 0)
+        emit(begin, end);
+}
+
+// Rows arrive left-to-right, so matching the preceding row needs only two
+// sorted span vectors. This preserves the original exact rectangle partition
+// without a width*height mask, a second pixel scan, or per-span tree nodes.
+template <class Rect, class Before, class After>
+std::vector<Rect> pixel_difference_rects(int width, int row0, int row1, unsigned bytes,
+                                         Before before, After after) {
+    struct Span {
+        int first, last;
+        size_t box;
+    };
+    std::vector<Rect> boxes;
+    std::vector<Span> previous, current;
+    for (int y = row0; y < row1; ++y) {
+        const auto *a = before(y), *b = after(y);
+        current.clear();
+        if (!pixel_bytes_equal(a, b, size_t(width) * bytes)) {
+            size_t old = 0;
+            const auto emit = [&](int first, int last) {
+                const auto key = std::make_pair(first, last);
+                while (old < previous.size() &&
+                       std::make_pair(previous[old].first, previous[old].last) < key)
+                    ++old;
+                size_t index;
+                if (old < previous.size() && previous[old].first == first &&
+                    previous[old].last == last) {
+                    index = previous[old].box;
+                    boxes[index].y1 = y + 1;
+                } else {
+                    index = boxes.size();
+                    boxes.push_back({first, y, last, y + 1});
+                }
+                current.push_back({first, last, index});
+            };
+            switch (bytes) {
+            case 1:
+                pixel_difference_runs<1>(a, b, width, emit);
+                break;
+            case 2:
+                pixel_difference_runs<2>(a, b, width, emit);
+                break;
+            case 3:
+                pixel_difference_runs<3>(a, b, width, emit);
+                break;
+            case 4:
+                pixel_difference_runs<4>(a, b, width, emit);
+                break;
+            }
+        }
+        // An unchanged row must break vertical merging too.
+        previous.swap(current);
+    }
+    return boxes;
+}
