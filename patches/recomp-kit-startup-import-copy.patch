+// Dispatch names must remain terminated and unchanged when the called shim
+// grows the trampoline table. Cover both sides of the 512-byte stack boundary.
+static std::string g_dispatch_enter, g_dispatch_leave;
+static unsigned g_dispatch_allocations = 0;
+static void descriptor_growth_shim(X86 *c) {
+    for (unsigned i = 0; i < 128; ++i) {
+        std::string name = "growth" + std::to_string(g_dispatch_allocations++);
+        imports_alloc_trampoline("descriptor-test.dll", name.c_str(), nullptr, 0);
+    }
+    set_eax(c, 0x12345678);
+}
+static void test_import_descriptor_copy() {
+    section("import descriptor stack copy");
+    auto old_call = imports_set_call_observer_get();
+    auto old_return = imports_set_return_observer_get();
+    imports_set_call_observer([](const char *desc, const uint32_t *, uint32_t, uint32_t *) {
+        g_dispatch_enter = desc;
+        return true;
+    });
+    imports_set_return_observer([](const char *desc, uint32_t) { g_dispatch_leave = desc; });
+    X86 *c = loader_context();
+    for (size_t length :
+         {size_t(0), size_t(1), size_t(490), size_t(491), size_t(492), size_t(700)}) {
+        std::string name(length, '%');
+        std::string expected = (std::string("descriptor-test.dll!") + name).substr(0, 511);
+        imports_alloc_trampoline("descriptor-test.dll", name.c_str(), descriptor_growth_shim, 0);
+        check(call_import(c, "descriptor-test.dll", name.c_str(), {}) == 0x12345678,
+              "descriptor shim returns its value for length %zu", length);
+        check(g_dispatch_enter == expected && g_dispatch_leave == expected,
+              "descriptor survives table growth, truncates and terminates for length %zu", length);
+    }
+    imports_set_call_observer(old_call);
+    imports_set_return_observer(old_return);
+}
