+++ b/dx/pixel_change_mask.h
@@ -0,0 +1,74 @@
+#pragma once
+#include <cstddef>
+#include <cstdint>
+#include <cstring>
+#ifdef __wasm_simd128__
+#include <wasm_simd128.h>
+#endif
+
+struct PixelChangeSpan {
+    size_t begin, end;
+};
+
+// One byte per pixel, exactly 0 or 1. The caller supplies a zeroed mask that
+// does not overlap either input. Bounds are [begin, end), or {pixels, 0} when
+// unchanged. Loads never cross the requested row, including unaligned tails.
+inline PixelChangeSpan pixel_change_mask(const uint8_t *was, const uint8_t *now, size_t pixels,
+                                         unsigned bb, uint8_t *mask) {
+    PixelChangeSpan span{pixels, 0};
+    size_t x = 0;
+#ifdef __wasm_simd128__
+    if (bb == 2) {
+        for (; pixels - x >= 8; x += 8) {
+            const v128_t different =
+                wasm_i16x8_ne(wasm_v128_load(was + x * 2), wasm_v128_load(now + x * 2));
+            const unsigned bits = wasm_i16x8_bitmask(different);
+            if (!bits)
+                continue;
+            // Signed narrowing preserves the all-ones comparison lanes; the
+            // low bit then gives the recorder's existing 0/1 coverage convention.
+            const v128_t bytes = wasm_v128_and(
+                wasm_i8x16_narrow_i16x8(different, wasm_i16x8_splat(0)), wasm_i8x16_splat(1));
+            wasm_v128_store64_lane(mask + x, bytes, 0);
+            if (span.begin == pixels)
+                span.begin = x + __builtin_ctz(bits);
+            span.end = x + 32 - __builtin_clz(bits);
+        }
+    }
+#endif
+    const size_t step = bb == 1 ? 8 : bb == 2 ? 4 : bb == 4 ? 2 : 0;
+    for (; x < pixels; ++x) {
+        if (step && pixels - x >= step) {
+            uint64_t a, b;
+            std::memcpy(&a, was + x * bb, 8);
+            std::memcpy(&b, now + x * bb, 8);
+            if (a == b) {
+                x += step - 1;
+                continue;
+            }
+        }
+        bool differs;
+        if (bb == 2) {
+            uint16_t a, b;
+            std::memcpy(&a, was + x * 2, 2);
+            std::memcpy(&b, now + x * 2, 2);
+            differs = a != b;
+        } else if (bb == 4) {
+            uint32_t a, b;
+            std::memcpy(&a, was + x * 4, 4);
+            std::memcpy(&b, now + x * 4, 4);
+            differs = a != b;
+        } else if (bb == 1) {
+            differs = was[x] != now[x];
+        } else {
+            differs = std::memcmp(was + x * bb, now + x * bb, bb) != 0;
+        }
+        if (differs) {
+            mask[x] = 1;
+            if (span.begin == pixels)
+                span.begin = x;
+            span.end = x + 1;
+        }
+    }
+    return span;
+}
