+        const auto span = fn(before.data() + offset, after.data() + offset, pixels, mask.data());
+        sum += span.begin + span.end + mask[pixels / 2];
+    }
+    *checksum = sum;
+    return std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - begin)
