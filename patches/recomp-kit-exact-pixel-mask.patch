+// The pre-change 16-bit mask loop, retaining its eight-byte equal runs.
+NOINLINE PixelChangeSpan previous_mask(const uint8_t *was, const uint8_t *now, size_t pixels,
+                                       uint8_t *mask) {
+    PixelChangeSpan span{pixels, 0};
+    for (size_t x = 0; x < pixels; ++x) {
+        if (pixels - x >= 4) {
+            uint64_t a, b;
+            std::memcpy(&a, was + x * 2, 8);
+            std::memcpy(&b, now + x * 2, 8);
+            if (a == b) {
+                x += 3;
+                continue;
+            }
+        }
+        uint16_t a, b;
+        std::memcpy(&a, was + x * 2, 2);
+        std::memcpy(&b, now + x * 2, 2);
+        if (a != b) {
+            mask[x] = 1;
+            if (span.begin == pixels)
+                span.begin = x;
+            span.end = x + 1;
+        }
+    }
+    return span;
+}
+NOINLINE PixelChangeSpan current_mask(const uint8_t *a, const uint8_t *b, size_t pixels,
+                                      uint8_t *mask) {
+    return pixel_change_mask(a, b, pixels, 2, mask);
+}
