+extern "C" void host_present_stage_pixels(const uint8_t *pixels, int w, int h, int bpp, int pitch,
+                                          const uint32_t *palette) {
+    auto s = active.load();
+    if (!s || !pixels || w <= 0 || h <= 0 || (bpp != 8 && bpp != 16 && bpp != 32) ||
+        uint64_t(w) * (bpp / 8) > uint64_t(std::max(0, pitch)))
+        return;
+    s->acquire(w, h, 0, 0);
+    std::lock_guard lock(s->mutex);
+    if (s->stop || !s->writing || !s->writing->target)
+        return;
+    auto &t = *s->writing->target;
+    const size_t row = size_t(w) * (bpp / 8);
+    t.surface_pixels.resize(row * h);
+    for (int y = 0; y < h; ++y)
+        memcpy(t.surface_pixels.data() + size_t(y) * row, pixels + size_t(y) * pitch, row);
+    if (bpp == 8)
+        for (int i = 0; i < 256; ++i)
+            t.surface_palette[i] = palette ? palette[i] : uint32_t(i * 0x010101u);
+    t.surface_w = s->guest_w = w;
+    t.surface_h = s->guest_h = h;
+    t.surface_bpp = bpp;
+    s->writing->pending_pixels = true;
+}
