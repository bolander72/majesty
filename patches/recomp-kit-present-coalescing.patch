+static void test_surface_snapshot_ordering() {
+    host_present_test_begin();
+    // Padding is excluded, the latest size/format wins, and guest mutations
+    // after the callback cannot change the sealed pixels.
+    uint8_t indexed[4] = {3, 0, 0, 0};
+    uint8_t rgb565[8] = {0x00, 0xf8, 99, 99, 0x00, 0xf8, 99, 99};
+    host_present_stage_pixels(indexed, 1, 1, 8, 4, nullptr);
+    host_present_stage_pixels(rgb565, 1, 2, 16, 4, nullptr);
+    memset(rgb565, 0, sizeof rgb565);
+    CHECK_EQ(host_present_test_surface_flushes(), 0u);
+    host_present_test_seal(1, HOST_SCREEN_MENU);
+    host_present_tick_for_test(0);
+    CHECK_EQ(host_present_test_surface_flushes(), 1u);
+    CHECK_EQ(host_present_test_last_pixel(), 255);
+    // An explicit RGBA present supersedes a pending DirectDraw image.
+    const uint8_t rgba[4] = {17, 2, 3, 255};
+    host_present_stage_pixels(indexed, 1, 1, 8, 4, nullptr);
+    host_present_stage_rgba(rgba, 1, 1);
+    host_present_test_seal(2, HOST_SCREEN_MENU);
+    host_present_tick_for_test(.02);
+    CHECK_EQ(host_present_test_surface_flushes(), 1u);
+    CHECK_EQ(host_present_test_last_pixel(), 17);
+    // Conversely, a newer XRGB image supersedes explicit RGBA input.
+    uint8_t xrgb[4] = {1, 2, 42, 0};
+    host_present_stage_rgba(rgba, 1, 1);
+    host_present_stage_pixels(xrgb, 1, 1, 32, 4, nullptr);
+    xrgb[2] = 0;
+    host_present_test_seal(3, HOST_SCREEN_MENU);
+    host_present_tick_for_test(.04);
+    CHECK_EQ(host_present_test_surface_flushes(), 2u);
+    CHECK_EQ(host_present_test_last_pixel(), 42);
+    host_present_stop();
+}
