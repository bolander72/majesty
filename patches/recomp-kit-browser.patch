+// A host-only fake transport exercises actual COM argument decoding and packet
+// relocation. Browser/relay integration is checked separately with real clients.
+using DpBytes = std::vector<uint8_t>;
+static std::deque<DpBytes> dp_test_in;
+static DpBytes dp_test_sent;
+static DpBytes dp_test_session;
+static unsigned dp_test_closed;
+static void dp_test_put(DpBytes &b, uint32_t v) {
+    for (int i = 0; i < 4; ++i)
+        b.push_back(uint8_t(v >> (i * 8)));
+}
+static uint32_t dp_test_word(const DpBytes &b, size_t at) {
+    return uint32_t(b[at]) | uint32_t(b[at + 1]) << 8 | uint32_t(b[at + 2]) << 16 |
+           uint32_t(b[at + 3]) << 24;
+}
+static OsWebSocket *dp_test_open(const char *, const char *) {
+    return reinterpret_cast<OsWebSocket *>(1);
+}
+static int dp_test_state(const OsWebSocket *) {
+    return OS_WS_OPEN;
+}
+static void dp_test_notify(OsWebSocket *, void (*)(uintptr_t), uintptr_t) {}
+static void dp_test_close(OsWebSocket *) {
+    ++dp_test_closed;
+    dp_test_in.clear();
+}
+static void dp_test_event(uint32_t op, const DpBytes &body) {
+    DpBytes b;
+    for (uint32_t v : {0x31525044u, 1u, op, 0u, 0u})
+        dp_test_put(b, v);
+    b.insert(b.end(), body.begin(), body.end());
+    dp_test_in.push_back(b);
+}
+static int dp_test_send(OsWebSocket *, const void *bytes, uint32_t length) {
+    const auto *p = static_cast<const uint8_t *>(bytes);
+    dp_test_sent.assign(p, p + length);
+    uint32_t op = dp_test_word(dp_test_sent, 8), request = dp_test_word(dp_test_sent, 12);
+    if (!request) {
+        if (op == 6) {
+            DpBytes ack;
+            dp_test_put(ack, dp_test_word(dp_test_sent, 20));
+            dp_test_event(108, ack);
+        }
+        return 0;
+    }
+    DpBytes out;
+    if (op == 3) {
+        dp_test_session.assign(p + 20, p + length);
+        dp_test_session[8] = 42;
+        out = dp_test_session;
+        dp_test_put(out, 0);
+    } else if (op == 5) {
+        dp_test_put(out, 1);
+        dp_test_put(out, 2);
+        dp_test_put(out, 0);
+        dp_test_put(out, 3);
+        out.insert(out.end(), {'B', 'o', 'b'});
+        dp_test_put(out, 0);
+        dp_test_put(out, 2);
+        out.insert(out.end(), {0x12, 0x34});
+    }
+    DpBytes b;
+    for (uint32_t v : {0x31525044u, 1u, op | 0x80000000u, request, 0u})
+        dp_test_put(b, v);
+    b.insert(b.end(), out.begin(), out.end());
+    dp_test_in.push_back(b);
+    return 0;
+}
+static int dp_test_receive(OsWebSocket *, void *bytes, uint32_t cap, uint32_t *length) {
+    if (dp_test_in.empty()) {
+        *length = 0;
+        return 0;
+    }
+    *length = uint32_t(dp_test_in.front().size());
+    if (cap < *length)
+        return -2;
+    memcpy(bytes, dp_test_in.front().data(), *length);
+    dp_test_in.pop_front();
+    return 1;
+}
+static void test_directplay_session_packets() {
+    directplay_reset();
+    dp_test_in.clear();
+    const DirectPlayTransport fake = {dp_test_open,    dp_test_state,  dp_test_send,
