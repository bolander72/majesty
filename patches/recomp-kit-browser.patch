index 0000000..b44ea6a
--- /dev/null
+++ b/platform/named_actions.h
@@ -0,0 +1,107 @@
+// Fixed storage for native UI requests. Producers publish names only; the
+// game thread consumes a boolean and owns any resulting guest operation.
+#pragma once
+#include <stdint.h>
+#include <string.h>
+#include <mutex>
+
+class NamedActions {
+  public:
+    static constexpr size_t capacity = 16;
+    static constexpr size_t name_bytes = 64;
+    static constexpr uint64_t lifetime_ns = 1000000000;
+
+    static bool valid_name(const char *name) {
+        if (!name)
+            return false;
+        for (size_t i = 0; i < name_bytes; ++i) {
+            const unsigned char c = (unsigned char)name[i];
+            if (!c)
+                return i != 0;
+            if (!((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') ||
+                  c == '-' || c == '_'))
+                return false;
+        }
+        return false;
+    }
+
+    // Coalesce repeats without refreshing their lifetime. Unknown names and
+    // a stalled consumer therefore cannot retain an unbounded request history.
+    bool request(const char *name, uint64_t now) {
+        return request_pair(name, nullptr, now);
+    }
+
+    // Some UI gestures publish a gate and its selected operation together.
+    // Admit both or neither under one lock, using the same fixed storage.
+    bool request_pair(const char *first, const char *second, uint64_t now) {
+        if (!valid_name(first) || (second && !valid_name(second)))
+            return false;
+        std::lock_guard<std::mutex> lock(mutex_);
+        expire(now);
+        const char *names[] = {first, second};
+        const size_t count = second && strcmp(first, second) != 0 ? 2 : 1;
+        bool pending[2]{};
+        size_t free = 0, needed = 0;
+        for (const auto &entry : entries_) {
+            if (!entry.name[0])
+                ++free;
+            else
+                for (size_t i = 0; i < count; ++i)
+                    if (strcmp(entry.name, names[i]) == 0)
+                        pending[i] = true;
+        }
+        for (size_t i = 0; i < count; ++i)
+            needed += !pending[i];
+        if (needed > free)
+            return false;
+        for (size_t i = 0; i < count; ++i) {
+            if (pending[i])
+                continue;
+            for (auto &entry : entries_) {
+                if (!entry.name[0]) {
+                    memcpy(entry.name, names[i], strlen(names[i]) + 1);
+                    entry.created = now;
+                    break;
+                }
+            }
+        }
+        return true;
+    }
+
+    bool take(const char *name, uint64_t now) {
+        if (!valid_name(name))
+            return false;
+        std::lock_guard<std::mutex> lock(mutex_);
+        expire(now);
+        for (auto &entry : entries_) {
+            if (now >= entry.created && strcmp(entry.name, name) == 0) {
+                entry.name[0] = 0;
+                return true;
+            }
+        }
+        return false;
+    }
+
+    void clear() {
+        std::lock_guard<std::mutex> lock(mutex_);
+        for (auto &entry : entries_)
+            entry.name[0] = 0;
+    }
+
+  private:
+    struct Entry {
+        char name[name_bytes]{};
+        uint64_t created = 0;
+    };
+    Entry entries_[capacity]{};
+    std::mutex mutex_;
+
+    void expire(uint64_t now) {
+        // Native callers sample time before taking this mutex. A producer
+        // that loses the race can arrive with an older sample; do not treat
+        // unsigned subtraction from a newer entry as an expired request.
+        for (auto &entry : entries_)
+            if (entry.name[0] && now >= entry.created && now - entry.created >= lifetime_ns)
+                entry.name[0] = 0;
+    }
+};
