@@ -0,0 +1,115 @@
+"""Focused native test orchestration without invoking CMake or a native process."""
+import importlib.util
+import io
+from contextlib import redirect_stderr
+from pathlib import Path
+import subprocess
+import unittest
+from unittest.mock import patch
+
+spec = importlib.util.spec_from_file_location("test_tools_py", Path(__file__).parents[1] / "tools/test.py")
+test_py = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(test_py)
+
+
+class FocusedNativeTests(unittest.TestCase):
+    def setUp(self):
+        self.game = Path("/example/game")
+        self.root = self.game / "build"
+        self.directory = self.root / "cmake/macos"
+        self.environment = {"RECOMP_LOG": "0"}
+
+    def test_only_the_requested_target_and_exact_entry_run(self):
+        with patch.object(test_py.buildlock, "BuildLock") as lock, \
+             patch.object(test_py, "configure", return_value=self.directory) as configure, \
+             patch.object(test_py.build_py, "build") as build, \
+             patch.object(test_py.build_py, "cmake_tool", return_value="ctest"), \
+             patch.object(test_py, "run") as run:
+            test_py.native_test("macos", self.environment, 1, self.game, self.root, "guarded_call_tests")
+            lock.assert_called_once_with(self.game, "focused native test guarded_call_tests", wait=0)
+            configure.assert_called_once_with("macos", self.game, self.root)
+            build.assert_called_once_with("macos", ["guarded_call_tests"], 1, build_dir=self.directory)
+            run.assert_called_once_with(["ctest", "--test-dir", str(self.directory), "-R",
+                                         "^guarded_call_tests$", "--no-tests=error", "--output-on-failure"],
+                                        self.environment)
+
+    def test_invalid_names_or_jobs_start_no_build(self):
+        for name, jobs in [("", 1), ("guarded_call_tests|runtime_tests", 1),
+                           ("../guarded_call_tests", 1), ("--help", 1),
+                           ("guarded_call_tests", 0), ("guarded_call_tests", -1)]:
+            with self.subTest(name=name, jobs=jobs), \
+                 patch.object(test_py.buildlock, "BuildLock") as lock, \
+                 patch.object(test_py, "configure") as configure, \
+                 patch.object(test_py.build_py, "build") as build, \
+                 patch.object(test_py, "run") as run:
+                with self.assertRaises(RuntimeError):
+                    test_py.native_test("macos", {}, jobs, self.game, self.root, name)
+                lock.assert_not_called()
+                configure.assert_not_called()
+                build.assert_not_called()
+                run.assert_not_called()
+
+    def test_busy_checkout_starts_no_configure_or_build(self):
+        with patch.object(test_py.buildlock, "BuildLock") as lock, \
+             patch.object(test_py, "configure") as configure, \
+             patch.object(test_py.build_py, "build") as build:
+            lock.return_value.__enter__.side_effect = TimeoutError("another build owns the checkout")
+            with self.assertRaises(TimeoutError):
+                test_py.native_test("macos", {}, 1, self.game, self.root, "guarded_call_tests")
+            configure.assert_not_called()
+            build.assert_not_called()
+
+    def test_build_failure_does_not_run_a_stale_binary(self):
+        with patch.object(test_py.buildlock, "BuildLock"), \
+             patch.object(test_py, "configure", return_value=self.directory), \
+             patch.object(test_py.build_py, "build", side_effect=subprocess.CalledProcessError(1, "build")), \
+             patch.object(test_py, "run") as run:
+            with self.assertRaises(subprocess.CalledProcessError):
+                test_py.native_test("macos", {}, 1, self.game, self.root, "guarded_call_tests")
+            run.assert_not_called()
+
+    def test_missing_or_failed_ctest_entry_is_not_success(self):
+        with patch.object(test_py.buildlock, "BuildLock"), \
+             patch.object(test_py, "configure", return_value=self.directory), \
+             patch.object(test_py.build_py, "build"), \
+             patch.object(test_py.build_py, "cmake_tool", return_value="ctest"), \
+             patch.object(test_py, "run", side_effect=subprocess.CalledProcessError(8, "ctest")):
+            with self.assertRaises(subprocess.CalledProcessError):
+                test_py.native_test("macos", {}, 1, self.game, self.root, "guarded_call_tests")
+
+    def test_invalid_cli_never_falls_back_to_the_broad_suite(self):
+        for arguments in [["--native-test", ""], ["--native-test", "guarded_call_tests", "--jobs", "0"],
+                          ["--native", "--native-test", "guarded_call_tests"]]:
+            with self.subTest(arguments=arguments), \
+                 patch("sys.argv", ["test.py", *arguments]), \
+                 patch.object(test_py.build_py.game_config, "load") as load, \
+                 patch.object(test_py, "run") as run, redirect_stderr(io.StringIO()):
+                with self.assertRaises(SystemExit) as error:
+                    test_py.main()
+                self.assertEqual(error.exception.code, 2)
+                load.assert_not_called()
+                run.assert_not_called()
+
+    def test_focused_cli_defaults_to_one_job(self):
+        with patch("sys.argv", ["test.py", "--native-test", "guarded_call_tests"]), \
+             patch.object(test_py.build_py.game_config, "load", return_value={}), \
+             patch.object(test_py, "probe_module") as probe, \
+             patch.object(test_py, "native_test") as focused:
+            probe.return_value.without_switches.return_value = {}
+            test_py.main()
+            self.assertEqual(focused.call_args.args[2], 1)
+            self.assertEqual(focused.call_args.args[-1], "guarded_call_tests")
+
+    def test_broad_cli_retains_its_previous_default_job_limit(self):
+        with patch("sys.argv", ["test.py", "--native"]), \
+             patch.object(test_py.os, "cpu_count", return_value=16), \
+             patch.object(test_py.build_py.game_config, "load", return_value={}), \
+             patch.object(test_py, "probe_module") as probe, \
+             patch.object(test_py, "native") as native:
+            probe.return_value.without_switches.return_value = {}
+            test_py.main()
+            self.assertEqual(native.call_args.args[2], 8)
+
+
+if __name__ == "__main__":
+    unittest.main()
