+import assert from "node:assert/strict";
+import { ZIP_READ_BYTES } from "../zip-stream.mjs";
+
+// Memory-backed substitutes are limited to synthetic test data.
+export function memoryIndex() {
+  const records = [];
+  return {
+    async write(bytes) { records.push(new Uint8Array(bytes)); },
+    async* chunks() {
+      const data = Buffer.concat(records);
+      for (let at = 0; at < data.length; at += ZIP_READ_BYTES) yield data.subarray(at, at + ZIP_READ_BYTES);
+    },
+  };
+}
+
+export function watchedFile(bytes, name = "save.GMP", reads = []) {
+  const file = new File([bytes], name, {lastModified:1700000000000});
+  const slice = file.slice.bind(file);
+  file.arrayBuffer = () => { throw new Error("Whole-save read is forbidden"); };
+  file.slice = (start, end) => {
+    assert.ok(end - start <= ZIP_READ_BYTES);
+    const part = slice(start, end);
+    const read = part.arrayBuffer.bind(part);
+    part.arrayBuffer = async () => { reads.push([start, end]); return read(); };
+    return part;
+  };
+  return file;
+}
