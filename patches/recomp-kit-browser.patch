+// Real filesystem transactions: failure must preserve the previously published
+// bytes, including migration and failures after writing the inactive slot.
+static void test_checkpoint_transactions() {
+    std::string scratch = std::string(os_temp_dir()) + "/checkpoint-store-XXXXXX";
+    CHECK(os_mkdtemp(scratch.data()) == 0);
+    const std::array<std::string, 2> paths = {scratch + "/save0", scratch + "/save1"};
+    const std::string manifest = scratch + "/current";
+    const auto write = [](const std::string &path, const std::string &bytes) {
+        std::ofstream file(path, std::ios::binary | std::ios::trunc);
+        file.write(bytes.data(), bytes.size());
+        file.close();
+        return !file.fail();
+    };
+    const auto read = [](const std::string &path) {
+        std::ifstream file(path, std::ios::binary);
+        return std::string(std::istreambuf_iterator<char>(file), {});
+    };
+    CheckpointStore store(manifest, paths, "content-one");
+    CHECK(store.read().status == CheckpointStore::Status::missing);
+    CHECK(write(paths[0], "legacy complete world"));
+    CHECK(store.commit(
+        [&](int slot) {
+            CHECK_EQ(slot, 1);
+            return write(paths[slot], "new world");
+        },
+        0));
+    CHECK(store.read().status == CheckpointStore::Status::valid);
+    CHECK_EQ(store.read().slot, 1);
+    CHECK(read(paths[0]) == "legacy complete world");
+    const std::string committed = read(manifest), active = read(paths[1]);
+    CHECK(!store.commit([&](int slot) {
+        CHECK_EQ(slot, 0);
+        write(paths[slot], "partial");
+        return false;
+    }));
+    CHECK(read(manifest) == committed && read(paths[1]) == active);
+    CHECK(store.read().status == CheckpointStore::Status::valid);
+    CHECK(os_mkdir((manifest + ".tmp").c_str()) == 0);
+    CHECK(!store.commit([&](int slot) { return write(paths[slot], "finished but unpublished"); }));
+    CHECK(read(manifest) == committed && read(paths[1]) == active);
+    CHECK(os_rmdir((manifest + ".tmp").c_str()) == 0);
+    const auto fail_rename = [](const char *, const char *) { return -1; };
+    CHECK(!store.commit([&](int slot) { return write(paths[slot], "another complete world"); }, -1,
+                        fail_rename));
+    CHECK(read(manifest) == committed && read(paths[1]) == active);
+    CHECK(!std::filesystem::exists(manifest + ".tmp"));
+    CHECK(store.read().status == CheckpointStore::Status::valid);
+    CHECK(!store.commit([&](int slot) { return write(paths[slot], ""); }));
+    CHECK(read(manifest) == committed && read(paths[1]) == active);
+    CHECK(store.commit([&](int slot) { return write(paths[slot], "third world"); }));
+    CHECK_EQ(store.read().slot, 0);
+    CHECK(read(paths[1]) == active);
+    CHECK(store.commit([&](int slot) { return write(paths[slot], "fourth world"); }));
+    CHECK_EQ(store.read().slot, 1);
+    CHECK(read(paths[0]) == "third world");
+    CHECK(CheckpointStore(manifest, paths, "wrong content").read().status ==
+          CheckpointStore::Status::invalid);
+    bool called = false;
+    CHECK(!CheckpointStore(manifest, paths, "wrong content").commit([&](int) {
+        called = true;
+        return true;
+    }));
+    CHECK(!called);
+    const std::string good = read(manifest), good_save = read(paths[1]);
+    CHECK(write(paths[1], "FOURTH world")); // same size, different hash
+    CHECK(store.read().status == CheckpointStore::Status::invalid);
+    CHECK(!store.commit([&](int) {
+        called = true;
+        return true;
+    }));
+    CHECK(!called);
+    CHECK(write(paths[1], good_save));
+    for (const std::string &bad :
+         {std::string(512, 'a'), good + "extra", good.substr(0, good.size() - 1),
+          std::string("checkpoint-v1\n9\n1\n") + std::string(64, 'a') + "\ncontent-one\n",
+          std::string("checkpoint-v1\n0\n18446744073709551616\n") + std::string(64, 'a') +
+              "\ncontent-one\n"}) {
+        CHECK(write(manifest, bad));
+        CHECK(store.read().status == CheckpointStore::Status::invalid);
+        CHECK(!store.commit([&](int) {
+            called = true;
+            return true;
+        }));
+        CHECK(!called);
+    }
+    CHECK(write(manifest, good));
+    CHECK(store.read().status == CheckpointStore::Status::valid);
+    CHECK(os_unlink(manifest.c_str()) == 0);
+    CheckpointStore native(manifest, paths, "");
+    CHECK(native.commit([&](int slot) { return write(paths[slot], "native diagnostic"); }));
+    CHECK(native.read().status == CheckpointStore::Status::valid);
+    const std::string native_manifest = read(manifest);
+    CHECK(write(manifest, native_manifest.substr(0, native_manifest.size() - 1)));
+    CHECK(native.read().status == CheckpointStore::Status::invalid);
+    std::filesystem::remove_all(scratch);
+}
