+  let next = 0;
+  return {trace, destination, destinationFiles, previous, profile, container, context,
+    async export(useDestination = true) {
+      const id = ++next;
+      await context.onmessage({data:{id, cmd:"exportSaves", game, destination:useDestination ? destination : undefined}});
+      return messages.get(id);
+    },
+  };
+}
+
+test("actual worker exports nested saves, closes handles and removes its temporary index", async () => {
+  const h = setup(); const reply = await h.export();
+  assert.equal(reply.error, undefined); assert.equal(reply.result.count, 1); assert.equal(reply.result.saved, true);
+  assert.equal(h.trace.closed, 1); assert.equal(h.trace.removed, 1); assert.equal(h.trace.outputClosed, 1); assert.equal(h.trace.aborted, 0);
+  assert.equal(h.container.children.get("export-tmp").children.size, 0);
+  assert.equal(h.destinationFiles.get("previous.zip"), h.previous); assert.equal(h.previous.toString(), "existing backup");
+  assert.equal(h.destinationFiles.get(reply.result.name), h.trace.committed);
