+    CHECK_EQ(recomp_network_barrier_enable(epoch), 0u);
+    CHECK_EQ(dp_test_word(dp_test_sent, 8), 12u);
+    CHECK_EQ(dp_test_word(dp_test_sent, 20), 0u);
+    CHECK_EQ(dp_test_word(dp_test_sent, 24), 24u);
+    CHECK(std::string(dp_test_sent.begin() + 28, dp_test_sent.end()) == "checkpoint-transition-v1");
+    const DpBytes enable_wire = dp_test_sent;
