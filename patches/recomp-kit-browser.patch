new file mode 100644
index 0000000..af949af
--- /dev/null
+++ b/tests/test_web_memory_policy.py
@@ -0,0 +1,63 @@
+"""Exercise memory-policy CMake script logic without configuring or building a host."""
+from pathlib import Path
+import shutil
+import subprocess
+import sys
+import tempfile
+import unittest
+
+
+ROOT = Path(__file__).resolve().parents[1]
+
+
+class WebMemoryPolicyTests(unittest.TestCase):
+    def evaluate(self, policy, function="recomp_web_memory_options"):
+        with tempfile.TemporaryDirectory(prefix="recomp-web-memory-") as directory:
+            script = Path(directory) / "policy.cmake"
+            output = Path(directory) / "options.txt"
+            script.write_text('include("' + (ROOT / "cmake/WebMemory.cmake").as_posix() + '")\n'
+                              + function + '(options "' + policy + '")\n'
+                              'file(WRITE "' + output.as_posix() + '" "${options}")\n')
+            cmake = Path(sys.executable).with_name("cmake")
+            executable = str(cmake) if cmake.is_file() else shutil.which("cmake")
+            self.assertIsNotNone(executable, "CMake is required; policy tests must not silently skip")
+            result = subprocess.run([executable, "-P", str(script)], capture_output=True,
+                                    text=True, timeout=10)
+            return result, output.read_text() if output.is_file() else None
+
+    def test_conservative_and_legacy_emit_explicit_link_settings(self):
+        expected = {
+            "conservative": ["-sMEMORY_GROWTH_GEOMETRIC_STEP=0.05", "-sMEMORY_GROWTH_GEOMETRIC_CAP=16777216"],
+            "legacy": ["-sMEMORY_GROWTH_GEOMETRIC_STEP=0.2", "-sMEMORY_GROWTH_GEOMETRIC_CAP=100663296"],
+        }
+        for policy, options in expected.items():
+            with self.subTest(policy=policy):
+                result, text = self.evaluate(policy)
+                self.assertEqual(result.returncode, 0, result.stderr)
+                self.assertEqual(text.split(";"), options)
+
+    def test_unknown_policy_and_extra_flag_text_fail_closed(self):
+        for policy in ("", "unknown", "conservative;-sMAXIMUM_MEMORY=0"):
+            with self.subTest(policy=policy):
+                result, text = self.evaluate(policy)
+                self.assertNotEqual(result.returncode, 0)
+                self.assertIn("Unknown browser memory-growth policy", result.stderr)
+                self.assertIsNone(text)
+
+    def test_worker_policy_retains_standard_default_and_compact_can_grow(self):
+        for policy, count in (("standard", 8), ("compact", 4), ("lean", 2)):
+            result, text = self.evaluate(policy, "recomp_web_worker_options")
+            self.assertEqual(result.returncode, 0, result.stderr)
+            # No strict pool cap, stack change or guest scheduling flag.
+            self.assertEqual(text, "-sPTHREAD_POOL_SIZE=" + str(count))
+
+    def test_worker_policy_refuses_unknown_and_extra_flags(self):
+        for policy in ("", "unknown", "compact;-sPTHREAD_POOL_SIZE_STRICT=2", "lean;-sDEFAULT_PTHREAD_STACK_SIZE=0"):
+            result, text = self.evaluate(policy, "recomp_web_worker_options")
+            self.assertNotEqual(result.returncode, 0)
+            self.assertIn("Unknown browser worker-pool policy", result.stderr)
+            self.assertIsNone(text)
+
+
+if __name__ == "__main__":
+    unittest.main()
