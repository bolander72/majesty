+// Stored ZIP exports: serial source reads, an awaited sink and a disk index.
+import { crc32 } from "./core.js";
+
+export const ZIP_READ_BYTES = 65536;
+const U32 = 0xffffffff;
+const FLAGS = 0x0808; // UTF-8 names and a signed data descriptor (APPNOTE 4.3.9).
+
+function check(signal) { if (signal?.aborted) throw new DOMException("Save export cancelled", "AbortError"); }
+function bounds(value) {
+  if (!Number.isSafeInteger(value) || value < 0 || value >= U32)
+    throw new Error("This backup is too large for a single ZIP archive.");
+  return value;
+}
+function header(name, file, offset) {
+  if (typeof name !== "string" || !name || name.startsWith("/") || name.includes("\\") ||
+      name.split("/").some(p => !p || p === "." || p === "..") || name.includes("\0"))
+    throw new Error("Invalid save export path");
+  const encoded = new TextEncoder().encode(name);
+  if (encoded.length > 65535) throw new Error("Save export path is too long");
+  bounds(file.size); bounds(offset + 30 + encoded.length + file.size + 16);
+  const date = new Date(file.lastModified ?? Date.now());
+  const year = Math.max(1980, Math.min(2107, date.getFullYear()));
+  const time = (date.getHours() << 11) | (date.getMinutes() << 5) | (date.getSeconds() >> 1);
+  const day = ((year - 1980) << 9) | ((date.getMonth() + 1) << 5) | date.getDate();
+  const local = new DataView(new ArrayBuffer(30));
+  local.setUint32(0, 0x04034b50, true); local.setUint16(4, 20, true);
+  local.setUint16(6, FLAGS, true); local.setUint16(10, time, true); local.setUint16(12, day, true);
+  local.setUint16(26, encoded.length, true);
+  return {encoded, local:new Uint8Array(local.buffer), time, day};
+}
