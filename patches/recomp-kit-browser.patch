+        CHECK_EQ(info.player_count, 2u);
+        CHECK_EQ(info.players[0], 2u);
+        CHECK_EQ(info.players[1], 3u);
+        CHECK_EQ(info.players[2], 0u);
+        CHECK_EQ(info.players[3], 0u);
