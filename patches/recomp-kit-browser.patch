new file mode 100644
index 0000000..0446c74
--- /dev/null
+++ b/dx/tests/directplay_network.inc
@@ -0,0 +1,339 @@
+// Real socket qualification, explicitly separate from the fake provider suite.
+// One native DirectPlay object owns the guest baton; the reference peer and
+// actual room server live in the supervisor. These votes attest transferred bytes,
+// not an original game's save verification or world attachment.
+static void test_directplay_network() {
+    const char *url = getenv("NATIVE_DIRECTPLAY_TEST_URL");
+    const char *role = getenv("NATIVE_DIRECTPLAY_TEST_ROLE");
+    CHECK(url && role);
+    if (!url || !role)
+        return;
+    const bool host = !strcmp(role, "host");
+    CHECK(host || !strcmp(role, "guest"));
+    // Optional stopped bytes use the same bounded transport contract. The
+    // supervisor pins the file and checks its digest before and after both
+    // roles. A received match does not authorize loading an original world.
+    struct Input {
+        FILE *file = nullptr;
+        ~Input() {
+            if (file)
+                fclose(file);
+        }
+    } input;
+    uint32_t total = 50003;
+    if (const char *path = getenv("NATIVE_DIRECTPLAY_TEST_BYTES_FILE")) {
+        input.file = fopen(path, "rb");
+        CHECK(input.file);
+        if (!input.file)
+            return;
+        CHECK_EQ(fseek(input.file, 0, SEEK_END), 0);
+        const long length = ftell(input.file);
+        CHECK(length > 16384 && length <= 64 * 1024 * 1024);
+        if (length <= 16384 || length > 64 * 1024 * 1024)
+            return;
+        total = uint32_t(length);
+        CHECK_EQ(fseek(input.file, 0, SEEK_SET), 0);
+    }
+    const std::string descriptor = "actual-socket-checkpoint-fixture-v1";
+    const std::string manifest =
+        std::string(64, 'a') + ":" + std::string(64, 'b') + ":" + std::string(64, 'c');
+    sched_set_guest_thread(true);
+    directplay_reset();
+    CHECK(directplay_set_transport(nullptr));
+    os_setenv("RECOMP_NETWORK_URL", url);
+    os_setenv("RECOMP_NETWORK_MANIFEST", manifest.c_str());
+    const uint32_t token = sc(0x1f00), desc = sc(0x2000), size = sc(0x2100), out = sc(0x2200);
+    const uint32_t from = sc(0x2110), to = sc(0x2114), buffer = sc(0x2400);
+    const uint8_t guid[] = {0xe0, 0x5e, 0xe9, 0x36, 0x77, 0x85, 0xcf, 0x11,
+                            0x96, 0x0c, 0,    0x80, 0xc7, 0x53, 0x4e, 0x82};
+    memcpy(gm_ptr(token), guid, sizeof guid);
+    const uint32_t dp = com_view(com_new(K_DIRECTPLAY), IF_DIRECTPLAY4A);
+    auto finish = [&] {
+        CHECK_EQ(call_method(dp, 4), 0u);
+        CHECK_EQ(call_method(dp, 2), 0u);
+        CHECK_EQ(recomp_network_session_epoch(), 0u);
+        os_unsetenv("RECOMP_NETWORK_URL");
+        os_unsetenv("RECOMP_NETWORK_MANIFEST");
+        sched_set_guest_thread(false);
+    };
+    auto success = [&](uint32_t hr) {
+        CHECK_EQ(hr, 0u);
+        return hr == 0;
+    };
+    if (!success(call_method(dp, 38, {token, 0}))) {
+        finish();
+        return;
+    }
+    memset(gm_ptr(desc), 0, 80);
+    wr32(desc, 80);
+    wr32(desc + 40, 4);
+    if (!host) {
+        const char *instance = getenv("NATIVE_DIRECTPLAY_TEST_INSTANCE");
+        CHECK(instance && strlen(instance) == 32);
+        if (!instance || strlen(instance) != 32) {
+            finish();
+            return;
+        }
+        for (unsigned i = 0; i < 16; ++i) {
+            unsigned byte = 0;
+            CHECK_EQ(sscanf(instance + i * 2, "%2x", &byte), 1);
+            wr8(desc + 8 + i, uint8_t(byte));
+        }
+    }
+    if (!success(call_method(dp, 24, {desc, host ? 2u : 1u})) ||
+        !success(call_method(dp, 6, {out, 0, 0, 0, 0, 0}))) {
+        finish();
+        return;
+    }
+    const uint32_t local = rd32(out), peer = host ? 3 : 2;
+    CHECK_EQ(local, host ? 2u : 3u);
+    const uint64_t epoch = recomp_network_session_epoch();
+    CHECK(epoch);
+    if (!success(recomp_network_barrier_enable(epoch)) ||
+        !success(recomp_network_checkpoint_enable(epoch))) {
+        finish();
+        return;
+    }
+    auto packet = [&](const char *text) {
+        const uint32_t length = uint32_t(strlen(text));
+        memcpy(gm_ptr(buffer), text, length);
+        return success(call_method(dp, 26, {local, peer, 1, buffer, length}));
+    };
+    auto wait_packet = [&](const char *expected) {
+        const uint64_t deadline = os_monotonic_ns() + 5000000000ull;
+        while (os_monotonic_ns() < deadline) {
+            wr32(from, peer);
+            wr32(to, local);
+            wr32(size, 1024);
+            uint32_t hr = call_method(dp, 25, {from, to, 6, buffer, size});
+            if (!hr) {
+                CHECK_EQ(rd32(from), peer);
+                CHECK_EQ(rd32(to), local);
+                CHECK_EQ(rd32(size), strlen(expected));
+                bool matches = rd32(size) == strlen(expected) &&
+                               !memcmp(gm_ptr(buffer), expected, strlen(expected));
+                CHECK(matches);
+                return matches;
+            }
+            if (hr != 0x887700beu) {
+                CHECK_EQ(hr, 0x887700beu);
+                return false;
+            }
+            guest_sleep_ms(5);
+        }
+        CHECK(false);
+        return false;
+    };
+    if (host ? !wait_packet("peer-ready") : !packet("peer-ready")) {
+        finish();
+        return;
+    }
+    recomp_network_session_v1 info{};
+    CHECK(recomp_network_session_info(epoch, &info));
+    CHECK_EQ(info.host, host ? 1u : 0u);
+    CHECK_EQ(info.local_player, local);
+    CHECK_EQ(info.player_count, 2u);
+    CHECK_EQ(info.players[0], 2u);
+    CHECK_EQ(info.players[1], 3u);
+    uint32_t serial = 1;
+    auto barrier = [&](uint32_t action) {
+        return recomp_network_barrier_action(epoch, action, serial, descriptor.data(),
+                                             uint32_t(descriptor.size()));
+    };
+    auto stage = [&](uint32_t expected) {
+        const uint64_t deadline = os_monotonic_ns() + 5000000000ull;
+        recomp_network_barrier_v1 state{};
+        while (os_monotonic_ns() < deadline) {
+            if (recomp_network_barrier_snapshot(epoch, &state) && state.stage == expected) {
+                CHECK_EQ(state.serial, serial);
+                CHECK_EQ(state.player_count, 2u);
+                CHECK_EQ(state.players[0], 2u);
+                CHECK_EQ(state.players[1], 3u);
+                CHECK_EQ(state.descriptor_bytes, descriptor.size());
+                CHECK(!memcmp(state.descriptor, descriptor.data(), descriptor.size()));
+                return true;
+            }
+            guest_sleep_ms(5);
+        }
+        CHECK_EQ(state.stage, expected);
+        return false;
+    };
+    if ((host && !success(barrier(1))) || !stage(1)) {
+        finish();
+        return;
+    }
+    auto send = [&](uint32_t action, uint32_t value, const void *data = nullptr,
+                    uint32_t count = 0) {
+        return recomp_network_checkpoint_action(epoch, action, serial, peer, value, data, count);
+    };
+    recomp_network_checkpoint_v1 notice{};
+    auto event = [&](uint32_t action, uint32_t value) {
+        const uint64_t deadline = os_monotonic_ns() + 5000000000ull;
+        while (os_monotonic_ns() < deadline) {
+            if (recomp_network_checkpoint_poll(epoch, &notice)) {
+                CHECK_EQ(notice.action, action);
+                CHECK_EQ(notice.serial, serial);
+                CHECK_EQ(notice.from, peer);
+                CHECK_EQ(notice.to, local);
+                CHECK_EQ(notice.value, value);
+                return notice.action == action && notice.serial == serial && notice.from == peer &&
+                       notice.to == local && notice.value == value;
+            }
+            guest_sleep_ms(5);
+        }
+        CHECK(false);
+        return false;
+    };
+    if (host) {
+        if (!event(0, 0) || !success(send(1, total)) || !success(barrier(2)) || !event(3, 0)) {
+            finish();
+            return;
+        }
+    } else {
+        if (!success(send(0, 0, descriptor.data(), uint32_t(descriptor.size()))) ||
+            !event(1, total)) {
+            finish();
+            return;
+        }
+        CHECK_EQ(notice.bytes, 0u);
+        CHECK_EQ(barrier(2), E_INVALIDARG);
+        if (!success(send(3, 0))) {
+            finish();
+            return;
+        }
+    }
+    std::array<uint8_t, 16384> chunk{};
+    auto read_chunk = [&](uint32_t at, uint32_t count) {
+        if (input.file) {
+            const bool seek = fseek(input.file, long(at), SEEK_SET) == 0;
+            CHECK(seek);
+            if (!seek)
+                return false;
+            const bool read = fread(chunk.data(), 1, count, input.file) == count;
+            CHECK(read);
+            return read;
+        }
+        for (uint32_t i = 0; i < count; ++i)
+            chunk[i] = uint8_t((at + i) % 251);
+        return true;
+    };
+    uint32_t offset = 0, sequence = 1;
+    while (offset < total) {
+        const uint32_t count = std::min<uint32_t>(chunk.size(), total - offset);
+        if (!read_chunk(offset, count)) {
+            finish();
+            return;
+        }
+        if (host) {
+            if (!success(send(2, sequence, chunk.data(), count))) {
+                finish();
+                return;
+            }
+            // A second unacknowledged chunk is rejected locally, without closing the room.
+            CHECK_EQ(send(2, sequence, chunk.data(), count), E_INVALIDARG);
+            if (!event(3, sequence)) {
+                finish();
+                return;
+            }
+            CHECK_EQ(notice.bytes, 0u);
+        } else {
+            if (!event(2, sequence)) {
+                finish();
+                return;
+            }
+            CHECK_EQ(notice.bytes, count);
+            CHECK(notice.bytes == count && !memcmp(notice.data, chunk.data(), count));
+            if (!success(send(3, sequence))) {
+                finish();
+                return;
+            }
+        }
+        offset += count;
+        ++sequence;
+    }
+    if (host) {
+        if (!success(send(4, sequence)) || !event(5, sequence)) {
+            finish();
+            return;
+        }
+    } else {
+        if (!event(4, sequence)) {
+            finish();
+            return;
+        }
+        CHECK_EQ(barrier(2), E_INVALIDARG);
+        if (!success(send(5, sequence)) || !success(barrier(2))) {
+            finish();
+            return;
+        }
+    }
+    if (!stage(2) || !success(barrier(3)) || !stage(3)) {
+        finish();
+        return;
+    }
+    // Snapshot is the latest agreement, not an event queue. The next proposal
+    // must wait until both peers consumed Complete. Original game resume/pause
+    // ordering still needs qualification; this fixture uses an ordinary packet.
+    if (!packet("agreement-observed") || !wait_packet("agreement-observed")) {
+        finish();
+        return;
+    }
+    // A second proposal is canceled after one acknowledged chunk. The epoch
+    // and original packet path must remain usable; no canceled vote may load.
+    serial = 2;
+    if ((host && !success(barrier(1))) || !stage(1)) {
+        finish();
+        return;
+    }
+    if (!read_chunk(0, uint32_t(chunk.size()))) {
+        finish();
+        return;
+    }
+    if (host) {
+        if (!event(0, 0) || !success(send(1, total)) || !event(3, 0) ||
+            !success(send(2, 1, chunk.data(), chunk.size())) || !event(3, 1) ||
+            !success(barrier(4))) {
+            finish();
+            return;
+        }
+    } else {
+        if (!success(send(0, 0, descriptor.data(), uint32_t(descriptor.size()))) ||
+            !event(1, total) || !success(send(3, 0)) || !event(2, 1)) {
+            finish();
+            return;
+        }
+        CHECK_EQ(notice.bytes, chunk.size());
+        CHECK(notice.bytes == chunk.size() && !memcmp(notice.data, chunk.data(), chunk.size()));
+        if (!success(send(3, 1))) {
+            finish();
+            return;
+        }
+    }
+    if (!stage(4)) {
+        finish();
+        return;
+    }
+    CHECK_EQ(barrier(2), E_INVALIDARG);
+    CHECK_EQ(recomp_network_checkpoint_poll(epoch, &notice), 0);
+    CHECK_EQ(notice.action | notice.serial | notice.from | notice.to | notice.value | notice.bytes,
+             0u);
+    CHECK_EQ(send(4, 2), E_INVALIDARG);
+    CHECK_EQ(recomp_network_session_epoch(), epoch);
+    CHECK(recomp_network_session_info(epoch, &info));
+    CHECK_EQ(info.player_count, 2u);
+    if (!packet("fixture-complete") || !wait_packet("completion-confirmed")) {
+        finish();
+        return;
+    }
+    // The reference peer closes after confirming both agreement completion and
+    // ordinary packet exchange. Loss must revoke the epoch, never reconnect it.
+    const uint64_t deadline = os_monotonic_ns() + 5000000000ull;
+    while (recomp_network_session_info(epoch, &info) && os_monotonic_ns() < deadline)
+        guest_sleep_ms(5);
+    CHECK_EQ(recomp_network_session_epoch(), 0u);
+    CHECK(!recomp_network_session_info(epoch, &info));
+    CHECK_EQ(info.player_count, 0u);
+    CHECK_EQ(recomp_network_checkpoint_enable(epoch), 0x88770136u);
+    CHECK_EQ(send(0, 0, descriptor.data(), uint32_t(descriptor.size())), 0x88770136u);
+    finish();
+}
