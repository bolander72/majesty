diff --git a/cmake/WebMemory.cmake b/cmake/WebMemory.cmake
new file mode 100644
index 0000000..52ef6fa
--- /dev/null
+++ b/cmake/WebMemory.cmake
@@ -0,0 +1,29 @@
+# Explicit browser heap-growth choices. Capacity, worker count and stacks are
+# configured separately; this policy only changes excess growth reservations.
+function(recomp_web_memory_options output policy)
+  if(policy STREQUAL "conservative")
+    # Smaller retries remain distinct above the 512 MiB initial heap: 5%, 2.5%,
+    # then 1.25%, with no more than 16 MiB excess before page alignment.
+    set(options -sMEMORY_GROWTH_GEOMETRIC_STEP=0.05 -sMEMORY_GROWTH_GEOMETRIC_CAP=16777216)
+  elseif(policy STREQUAL "legacy")
+    set(options -sMEMORY_GROWTH_GEOMETRIC_STEP=0.2 -sMEMORY_GROWTH_GEOMETRIC_CAP=100663296)
+  else()
+    message(FATAL_ERROR "Unknown browser memory-growth policy: ${policy}")
+  endif()
+  set(${output} ${options} PARENT_SCOPE)
+endfunction()
+
+# Only idle startup workers change. Later pthread creation may grow the pool;
+# stack sizes, guest scheduling and the number of live game threads are intact.
+function(recomp_web_worker_options output policy)
+  if(policy STREQUAL "standard")
+    set(options -sPTHREAD_POOL_SIZE=8)
+  elseif(policy STREQUAL "compact")
+    set(options -sPTHREAD_POOL_SIZE=4)
+  elseif(policy STREQUAL "lean")
+    set(options -sPTHREAD_POOL_SIZE=2)
+  else()
+    message(FATAL_ERROR "Unknown browser worker-pool policy: ${policy}")
+  endif()
+  set(${output} ${options} PARENT_SCOPE)
+endfunction()
