+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { readFile } from "node:fs/promises";
+import { runInNewContext } from "node:vm";
+import { randomUUID } from "node:crypto";
+import * as core from "../core.js";
+import * as zip from "../zip-stream.mjs";
+import { watchedFile } from "./save-fixtures.mjs";
+
+const workerSource = (await readFile(new URL("../worker.js", import.meta.url), "utf8")).replace(/^import .+;\n/gm, "");
+const appSource = await readFile(new URL("../app.js", import.meta.url), "utf8");
+const exportSource = appSource.slice(appSource.indexOf('el.querySelector(".export-saves").onclick ='),
+  appSource.indexOf('el.querySelector(".import-saves").onclick ='));
+
+function setup(files = {"regions/0/save.GMP":watchedFile(new Uint8Array(2 * zip.ZIP_READ_BYTES + 17))}, fault = "") {
+  const trace = {closed:0, removed:0, committed:Buffer.from("existing backup"), outputClosed:0, aborted:0, pulls:0,
+    destinationCreated:0, destinationRemoved:0};
+  class Directory {
+    constructor() { this.kind = "directory"; this.children = new Map(); }
+    async getDirectoryHandle(name, {create = false} = {}) {
+      if (!this.children.has(name) && create) this.children.set(name, new Directory());
+      const child = this.children.get(name); if (!child || child.kind !== "directory") throw new Error("No directory");
+      return child;
+    }
+    async getFileHandle(name, {create = false} = {}) {
+      if (!this.children.has(name) && create) this.children.set(name, {
+        kind:"file", async createSyncAccessHandle() {
+          if (fault === "open-index") throw new Error("Cannot open index");
+          let bytes = Buffer.alloc(0), closed = false;
+          function live() { assert.equal(closed, false); }
+          return {
+            truncate(n) { live(); bytes = Buffer.alloc(n); },
+            write(b, {at}) {
+              live(); if (fault === "write-index") return b.length - 1;
+              if (bytes.length < at + b.length) { const bigger = Buffer.alloc(at + b.length); bytes.copy(bigger); bytes = bigger; }
+              bytes.set(b, at); return b.length;
+            },
+            read(b, {at}) { live(); b.set(bytes.subarray(at, at + b.length)); return b.length - (fault === "read-index" ? 1 : 0); },
+            flush() { live(); if (fault === "flush-index") throw new Error("Cannot flush index"); },
+            close() { live(); closed = true; ++trace.closed; },
+          };
+        },
+      });
+      const child = this.children.get(name); if (!child || child.kind !== "file") throw new Error("No file"); return child;
+    }
+    async removeEntry(name) { assert.ok(this.children.delete(name)); ++trace.removed; }
+    async* entries() { for (const entry of this.children) { ++trace.pulls; yield entry; } }
+  }
+  const root = new Directory(), game = {id:"synthetic", title:"Synthetic"};
+  const container = awaitableDirectory(root, game.id), profile = awaitableDirectory(container, "profile");
+  function awaitableDirectory(parent, name) { const dir = new Directory(); parent.children.set(name, dir); return dir; }
+  for (const [path, file] of Object.entries(files)) {
+    const parts = path.split("/"), name = parts.pop(); let dir = profile;
+    for (const part of parts) dir = dir.children.get(part) || awaitableDirectory(dir, part);
+    dir.children.set(name, {kind:"file", async getFile() { return file; }});
+  }
+  const previous = Buffer.from("existing backup"), destinationFiles = new Map([["previous.zip", previous]]);
+  const destination = {async getFileHandle(name, {create = false} = {}) {
+    if (fault === "choose-output") throw new DOMException("Permission denied", "NotAllowedError");
+    if (!create) {
+      if (fault === "collisions" || destinationFiles.has(name)) return {};
+      throw new DOMException("Not found", "NotFoundError");
+    }
+    assert.equal(destinationFiles.has(name), false, "An existing backup must never be opened for writing");
+    destinationFiles.set(name, Buffer.alloc(0)); ++trace.destinationCreated;
+    return {async createWritable() {
+    if (fault === "open-output") throw new Error("Cannot open destination");
+    const pending = []; let writes = 0;
+    return {
+      async write(bytes) { if (++writes === 3 && fault === "write-output") throw new Error("Disk full"); pending.push(Buffer.from(bytes)); },
+      async close() { if (fault === "close-output") throw new Error("Commit failed"); trace.committed = Buffer.concat(pending); destinationFiles.set(name, trace.committed); ++trace.outputClosed; },
+      async abort() { pending.length = 0; ++trace.aborted; },
+    };
+    }};
+  }, async removeEntry(name) {
+    assert.notEqual(name, "previous.zip"); assert.equal(destinationFiles.delete(name), true); ++trace.destinationRemoved;
+  }};
+  const messages = new Map();
+  const context = {...core, ...zip, Uint8Array, ArrayBuffer, TextEncoder, TextDecoder, DOMException, Blob,
+    AbortController, crypto:{randomUUID}, navigator:{storage:{async getDirectory() { return root; }}},
+    postMessage(message) { messages.set(message.id, message); }};
