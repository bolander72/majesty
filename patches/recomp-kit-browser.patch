+    memset(&disconnected, 0xa5, sizeof disconnected);
+    CHECK(!recomp_network_session_info(epoch, &disconnected));
+    CHECK(!disconnected.host && !disconnected.local_player && !disconnected.player_count &&
+          !disconnected.players[0] && !disconnected.players[3]);
+    CHECK_EQ(call_method(dp, 17, {0, size}), 0u);
+    CHECK_EQ(recomp_network_session_epoch(), 0u);
+    close();
+    CHECK_EQ(call_method(dp, 2), 0u);
+    CHECK(directplay_set_transport(nullptr));
+    os_unsetenv("RECOMP_NETWORK_URL");
+    os_unsetenv("RECOMP_NETWORK_MANIFEST");
+    if (!held)
+        sched_set_guest_thread(false);
+}
+static uint32_t dp_checkpoint_reply_status;
+static bool dp_checkpoint_bad_version, dp_checkpoint_reply_payload;
+static bool dp_checkpoint_auto_ack, dp_checkpoint_commit_after_end, dp_checkpoint_cancel_action;
+static std::deque<DpBytes> dp_checkpoint_early_events;
+static DpBytes dp_checkpoint_event_body(uint32_t action, uint32_t serial, uint32_t from,
+                                        uint32_t to, uint32_t value = 0, const DpBytes &data = {}) {
+    DpBytes body;
+    for (uint32_t v : {action, serial, from, to})
+        dp_test_put(body, v);
+    if (action)
+        dp_test_put(body, value);
+    if (action == 2) {
+        dp_test_put(body, uint32_t(data.size()));
+        body.insert(body.end(), data.begin(), data.end());
+    }
+    return body;
+}
+static int dp_checkpoint_test_send(OsWebSocket *socket, const void *bytes, uint32_t length) {
+    const auto *p = static_cast<const uint8_t *>(bytes);
+    DpBytes wire(p, p + length);
+    if (dp_test_word(wire, 8) != 13)
+        return dp_barrier_test_send(socket, bytes, length);
+    dp_test_sent = wire;
+    const uint32_t request = dp_test_word(wire, 12), action = dp_test_word(wire, 20);
+    if (dp_checkpoint_cancel_action && action != 6)
+        dp_test_event(109, dp_barrier_event_body(dp_test_word(wire, 24), 4, "checkpoint"));
+    if (dp_checkpoint_auto_ack && (action == 1 || action == 2 || action == 4)) {
+        const uint32_t serial = dp_test_word(wire, 24), peer = dp_test_word(wire, 28);
+        const uint32_t seq = action == 1 ? 0 : dp_test_word(wire, 32);
+        dp_test_event(110, dp_checkpoint_event_body(action == 4 ? 5 : 3, serial, peer, 2, seq));
+        if (action == 4 && dp_checkpoint_commit_after_end)
+            dp_test_event(109, dp_barrier_event_body(serial, 2, "checkpoint"));
+    }
+    // Exercise replies interleaved with delivery events, as the real pump does.
+    for (const auto &event : dp_checkpoint_early_events)
+        dp_test_event(110, event);
+    dp_checkpoint_early_events.clear();
+    DpBytes reply;
+    for (uint32_t v : {0x31525044u, 1u, 13u | 0x80000000u, request, dp_checkpoint_reply_status})
+        dp_test_put(reply, v);
+    if (action == 6 && !dp_checkpoint_reply_status)
+        dp_test_put(reply, dp_checkpoint_bad_version ? 2 : 1);
+    else if (dp_checkpoint_reply_payload)
+        dp_test_put(reply, 99);
+    dp_test_in.push_back(reply);
+    return 0;
+}
