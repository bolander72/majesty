+        wr32(desc, 80);
+        wr32(desc + 40, 4);
+        CHECK_EQ(call_method(dp, 24, {desc, flags}), 0u);
+        const uint64_t epoch = recomp_network_session_epoch();
+        CHECK(epoch);
+        CHECK_EQ(call_method(dp, 6, {out, 0, 0, 0, 0, 0}), 0u);
