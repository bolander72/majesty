+// MSVC restores FS:[0] while saved registers and locals are still below
+// the registration. Reusing that stack slot must not retain dead jmp_bufs
+// or make every subsequent leave scan all previous function calls.
+static void unlink_before_stack_restore() {
+    X86 c;
+    loader_init_context(&c);
+    const uint32_t outer = c.r[R_ESP] - 16, inner = outer - 64;
+    c.r[R_ESP] = outer;
+    registration(&c, outer, 0xffffffff, handler_search);
+    recomp_seh_frame_enter(&c);
+    uint32_t peak = 0;
+    for (unsigned i = 0; i < 64; ++i) {
+        c.r[R_ESP] = inner;
+        registration(&c, inner, outer, handler_search);
+        recomp_seh_frame_enter(&c);
+        const uint32_t count = recomp_seh_test_frame_count(&c);
+        if (count > peak)
+            peak = count;
+        c.r[R_ESP] = inner - 32; // epilogue has not popped locals/registers
+        wr32(c.fs_base, outer);
+        recomp_seh_frame_leave(&c);
+    }
+    CHECK(peak == 2);
+    CHECK(recomp_seh_test_frame_count(&c) == 1);
+    CHECK(rd32(c.fs_base) == outer && c.r[R_ESP] == inner - 32);
+    // Equality still preserves the live outer record at this same ESP.
+    recomp_seh_frame_leave(&c);
+    CHECK(recomp_seh_test_frame_count(&c) == 1);
+    wr32(c.fs_base, 0xffffffff);
+    recomp_seh_frame_leave(&c);
+    CHECK(recomp_seh_test_frame_count(&c) == 0);
