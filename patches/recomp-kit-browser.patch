+// Exercise the actual host gate and guest USER32 loop, including repeats and
+// consumed input. A host-only character assertion misses double translation.
+static void test_input_gate_characters() {
+    X86 ctx;
+    loader_init_context(&ctx);
+    gate_make_window(&ctx);
+    struct Case {
+        uint32_t vk, character;
+        bool shift;
+    };
+    const Case cases[] = {
+        {'1', '1', false},   {'G', 'g', false},   {'G', 'G', true},    {'1', '!', true},
+        {0xbd, '-', false},  {0xbd, '_', true},   {0x09, '\t', false}, {0x0d, '\r', false},
+        {0x08, '\b', false}, {0x1b, 0x1b, false}, {0x61, '1', false},
+    };
+    for (const auto &item : cases) {
+        gate_reset_all(&ctx);
+        g_consume_next = false;
+        uint16_t mac = 0xffff;
+        for (int i = 0; i < host_key_mapping_count(); ++i)
+            if (host_key_mapping_table()[i].vk == item.vk) {
+                mac = host_key_mapping_table()[i].mac;
+                break;
+            }
+        CHECK(mac != 0xffff);
+        if (mac == 0xffff)
+            continue;
+        if (item.shift) {
+            host_modifier_event(0x00000002u);
+            gate_drain(&ctx);
+        }
+        for (int repeat = 0; repeat != 2; ++repeat) {
+            CHECK(!host_key_event(mac, true, item.character));
+            uint32_t wp = 0, msg = gate_scratch(0x200);
+            CHECK(gate_next_message(&ctx, &wp) == 0x0100);
+            CHECK(wp == item.vk);
+            CHECK(bool(rd32(msg + 12) & (1u << 30)) == bool(repeat));
+            CHECK(!host_messages_pending());
+            CHECK(gate_call_import(&ctx, "USER32.dll", "TranslateMessage", {msg}) == 1);
+            CHECK(gate_next_message(&ctx, &wp) == 0x0102);
+            CHECK(wp == item.character);
+            CHECK(gate_call_import(&ctx, "USER32.dll", "TranslateMessage", {msg}) == 0);
+            CHECK(gate_next_message(&ctx, nullptr) == 0);
+        }
+        CHECK(!host_key_event(mac, false, 0));
+        CHECK(gate_next_message(&ctx, nullptr) == 0x0101);
+        CHECK(gate_call_import(&ctx, "USER32.dll", "TranslateMessage", {gate_scratch(0x200)}) == 0);
+        CHECK(gate_next_message(&ctx, nullptr) == 0);
+        host_modifier_event(0);
+        gate_drain(&ctx);
+        // A browser can queue the complete chord before the guest gets CPU.
+        // Translation must use the modifier state of this queued key, not
+        // the already released (or newly pressed) physical Shift key.
+        if (item.shift)
+            host_modifier_event(0x00000002u);
+        CHECK(!host_key_event(mac, true, item.character));
+        CHECK(!host_key_event(mac, false, 0));
+        host_modifier_event(item.shift ? 0 : 0x00000002u);
+        uint32_t msg = gate_scratch(0x200), wp = 0;
+        if (item.shift)
+            CHECK(gate_next_message(&ctx, nullptr) == 0x0100);
+        CHECK(gate_next_message(&ctx, &wp) == 0x0100);
+        CHECK(wp == item.vk);
+        CHECK(gate_call_import(&ctx, "USER32.dll", "TranslateMessage", {msg}) == 1);
+        CHECK(gate_next_message(&ctx, nullptr) == 0x0101);
+        CHECK(gate_next_message(&ctx, nullptr) == (item.shift ? 0x0101 : 0x0100));
+        CHECK(gate_next_message(&ctx, &wp) == 0x0102);
+        CHECK(wp == item.character);
+        CHECK(gate_next_message(&ctx, nullptr) == 0);
+        host_modifier_event(0);
+        gate_drain(&ctx);
+    }
+    gate_reset_all(&ctx);
+}
