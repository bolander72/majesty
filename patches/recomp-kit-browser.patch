+    auto close = [&] { CHECK_EQ(call_method(dp, 4), 0u); };
+    auto command = [&](uint64_t epoch, uint32_t action, uint32_t serial, const std::string &data) {
+        return recomp_network_barrier_action(epoch, action, serial, data.data(),
