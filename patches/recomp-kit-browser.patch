+static void test_streamed_file_hash() {
+    std::string scratch = std::string(os_temp_dir()) + "/stream-hash-XXXXXX";
+    CHECK(os_mkdtemp(scratch.data()) == 0);
+    const std::string path = scratch + "/data";
+    const std::pair<size_t, const char *> cases[] = {
+        {55, "463eb28e72f82e0a96c0a4cc53690c571281131f672aa229e0d45ae59b598b59"},
+        {56, "da2ae4d6b36748f2a318f23e7ab1dfdf45acdc9d049bd80e59de82a60895f562"},
+        {63, "29af2686fd53374a36b0846694cc342177e428d1647515f078784d69cdb9e488"},
+        {64, "fdeab9acf3710362bd2658cdc9a29e8f9c757fcf9811603a8c447cd1d9151108"},
+        {65, "4bfd2c8b6f1eec7a2afeb48b934ee4b2694182027e6d0fc075074f2fabb31781"},
+        {16383, "e08c7d58e58b9318263144a618d6f2b6f6825974decd9e6f9371567354b6f566"},
+        {16384, "4348e3b98e8a327b34ced39c1da9e67cdb4cd5e48e4d7960607a3ae403d35f0c"},
+        {16385, "ba4f9b37402df1e3ad948a794ab43a9ed887d63e3a389c208ca4314fdd5add58"},
+        {1048583, "9e037498ddbb955fba0752812031c14ba299a4875cb400e8b8c1d77b3962c90e"},
+    };
+    for (const auto &[length, expected] : cases) {
+        std::ofstream file(path, std::ios::binary | std::ios::trunc);
+        for (size_t i = 0; i < length; ++i)
+            file.put(char(i % 251));
+        file.close();
+        CHECK(loader_hash_file(path.c_str()) == expected);
+    }
+    {
+        std::ofstream empty(path, std::ios::trunc);
+    }
+    CHECK(loader_hash_file(path.c_str()).empty());
+    CHECK(loader_hash_file((scratch + "/missing").c_str()).empty());
+    CHECK(loader_hash_file(nullptr).empty());
+    std::filesystem::remove_all(scratch);
+}
