diff --git a/runtime/tests/guarded_call_tests.cpp b/runtime/tests/guarded_call_tests.cpp
new file mode 100644
index 0000000..6091f87
--- /dev/null
+++ b/runtime/tests/guarded_call_tests.cpp
@@ -0,0 +1,360 @@
+// Focused callback-stop tests over real runtime shims, without original code,
+// a PE image, game window, audio device or a browser. Hook unwind is a spy.
+#include "../imports.h"
+#include "../loader.h"
+#include "../memory.h"
+#include "../profile.h"
+#include "../seh.h"
+#include "../win32.h"
+#include <climits>
+#include <cstdio>
+#include <cstring>
+#include <thread>
+
+static int checks, failures, reached_after_cancel, dispatched;
+#define CHECK(x)                                                                                   \
+    do {                                                                                           \
+        ++checks;                                                                                  \
+        if (!(x)) {                                                                                \
+            ++failures;                                                                            \
+            fprintf(stderr, "FAIL line %d: %s\n", __LINE__, #x);                                   \
+        }                                                                                          \
+    } while (0)
+
+static uint64_t owner_cookie, nested_cookie, stale_cookie;
+static uint32_t normal_fn, cancel_fn, nested_fn, ordinary_fn, foreign_fn;
+static uint32_t landing_fn, simple_cancel_fn;
+static uint32_t unwound_to, parent_esp, parent_depth;
+static X86 foreign_cpu;
+static X86 *owner_cpu;
+static constexpr uint32_t RESULT = 0x13579bdf;
+static constexpr uint32_t MEMORY_MARKER = STACK_TOP - 0x2000;
+
+extern "C" int32_t recomp_index_of(uint32_t) {
+    return -1;
+}
+extern "C" int recomp_is_call_return(uint32_t target) {
+    return target == GUEST_RETURN_SENTINEL;
+}
+extern "C" void recomp_call(X86 *c, uint32_t target) {
+    CHECK(imports_dispatch(c, target));
+}
+extern "C" void recomp_jump(X86 *c, uint32_t target) {
+    recomp_call(c, target);
+}
+extern "C" void mods_hooks_unwind_to_esp(uint32_t esp) {
+    unwound_to = esp;
+}
+
+static void check_cpu(const X86 &actual, const X86 &expected) {
+    // Compare every modeled field, not C++ structure padding.
+    CHECK(!memcmp(actual.r, expected.r, sizeof actual.r));
+    CHECK(actual.eip == expected.eip);
+    CHECK(actual.eflags_cf == expected.eflags_cf && actual.eflags_zf == expected.eflags_zf);
+    CHECK(actual.eflags_sf == expected.eflags_sf && actual.eflags_of == expected.eflags_of);
+    CHECK(actual.eflags_pf == expected.eflags_pf && actual.eflags_af == expected.eflags_af);
+    CHECK(actual.eflags_df == expected.eflags_df && actual.eflags_misc == expected.eflags_misc);
+    CHECK(!memcmp(actual.st, expected.st, sizeof actual.st));
+    CHECK(!memcmp(actual.st_bits, expected.st_bits, sizeof actual.st_bits));
+    CHECK(!memcmp(actual.st_exact, expected.st_exact, sizeof actual.st_exact));
+    CHECK(actual.fpu_top == expected.fpu_top && actual.fpu_cw == expected.fpu_cw);
+    CHECK(actual.fpu_sw == expected.fpu_sw && actual.fpu_tag == expected.fpu_tag);
+    CHECK(actual.fs_base == expected.fs_base);
+    CHECK(!memcmp(actual.xmm, expected.xmm, sizeof actual.xmm));
+    CHECK(!memcmp(actual.mm, expected.mm, sizeof actual.mm));
+}
+
+static void normal(X86 *c) {
+    ++dispatched;
+    CHECK(guest_call_guarded_cookie(c) == owner_cookie && owner_cookie != 0);
+    CHECK(arg(c, 0) == 17 && arg(c, 1) == 29);
+    CHECK(!guest_call_guarded_cancel(c, stale_cookie, 0));
+    c->r[R_ECX] = 0x2468ace0; // normal guest register changes must survive
+    c->r[R_EAX] = RESULT;
+}
+
+static void cancel(X86 *c) {
+    ++dispatched;
+    CHECK(guest_call_guarded_cookie(c) == owner_cookie);
+    CHECK(!guest_call_guarded_cancel(c, 0, 0));
+    CHECK(!guest_call_guarded_cancel(c, stale_cookie, 0));
+    CHECK(!guest_call_guarded_cancel(&foreign_cpu, owner_cookie, 0));
+    uint32_t reg = c->r[R_ESP] - 64;
+    wr32(reg, rd32(c->fs_base));
+    wr32(reg + 4, normal_fn);
+    wr32(reg + 8, c->r[R_EBP]);
+    wr32(c->fs_base, reg);
+    recomp_seh_frame_enter(c); // cancellation discards this unfinished frame
+    // Stop with a real pending SEH transfer, without dispatching a handler.
+    recomp_seh_unwind(c, reg, 0, 0, 0);
+    CHECK(recomp_seh_pending_target() == reg);
+    uint64_t rejected_cookie = 123;
+    CHECK(guest_call_guarded(c, normal_fn, nullptr, 0, &rejected_cookie).status ==
+          GuestCallGuardedStatus::InvalidCall);
+    CHECK(rejected_cookie == 0 && recomp_seh_pending_target() == reg);
+    for (int i = 0; i < 9; ++i)
+        sched_atomic_enter(c->r[R_ESP] - 8 * (i + 1));
+    CHECK(sched_atomic_depth() == parent_depth + 9);
+    recomp_profile_push(31);
+    wr32(MEMORY_MARKER, RESULT); // a stop is not a guest memory transaction
+    memset(c, 0x5a, sizeof *c);
+    guest_call_guarded_cancel(c, owner_cookie, RESULT);
+    ++reached_after_cancel;
+}
+
+static void inner_cancel(X86 *c) {
+    CHECK(guest_call_guarded_cookie(c) == nested_cookie);
+    CHECK(guest_call_guarded_active(c, nested_cookie));
+    CHECK(guest_call_guarded_active(c, owner_cookie));
+    CHECK(nested_cookie != owner_cookie);
+    CHECK(!guest_call_guarded_cancel(c, owner_cookie, 0));
+    guest_call_guarded_cancel(c, nested_cookie, 77);
+    ++reached_after_cancel;
+}
+
+static void inner_ordinary(X86 *c) {
+    CHECK(guest_call_guarded_cookie(c) == 0);
+    CHECK(guest_call_guarded_active(c, owner_cookie));
+    CHECK(!guest_call_guarded_active(c, nested_cookie));
+    CHECK(!guest_call_guarded_cancel(c, owner_cookie, 0));
+    c->r[R_EAX] = 88;
+}
+
+static void inner_foreign(X86 *c) {
+    CHECK(c == &foreign_cpu);
+    CHECK(guest_call_guarded_active(owner_cpu, owner_cookie));
+    CHECK(!guest_call_guarded_active(c, owner_cookie));
+    CHECK(guest_call_guarded_cookie(c) == 0);
+    CHECK(!guest_call_guarded_cancel(c, owner_cookie, 0));
+    CHECK(guest_call_guarded_cookie(owner_cpu) == 0);
+    CHECK(!guest_call_guarded_cancel(owner_cpu, owner_cookie, 0));
+    X86 before = *c;
+    uint64_t rejected = 123;
+    CHECK(guest_call_guarded(c, simple_cancel_fn, nullptr, 0, &rejected).status ==
+          GuestCallGuardedStatus::InvalidCall);
+    CHECK(rejected == 0);
+    check_cpu(*c, before);
+    c->r[R_EAX] = 99;
+}
+
+static void nested(X86 *c) {
+    CHECK(guest_call_guarded_cookie(c) == owner_cookie);
+    X86 foreign_before = foreign_cpu;
+    uint64_t rejected = 123;
+    CHECK(guest_call_guarded(&foreign_cpu, simple_cancel_fn, nullptr, 0, &rejected).status ==
+          GuestCallGuardedStatus::InvalidCall);
+    CHECK(rejected == 0 && guest_call_guarded_cookie(c) == owner_cookie);
+    check_cpu(foreign_cpu, foreign_before);
+    X86 before = *c;
+    auto result = guest_call_guarded(c, nested_fn, nullptr, 0, &nested_cookie);
+    CHECK(result.status == GuestCallGuardedStatus::Cancelled && result.eax == 77);
+    CHECK(!guest_call_guarded_active(c, nested_cookie));
+    before.r[R_EAX] = 77;
+    check_cpu(*c, before);
+    CHECK(guest_call_guarded_cookie(c) == owner_cookie);
+    CHECK(!guest_call_guarded_cancel(c, nested_cookie, 0));
+    CHECK(guest_call(c, ordinary_fn) == 88);
+    // This call deliberately uses another CPU, whose ordinary callback must
+    // hide the outer guarded CPU on the same host thread.
+    CHECK(guest_call(&foreign_cpu, foreign_fn) == 99);
+    CHECK(guest_call_guarded_cookie(c) == owner_cookie);
+    bool foreign_thread_rejected = false;
+    {
+        std::thread worker([&] {
+            foreign_thread_rejected = guest_call_guarded_cookie(c) == 0 &&
+                                      !guest_call_guarded_active(c, owner_cookie) &&
+                                      !guest_call_guarded_cancel(c, owner_cookie, 0);
+        });
+        worker.join();
+    } // no C++ thread owner remains live across the accepted cancellation
+    CHECK(foreign_thread_rejected);
+    guest_call_guarded_cancel(c, owner_cookie, 66);
+    ++reached_after_cancel;
+}
+
+static void sentinel_return(X86 *c) {
+    CHECK(guest_call_guarded_cookie(c) == owner_cookie);
+    c->r[R_EAX] = RESULT;
+    c->r[R_ESP] += 4;
+    c->eip = GUEST_RETURN_SENTINEL;
+    recomp_callback_return(c);
+    ++reached_after_cancel;
+}
+
+static void landing_body(X86 *c) {
+    c->r[R_EAX] = 111;
+}
+
+static void simple_cancel(X86 *c) {
+    CHECK(guest_call_guarded_cookie(c) == owner_cookie);
+    guest_call_guarded_cancel(c, owner_cookie, 22);
+    ++reached_after_cancel;
+}
+
+static void prepare_landing(X86 *c, uint32_t reg) {
+    wr32(reg, rd32(c->fs_base));
+    wr32(reg + 4, normal_fn);
+    wr32(reg + 8, c->r[R_EBP]);
+    wr32(c->fs_base, reg);
+    c->r[R_ESP] = reg - 16;
+    wr32(c->r[R_ESP], GUEST_RETURN_SENTINEL);
+}
+
+// A completed guest landing has jumped back to its establishing host frame.
+// Cancelling now must delete that frame and clear the stored landing pointer.
+static void cancel_own_landing(X86 *c) {
+    uint32_t reg = c->r[R_ESP] - 64;
+    prepare_landing(c, reg);
+    jmp_buf *checkpoint = recomp_seh_frame_enter(c);
+    if (!setjmp(*checkpoint)) {
+        recomp_seh_unwind(c, reg, 0, 0, 0);
+        recomp_seh_intercept(c, landing_fn);
+        ++reached_after_cancel;
+    }
+    CHECK(recomp_seh_test_has_landing());
+    CHECK(recomp_seh_test_frame_count(c) == 1);
+    guest_call_guarded_cancel(c, owner_cookie, 33);
+    ++reached_after_cancel;
+}
+
+// A guarded callback invoked from an older landing must keep the older one
+// alive so its normal completion can still release its own host checkpoint.
+static void preserve_outer_landing(X86 *c) {
+    X86 before = *c;
+    uint32_t previous_head = rd32(c->fs_base);
+    uint32_t reg = c->r[R_ESP] - 64;
+    prepare_landing(c, reg);
+    jmp_buf *checkpoint = recomp_seh_frame_enter(c);
+    if (!setjmp(*checkpoint)) {
+        recomp_seh_unwind(c, reg, 0, 0, 0);
+        recomp_seh_intercept(c, landing_fn);
+        ++reached_after_cancel;
+    }
+    CHECK(recomp_seh_test_has_landing());
+    auto result = guest_call_guarded(c, simple_cancel_fn, nullptr, 0, &owner_cookie);
+    CHECK(result.status == GuestCallGuardedStatus::Cancelled && result.eax == 22);
+    CHECK(recomp_seh_test_has_landing() && recomp_seh_test_frame_count(c) == 1);
+    recomp_seh_land(c);
+    wr32(before.fs_base, previous_head);
+    *c = before;
+    CHECK(!recomp_seh_test_has_landing() && recomp_seh_test_frame_count(c) == 0);
+}
+
+static void invalid_entries(X86 &c) {
+    X86 before = c;
+    uint32_t args[2] = {17, 29};
+    uint32_t marker_at = c.r[R_ESP] - 4;
+    wr32(marker_at, RESULT);
+    uint64_t cookie = 123;
+    CHECK(guest_call_guarded(nullptr, normal_fn, args, 2, &cookie).status ==
+              GuestCallGuardedStatus::InvalidCall &&
+          cookie == 0);
+    CHECK(guest_call_guarded(&c, 0, args, 2).status == GuestCallGuardedStatus::InvalidCall);
+    CHECK(guest_call_guarded(&c, normal_fn, args, -1).status ==
+          GuestCallGuardedStatus::InvalidCall);
+    CHECK(guest_call_guarded(&c, normal_fn, nullptr, 1).status ==
+          GuestCallGuardedStatus::InvalidCall);
+    CHECK(guest_call_guarded(&c, normal_fn, args, INT_MAX).status ==
+          GuestCallGuardedStatus::InvalidCall);
+    check_cpu(c, before);
+    c.fs_base = GUEST_SIZE - 2;
+    CHECK(guest_call_guarded(&c, normal_fn, args, 2).status == GuestCallGuardedStatus::InvalidCall);
+    c = before;
+    c.r[R_ESP] = 3;
+    CHECK(guest_call_guarded(&c, normal_fn, args, 2).status == GuestCallGuardedStatus::InvalidCall);
+    c = before;
+    CHECK(rd32(marker_at) == RESULT && dispatched == 0);
+}
+
+int main() {
+    CHECK(recomp_profile_enabled); // CTest supplies RECOMP_PROFILE=1
+    mem_init();
+    imports_init();
+    normal_fn = imports_alloc_trampoline("guard-test.dll", "normal", normal, 2);
+    cancel_fn = imports_alloc_trampoline("guard-test.dll", "cancel", cancel, 0);
+    nested_fn = imports_alloc_trampoline("guard-test.dll", "inner-cancel", inner_cancel, 0);
+    ordinary_fn = imports_alloc_trampoline("guard-test.dll", "ordinary", inner_ordinary, 0);
+    foreign_fn = imports_alloc_trampoline("guard-test.dll", "foreign", inner_foreign, 0);
+    uint32_t outer_fn = imports_alloc_trampoline("guard-test.dll", "nested", nested, 0);
+    landing_fn = imports_alloc_trampoline("guard-test.dll", "landing", landing_body, 0);
+    simple_cancel_fn =
+        imports_alloc_trampoline("guard-test.dll", "simple-cancel", simple_cancel, 0);
+    uint32_t landing_cancel_fn =
+        imports_alloc_trampoline("guard-test.dll", "cancel-landing", cancel_own_landing, 0);
+    X86 c;
+    loader_init_context(&c);
+    owner_cpu = &c;
+    foreign_cpu = c;
+    foreign_cpu.fs_base += 0x800;
+    foreign_cpu.r[R_ESP] -= 0x10000;
+    wr32(foreign_cpu.fs_base, 0xffffffffu);
+    wr32(foreign_cpu.fs_base + 4, STACK_TOP - 0x10000);
+    wr32(foreign_cpu.fs_base + 8, STACK_LIMIT);
+    CHECK(guest_call_guarded_cookie(&c) == 0);
+    CHECK(!guest_call_guarded_cancel(&c, 1, 0));
+    invalid_entries(c);
+    uint32_t args[2] = {17, 29};
+    X86 before = c;
+    auto result = guest_call_guarded(&c, normal_fn, args, 2, &owner_cookie);
+    CHECK(result.status == GuestCallGuardedStatus::Returned && result.eax == RESULT);
+    CHECK(c.r[R_ECX] == 0x2468ace0 && c.r[R_ESP] == before.r[R_ESP] && c.eip == before.eip);
+    CHECK(guest_call_guarded_cookie(&c) == 0);
+    stale_cookie = owner_cookie;
+    CHECK(!guest_call_guarded_cancel(&c, stale_cookie, 0));
+    uint32_t sentinel_fn =
+        imports_alloc_trampoline("guard-test.dll", "sentinel", sentinel_return, 0);
+    result = guest_call_guarded(&c, sentinel_fn, nullptr, 0, &owner_cookie);
+    CHECK(result.status == GuestCallGuardedStatus::Returned && result.eax == RESULT);
+    stale_cookie = owner_cookie;
+    // An inherited native exception frame and atomic/profile scopes survive.
+    uint32_t outer_reg = c.r[R_ESP] - 128;
+    wr32(outer_reg, 0xffffffffu);
+    wr32(outer_reg + 4, normal_fn);
+    wr32(outer_reg + 8, c.r[R_EBP]);
+    wr32(c.fs_base, outer_reg);
+    c.r[R_ESP] = outer_reg - 32; // inner registrations are below the inherited frame
+    recomp_seh_frame_enter(&c);
+    sched_atomic_enter(c.r[R_ESP]);
+    parent_depth = sched_atomic_depth();
+    CHECK(parent_depth == 1);
+    recomp_profile_push(17);
+    uint32_t profile_depth = recomp_profile_depth(), blocks = heap_stats().used_blocks;
+    before = c;
+    for (int i = 0; i < 32; ++i) {
+        unwound_to = 0;
+        parent_esp = c.r[R_ESP];
+        result = guest_call_guarded(&c, cancel_fn, nullptr, 0, &owner_cookie);
+        CHECK(result.status == GuestCallGuardedStatus::Cancelled && result.eax == RESULT);
+        before.r[R_EAX] = RESULT;
+        check_cpu(c, before);
+        CHECK(unwound_to == parent_esp);
+        CHECK(rd32(c.fs_base) == outer_reg && recomp_seh_pending_target() == 0);
+        CHECK(recomp_seh_test_frame_count(&c) == 1 && recomp_callback_depth() == 0);
+        CHECK(sched_atomic_depth() == parent_depth && recomp_profile_depth() == profile_depth);
+        CHECK(heap_stats().used_blocks == blocks && rd32(MEMORY_MARKER) == RESULT);
+        stale_cookie = owner_cookie;
+    }
+    // Unlink the inherited test frame before the nested callback checks.
+    wr32(c.fs_base, 0xffffffffu);
+    recomp_seh_frame_leave(&c);
+    CHECK(recomp_seh_test_frame_count(&c) == 0);
+    result = guest_call_guarded(&c, outer_fn, nullptr, 0, &owner_cookie);
+    CHECK(result.status == GuestCallGuardedStatus::Cancelled && result.eax == 66);
+    CHECK(reached_after_cancel == 0 && recomp_callback_depth() == 0);
+    CHECK(sched_atomic_depth() == parent_depth && recomp_profile_depth() == profile_depth);
+    sched_atomic_leave();
+    recomp_profile_pop();
+    before = c;
+    result = guest_call_guarded(&c, landing_cancel_fn, nullptr, 0, &owner_cookie);
+    CHECK(result.status == GuestCallGuardedStatus::Cancelled && result.eax == 33);
+    before.r[R_EAX] = 33;
+    check_cpu(c, before);
+    CHECK(!recomp_seh_test_has_landing() && recomp_seh_test_frame_count(&c) == 0);
+    CHECK(rd32(c.fs_base) == 0xffffffffu && recomp_callback_depth() == 0);
+    preserve_outer_landing(&c);
+    CHECK(reached_after_cancel == 0 && recomp_callback_depth() == 0);
+    recomp_seh_reset(&c);
+    mem_shutdown();
+    printf("%d guarded callback checks, %d failures\n", checks, failures);
+    return failures ? 1 : 0;
+}
