+static void test_native_websocket() {
+    const char *base = std::getenv("NATIVE_WEBSOCKET_TEST_URL");
+    CHECK(base && *base);
+    if (!base || !*base)
+        return;
+    const std::string url(base);
+    const char *protocol = "recomp-directplay-v1";
+    const auto open = [&](const char *path) {
+        return os_websocket_open((url + path).c_str(), protocol);
+    };
+    CHECK(!os_websocket_open(nullptr, protocol));
+    CHECK(!os_websocket_open("http://127.0.0.1/", protocol));
+    CHECK(!os_websocket_open((url + "/echo").c_str(), nullptr));
+    CHECK(!os_websocket_open((url + "/echo").c_str(), "bad protocol"));
+    CHECK(!os_websocket_open("ws://user:password@127.0.0.1/echo", protocol));
+    CHECK(!os_websocket_open("ws://127.0.0.1:0/echo", protocol));
+    CHECK(!os_websocket_open("ws://127.0.0.1/echo#fragment", protocol));
+    uint32_t length = 99;
+    CHECK(os_websocket_receive(nullptr, nullptr, 0, &length) == -1 && length == 0);
+    CHECK(os_websocket_receive(nullptr, nullptr, 0, nullptr) == -1);
+    os_websocket_set_notify(nullptr, websocket_notify, 71);
+    os_websocket_close(nullptr);
+    OsWebSocket *s = open("/echo");
+    CHECK(s);
+    if (!s)
+        return;
+    websocket_notifications = 0;
+    os_websocket_set_notify(s, websocket_notify, 71);
+    CHECK(websocket_opened(s));
+    std::vector<uint8_t> payload(66560), output(66560);
+    for (size_t i = 0; i < payload.size(); ++i)
+        payload[i] = uint8_t(i * 17 + 19);
+    CHECK(os_websocket_send(s, nullptr, 1) == -1);
+    CHECK(os_websocket_send(s, payload.data(), 0) == -1);
+    CHECK(os_websocket_send(s, payload.data(), 66561) == -1);
+    for (uint32_t size : {1u, 173u, 16384u, 66560u}) {
+        CHECK(os_websocket_send(s, payload.data(), size) == 0);
+        CHECK(websocket_read(s, nullptr, 0, length) == -2 && length == size);
+        CHECK(os_websocket_receive(s, output.data(), size - 1, &length) == -2 && length == size);
+        CHECK(os_websocket_receive(s, output.data(), output.size(), &length) == 1 &&
+              length == size);
+        CHECK(!memcmp(output.data(), payload.data(), size));
+        CHECK(os_websocket_receive(s, output.data(), output.size(), &length) == 0 && length == 0);
+    }
+    CHECK(websocket_notifications.load() > 0);
+    os_websocket_set_notify(s, nullptr, 0);
+    os_websocket_close(s);
+    for (const char *path : {"/text", "/empty", "/oversize", "/fragment-oversize", "/count-flood",
+                             "/byte-flood", "/close", "/no-protocol"}) {
+        s = open(path);
+        CHECK(s);
+        CHECK(websocket_terminal(s));
+        length = 99;
+        CHECK(os_websocket_receive(s, output.data(), output.size(), &length) == -1 && length == 0);
+        CHECK(os_websocket_send(s, payload.data(), 1) == -1);
+        os_websocket_close(s);
+    }
+    s = open("/fragment-ok");
+    CHECK(websocket_opened(s));
+    CHECK(websocket_read(s, output.data(), output.size(), length) == 1 && length == 6);
+    CHECK(!memcmp(output.data(), "abcdef", 6));
+    os_websocket_close(s);
+
+    // A stopped receiver creates real transport pressure. Outstanding native
+    // sends must hit the byte/entry cap; this does not measure kernel memory.
+    s = open("/blackhole");
+    CHECK(websocket_opened(s));
+    unsigned admitted = 0;
+    while (admitted < 256 && os_websocket_send(s, payload.data(), payload.size()) == 0)
+        admitted++;
+    CHECK(admitted > 0 && admitted < 256);
+    os_websocket_close(s);
+
+    // Delayed callbacks after explicit Close must not call the old notifier or
+    // accidentally find a newly opened connection. Keep the test cookie alive.
+    for (unsigned cycle = 0; cycle < 12; ++cycle) {
+        s = open("/delayed");
+        CHECK(websocket_opened(s));
+        os_websocket_set_notify(s, websocket_notify, 71);
+        CHECK(os_websocket_send(s, payload.data(), 173) == 0);
+        os_websocket_close(s);
+        const unsigned closed_count = websocket_notifications.load();
+        OsWebSocket *replacement = open("/echo");
+        CHECK(websocket_opened(replacement));
+        CHECK(os_websocket_send(replacement, payload.data(), 1) == 0);
+        CHECK(websocket_read(replacement, output.data(), output.size(), length) == 1 &&
+              length == 1);
+        os_sleep_us(30000);
+        CHECK(websocket_notifications.load() == closed_count);
+        os_websocket_close(replacement);
+    }
+    const char *tls = std::getenv("NATIVE_WEBSOCKET_TEST_TLS_URL");
+    CHECK(tls && *tls);
+    if (tls && *tls) {
+        // A self-signed local test server must fail platform certificate checks.
+        // No trust override or host credential store is changed for this test.
+        s = os_websocket_open(tls, protocol);
+        CHECK(s);
+        CHECK(websocket_terminal(s));
+        CHECK(os_websocket_state(s) == OS_WS_FAILED);
+        os_websocket_close(s);
+    }
+}
