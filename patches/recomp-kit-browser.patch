+static void test_heap_inspection() {
+    section("bounded heap inspection");
+    uint32_t owned[137]{};
+    for (size_t i = 0; i < 137; ++i) {
+        owned[i] = heap_alloc(static_cast<uint32_t>(i * 7));
+        check(owned[i] != 0, "allocated inspection fixture %zu", i);
+        if (i)
+            memset(g_mem + owned[i], 0x6a, i * 7);
+    }
+    for (size_t i = 3; i < 137; i += 3) {
+        heap_free(owned[i]);
+        owned[i] = 0;
+    }
+    owned[0] = heap_realloc(owned[0], 4097);
+    check(owned[0] != 0, "inspection fixture includes a relocated/rounded block");
+    const auto baseline = heap_stats();
+    const auto inspect = [&](size_t capacity) {
+        std::map<uint32_t, HeapAllocation> found;
+        uint32_t cursor = 0;
+        bool complete = false;
+        for (unsigned pages = 0; pages < 4096 && !complete; ++pages) {
+            HeapAllocation rows[64]{};
+            const auto page = heap_read_allocations(cursor, rows, capacity);
+            check(page.valid && page.count <= capacity && page.scanned <= 256,
+                  "inspection page obeys capacity and work limits");
+            check(page.complete || page.cursor > cursor, "an unfinished page advances");
+            for (uint32_t i = 0; i < page.count; ++i) {
+                check(rows[i].address > cursor && !found.count(rows[i].address),
+                      "inspection returns each live address exactly once in order");
+                check(heap_size(rows[i].address) == rows[i].requested_bytes,
+                      "inspection requested size matches the live allocator");
+                cursor = rows[i].address;
+                found.emplace(rows[i].address, rows[i]);
+            }
+            cursor = page.cursor;
+            complete = page.complete;
+        }
+        check(complete, "inspection completes within the fixture bound");
+        return found;
+    };
+    const auto single = inspect(1), batched = inspect(64);
+    uint64_t rounded = 0, requested = 0;
+    check(single.size() == batched.size() && batched.size() == baseline.used_blocks,
+          "single-row and batched walks cover the full live heap");
+    for (const auto &entry : batched) {
+        const auto other = single.find(entry.first);
+        check(other != single.end() && other->second.rounded_bytes == entry.second.rounded_bytes &&
+                  other->second.requested_bytes == entry.second.requested_bytes,
+              "page boundaries do not change allocation metadata");
+        rounded += entry.second.rounded_bytes;
+        requested += entry.second.requested_bytes;
+    }
