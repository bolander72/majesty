+    return s && (os_websocket_state(s) == OS_WS_FAILED || os_websocket_state(s) == OS_WS_CLOSED);
+}
+static int websocket_read(OsWebSocket *s, void *out, uint32_t capacity, uint32_t &length) {
+    const uint64_t deadline = os_monotonic_ns() + 5000000000ull;
+    int result;
+    do {
+        result = os_websocket_receive(s, out, capacity, &length);
+        if (result || os_monotonic_ns() >= deadline)
+            return result;
+        os_sleep_us(1000);
+    } while (true);
