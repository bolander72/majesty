+    CHECK_EQ(call_method(dp, 4), 0u);
+    // Receive used the descriptor's first two words as from/to outputs.
+    // Rebuild the input descriptor before opening a fresh session.
+    memset(gm_ptr(desc), 0, 80);
+    wr32(desc, 80);
+    wr32(desc + 40, 4);
+    CHECK_EQ(call_method(dp, 24, {desc, 2}), 0u);
+    const uint64_t second = recomp_network_session_epoch();
+    CHECK(second > first);
+    CHECK(!recomp_network_reject_session(first));
+    CHECK_EQ(recomp_network_session_epoch(), second);
+    // A natural LostEvent can arrive after gameplay and pending completion.
+    // Explicit rejection must still close/free the transport and discard those
+    // queues while preserving the one existing loss notification.
+    CHECK_EQ(call_method(dp, 6, {out, 0, 0, 0, 0, 0}), 0u);
+    dp_test_event(106, payload);
+    CHECK_EQ(call_method(dp, 49, {2, 0, 0x201, desc, 4, 0, 0, 0x1234, 0}), 0x8000000au);
+    // This fake normally ACKs synchronously. Withhold that ACK so rejection
+    // really clears an outstanding completion rather than a queued one.
+    CHECK(!dp_test_in.empty());
+    CHECK_EQ(dp_test_word(dp_test_in.back(), 8), 108u);
+    dp_test_in.pop_back();
+    dp_test_event(107, {});
+    CHECK_EQ(call_method(dp, 17, {0, size}), 0u);
+    CHECK_EQ(rd32(size), 2u);
+    CHECK_EQ(recomp_network_session_epoch(), 0u);
+    const unsigned before_lost_reject = dp_test_closed;
+    CHECK(recomp_network_reject_session(second));
+    CHECK_EQ(dp_test_closed, before_lost_reject + 1);
+    CHECK_EQ(call_method(dp, 17, {0, size}), 0u);
+    CHECK_EQ(rd32(size), 1u);
+    wr32(size, 512);
+    CHECK_EQ(call_method(dp, 25, {desc, desc + 4, 0, out, size}), 0u);
+    CHECK_EQ(rd32(out), 0x31u);
+    CHECK(recomp_network_reject_session(second));
+    CHECK_EQ(dp_test_closed, before_lost_reject + 1);
+    CHECK_EQ(call_method(dp, 25, {desc, desc + 4, 0, out, size}), 0x88770136u);
+    CHECK_EQ(call_method(dp, 4), 0u);
+    memset(gm_ptr(desc), 0, 80);
+    wr32(desc, 80);
+    wr32(desc + 40, 4);
+    CHECK_EQ(call_method(dp, 24, {desc, 2}), 0u);
+    const uint64_t third = recomp_network_session_epoch();
+    CHECK(third > second);
+    // If Receive already consumed the natural loss, rejecting it must not
+    // manufacture another notification or preserve the old socket.
+    dp_test_event(107, {});
+    wr32(size, 512);
+    CHECK_EQ(call_method(dp, 25, {desc, desc + 4, 0, out, size}), 0u);
+    CHECK_EQ(rd32(out), 0x31u);
+    const unsigned before_consumed_reject = dp_test_closed;
+    CHECK(recomp_network_reject_session(third));
+    CHECK_EQ(dp_test_closed, before_consumed_reject + 1);
+    CHECK(recomp_network_reject_session(third));
+    CHECK_EQ(dp_test_closed, before_consumed_reject + 1);
+    CHECK_EQ(call_method(dp, 25, {desc, desc + 4, 0, out, size}), 0x88770136u);
+    CHECK_EQ(call_method(dp, 4), 0u);
+    memset(gm_ptr(desc), 0, 80);
+    wr32(desc, 80);
+    wr32(desc + 40, 4);
+    CHECK_EQ(call_method(dp, 24, {desc, 2}), 0u);
+    const uint64_t fourth = recomp_network_session_epoch();
+    CHECK(fourth > third);
+    CHECK_EQ(call_method(dp, 6, {out, 0, 0, 0, 0, 0}), 0u);
+    sched_set_guest_thread(true);
+    recomp_network_session_v1 joined{};
+    CHECK(recomp_network_session_info(fourth, &joined));
+    CHECK_EQ(joined.host, 1u);
+    CHECK_EQ(joined.local_player, 2u);
+    CHECK_EQ(joined.player_count, 1u);
+    sched_set_guest_thread(false);
+    CHECK(!recomp_network_reject_session(third));
+    CHECK_EQ(recomp_network_session_epoch(), fourth);
+    // An ambiguous provider selection is not permission to reject another room.
+    uint32_t other = com_view(com_new(K_DIRECTPLAY), IF_DIRECTPLAY4A);
+    CHECK_EQ(call_method(other, 38, {token, 0}), 0u);
+    CHECK_EQ(call_method(other, 24, {desc, 2}), 0u);
+    CHECK_EQ(recomp_network_session_epoch(), 0u);
+    sched_set_guest_thread(true);
+    memset(&joined, 0xa5, sizeof joined);
+    CHECK(!recomp_network_session_info(fourth, &joined));
+    CHECK(!joined.host && !joined.local_player && !joined.player_count && !joined.players[0]);
+    sched_set_guest_thread(false);
+    CHECK(recomp_network_reject_session(fourth));
+    CHECK(recomp_network_session_epoch() > fourth);
+    CHECK_EQ(call_method(dp, 4), 0u);
+    CHECK_EQ(call_method(other, 4), 0u);
+    CHECK_EQ(call_method(dp, 2), 0u);
+    CHECK_EQ(call_method(other, 2), 0u);
+    CHECK_EQ(recomp_network_session_epoch(), 0u);
+    CHECK(directplay_set_transport(nullptr));
+    os_unsetenv("RECOMP_NETWORK_URL");
+    os_unsetenv("RECOMP_NETWORK_MANIFEST");
+}
+
+static uint32_t dp_barrier_reply_status;
+static uint32_t dp_barrier_forced_stage;
+static bool dp_barrier_bad_enable, dp_barrier_early_prepare;
+static bool dp_barrier_cancel_begin;
+static DpBytes dp_barrier_event_body(uint32_t serial, uint32_t stage, const std::string &descriptor,
+                                     std::initializer_list<uint32_t> players = {2, 3}) {
+    DpBytes body;
+    dp_test_put(body, serial);
+    dp_test_put(body, stage);
+    dp_test_put(body, uint32_t(descriptor.size()));
+    body.insert(body.end(), descriptor.begin(), descriptor.end());
+    dp_test_put(body, uint32_t(players.size()));
+    for (uint32_t id : players)
+        dp_test_put(body, id);
+    return body;
+}
+static int dp_barrier_test_send(OsWebSocket *socket, const void *bytes, uint32_t length) {
+    const auto *p = static_cast<const uint8_t *>(bytes);
+    DpBytes wire(p, p + length);
+    const uint32_t op = dp_test_word(wire, 8), request = dp_test_word(wire, 12);
+    if (op == 4) {
+        // Guest Open shares the same well-formed session reply as Create.
+        dp_test_sent = wire;
+        DpBytes reply;
+        for (uint32_t value : {0x31525044u, 1u, op | 0x80000000u, request, 0u})
+            dp_test_put(reply, value);
+        reply.insert(reply.end(), p + 20, p + length);
+        dp_test_put(reply, 0);
+        dp_test_in.push_back(reply);
+        return 0;
+    }
+    if (op != 12)
+        return dp_test_send(socket, bytes, length);
+    dp_test_sent = wire;
+    const uint32_t action = dp_test_word(wire, 20);
+    if (action && (!dp_barrier_reply_status || dp_barrier_forced_stage)) {
+        const uint32_t serial = dp_test_word(wire, 24), size = dp_test_word(wire, 28);
+        CHECK_EQ(size, wire.size() - 32);
+        const std::string descriptor(wire.begin() + 32, wire.end());
+        if (dp_barrier_forced_stage)
+            dp_test_event(109, dp_barrier_event_body(serial, dp_barrier_forced_stage, descriptor));
+        else if (action == 1 || action == 3 || action == 4)
+            dp_test_event(109, dp_barrier_event_body(serial,
+                                                     action == 1   ? 1
+                                                     : action == 3 ? 3
+                                                                   : 4,
+                                                     descriptor));
+        if (action == 1 && dp_barrier_cancel_begin)
+            dp_test_event(109, dp_barrier_event_body(serial, 4, descriptor));
+    }
+    DpBytes reply;
+    for (uint32_t value : {0x31525044u, 1u, op | 0x80000000u, request, dp_barrier_reply_status})
+        dp_test_put(reply, value);
+    if (!action && !dp_barrier_reply_status)
+        dp_test_put(reply, dp_barrier_bad_enable ? 2 : 1);
+    dp_test_in.push_back(reply);
+    if (!action && dp_barrier_early_prepare && !dp_barrier_reply_status)
+        dp_test_event(109, dp_barrier_event_body(1, 1, "early-checkpoint"));
+    return 0;
+}
+static void test_directplay_checkpoint_barrier() {
+    const bool held = sched_holds_baton();
+    if (!held)
+        sched_set_guest_thread(true);
+    directplay_reset();
+    dp_test_in.clear();
+    dp_test_closed = 0;
+    dp_barrier_reply_status = 0;
+    dp_barrier_forced_stage = 0;
+    dp_barrier_bad_enable = dp_barrier_early_prepare = false;
+    dp_barrier_cancel_begin = false;
+    const DirectPlayTransport fake = {dp_test_open,    dp_test_state,  dp_barrier_test_send,
+                                      dp_test_receive, dp_test_notify, dp_test_close};
+    CHECK(directplay_set_transport(&fake));
+    os_setenv("RECOMP_NETWORK_URL", "ws://localhost:8002/rooms");
+    os_setenv("RECOMP_NETWORK_MANIFEST", "contract-fixture");
+    const uint32_t token = sc(0x1f00), desc = sc(0x2000), size = sc(0x2100), out = sc(0x2200);
+    const uint8_t guid[] = {0xe0, 0x5e, 0xe9, 0x36, 0x77, 0x85, 0xcf, 0x11,
+                            0x96, 0x0c, 0,    0x80, 0xc7, 0x53, 0x4e, 0x82};
+    memcpy(gm_ptr(token), guid, 16);
+    uint32_t dp = com_view(com_new(K_DIRECTPLAY), IF_DIRECTPLAY4A);
+    CHECK_EQ(call_method(dp, 38, {token, 0}), 0u);
+    auto open = [&](uint32_t flags = 2) {
