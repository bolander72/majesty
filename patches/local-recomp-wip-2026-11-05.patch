+    // CreateNewInventoryItem (004232a2..004232bb). No fabricated GPL value.
+    guest_call(&extra, 0x006292f0u, scratch, scratch + 64);
+    guest_call(&extra, 0x0064cf1fu, scratch, 0x0069c678u);
+  }
+};
