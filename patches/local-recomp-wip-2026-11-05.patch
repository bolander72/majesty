+             {{0x006d7670, 0},
+              {0x006d8568, 0},
+              {0x0071c68c, 0},
+              {state, 3},
+              {state, 2},
+              {state + 4, 3},
+              {manager + 0x27c, owner + 1},
+              {manager + 0x8c, owner + 1},
+              {manager + 0x218, 0},
+              {manager + 0x218, 2},
+              {manager + 0x44, 0},
+              {manager + 0x44, UINT32_MAX},
+              {secondary + 8, 0},
+              {secondary + 8, UINT32_MAX},
+              {secondary_deque + 0x2c, 4096}}}) {
+      const uint32_t old = rd32(guard[0]);
+      wr32(guard[0], guard[1]);
+      CHECK(!majesty::enqueue_coop_resume(c, owner));
+      wr32(guard[0], old);
+      resume_refused(nullptr, owner); // Verify no allocation/queue side effect.
+    }
+    X86 bad_resume = *c;
+    bad_resume.r[R_ESP] = STACK_LIMIT + 65535;
+    resume_refused(&bad_resume, owner);
+    bad_resume.r[R_ESP] = STACK_TOP + 4;
+    resume_refused(&bad_resume, owner);
+    sched_set_guest_thread(false);
+    CHECK(!majesty::enqueue_coop_resume(c, owner));
+    sched_set_guest_thread(true);
+    wr32(0x006c066c, 31 + cycle);
+    wr32(0x006d8548, 700 + cycle);
+    const X86 resume_cpu = *c;
+    const auto resume_earliest = invoke(c, 0x005ecf00, header + 0x14);
+    CHECK(majesty::enqueue_coop_resume(c, owner));
+    const auto resume_latest = invoke(c, 0x005ecf00, header + 0x14);
+    CHECK(!std::memcmp(c, &resume_cpu, sizeof resume_cpu));
+    CHECK(!rd32(deque + 0x2c) && !rd32(queue + 0xc));
+    CHECK(rd32(secondary_deque + 0x2c) == 1 && rd32(secondary + 0xc) == 1);
+    CHECK(rd32(state) == 7 && !rd32(state + 4) &&
+          rd32(manager + 0x27c) == owner);
+    wr32(pair, 0);
+    CHECK(invoke(c, 0x005d9c80, pair + 4) == pair + 4);
+    CHECK((invoke(c, 0x005dc3b0, secondary, dequeue_args, 1) & 0xff) == 1);
+    tracked_packet = rd32(pair);
+    tracked_reference = rd32(pair + 4);
+    CHECK(tracked_packet && gm_valid(tracked_packet, 0x28) &&
+          tracked_reference && gm_valid(tracked_reference, 4));
+    CHECK(rd32(tracked_packet) == 0x00682e28 && rd32(tracked_packet + 8) == 1 &&
+          rd32(tracked_packet + 12) == owner && !rd32(tracked_packet + 0x1c) &&
+          rd32(tracked_packet + 0x20) == 31 + cycle &&
+          rd32(tracked_packet + 0x24) == 700 + cycle);
+    CHECK(uint32_t(rd32(tracked_packet + 4) - resume_earliest) <=
+          uint32_t(resume_latest - resume_earliest));
+    CHECK(rd32(tracked_reference) == 1);
+    const auto resume_packets = packet_frees, resume_refs = reference_frees;
+    const uint32_t resume_args[] = {tracked_packet, tracked_reference};
+    wr32(pair, 0);
+    wr32(pair + 4, 0);
+    invoke(c, 0x005a5610, manager, resume_args, 2);
+    CHECK(!tracked_packet && !tracked_reference &&
+          packet_frees == resume_packets + 1 &&
+          reference_frees == resume_refs + 1);
+    CHECK(!rd32(secondary_deque + 0x2c) && !rd32(secondary + 0xc));
+    CHECK(!majesty::coop_pause_boundary(owner, boundary));
+    CHECK(rd32(state) == 7 && rd32(state + 4) == 3 &&
+          rd32(manager + 0x27c) == UINT32_MAX && rd32(state + 0x28) == frame &&
+          rd32(0x0071c6a8) == clock);
+    // Both original pause and the phase setter return early on current7.
+    // The coordinator therefore skips the next original gameplay tick and
+    // queues7 at its phase3 entry, before any world/frame/clock advancement.
+    const uint32_t cancel_resume[] = {7};
+    invoke(c, 0x00416050, state, cancel_resume, 1);
+    CHECK(rd32(state) == 7 && rd32(state + 4) == 3 &&
+          rd32(state + 0x28) == frame && rd32(0x0071c6a8) == clock);
+    wr32(state, 3);
+    wr32(state + 4, 0); // Emulate only the outer deferred copy.
+    invoke(c, 0x00416050, state, cancel_resume, 1);
+    CHECK(rd32(state) == 3 && rd32(state + 4) == 7 &&
+          rd32(state + 0x28) == frame && rd32(0x0071c6a8) == clock);
+    CHECK(heap_check().empty());
+  }
+  // Original tick preparation replaces the secondary control batch even
+  // while paused. A resume queued before it is lost; input must enqueue
+  // after this preparation and before005a4600's eventual network send.
+  wr32(state, 7); wr32(state + 4, 0);
+  wr32(manager + 0x218, 1); wr32(manager + 0x8c, 7);
+  wr32(manager + 0x27c, 7); wr32(manager + 0xc4, 1);
+  wr32(manager + 0x21c, 0);
+  const uint32_t prepare_args[] = {0};
+  invoke(c, 0x005a4250, manager, prepare_args, 1);
+  CHECK(majesty::enqueue_coop_resume(c, 7));
+  CHECK(rd32(rd32(manager + 0x44) + 0xc) == 1);
+  invoke(c, 0x005a4250, manager, prepare_args, 1);
+  CHECK(rd32(rd32(manager + 0x44) + 0xc) == 0);
+  CHECK(majesty::enqueue_coop_resume(c, 7));
+  CHECK(rd32(rd32(manager + 0x44) + 0xc) == 1);
+  // Execute the original transmitter in readback mode. At a rebuilt frame0
+  // it returns without sending the real queued control record while the
+  // replay's terminal frame is0 or greater. This is an original send gate,
+  // not an inferred result from a helper or a stubbed network sender.
+  for (uint32_t terminal : {0u, 1u, 199u}) {
+    wr32(manager + 0x218, 2); wr32(manager + 0x21c, terminal);
+    const auto before_send = heap_stats();
+    invoke(c, 0x005a4600, manager);
+    CHECK(rd32(rd32(manager + 0x44) + 0xc) == 1);
+    CHECK(rd32(state) == 7 && !rd32(state + 4) && rd32(manager + 0x27c) == 7);
+    const auto after_send = heap_stats();
+    CHECK(after_send.used_bytes == before_send.used_bytes &&
+          after_send.used_blocks == before_send.used_blocks &&
+          after_send.total_allocs == before_send.total_allocs &&
+          after_send.total_frees == before_send.total_frees);
+  }
+  wr32(manager + 0x218, 1); wr32(manager + 0x21c, 0);
+  // Execute the surviving packet through the original dequeue/dispatcher,
+  // rather than inferring success from the queue's entry count alone.
+  const uint32_t prepared_queue = rd32(manager + 0x44),
+                 held_frame = rd32(state + 0x28),
+                 held_clock = rd32(0x0071c6a8);
+  wr32(pair, 0);
+  CHECK(invoke(c, 0x005d9c80, pair + 4) == pair + 4);
+  const uint32_t prepared_dequeue[] = {pair};
+  CHECK((invoke(c, 0x005dc3b0, prepared_queue, prepared_dequeue, 1) & 0xff) == 1);
+  tracked_packet = rd32(pair); tracked_reference = rd32(pair + 4);
+  CHECK(tracked_packet && gm_valid(tracked_packet, 0x28) &&
+        tracked_reference && gm_valid(tracked_reference, 4));
+  CHECK(rd32(tracked_packet + 8) == 1 && rd32(tracked_packet + 12) == 7);
+  const auto prepared_packets = packet_frees, prepared_refs = reference_frees;
+  const uint32_t prepared_dispatch[] = {tracked_packet, tracked_reference};
+  wr32(pair, 0); wr32(pair + 4, 0);
+  invoke(c, 0x005a5610, manager, prepared_dispatch, 2);
+  CHECK(!tracked_packet && !tracked_reference &&
+        packet_frees == prepared_packets + 1 && reference_frees == prepared_refs + 1);
+  CHECK(!rd32(prepared_queue + 0xc));
+  CHECK(rd32(state) == 7 && rd32(state + 4) == 3 &&
+        rd32(manager + 0x27c) == UINT32_MAX &&
+        rd32(state + 0x28) == held_frame && rd32(0x0071c6a8) == held_clock);
+  // Dispose only the actual original shared batches made by preparation.
+  invoke(c, 0x005d9cd0, manager + 0x3c);
+  invoke(c, 0x005d9cd0, manager + 0x44);
+  wr32(manager + 0x3c, 0); wr32(manager + 0x40, 0);
+  wr32(manager + 0x44, 0); wr32(manager + 0x48, 0);
+  wr32(0x0071c68c, 0);
+  wr32(manager + 0x34, 0);
+  wr32(manager + 0x44, previous_secondary);
+  // The actual base queue destructor releases its map/blocks and metadata.
+  const uint32_t deleting[] = {1};
+  invoke(c, rd32(rd32(queue)), queue, deleting, 1);
+  invoke(c, rd32(rd32(secondary)), secondary, deleting, 1);
+  for (const auto object : {pair, header}) {
+    const uint32_t args[] = {object};
+    invoke(c, 0x00645bc0, 0, args, 1);
+  }
+  CHECK(heap_check().empty());
+}
+// Exercise original prepared transmit -> player ring -> packet dispatch. The
+// inline ring initialization follows004995db..00499612/00499687..004996c1;
+// no provider or world runs. Suppress recording through the original network
+// flag, so005a3c30 never opens a replay file.
+static void prepared_transmit(X86 *c, uint32_t state, uint32_t manager) {
+  const uint32_t previous_recording = rd32(0x006cd2a4),
+                 previous_single = rd32(manager + 0x5c),
+                 previous_network = rd32(manager + 0xc8),
+                 previous_primary_pause = rd32(manager + 0xc4),
+                 previous_primary_gate = rd32(manager + 0x78);
+  CHECK(!previous_single && !rd32(manager + 0x34) &&
+        !rd32(manager + 0x3c) && !rd32(manager + 0x44));
+  const uint32_t scratch = alloc(c, 64), header = alloc(c, 32);
+  std::memset(g_mem + header, 0, 32);
+  wr32(scratch + 32, 7);
+  const uint32_t insert[] = {scratch, scratch + 32};
+  invoke(c, 0x004a2d00, manager + 0x4c, insert, 2);
+  const uint32_t node = rd32(scratch);
+  CHECK(node && gm_valid(node, 0x14) && rd32(node + 0xc) == 7 &&
+        !rd32(node + 0x10));
+  if (failures) return;
+  wr32(0x006cd2a4, 1); wr32(manager + 0xc8, 0);
+  wr32(manager + 0x78, 0); wr32(0x0071c68c, header);
+  for (uint32_t offset : {0x34u, 0x3cu, 0x44u})
+    if (!rd32(manager + offset + 4)) invoke(c, 0x005d9c80, manager + offset + 4);
+  auto release_pair = [&](uint32_t pair) {
+    const uint32_t object = rd32(pair);
+    if ((invoke(c, 0x005d9cf0, pair + 4) & 0xffu) && object) {
+      const uint32_t deleting[] = {1};
+      invoke(c, rd32(rd32(object)), object, deleting, 1);
+    }
+    invoke(c, 0x005d9cd0, pair + 4);
+    wr32(pair, 0); wr32(pair + 4, 0);
+    if (pair != scratch) invoke(c, 0x005d9c80, pair + 4);
+  };
+  const auto baseline = heap_stats();
+  for (unsigned cycle = 0; cycle < 12 && !failures; ++cycle) {
+    const auto before_packets = packet_frees, before_references = reference_frees;
+    const uint32_t player_ring = alloc(c, 0x30), single_ring = alloc(c, 0x30);
+    CHECK(invoke(c, 0x0049fc00, player_ring) == player_ring);
+    CHECK(invoke(c, 0x0049fc00, single_ring) == single_ring);
+    wr32(node + 0x10, player_ring); wr32(manager + 0x5c, single_ring);
+    wr32(state, 7); wr32(state + 4, 0); wr32(state + 0x28, 0);
+    wr32(0x0071c6a8, 60000 + 50 * cycle);
+    wr32(manager + 0x218, cycle % 2 ? 3 : 1);
+    // Original pause leaves+c4=1, suppressing ordinary frame batches. Also
+    // exercise its normal0 branch; the secondary resume must survive both.
+    const uint32_t primary_paused = cycle % 3 ? 1 : 0;
+    wr32(manager + 0xc4, primary_paused);
+    wr32(manager + 0x8c, 7); wr32(manager + 0x27c, 7);
+    wr8(manager + 0x280, 0);
+    const uint32_t prepare[] = {0};
+    invoke(c, 0x005a4250, manager, prepare, 1);
+    CHECK(majesty::enqueue_coop_resume(c, 7));
+    const uint32_t secondary = rd32(manager + 0x44),
+                   held_clock = rd32(0x0071c6a8);
+    CHECK(rd32(secondary + 0xc) == 1 && !rd32(secondary + 0x14));
+    invoke(c, 0x005a4600, manager);
+    CHECK(rd32(player_ring + 0x2c) == 2 - primary_paused &&
+          !rd32(single_ring + 0x2c));
+    CHECK(rd32(state) == 7 && !rd32(state + 4) && rd32(manager + 0x27c) == 7);
+    unsigned resumes = 0;
+    for (const uint32_t ring : {player_ring, single_ring}) {
+      while (rd32(ring + 0x2c)) {
+        wr32(scratch, 0); wr32(scratch + 4, 0);
+        const uint32_t pop[] = {scratch};
+        CHECK(invoke(c, 0x0049fc50, ring, pop, 1) == scratch);
+        const uint32_t batch = rd32(scratch);
+        CHECK(batch && gm_valid(batch, 0x1c) && rd32(batch) == 0x00682d04);
+        if (rd32(batch + 0xc)) {
+          CHECK(batch == secondary && rd32(batch + 0xc) == 1);
+          wr32(scratch + 8, 0); wr32(scratch + 12, 0);
+          CHECK(invoke(c, 0x005d9c80, scratch + 12) == scratch + 12);
+          const uint32_t take[] = {scratch + 8};
+          CHECK((invoke(c, 0x005dc3b0, batch, take, 1) & 0xff) == 1);
+          tracked_packet = rd32(scratch + 8); tracked_reference = rd32(scratch + 12);
+          CHECK(rd32(tracked_packet + 8) == 1 && rd32(tracked_packet + 12) == 7);
+          const uint32_t dispatch[] = {tracked_packet, tracked_reference};
+          wr32(scratch + 8, 0); wr32(scratch + 12, 0);
+          invoke(c, 0x005a5610, manager, dispatch, 2);
+          CHECK(!tracked_packet && !tracked_reference);
+          ++resumes;
+        }
+        release_pair(scratch);
+      }
+      const uint32_t free[] = {ring};
+      invoke(c, 0x00645bc0, 0, free, 1);
+    }
+    CHECK(resumes == 1 && rd32(state) == 7 && rd32(state + 4) == 3 &&
+          rd32(manager + 0x27c) == UINT32_MAX && !rd32(state + 0x28) &&
+          rd32(0x0071c6a8) == held_clock);
+    CHECK(packet_frees == before_packets + 1 &&
+          reference_frees == before_references + 1);
+    wr32(node + 0x10, 0); wr32(manager + 0x5c, 0);
+    for (const uint32_t pair : {manager + 0x34, manager + 0x3c, manager + 0x44})
+      release_pair(pair);
+    const auto after = heap_stats();
+    CHECK(after.used_bytes == baseline.used_bytes &&
+          after.used_blocks == baseline.used_blocks && heap_check().empty());
+  }
+  wr32(0x006cd2a4, previous_recording); wr32(manager + 0x5c, previous_single);
+  wr32(manager + 0xc8, previous_network); wr32(manager + 0x78, previous_primary_gate);
+  wr32(manager + 0xc4, previous_primary_pause);
+  wr32(0x0071c68c, 0);
+  for (const uint32_t p : {scratch, header}) {
+    const uint32_t free[] = {p}; invoke(c, 0x00645bc0, 0, free, 1);
+  }
+}
