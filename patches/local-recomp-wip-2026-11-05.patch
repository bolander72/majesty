+struct NativeRegistrySnapshot {
+    struct Group {
+        uint32_t address = 0, table = 0, kind = 0, list_count = 0, tree_count = 0;
+        uint64_t members = 14695981039346656037ull;
+        bool operator==(const Group &) const = default;
