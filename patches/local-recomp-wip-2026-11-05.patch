+  completed = true;
+  std::fprintf(stderr,
+               "[campaign-fixture] Building objective completed restored=1 "
+               "owner-filter=1 unfinished-filter=1 invalid-refused=1 "
+               "clock-same=1 hooks-same=1 result=pass\n");
+#else
+  (void)c;
+#endif
