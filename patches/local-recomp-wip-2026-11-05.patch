+  std::fprintf(
+      stderr,
+      "[coop-read-fixture] Loaded binding load=%u region=%s context=%08x "
+      "slots=0,1 ids=7,8 graph-restored=1 party-restored=1 cpu-same=1 "
+      "heap-same=1 hooks-same=1 network=0 result=pass\n",
+      load++, region().key.c_str(), context);
