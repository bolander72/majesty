+    if (!active || !gm_valid(active, 8)) std::abort();
+    session_ui_restore.begin(rd32(active + 4));
+  }
+#ifndef __EMSCRIPTEN__
+  if (halo_reload_enabled()) halo_reload.pending = true;
+#endif
