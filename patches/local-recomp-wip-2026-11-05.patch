--- /dev/null
+++ b/native_actor_stage.cpp
@@ -0,0 +1,178 @@
+#include "native_actor_stage.h"
+#include "platform/os.h"
+#include "runtime/memory.h"
+#include "runtime/win32.h"
+#include <cstdlib>
+
+namespace majesty::actors {
+namespace {
+constexpr uint32_t PRIMARY = 0x005bfe50, FACTORY = 0x0042c3d0;
+constexpr uint32_t REGISTER = 0x005a12e0, CELL = 0x005ad470;
+constexpr uint32_t FACTORY_TABLE = 0x00682950;
+} // namespace
+UnitStage::UnitStage()
+    : bindings_{{{this, PRIMARY, 0}, {this, FACTORY, 0}, {this, REGISTER, 0}, {this, CELL, 0}}},
+      thread_(uint64_t(os_thread_self())) {}
+bool UnitStage::thread() const {
+    return thread_ == uint64_t(os_thread_self());
+}
+uint32_t UnitStage::installed_count() const {
+    uint32_t n = 0;
+    for (const auto &b : bindings_)
+        n += b.handle != 0;
+    return n;
+}
+bool UnitStage::install() {
+    if (!thread() || !sched_holds_baton() || mods_hook_depth() || cpu_ || unit_ || attempted_ ||
+        failure_ != StageFailure::None || installed_count())
+        return false;
+    mods_registry_pump();
+    for (const auto &b : bindings_)
+        if (!mods_symbol_hookable(b.address))
+            return false;
+    for (auto &b : bindings_) {
+        if (mods_hook_install_ex(MODS_OWNER_RUNTIME, b.address, 0, callback, POP_HOOK_WRAP,
+                                 POP_HOOK_NO_GAME_VIEW, &b, &b.handle) != POP_OK) {
+            remove();
+            return false;
+        }
+    }
+    return true;
+}
+bool UnitStage::remove() {
+    if (!thread() || !sched_holds_baton() || mods_hook_depth() || cpu_)
+        return false;
+    mods_registry_pump();
+    bool ok = true;
+    for (auto i = bindings_.rbegin(); i != bindings_.rend(); ++i) {
+        if (!i->handle)
+            continue;
+        if (mods_hook_remove(MODS_OWNER_RUNTIME, i->handle) == POP_OK)
+            i->handle = 0;
+        else
+            ok = false;
+    }
+    return ok;
+}
+StageResult UnitStage::read(X86 *cpu, uint32_t context, uint32_t factory, uint32_t output,
+                            const StageInput &input) {
+    StageProfile profile;
+    if (!thread() || !sched_holds_baton() || mods_hook_depth() || !cpu || cpu_ || unit_ ||
+        attempted_ || installed_count() != bindings_.size() || failure_ != StageFailure::None ||
+        !stage_profile(input, profile) || !gm_valid(context, 0x34) ||
+        rd32(context + 0x30) != 0x006bd760 || !gm_valid(factory, 0x88) ||
+        rd32(factory) != FACTORY_TABLE || !gm_valid(output, 4) || rd32(output))
+        return {{0, GuestCallGuardedStatus::InvalidCall}, unit_, false};
+    attempted_ = true;
+    cpu_ = cpu;
+    factory_ = factory;
+    output_ = output;
+    input_ = input;
+    profile_ = profile;
+    cpu->r[R_ECX] = context;
+    uint32_t args[] = {profile_.components, factory, output};
+    auto result = guest_call_guarded(cpu, 0x005c1f30, args, 3, &cookie_);
+    cpu_ = nullptr;
+    cookie_ = 0;
+    bool ok = result.status == GuestCallGuardedStatus::Returned && !result.eax &&
+              failure_ == StageFailure::None && primary_ && created_ && registered_ && cell_ &&
+              rd32(output) == unit_ && gm_valid(unit_, profile_.bytes) &&
+              rd32(unit_) == profile_.table && rd32(unit_ + 0x5c) == profile_.kind &&
+              !rd32(unit_ + 0x60) && !rd32(unit_ + 0x84) && rd32(unit_ + 0x64) == input.flags &&
+              rd32(unit_ + 0x74) == input.parent && rd32(unit_ + 0x6c) == input.description &&
+              rd32(unit_ + 0x80) && rd32(unit_ + 0x70) == input.player && !rd32(unit_ + 0x88) &&
+              !rd32(unit_ + 0x8c) && !rd32(unit_ + 0x90);
+    if (!ok && failure_ == StageFailure::None)
+        failure_ = result.status == GuestCallGuardedStatus::Returned ? StageFailure::Incomplete
+                                                                     : StageFailure::GuardStopped;
+    return {result, unit_, ok};
+}
+bool UnitStage::acknowledge_destroyed(uint32_t unit) {
+    if (!thread() || cpu_ || installed_count() || !unit || unit != unit_)
+        return false;
+    unit_ = 0;
+    return true;
+}
+[[noreturn]] void UnitStage::stop(StageFailure why) {
+    if (failure_ == StageFailure::None)
+        failure_ = why;
+    guest_call_guarded_cancel(cpu_, cookie_, 0xbad10001);
+    std::abort();
+}
+void UnitStage::next(pop_cpu_v1 *cpu, PopHookInvocation *inv) {
+    if (mods_call_next(nullptr, inv, cpu) != POP_OK) {
+        if (cpu_ && guest_call_guarded_cookie(cpu_) == cookie_)
+            stop(StageFailure::HookFailed);
+        std::abort();
+    }
+}
+void UnitStage::callback(const PopModApi *, pop_cpu_v1 *cpu, PopHookInvocation *inv, void *user) {
+    auto *b = static_cast<Binding *>(user);
+    b->owner->dispatch(b->address, cpu, inv);
+}
+void UnitStage::dispatch(uint32_t fn, pop_cpu_v1 *cpu, PopHookInvocation *inv) {
+    if (!cpu_ || !cookie_ || guest_call_guarded_cookie(cpu_) != cookie_) {
+        next(cpu, inv);
+        return;
+    }
+    if (fn == PRIMARY) {
+        uint32_t chunk = rd32(cpu->esp + 4);
+        if (primary_ || !gm_valid(chunk, 0x28) || rd32(chunk + 4) != 0x4d495250 ||
+            rd32(chunk + 0x20) != 9 || rd32(cpu->esp + 8) != factory_ ||
+            rd32(cpu->esp + 12) != output_)
+            stop(StageFailure::WrongInput);
+        primary_ = true;
+        next(cpu, inv);
+        return;
+    }
+    if (fn == FACTORY) {
+        if (!primary_ || created_ || cpu->ecx != factory_ ||
+            rd32(cpu->esp + 4) != profile_.kind ||
+            rd32(cpu->esp + 8))
+            stop(StageFailure::WrongInput);
+        // The actual original factory constructs the complete class with no
+        // world association; its kind/description stores still execute.
+        cpu->ecx = 0;
+        next(cpu, inv);
+        unit_ = cpu->eax;
+        if (!unit_ || !gm_valid(unit_, profile_.bytes) || rd32(unit_) != profile_.table ||
+            rd32(unit_ + 0x5c) != profile_.kind || rd32(unit_ + 0x60) ||
+            rd32(unit_ + 0x84))
+            stop(StageFailure::WrongInput);
+        created_ = true;
+        return;
+    }
+    if (fn == REGISTER) {
+        if (!created_ || registered_ || cpu->ecx != factory_ || rd32(cpu->esp + 4) != unit_ ||
+            rd32(cpu->esp + 12) || rd32(unit_ + 0x64) != input_.flags ||
+            rd32(unit_ + 0x74) != input_.parent || rd32(unit_ + 0x70) != input_.player ||
+            rd32(cpu->esp + 8) != ((input_.flags & 0x100) ? 2u : 1u))
+            stop(StageFailure::WrongInput);
+        registered_ = true; // record the request; publish no identity/tree/list
+        if (mods_hook_return(nullptr, cpu, 0, 12) != POP_OK)
+            stop(StageFailure::HookFailed);
+        return;
+    }
+    if (fn != CELL || !registered_ || cell_ || cpu->ecx != unit_ || rd32(unit_ + 0x60) ||
+        rd32(unit_ + 0x84))
+        stop(StageFailure::WrongInput);
+    uint32_t point = rd32(cpu->esp + 4);
+    if (!gm_valid(point, 8))
+        stop(StageFailure::WrongInput);
+    cell_ = true;
+    if (input_.parent && !(input_.flags & 0x80)) {
+        // This pinned original branch returns before any grid/observer effect.
+        next(cpu, inv);
+        return;
+    }
+    cell_x_ = rd32(point);
+    cell_y_ = rd32(point + 4);
+    cell_deferred_ = true;
+    // Preserve the original field stores while deferring removal/insertion
+    // and the global observer until a separately qualified publication step.
+    wr32(unit_ + 0x54, cell_x_);
+    wr32(unit_ + 0x58, cell_y_);
+    if (mods_hook_return(nullptr, cpu, 0, 4) != POP_OK)
+        stop(StageFailure::HookFailed);
+}
+} // namespace majesty::actors
diff --git a/native_actor_stage.h b/native_actor_stage.h
new file mode 100644
index 0000000..e4a867c
--- /dev/null
+++ b/native_actor_stage.h
@@ -0,0 +1,77 @@
+// Guarded original UNIT restoration with deferred registry/spatial exposure.
+#pragma once
+#include "native_actor_profile.h"
+#include "mods/mods_internal.h"
+#include "runtime/guest.h"
+#include <array>
+
+namespace majesty::actors {
+enum class StageFailure { None, InvalidCall, WrongInput, HookFailed, GuardStopped, Incomplete };
+struct StageResult {
+    GuestCallGuardedResult guest;
+    uint32_t unit;
+    bool complete;
+};
+// One read attempt per instance; captured construction requires explicit cleanup.
+class UnitStage {
+  public:
+    UnitStage();
+    UnitStage(const UnitStage &) = delete;
+    UnitStage &operator=(const UnitStage &) = delete;
+    bool install();
+    bool remove();
+    // Caller supplies a stopped immutable UNIT (version 0) / PRIMARY v9:
+    // two components for Vehicle, one for the explicit ExploreReward profile,
+    // verifies its living flags before opening the stream, and retains context,
+    // output and this object outside all longjmp-skipped frames. Source script
+    // IDs/parent references remain pending; never activate this private object.
+    StageResult read(X86 *, uint32_t context, uint32_t factory, uint32_t output,
+                     const StageInput &input);
+    uint32_t unit() const {
+        return unit_;
+    }
+    uint32_t installed_count() const;
+    StageFailure failure() const {
+        return failure_;
+    }
+    bool registry_deferred() const {
+        return registered_;
+    }
+    bool spatial_deferred() const {
+        return cell_deferred_;
+    }
+    uint32_t cell_x() const {
+        return cell_x_;
+    }
+    uint32_t cell_y() const {
+        return cell_y_;
+    }
+    // Does not destroy an object or reclaim memory. After qualified original
+    // cleanup, the caller acknowledges removal of this exact private object.
+    bool acknowledge_destroyed(uint32_t unit);
+
+  private:
+    struct Binding {
+        UnitStage *owner;
+        uint32_t address, handle;
+    };
+    static void callback(const PopModApi *, pop_cpu_v1 *, PopHookInvocation *, void *);
+    void dispatch(uint32_t, pop_cpu_v1 *, PopHookInvocation *);
+    void next(pop_cpu_v1 *, PopHookInvocation *);
+    [[noreturn]] void stop(StageFailure);
+    bool thread() const;
+    std::array<Binding, 4> bindings_;
+    uint64_t thread_, cookie_ = 0;
+    X86 *cpu_ = nullptr;
+    uint32_t factory_ = 0, output_ = 0, unit_ = 0;
+    StageInput input_{};
+    StageProfile profile_{};
+    StageFailure failure_ = StageFailure::None;
+    bool attempted_ = false;
+    bool primary_ = false, created_ = false, registered_ = false, cell_ = false;
+    bool cell_deferred_ = false;
+    uint32_t cell_x_ = 0, cell_y_ = 0;
+};
+// No implicit cleanup: installed handles and captured partial objects require
+// explicit reconciliation before this scope's storage may be destroyed.
+} // namespace majesty::actors
diff --git a/native_order_allocation.cpp b/native_order_allocation.cpp
new file mode 100644
index 0000000..170f4b5
--- /dev/null
+++ b/native_order_allocation.cpp
@@ -0,0 +1,371 @@
+#include "native_order_allocation.h"
+#include "runtime/memory.h"
+
+namespace majesty::orders {
+AllocationBridge::AllocationBridge(Journal &journal, const EntryPoints &sites, ClaimPolicy policy)
+    : journal_(&journal), journal_revision_(journal.revision_), sites_(sites), policy_(policy) {
+    if (!valid_sites())
+        failure_ = AllocationFailure::InvalidSites;
+}
+bool AllocationBridge::valid_sites() const {
+    if (!sites_.construct || !sites_.read || sites_.construct == sites_.read)
+        return false;
+    if (journal_->reserves_names() && !sites_.name_allocate_return)
+        return false;
+    if (sites_.kind_nine_allocate_return &&
+        sites_.kind_nine_allocate_return == sites_.name_allocate_return)
+        return false;
+    if (sites_.kind_twelve_allocate_return &&
+        (sites_.kind_twelve_allocate_return == sites_.name_allocate_return ||
+         sites_.kind_twelve_allocate_return == sites_.kind_nine_allocate_return))
+        return false;
+    if (sites_.kind_thirteen_allocate_return &&
+        (sites_.kind_thirteen_allocate_return == sites_.name_allocate_return ||
+         sites_.kind_thirteen_allocate_return == sites_.kind_nine_allocate_return ||
+         sites_.kind_thirteen_allocate_return == sites_.kind_twelve_allocate_return))
+        return false;
+    for (uint32_t i = 0; i < sites_.allocate_return.size(); ++i) {
+        if (!sites_.allocate_return[i])
+            return false;
+        if (sites_.allocate_return[i] == sites_.kind_nine_allocate_return)
+            return false;
+        if (sites_.allocate_return[i] == sites_.kind_twelve_allocate_return)
+            return false;
+        if (sites_.allocate_return[i] == sites_.kind_thirteen_allocate_return)
+            return false;
+        for (uint32_t j = 0; j < i; ++j)
+            if (sites_.allocate_return[i] == sites_.allocate_return[j])
+                return false;
+    }
+    return true;
+}
+bool AllocationBridge::ready() const {
+    return failure_ == AllocationFailure::None && phase_ == Phase::Idle && !cpu_ &&
+           journal_->revision_ == journal_revision_ && journal_->state() == State::Reserved &&
+           !journal_->invocation_active();
+}
+uint32_t AllocationBridge::address(Role role, uint32_t index) const {
+    const Block *b = journal_->find(role, bank_, index);
+    return b ? b->address : 0;
+}
+BankInvocationResult AllocationBridge::invalid(AllocationFailure why) {
+    if (failure_ == AllocationFailure::None)
+        failure_ = why;
+    return {{0, GuestCallGuardedStatus::InvalidCall}, false};
+}
+AllocationDecision AllocationBridge::stop(AllocationFailure why) {
+    if (failure_ == AllocationFailure::None)
+        failure_ = why;
+    return {AllocationAction::Stop, 0, failure_, false};
+}
+AllocationDecision AllocationBridge::claim(const Block *b, uint32_t bytes) {
+    if (!b || b->request.bytes != bytes)
+        return stop(AllocationFailure::WrongSize);
+    if (policy_.allow && !policy_.allow(policy_.context, b->request))
+        return stop(AllocationFailure::PolicyRefused);
+    uint32_t result = 0;
+    if (!journal_->claim(b->request, &result))
+        return stop(AllocationFailure::ClaimRefused);
+    return {AllocationAction::Return, result, AllocationFailure::None, false};
+}
+BankInvocationResult AllocationBridge::construct(X86 *cpu, uint32_t bank, uint32_t owner) {
+    if (!cpu || !ready() || bank != constructed_ || bank >= 3)
+        return invalid(AllocationFailure::InvalidSequence);
+    bank_ = bank;
+    const Block *b = journal_->find(Role::Bank, bank);
+    auto bank_claim = claim(b, 20);
+    if (bank_claim.action != AllocationAction::Return)
+        return invalid(bank_claim.failure);
+    uint32_t storage = bank_claim.address;
+    phase_ = Phase::Construct;
+    cpu_ = cpu;
+    head_ = false;
+    cpu->r[R_ECX] = storage;
+    auto result = journal_->invoke(cpu, sites_.construct, &owner, 1);
+    cpu_ = nullptr;
+    phase_ = Phase::Idle;
+    if (result.status != GuestCallGuardedStatus::Returned) {
+        if (failure_ == AllocationFailure::None)
+            failure_ = AllocationFailure::GuardStopped;
+    } else if (failure_ == AllocationFailure::None && (!head_ || result.eax != storage)) {
+        failure_ = AllocationFailure::InvalidReturn;
+    }
+    bool ok = failure_ == AllocationFailure::None;
+    if (ok)
+        ++constructed_;
+    return {result, ok};
+}
+BankInvocationResult AllocationBridge::read(X86 *cpu, uint32_t bank, uint32_t stream) {
+    if (!cpu || !ready() || constructed_ != 3 || bank != read_ || bank >= 3)
+        return invalid(AllocationFailure::InvalidSequence);
+    bank_ = bank;
+    phase_ = Phase::Read;
+    cpu_ = cpu;
+    next_ = 0;
+    pending_ = NO_INDEX;
+    kind_ = order_ = 0;
+    node_ = path_ = observed_failure_ = false;
+    cpu->r[R_ECX] = address(Role::Bank);
+    auto result = journal_->invoke(cpu, sites_.read, &stream, 1);
+    cpu_ = nullptr;
+    phase_ = Phase::Idle;
+    if (result.status != GuestCallGuardedStatus::Returned) {
+        if (failure_ == AllocationFailure::None)
+            failure_ = AllocationFailure::GuardStopped;
+    } else if (failure_ == AllocationFailure::None) {
+        if (result.eax || observed_failure_)
+            failure_ = AllocationFailure::ReadFailed;
+        else if ((pending_ != NO_INDEX && !node_) || journal_->find(Role::Order, bank_, next_))
+            failure_ = AllocationFailure::IncompleteRead;
+    }
+    bool ok = failure_ == AllocationFailure::None;
+    if (ok)
+        ++read_;
+    return {result, ok};
+}
+BankInvocationResult AllocationBridge::read_unit(X86 *cpu, uint32_t unit, uint32_t stream,
+                                                 const UnitReadPoints &sites) {
+    if (!cpu || !ready() || constructed_ || read_ || !unit || !stream || !sites.read ||
+        !sites.bank_allocate_return || sites.bank_allocate_return == sites_.name_allocate_return ||
+        !sites.table || sites.bank_fields % 4 || sites.read == sites_.construct ||
+        sites.read == sites_.read || uint64_t(unit) + sites.bank_fields + 12 > UINT32_MAX ||
+        !gm_valid(unit, 4) || !gm_valid(unit + sites.bank_fields, 12) || rd32(unit) != sites.table)
+        return invalid(AllocationFailure::InvalidSequence);
+    for (uint32_t pc : sites_.allocate_return)
+        if (pc == sites.bank_allocate_return)
+            return invalid(AllocationFailure::InvalidSites);
+    if (sites_.kind_nine_allocate_return &&
+        sites_.kind_nine_allocate_return == sites.bank_allocate_return)
+        return invalid(AllocationFailure::InvalidSites);
+    if (sites_.kind_twelve_allocate_return &&
+        sites_.kind_twelve_allocate_return == sites.bank_allocate_return)
+        return invalid(AllocationFailure::InvalidSites);
+    if (sites_.kind_thirteen_allocate_return &&
+        sites_.kind_thirteen_allocate_return == sites.bank_allocate_return)
+        return invalid(AllocationFailure::InvalidSites);
+    for (uint32_t bank = 0; bank < 3; ++bank) {
+        const Block *b = journal_->find(Role::Bank, bank);
+        if (rd32(unit + sites.bank_fields + bank * 4) || !b || b->claimed || !b->owned)
+            return invalid(AllocationFailure::InvalidSequence);
+    }
+    unit_sites_ = sites;
+    unit_ = unit;
+    unit_stream_ = stream;
+    unit_active_ = true;
+    bank_pending_ = false;
+    bank_ = 0;
+    phase_ = Phase::UnitGet;
+    cpu_ = cpu;
+    cpu->r[R_ECX] = unit;
+    auto result = journal_->invoke(cpu, sites.read, &stream, 1);
+    cpu_ = nullptr;
+    unit_active_ = false;
+    if (result.status != GuestCallGuardedStatus::Returned) {
+        if (failure_ == AllocationFailure::None)
+            failure_ = AllocationFailure::GuardStopped;
+    } else if (failure_ == AllocationFailure::None) {
+        if (result.eax)
+            failure_ = AllocationFailure::ReadFailed;
+        else if (phase_ != Phase::UnitGet || bank_pending_ || constructed_ != 3 || read_ != 3 ||
+                 !journal_->fully_claimed())
+            failure_ = AllocationFailure::IncompleteRead;
+        else
+            for (uint32_t bank = 0; bank < 3; ++bank)
+                if (rd32(unit + sites.bank_fields + bank * 4) !=
+                    journal_->find(Role::Bank, bank)->address)
+                    failure_ = AllocationFailure::InvalidReturn;
+    }
+    phase_ = Phase::Idle;
+    return {result, failure_ == AllocationFailure::None};
+}
+bool AllocationBridge::handoff_unit_orders(uint32_t unit) {
+    if (!unit || unit != unit_ || unit_active_ || !journal_->reserves_names() || !complete() ||
+        !gm_valid(unit, 4) || !gm_valid(unit + unit_sites_.bank_fields, 12) ||
+        rd32(unit) != unit_sites_.table)
+        return false;
+    for (uint32_t bank = 0; bank < 3; ++bank) {
+        const Block *b = journal_->find(Role::Bank, bank);
+        if (!b || !b->owned || !b->claimed ||
+            rd32(unit + unit_sites_.bank_fields + bank * 4) != b->address)
+            return false;
+    }
+    return journal_->transfer_to_owner();
+}
+AllocationDecision AllocationBridge::observe_unit_bank(X86 *cpu, uint32_t fn, uint32_t receiver,
+                                                       uint32_t argument, uint32_t result,
+                                                       bool returning) {
+    if (!unit_active_ || cpu != cpu_ || !journal_->eligible_cookie())
+        return {AllocationAction::Delegate, 0, AllocationFailure::None, false};
+    if (failure_ != AllocationFailure::None || journal_->state() != State::Reserved)
+        return stop(AllocationFailure::InvalidSequence);
+    if (bank_ >= 3)
+        return stop(AllocationFailure::WrongEntry);
+    if (fn == sites_.construct) {
+        if (!bank_pending_ || receiver != address(Role::Bank) || argument != unit_)
+            return stop(AllocationFailure::WrongReceiver);
+        if (!returning) {
+            if (phase_ != Phase::UnitGet || constructed_ != read_ || bank_ != read_)
+                return stop(AllocationFailure::WrongPhase);
+            head_ = false;
+            phase_ = Phase::Construct;
+        } else {
+            if (phase_ != Phase::Construct || !head_ || result != receiver)
+                return stop(AllocationFailure::InvalidReturn);
+            ++constructed_;
+            phase_ = Phase::UnitGet;
+        }
+    } else if (fn == sites_.read) {
+        if (!bank_pending_ || receiver != address(Role::Bank) || argument != unit_stream_ ||
+            rd32(unit_ + unit_sites_.bank_fields + bank_ * 4) != receiver)
+            return stop(AllocationFailure::WrongReceiver);
+        if (!returning) {
+            if (phase_ != Phase::UnitGet || constructed_ != read_ + 1 || bank_ != read_)
+                return stop(AllocationFailure::WrongPhase);
+            next_ = 0;
+            pending_ = NO_INDEX;
+            kind_ = order_ = 0;
+            node_ = path_ = observed_failure_ = false;
+            phase_ = Phase::Read;
+        } else {
+            if (phase_ != Phase::Read)
+                return stop(AllocationFailure::WrongPhase);
+            if (result || observed_failure_)
+                failure_ = AllocationFailure::ReadFailed;
+            else if ((pending_ != NO_INDEX && !node_) || journal_->find(Role::Order, bank_, next_))
+                return stop(AllocationFailure::IncompleteRead);
+            else {
+                ++read_;
+                bank_pending_ = false;
+            }
+            phase_ = Phase::UnitGet;
+            // A known failed read may return its original status to the UNIT
+            // reader. Further allocations/observers still stop on the latch.
+        }
+    } else {
+        return stop(AllocationFailure::UnknownCaller);
+    }
+    return {AllocationAction::Return, 0, failure_, false};
+}
+AllocationDecision AllocationBridge::intercept(X86 *cpu, uint32_t pc, uint32_t bytes,
+                                               uint32_t receiver, uint32_t status) {
+    if (phase_ == Phase::Idle || cpu != cpu_ || !journal_->eligible_cookie())
+        return {AllocationAction::Delegate, 0, AllocationFailure::None, false};
+    if (failure_ != AllocationFailure::None || journal_->state() != State::Reserved)
+        return stop(AllocationFailure::InvalidSequence);
+    if (unit_active_ && phase_ == Phase::UnitGet) {
+        if (pc != unit_sites_.bank_allocate_return)
+            return stop(AllocationFailure::UnknownCaller);
+        if (bank_pending_ || constructed_ != read_ || read_ >= 3)
+            return stop(AllocationFailure::WrongPhase);
+        if (receiver != unit_)
+            return stop(AllocationFailure::WrongReceiver);
+        bank_ = read_;
+        auto result = claim(journal_->find(Role::Bank, bank_), bytes);
+        if (result.action == AllocationAction::Return)
+            bank_pending_ = true;
+        return result;
+    }
+    uint32_t site = 0;
+    while (site < sites_.allocate_return.size() && sites_.allocate_return[site] != pc)
+        ++site;
+    const bool kind_nine = sites_.kind_nine_allocate_return &&
+                           pc == sites_.kind_nine_allocate_return;
+    const bool kind_twelve = sites_.kind_twelve_allocate_return &&
+                             pc == sites_.kind_twelve_allocate_return;
+    const bool kind_thirteen = sites_.kind_thirteen_allocate_return &&
+                               pc == sites_.kind_thirteen_allocate_return;
+    if (site == sites_.allocate_return.size() && !kind_nine && !kind_twelve && !kind_thirteen)
+        return stop(AllocationFailure::UnknownCaller);
+    if (site == 0) {
+        if (phase_ != Phase::Construct || head_)
+            return stop(AllocationFailure::WrongPhase);
+        if (receiver != address(Role::Bank))
+            return stop(AllocationFailure::WrongReceiver);
+        auto result = claim(journal_->find(Role::Head, bank_), bytes);
+        if (result.action == AllocationAction::Return)
+            head_ = true;
+        return result;
+    }
+    if (phase_ != Phase::Read)
+        return stop(AllocationFailure::WrongPhase);
+    observed_failure_ |= status != 0;
+    if (site <= 8 || kind_nine || kind_twelve || kind_thirteen) {
+        if (pending_ != NO_INDEX && !node_)
+            return stop(AllocationFailure::WrongEntry);
+        static constexpr uint32_t kinds[] = {1, 2, 4, 5, 6, 7, 10, 11};
+        const uint32_t expected_kind = kind_nine ? 9 : kind_twelve ? 12 : kind_thirteen ? 13 : kinds[site - 1];
+        const Block *b = journal_->find(Role::Order, bank_, next_);
+        if (!b || b->request.kind != expected_kind)
+            return stop(AllocationFailure::WrongEntry);
+        auto result = claim(b, bytes);
+        if (result.action == AllocationAction::Return) {
+            pending_ = next_++;
+            kind_ = expected_kind;
+            node_ = path_ = false;
+            order_ = result.address;
+        }
+        return result;
+    }
+    if (pending_ == NO_INDEX || node_)
+        return stop(AllocationFailure::WrongEntry);
+    if (site == 9 || site == 10) {
+        if (path_ || kind_ != (site == 9 ? 4u : 7u))
+            return stop(AllocationFailure::WrongEntry);
+        if (receiver != order_)
+            return stop(AllocationFailure::WrongReceiver);
+        const Block *b = journal_->find(Role::Path, bank_, pending_);
+        if (!b || b->request.kind != kind_)
+            return stop(AllocationFailure::WrongEntry);
+        if (kind_ == 4 && !bytes && b->request.bytes && status) {
+            path_ = true;
+            return {AllocationAction::Return, 0, AllocationFailure::None, true};
+        }
+        auto result = claim(b, bytes);
+        if (result.action == AllocationAction::Return)
+            path_ = true;
+        return result;
+    }
+    if ((kind_ == 4 || kind_ == 7) && !path_)
+        return stop(AllocationFailure::WrongEntry);
+    if (receiver != address(Role::Head))
+        return stop(AllocationFailure::WrongReceiver);
+    if (journal_->reserves_names() && !status) {
+        const Block *base = journal_->find(Role::BaseName, bank_, pending_);
+        const Block *leaf = journal_->find(Role::LeafName, bank_, pending_);
+        if (!base || !base->claimed || (leaf && !leaf->claimed))
+            return stop(AllocationFailure::WrongEntry);
+    }
+    const Block *b = journal_->find(Role::Node, bank_, pending_);
+    if (!b || b->request.kind != kind_)
+        return stop(AllocationFailure::WrongEntry);
+    auto result = claim(b, bytes);
+    if (result.action == AllocationAction::Return)
+        node_ = true;
+    return result;
+}
+AllocationDecision AllocationBridge::intercept_name(X86 *cpu, uint32_t pc, uint32_t bytes,
+                                                    uint32_t field) {
+    if (phase_ == Phase::Idle || cpu != cpu_ || !journal_->eligible_cookie())
+        return {AllocationAction::Delegate, 0, AllocationFailure::None, false};
+    if (failure_ != AllocationFailure::None || journal_->state() != State::Reserved)
+        return stop(AllocationFailure::InvalidSequence);
+    if (phase_ != Phase::Read || !journal_->reserves_names() || pending_ == NO_INDEX || node_)
+        return stop(AllocationFailure::WrongPhase);
+    if (pc != sites_.name_allocate_return)
+        return stop(AllocationFailure::UnknownCaller);
+    if (bytes != 1)
+        return stop(AllocationFailure::WrongSize);
+    Role role;
+    if (uint64_t(order_) + 36 == field)
+        role = Role::BaseName;
+    else if (uint64_t(order_) + (kind_ == 2 || kind_ == 6 ? 76 : 72) == field &&
+             (kind_ == 2 || kind_ == 5 || kind_ == 6 || kind_ == 11 || kind_ == 13))
+        role = Role::LeafName;
+    else
+        return stop(AllocationFailure::WrongReceiver);
+    return claim(journal_->find(role, bank_, pending_), bytes);
+}
+bool AllocationBridge::complete() const {
+    return ready() && constructed_ == 3 && read_ == 3 && journal_->fully_claimed();
+}
+} // namespace majesty::orders
diff --git a/native_order_allocation.h b/native_order_allocation.h
new file mode 100644
index 0000000..9af7d04
--- /dev/null
+++ b/native_order_allocation.h
@@ -0,0 +1,117 @@
+// Scoped claims for unpublished initial banks. No hook installation or actor
+// publication: the caller supplies verified entry/return PCs and a hook adapter.
+#pragma once
+#include "native_order_storage.h"
+
+namespace majesty::orders {
+struct EntryPoints {
+    uint32_t construct, read;
+    // Sentinel; kinds 1,2,4,5,6,7,10,11; paths 4,7; list node.
+    std::array<uint32_t, 12> allocate_return;
+    uint32_t name_allocate_return = 0; // original empty-name copier's malloc call
+    // Optional independently verified base-only command factory allocation.
+    // Existing profiles retain their twelve sites and refuse this caller.
+    uint32_t kind_nine_allocate_return = 0;
+    // Optional frame-command factory allocation005da75f;72-byte object.
+    uint32_t kind_twelve_allocate_return = 0;
+    // Optional inherited Animate Extended factory005da790;100-byte object.
+    uint32_t kind_thirteen_allocate_return = 0;
+};
+struct UnitReadPoints {
+    uint32_t read, bank_allocate_return, table, bank_fields;
+};
+// Nonthrowing, nonallocating admission before consuming a claim. An optional
+// policy may refuse exposure; its false result must stop the owned guest call.
+struct ClaimPolicy {
+    void *context = nullptr;
+    bool (*allow)(void *, const Request &) = nullptr;
+};
+enum class AllocationAction { Delegate, Return, Stop };
+enum class AllocationFailure {
+    None,
+    InvalidSites,
+    InvalidSequence,
+    GuardStopped,
+    InvalidReturn,
+    UnknownCaller,
+    WrongPhase,
+    WrongSize,
+    WrongReceiver,
+    WrongEntry,
+    ClaimRefused,
+    PolicyRefused,
+    ReadFailed,
+    IncompleteRead
+};
+struct AllocationDecision {
+    AllocationAction action;
+    uint32_t address;
+    AllocationFailure failure;
+    bool failed_zero_path;
+};
+struct BankInvocationResult {
+    GuestCallGuardedResult guest;
+    bool complete;
+};
+
+// Keep both this controller and its journal outside skipped guest frames.
+// Its wrapper owns the exact CPU/cookie scope; caller-chosen tokens cannot
+// authorize a claim. Ordinary/foreign callbacks delegate without consuming it.
+// The adapter MUST cancel a Stop decision before another guest instruction;
+// returning a null pointer to an unchecked original allocation is not safe.
+// Calls are serialized on the journal's reserving host thread. A successful
+// result proves claim completion only, not graph semantics or publication.
+class AllocationBridge {
+  public:
+    AllocationBridge(Journal &journal, const EntryPoints &sites, ClaimPolicy policy = {});
+    BankInvocationResult construct(X86 *cpu, uint32_t bank, uint32_t owner);
+    BankInvocationResult read(X86 *cpu, uint32_t bank, uint32_t stream);
+    // Only a stopped unpublished UNIT with three null bank fields is admitted.
+    // The caller installs verified constructor/read observers and cancels Stop
+    // decisions. Failed calls can leave UNIT fields borrowing journal storage:
+    // the caller must detach those exact fields before stopped raw release.
+    BankInvocationResult read_unit(X86 *cpu, uint32_t unit, uint32_t stream,
+                                   const UnitReadPoints &sites);
+    // After successful native-name read_unit and caller validation of the complete graph,
+    // relinquish every reservation to this exact stopped UNIT. The caller must
+    // qualify original destruction of these port allocations and all semantic
+    // references/navigation/clocks BEFORE handoff. This does not publish or
+    // activate an actor. Subsequent journal release never frees transferred
+    // blocks; rollback must use the qualified original owner instead.
+    bool handoff_unit_orders(uint32_t unit);
+    AllocationDecision observe_unit_bank(X86 *cpu, uint32_t fn, uint32_t receiver,
+                                         uint32_t argument, uint32_t result, bool returning);
+    AllocationDecision intercept(X86 *cpu, uint32_t return_pc, uint32_t bytes, uint32_t receiver,
+                                 uint32_t stream_status = 0);
+    // A separate malloc hook receives the name copier's preserved EBX, which
+    // identifies its destination string field. No arbitrary string is admitted.
+    AllocationDecision intercept_name(X86 *cpu, uint32_t return_pc, uint32_t bytes, uint32_t field);
+    bool complete() const;
+    AllocationFailure failure() const {
+        return failure_;
+    }
+
+  private:
+    friend class ReaderHooks;
+    enum class Phase { Idle, Construct, Read, UnitGet };
+    bool ready() const;
+    bool valid_sites() const;
+    AllocationDecision stop(AllocationFailure why);
+    AllocationDecision claim(const Block *, uint32_t bytes);
+    BankInvocationResult invalid(AllocationFailure why);
+    uint32_t address(Role role, uint32_t index = NO_INDEX) const;
+    Journal *journal_;
+    uint64_t journal_revision_;
+    EntryPoints sites_;
+    ClaimPolicy policy_;
+    X86 *cpu_ = nullptr;
+    Phase phase_ = Phase::Idle;
+    AllocationFailure failure_ = AllocationFailure::None;
+    uint32_t bank_ = 0, constructed_ = 0, read_ = 0;
+    uint32_t next_ = 0, pending_ = NO_INDEX, kind_ = 0, order_ = 0;
+    bool head_ = false, node_ = false, path_ = false, observed_failure_ = false;
+    UnitReadPoints unit_sites_{};
+    uint32_t unit_ = 0, unit_stream_ = 0;
+    bool unit_active_ = false, bank_pending_ = false;
+};
+} // namespace majesty::orders
diff --git a/native_order_hooks.cpp b/native_order_hooks.cpp
new file mode 100644
index 0000000..84746f3
--- /dev/null
+++ b/native_order_hooks.cpp
@@ -0,0 +1,165 @@
+#include "native_order_hooks.h"
+#include "native_actor_profile.h"
+#include "runtime/win32.h"
+#include <cstdlib>
+
+namespace majesty::orders {
+namespace {
+// Pinned allocator and constructor/read entries; see UNIT reader/stream audits.
+constexpr uint32_t MALLOC = 0x0064c616, NAME_MALLOC = 0x0064d59f;
+constexpr uint32_t BANK_CTOR = 0x004abcc0, BANK_READ = 0x005e4d20;
+constexpr UnitReadPoints UNIT_READ{0x005b1b90, 0x0043010f, 0x0068098c, 0x88};
+} // namespace
+ReaderHooks::ReaderHooks(AllocationBridge &bridge, HookTrace trace)
+    : journal_(bridge.journal_), bridge_(&bridge), trace_(trace),
+      bindings_{
+          {{this, MALLOC, 0}, {this, NAME_MALLOC, 0}, {this, BANK_CTOR, 0}, {this, BANK_READ, 0}}} {
+}
+uint32_t ReaderHooks::installed_count() const {
+    uint32_t count = 0;
+    for (const auto &binding : bindings_)
+        count += binding.handle != 0;
+    return count;
+}
+bool ReaderHooks::install() {
+    if (!journal_->owner_thread() || !sched_holds_baton() || mods_hook_depth() || cpu_ ||
+        journal_->invocation_active() || installed_count() || hook_failed_ || !bridge_->ready() ||
+        bridge_->sites_.construct != BANK_CTOR || bridge_->sites_.read != BANK_READ)
+        return false;
+    mods_registry_pump(); // settle queued mutations before publishing our handles
+    // Validate the complete set before installing any handle.
+    for (const auto &binding : bindings_)
+        if (!mods_symbol_hookable(binding.address))
+            return false;
+    for (auto &binding : bindings_) {
+        if (mods_hook_install_ex(MODS_OWNER_RUNTIME, binding.address, 0, callback, POP_HOOK_WRAP,
+                                 POP_HOOK_NO_GAME_VIEW, &binding, &binding.handle) != POP_OK) {
+            remove();
+            return false;
+        }
+    }
+    return true;
+}
+bool ReaderHooks::remove() {
+    if (!journal_->owner_thread() || !sched_holds_baton() || mods_hook_depth() || cpu_ ||
+        journal_->invocation_active())
+        return false;
+    mods_registry_pump();
+    bool ok = true;
+    for (auto i = bindings_.rbegin(); i != bindings_.rend(); ++i) {
+        if (!i->handle)
+            continue;
+        if (mods_hook_remove(MODS_OWNER_RUNTIME, i->handle) == POP_OK)
+            i->handle = 0;
+        else
+            ok = false;
+    }
+    return ok;
+}
+bool ReaderHooks::stream_status(uint32_t stream, uint32_t *status) {
+    // Original 004ef6c0..004ef6e2: virtual ios state overrides wrapper +4.
+    // Resolve the signed virtual-base displacement without a guest callback.
+    if (!gm_valid(stream, 8))
+        return false;
+    uint32_t input = rd32(stream);
+    if (!gm_valid(input, 4))
+        return false;
+    uint32_t table = rd32(input);
+    if (!gm_valid(table, 8))
+        return false;
+    int64_t state = int64_t(input) + int32_t(rd32(table + 4)) + 8;
+    if (state < 0 || state > UINT32_MAX || !gm_valid(uint32_t(state), 4))
+        return false;
+    uint32_t bits = rd32(uint32_t(state));
+    *status = bits ? ((bits & 1) ? 0x2000000a : 0x1e) : rd32(stream + 4);
+    return true;
+}
+BankInvocationResult ReaderHooks::read_unit(X86 *cpu, uint32_t unit, uint32_t stream,
+                                            const UnitReadPoints &sites) {
+    uint32_t status = 0;
+    if (!journal_->owner_thread() || !sched_holds_baton() || mods_hook_depth() || !cpu || cpu_ ||
+        installed_count() != bindings_.size() || hook_failed_ || !stream_status(stream, &status) ||
+        sites.read != UNIT_READ.read ||
+        sites.bank_allocate_return != UNIT_READ.bank_allocate_return ||
+        (sites.table != UNIT_READ.table && sites.table != 0x0068071c) ||
+        sites.bank_fields != UNIT_READ.bank_fields ||
+        !gm_valid(unit, 0x94) || rd32(unit) != sites.table || rd32(unit + 0x60) ||
+        rd32(unit + 0x84))
+        return {{0, GuestCallGuardedStatus::InvalidCall}, false};
+    if (sites.table == 0x0068071c) {
+        actors::StageProfile profile{};
+        if (!actors::stage_profile({rd32(unit + 0x64), rd32(unit + 0x74),
+                                   rd32(unit + 0x6c), rd32(unit + 0x70),
+                                   actors::StageClass::ExploreReward}, profile) ||
+            !gm_valid(unit, profile.bytes) || rd32(unit + 0x5c) != profile.kind)
+            return {{0, GuestCallGuardedStatus::InvalidCall}, false};
+    }
+    cpu_ = cpu;
+    stream_ = stream;
+    auto result = bridge_->read_unit(cpu, unit, stream, sites);
+    cpu_ = nullptr;
+    stream_ = 0;
+    result.complete = result.complete && !hook_failed_;
+    return result;
+}
+[[noreturn]] void ReaderHooks::cancel(uint32_t value) {
+    // A failed cancellation must never return into unchecked original malloc.
+    guest_call_guarded_cancel(cpu_, journal_->eligible_cookie(), value);
+    std::abort();
+}
+void ReaderHooks::next(pop_cpu_v1 *cpu, PopHookInvocation *inv) {
+    // Runtime-owned callbacks may receive a null API context. The direct SDK
+    // entry does not dereference it; do not adopt another mod's API/identity.
+    if (mods_call_next(nullptr, inv, cpu) != POP_OK) {
+        hook_failed_ = true;
+        if (cpu_ && journal_->eligible_cookie())
+            cancel(0xbad00001);
+        std::abort(); // cannot safely resume a failed foreign/base dispatch
+    }
+}
+void ReaderHooks::callback(const PopModApi *, pop_cpu_v1 *cpu, PopHookInvocation *inv, void *user) {
+    auto *binding = static_cast<Binding *>(user);
+    binding->owner->dispatch(binding->address, cpu, inv);
+}
+void ReaderHooks::dispatch(uint32_t fn, pop_cpu_v1 *cpu, PopHookInvocation *inv) {
+    if (!cpu_ || !journal_->eligible_cookie()) {
+        next(cpu, inv);
+        return;
+    }
+    if (fn == BANK_CTOR || fn == BANK_READ) {
+        uint32_t receiver = cpu->ecx, argument = rd32(cpu->esp + 4);
+        auto before = bridge_->observe_unit_bank(cpu_, fn, receiver, argument, 0, false);
+        if (before.action == AllocationAction::Delegate) {
+            next(cpu, inv);
+            return;
+        }
+        if (before.action == AllocationAction::Stop)
+            cancel(0xbad00001);
+        next(cpu, inv);
+        auto after = bridge_->observe_unit_bank(cpu_, fn, receiver, argument, cpu->eax, true);
+        if (after.action != AllocationAction::Return)
+            cancel(0xbad00001);
+        return;
+    }
+    bool name = fn == NAME_MALLOC;
+    uint32_t status = 0;
+    if (!name && !stream_status(stream_, &status))
+        cancel(0xbad00001);
+    auto decision =
+        name ? bridge_->intercept_name(cpu_, rd32(cpu->esp), rd32(cpu->esp + 4), cpu->ebx)
+             : bridge_->intercept(cpu_, rd32(cpu->esp), rd32(cpu->esp + 4), cpu->esi, status);
+    if (decision.action == AllocationAction::Delegate) {
+        next(cpu, inv);
+        return;
+    }
+    if (trace_.allocation)
+        trace_.allocation(trace_.context, name, decision);
+    if (decision.action == AllocationAction::Stop)
+        cancel(name ? 0xbad00003 : 0xbad00002);
+    // Both observed malloc entries use cdecl; their callers pop arguments.
+    if (mods_hook_return(nullptr, cpu, decision.address, 0) != POP_OK) {
+        hook_failed_ = true;
+        cancel(0xbad00001);
+    }
+}
+} // namespace majesty::orders
