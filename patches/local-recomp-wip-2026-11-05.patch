+  extra.r[R_ECX] = manager;
+  guest_call(&extra, 0x004a5c00, owner, 0u, 0u);
+  return rd32(0x006d7670) == state && rd32(0x006d8568) == manager &&
+         rd32(0x0071c68c) == world && rd32(world + 4) == context &&
+         rd32(state) == 2 && rd32(state + 4) == 7 &&
+         rd32(manager + 0x27c) == owner && rd32(state + 0x28) == frame &&
+         rd32(0x0071c6a8) == clock;
+}
+
+// New co-op travel transition, not an original phase setter behavior.
+// Original00416050 turns request2 from phase7 into pending5 (exit/load).
+// After00415f30 has transferred the single full graph into BOTH proxy fields,
+// the exact committed coordinator may replace that pending5 with2. A newly
+// generated graph also requires the original fresh-start byte atstate+4c:
+// constructor00415cb1 sets1, rebuild00416fde runs InitializeGpl00417140,
+// then0041706e clears it. A saved graph keeps0 and its serialized agents.
+// original dispatcher/rebuild still run, and the separate Loaded barrier
+// still holds both kingdoms before any original resume command is sent.
+inline bool coop_queue_attached_rebuild(
+    X86 *c, uint32_t context, uint32_t owner,
+    const recomp_network_barrier_v1 &barrier,
+    const recomp_network_session_v1 &party, uint32_t serial,
+    const CoopTransition &target) {
+  CoopPlayerBinding binding;
+  if (!c || !sched_holds_baton() || mods_hook_depth() ||
+      c->r[R_ESP] < STACK_LIMIT + 65536 || c->r[R_ESP] > STACK_TOP ||
+      !(coop_committed_read(barrier, party, serial, target) ||
+        coop_committed_generate(barrier, party, serial, target)) ||
+      owner == UINT32_MAX ||
+      !std::binary_search(party.players, party.players + party.player_count, owner) ||
+      (party.host && party.local_player != owner) ||
+      !coop_player_binding(party, binding)) return false;
+  const uint32_t state = rd32(0x006d7670), manager = rd32(0x006d8568),
+                 world = rd32(0x0071c68c);
+  if (!context || !gm_valid(context, 0x11c) || rd32(context) != 0x00682950u ||
+      rd32(context + 0x24) != binding.slot || !world ||
+      !gm_valid(world, 0x20) || rd32(world) != 0x0067f85cu ||
+      rd32(world + 4) != context || rd32(world + 0x10) != context ||
+      rd32(manager + 0xc0) != context || !coop_match_type(manager) ||
+      rd32(manager + 0x27c) != owner || rd32(state) != 7 ||
+      rd32(state + 4) != 5 || rd8(state + 0x4c) != 0 ||
+      rd32(state + 0x28) != target.frame ||
+      rd32(0x0071c6a8) != target.target_clock) return false;
+  if (!target.target_saved) wr8(state + 0x4c, 1);
+  wr32(state + 4, 2);
+  return true;
+}
+// Keep the current match's inline player IDs/names/counts, not lobby+164's
+// pending settings. The pinned ctor004bae00 initializes eight IDs at+344,
+// eight inline 0x2e-byte names at+364 and the count at+4d4. Startup004bbb90
+// restores this 0x198-byte destination from a different lobby snapshot.
+// No guest strings, COM references or serialized host pointers are retained.
+class CoopLiveParty {
+public:
+  bool capture(const recomp_network_session_v1 &expected) {
+    held_ = false;
+    if (mods_hook_depth() || !coop_player_binding(expected, binding_))
+      return false;
+    state_ = rd32(0x006d7670);
+    manager_ = rd32(0x006d8568);
+    settings_ = rd32(0x006d87a0);
+    if (rd32(state_) != 7 || rd32(state_ + 4) || !coop_match_type(manager_))
+      return false;
+    match_type_ = rd32(manager_ + 0x218);
+    startup_mode_ = rd32(settings_ + 0x6c);
+    std::memcpy(party_.data(), g_mem + settings_ + 0x344, party_.size());
+    expected_ = expected;
+    held_ = true;
+    return true;
+  }
+  // The coordinator rechecks the exact joined epoch before calling this.
+  // A changed root, provider identity or local selection must end the load;
+  // it cannot restore into another scene. Refusal performs no guest writes.
+  bool restore(const recomp_network_session_v1 &expected) {
+    const bool held = held_;
+    held_ = false;
+    if (!held || !sched_holds_baton() || mods_hook_depth() ||
+        std::memcmp(&expected, &expected_, sizeof expected) ||
+        rd32(0x006d7670) != state_ || rd32(0x006d8568) != manager_ ||
+        rd32(0x006d87a0) != settings_ || !gm_valid(state_, 0x50) ||
+        !gm_valid(manager_, 0x2b0) || !gm_valid(settings_, 0x4f8) ||
+        rd32(manager_ + 0x8c) != binding_.player ||
+        rd32(manager_ + 0x218) != match_type_ || rd32(state_ + 0x24) != binding_.slot ||
+        rd32(state_) != 7 || rd32(state_ + 4))
+      return false;
+    std::memcpy(g_mem + settings_ + 0x344, party_.data(), party_.size());
+    CoopPlayerBinding current;
+    if (!coop_player_binding(expected, current) ||
+        current.slot != binding_.slot || current.player != binding_.player)
+      return false;
+    // Saved-reader preparation temporarily uses mode1 (00463c56). This is
+    // a startup selector, not a boolean:004bbcf5/004bbf8e/004bc02e select
+    // modes1/2/3, and004bc185 copies it into the match manager. Retain the
+    // current multiplayer mode as well as the live roster after reading.
+    wr32(settings_ + 0x6c, startup_mode_);
+    return true;
+  }
+  CoopPlayerBinding binding() const { return binding_; }
+
+private:
+  std::array<uint8_t, 0x198> party_{};
+  recomp_network_session_v1 expected_{};
+  CoopPlayerBinding binding_{};
+  uint32_t state_ = 0, manager_ = 0, settings_ = 0, match_type_ = 0;
+  uint32_t startup_mode_ = 0;
+  bool held_ = false;
+};
+
+// Bind the unattached context returned by the original full reader before
+// handing it to the world attachment lifecycle. +20 is005bbaf0, the same
+// slot setter used by004169a0, but the new context is not yet global world+4.
+// The caller has restored and revalidated the current room/party metadata.
+inline bool coop_select_loaded_context(X86 *c, uint32_t context,
+                                       CoopPlayerBinding binding) {
+  if (!c || !sched_holds_baton() || mods_hook_depth() || binding.slot >= 4 ||
+      !binding.player || binding.player == UINT32_MAX || !context ||
+      !gm_valid(context, 0x11c) || rd32(context) != 0x00682950 ||
+      rd32(rd32(context) + 0x20) != 0x005bbaf0 ||
+      c->r[R_ESP] < STACK_LIMIT + 65536 || c->r[R_ESP] > STACK_TOP)
+    return false;
+  const uint32_t state = rd32(0x006d7670), manager = rd32(0x006d8568),
+                 settings = rd32(0x006d87a0);
+  if (!state || !manager || !settings || !gm_valid(state, 0x50) ||
+      !gm_valid(manager, 0x2b0) || !gm_valid(settings, 0x4f8) ||
+      rd32(state + 0x24) != binding.slot ||
+      rd32(manager + 0x8c) != binding.player ||
+      rd32(settings + 0x344 + binding.slot * 4) != binding.player)
+    return false;
+  X86 extra = *c;
+  extra.r[R_ESP] -= 32768;
+  extra.r[R_ECX] = context;
+  guest_call(&extra, 0x005bbaf0, binding.slot);
+  return rd32(context + 0x24) == binding.slot;
+}
+} // namespace majesty
+
+// Success transfers one unattached original context to the game coordinator.
+// Attach or destroy it in the same baton turn before returning to the outer
+// dispatcher. No Ready/Loaded vote, phase rebuild or resume is implied. Failure
+// after an attempted read rejects the exact room: resource caches may already
+// have changed, so the old scene cannot be resumed as a reduced party.
+extern "C" bool majesty_browser_coop_checkpoint_read(
+    X86 *, uint64_t epoch, uint32_t owner, uint32_t serial,
+    const majesty::CoopTransition &, const recomp_network_session_v1 &,
+    uint32_t &context);
+extern "C" bool majesty_browser_coop_checkpoint_attach(
+    X86 *, uint64_t epoch, uint32_t owner, uint32_t serial,
+    const majesty::CoopTransition &, const recomp_network_session_v1 &);
+extern "C" bool
+majesty_browser_coop_current_identity(uint64_t epoch,
+                                      majesty::CoopCheckpointIdentity &);
+
+// Empty incoming selects an already verified target store. Otherwise the
+// admitted private received file is imported before Ready; never a graph load.
+extern "C" bool majesty_browser_coop_checkpoint_ready(
+    X86 *, uint64_t epoch, uint32_t owner, uint32_t serial,
+    const majesty::CoopTransition &, const recomp_network_session_v1 &,
+    const char *incoming);
+
+// Select a saved neighboring region and submit the next exact host proposal.
+// Capture must already have completed at the current settled source pause.
+extern "C" bool majesty_browser_coop_checkpoint_begin(
+    X86 *, uint64_t epoch, uint32_t owner, int32_t dx, int32_t dy,
+    const majesty::CoopCheckpointIdentity &,
+    const majesty::CoopCheckpointStore::Record &,
+    const recomp_network_session_v1 &, uint32_t &serial);
+extern "C" bool majesty_browser_coop_saved_metadata(const char *,
+                                                    uint32_t &clock,
+                                                    uint32_t &gpl_seed,
+                                                    uint32_t &game_seed);
diff --git a/coop_source_abort.h b/coop_source_abort.h
new file mode 100644
index 0000000..4a7d71e
--- /dev/null
+++ b/coop_source_abort.h
@@ -0,0 +1,51 @@
+#pragma once
+#include "coop_transition.h"
+#include "kit/runtime/native_seam.h"
+#include <cstring>
+
+namespace majesty {
+// The relay only publishes Canceled before commit. The coordinator must still
+// retain the exact source roots/profile/pause and prove no destructive load
+// has begun. Cancellation never grants target read or Loaded permission.
+inline bool coop_canceled_source_permission(
+    const recomp_network_barrier_v1 &current,
+    const recomp_network_session_v1 &party, uint32_t serial,
+    const CoopTransition &target, uint32_t owner) {
+  return current.stage == 4 &&
+         coop_agreement_matches(current, party, serial, target, 4) &&
+         owner != UINT32_MAX &&
+         std::binary_search(party.players, party.players + party.player_count, owner) &&
+         bool(party.host) == (party.local_player == owner);
+}
+
+// An unavailable destination must not strand the verified source in its
+// transition pause. This permission applies only BEFORE Begin is submitted.
+// The caller separately binds the exact epoch, live party, world and captured
+// pause boundary, and confirms that no read or unload has started.
+inline bool coop_source_abort_permission(
+    const recomp_network_barrier_v1 &before,
+    const recomp_network_barrier_v1 &current) {
+  if (std::memcmp(&before, &current, sizeof before))
+    return false;
+  if (!before.stage) {
+    const recomp_network_barrier_v1 empty{};
+    return !std::memcmp(&before, &empty, sizeof before);
+  }
+  if ((before.stage != 3 && before.stage != 4) || !before.serial ||
+      before.player_count < 2 || before.player_count > 4 ||
+      !before.descriptor_bytes ||
+      before.descriptor_bytes > sizeof before.descriptor)
+    return false;
+  for (uint32_t i = 0; i < 4; ++i)
+    if (i < before.player_count
+            ? !before.players[i] || before.players[i] == UINT32_MAX ||
+                  (i && before.players[i - 1] >= before.players[i])
+            : before.players[i] != 0)
+      return false;
+  CoopTransition previous;
+  return decode_coop_transition(
+      {reinterpret_cast<const char *>(before.descriptor),
+       before.descriptor_bytes},
+      previous);
+}
+} // namespace majesty
diff --git a/coop_transition.h b/coop_transition.h
new file mode 100644
index 0000000..650683d
--- /dev/null
+++ b/coop_transition.h
@@ -0,0 +1,239 @@
+#pragma once
+#include "kit/runtime/native_seam.h"
+#include <algorithm>
+#include <array>
+#include <charconv>
+#include <cstddef>
+#include <cstdint>
+#include <cstring>
+#include <string_view>
+
+namespace majesty {
+// Game-owned agreement identity. Never include host paths, guest pointers or
+// local camera/UI state. A relay roster authenticates votes independently.
+// Source bytes identify the host's shared checkpoint, not each client's save.
+struct CoopTransition {
+  std::array<char, 41> world{};
+  std::array<char, 130> content{};
+  std::array<char, 65> rules{}, source_digest{}, target_digest{};
+  int32_t source_x = 0, source_y = 0, target_x = 0, target_y = 0;
+  uint32_t world_seed = 71201, generation = 1, frame = 0, clock = 0;
+  uint64_t source_revision = 0, source_bytes = 0, target_revision = 0,
+           target_bytes = 0;
+  bool target_saved = false;
+  uint32_t target_clock = 0, target_gpl_seed = 0, target_game_seed = 0;
+};
+struct CoopTransitionWire {
+  std::array<char, 1024> bytes{};
+  size_t size = 0;
+  std::string_view view() const { return {bytes.data(), size}; }
+};
+namespace coop_detail {
+template <size_t N> inline std::string_view text(const std::array<char, N> &a) {
+  const auto end = std::find(a.begin(), a.end(), '\0');
+  if (end == a.end() ||
+      std::any_of(end, a.end(), [](char c) { return c != '\0'; }))
+    return {};
+  return {a.data(), size_t(end - a.begin())};
+}
+inline bool digest(std::string_view s) {
+  return s.size() == 64 && std::all_of(s.begin(), s.end(), [](char c) {
+           return (c >= '0' && c <= '9') || (c >= 'a' && c <= 'f');
+         });
+}
+template <size_t N>
+inline bool copy(std::string_view s, std::array<char, N> &a) {
+  if (s.size() >= N)
+    return false;
+  a.fill(0);
+  std::copy(s.begin(), s.end(), a.begin());
+  return true;
+}
+template <class T> inline bool number(std::string_view s, T &out) {
+  if (s.empty())
+    return false;
+  T n{};
+  const auto r = std::from_chars(s.data(), s.data() + s.size(), n);
+  if (r.ec != std::errc{} || r.ptr != s.data() + s.size())
+    return false;
+  char canonical[32];
+  const auto w = std::to_chars(canonical, canonical + sizeof canonical, n);
+  if (w.ec != std::errc{} ||
+      std::string_view(canonical, size_t(w.ptr - canonical)) != s)
+    return false;
+  out = n;
+  return true;
+}
+} // namespace coop_detail
+
+inline bool coop_transition_valid(const CoopTransition &t) {
+  using namespace coop_detail;
+  const auto world = text(t.world), content = text(t.content);
+  if (world.empty() ||
+      !std::all_of(world.begin(), world.end(),
+                   [](char c) {
+                     return (c >= 'a' && c <= 'z') || (c >= '0' && c <= '9') ||
+                            c == '-';
+                   }) ||
+      content.size() != 129 || content[64] != ':' ||
+      !digest(content.substr(0, 64)) || !digest(content.substr(65)) ||
+      !digest(text(t.rules)) || !digest(text(t.source_digest)) ||
+      t.world_seed != 71201 || t.generation != 1 || !t.source_revision ||
+      !t.source_bytes || t.source_bytes > 64u * 1024u * 1024u)
+    return false;
+  for (auto n : {t.source_x, t.source_y, t.target_x, t.target_y})
+    if (n < -1000000 || n > 1000000)
+      return false;
+  const int64_t dx = int64_t(t.target_x) - t.source_x,
+                dy = int64_t(t.target_y) - t.source_y;
+  if ((dx < 0 ? -dx : dx) + (dy < 0 ? -dy : dy) != 1)
+    return false;
+  if (!t.target_saved)
+    return !t.target_revision && !t.target_bytes && !t.target_clock &&
+           !t.target_gpl_seed && !t.target_game_seed &&
+           std::all_of(t.target_digest.begin(), t.target_digest.end(),
+                       [](char c) { return c == 0; });
+  return t.target_revision && t.target_bytes &&
+         t.target_bytes <= 64u * 1024u * 1024u &&
+         digest(text(t.target_digest)) && t.target_gpl_seed &&
+         t.target_game_seed;
+}
+
+// Canonical newline-delimited ASCII fits the provider's non-NUL 1024-byte
+// descriptor. Both encode and decode publish output only after full validation.
+inline bool encode_coop_transition(const CoopTransition &t,
+                                   CoopTransitionWire &out) {
+  out = {};
+  if (!coop_transition_valid(t))
+    return false;
+  CoopTransitionWire w;
+  const auto line = [&](std::string_view s) {
+    if (s.size() + 1 > w.bytes.size() - w.size)
+      return false;
+    std::copy(s.begin(), s.end(), w.bytes.begin() + w.size);
+    w.size += s.size();
+    w.bytes[w.size++] = '\n';
+    return true;
+  };
+  const auto number = [&](auto n) {
+    char b[32];
+    const auto r = std::to_chars(b, b + sizeof b, n);
+    return r.ec == std::errc{} && line({b, size_t(r.ptr - b)});
+  };
+  using coop_detail::text;
+  if (!line("majesty-coop-region-v1") || !line(text(t.world)) ||
+      !number(t.source_x) || !number(t.source_y) || !number(t.target_x) ||
+      !number(t.target_y) || !number(t.world_seed) || !number(t.generation) ||
+      !line(text(t.content)) || !line(text(t.rules)) || !number(t.frame) ||
+      !number(t.clock) || !number(t.source_revision) ||
+      !number(t.source_bytes) || !line(text(t.source_digest)) ||
+      !number(unsigned(t.target_saved)) || !number(t.target_revision) ||
+      !number(t.target_clock) || !number(t.target_bytes) ||
+      !line(t.target_saved ? text(t.target_digest) : "-") ||
+      !number(t.target_gpl_seed) || !number(t.target_game_seed))
+    return false;
+  out = w;
+  return true;
+}
+inline bool decode_coop_transition(std::string_view wire, CoopTransition &out) {
+  out = {};
+  if (wire.empty() || wire.size() > 1024 || wire.back() != '\n' ||
+      wire.find('\0') != wire.npos)
+    return false;
+  std::array<std::string_view, 22> fields{};
+  for (auto &field : fields) {
+    const size_t n = wire.find('\n');
+    if (n == wire.npos)
+      return false;
+    field = wire.substr(0, n);
+    wire.remove_prefix(n + 1);
+  }
+  if (!wire.empty() || fields[0] != "majesty-coop-region-v1")
+    return false;
+  using namespace coop_detail;
+  CoopTransition t;
+  unsigned saved = 0;
+  if (!copy(fields[1], t.world) || !number(fields[2], t.source_x) ||
+      !number(fields[3], t.source_y) || !number(fields[4], t.target_x) ||
+      !number(fields[5], t.target_y) || !number(fields[6], t.world_seed) ||
+      !number(fields[7], t.generation) || !copy(fields[8], t.content) ||
+      !copy(fields[9], t.rules) || !number(fields[10], t.frame) ||
+      !number(fields[11], t.clock) || !number(fields[12], t.source_revision) ||
+      !number(fields[13], t.source_bytes) ||
+      !copy(fields[14], t.source_digest) || !number(fields[15], saved) ||
+      saved > 1 || !number(fields[16], t.target_revision) ||
+      !number(fields[17], t.target_clock) ||
+      !number(fields[18], t.target_bytes) ||
+      !number(fields[20], t.target_gpl_seed) ||
+      !number(fields[21], t.target_game_seed))
+    return false;
+  t.target_saved = saved != 0;
+  if (t.target_saved ? !copy(fields[19], t.target_digest) : fields[19] != "-")
+    return false;
+  if (!coop_transition_valid(t))
+    return false;
+  out = t;
+  return true;
+}
+// A committed relay agreement authorizes one read, not Loaded/resume. The
+// caller separately queries the exact current epoch and validates file bytes.
+inline bool coop_agreement_matches(const recomp_network_barrier_v1 &barrier,
+                                   const recomp_network_session_v1 &party,
+                                   uint32_t serial,
+                                   const CoopTransition &target,
+                                   uint32_t stage) {
+  CoopTransitionWire wire;
+  if (party.host > 1 || !party.local_player ||
+      party.local_player == UINT32_MAX || party.player_count < 2 ||
+      party.player_count > 4 || (stage < 1 || stage > 4))
+    return false;
+  for (uint32_t i = 0; i < 4; ++i)
+    if (i < party.player_count
+            ? !party.players[i] || party.players[i] == UINT32_MAX ||
+                  (i && party.players[i - 1] >= party.players[i])
+            : party.players[i] != 0)
+      return false;
+  return std::binary_search(party.players, party.players + party.player_count,
+                            party.local_player) &&
+         serial && barrier.serial == serial && barrier.stage == stage &&
+         party.player_count >= 2 && party.player_count <= 4 &&
+         barrier.player_count == party.player_count &&
+         std::equal(std::begin(barrier.players), std::end(barrier.players),
+                    std::begin(party.players)) &&
+         encode_coop_transition(target, wire) &&
+         barrier.descriptor_bytes == wire.size &&
+         !std::memcmp(barrier.descriptor, wire.bytes.data(), wire.size);
+}
+// Proposal acknowledgement is separate from load and resume permission. The
+// adapter supplies verified local checkpoint durability and the exact epoch.
+inline bool coop_ready_permission(const recomp_network_barrier_v1 &barrier,
+                                  const recomp_network_session_v1 &party,
+                                  uint32_t serial, const CoopTransition &target,
+                                  bool local_verified) {
+  return local_verified &&
+         coop_agreement_matches(barrier, party, serial, target, 1);
+}
+inline bool coop_committed_read(const recomp_network_barrier_v1 &barrier,
+                                const recomp_network_session_v1 &party,
+                                uint32_t serial, const CoopTransition &target) {
+  return target.target_saved &&
+         coop_agreement_matches(barrier, party, serial, target, 2);
+}
+// Fresh construction has a separate permission from the original file reader.
+// The adapter must additionally retain each member's local source checkpoint
+// and prove the destination has no prior or interrupted save artifacts.
+inline bool coop_committed_generate(const recomp_network_barrier_v1 &barrier,
+                                    const recomp_network_session_v1 &party,
+                                    uint32_t serial, const CoopTransition &target) {
+  return !target.target_saved &&
+         coop_agreement_matches(barrier, party, serial, target, 2);
+}
+inline bool coop_resume_permission(const recomp_network_barrier_v1 &barrier,
+                                   const recomp_network_session_v1 &party,
+                                   uint32_t serial,
+                                   const CoopTransition &target,
+                                   bool local_loaded) {
+  return local_loaded &&
+         coop_agreement_matches(barrier, party, serial, target, 3);
+}
+} // namespace majesty
diff --git a/majesty-cheats.h b/majesty-cheats.h
new file mode 100644
index 0000000..9e4b106
--- /dev/null
+++ b/majesty-cheats.h
@@ -0,0 +1,255 @@
+// Game-thread cheats for the pinned MajestyHD - Old.exe. See docs/browser-cheats.md.
+#pragma once
+#include "mods/mods_internal.h"
+#include "runtime/guest.h"
+#include "runtime/native_seam.h"
+#include "platform/os.h"
+#include <algorithm>
+#include <array>
+#include <cstdio>
+#include <cstring>
+#include <string_view>
+
+namespace majesty_cheats {
+void characters(const PopModApi *api, pop_cpu_v1 *cpu, PopHookInvocation *inv, void *) {
+  static unsigned remaining = 32;
+  if (remaining && gm_valid(cpu->esp, 12)) { --remaining; std::fprintf(stderr, "[cheats-input] character=%u flags=%u\n", rd32(cpu->esp+4), rd32(cpu->esp+8)); }
+  mods_call_next(api, inv, cpu);
+}
+
+// Seven digits fit the original treasury widget without clipping.
+constexpr int32_t gold_floor = 9999999;
+constexpr int32_t hero_level = 1000, levels_per_frame = 32;
+struct State {
+  uint32_t world = 0, owner = 0, last_hero = 0;
+  bool gold = false, levels = false;
+} active;
+
+bool context(uint32_t &world, uint32_t &owner, bool settled = true) {
+  const uint32_t state = rd32(0x006d7670), settings = rd32(0x006d87a0);
+  world = rd32(0x0071c68c);
+  // 00480a56..00480a6c admits the original cheat input through settings+9c.
+  // Keep that switch and refuse a joined network session, including co-op.
+  if (!state || !world || !settings || !gm_valid(state, 0x50) ||
+      !gm_valid(world, 0x18) || !gm_valid(settings, 0xa0) ||
+      (rd32(state) != 3 && rd32(state) != 7) || (settled && rd32(state + 4)) ||
+      !rd32(settings + 0x9c) || recomp_network_session_epoch())
+    return false;
+  owner = rd32(state + 0x24); // Original004169a0 selects this kingdom.
+  return owner < 8 && rd32(world + 4) && gm_valid(rd32(world + 4), 0x88);
+}
+
+// TString: pointer, capacity/encoding flags, length; verified004e4340/004e5530.
+// Accept the same ASCII phrases from either native narrow or wide input.
+bool phrase(uint32_t text, std::array<char, 64> &out) {
+  if (!text || !gm_valid(text, 12)) return false;
+  const uint32_t flags = rd32(text + 4), length = rd32(text + 8),
+                 data = rd32(text), stride = flags & 0x1000000u ? 2u : 1u;
+  if (!length || length > (flags & 0xffffffu) || length >= out.size() || !data ||
+      !gm_valid(data, (length + 1) * stride)) return false;
+  for (uint32_t i = 0; i < length; ++i) {
+    uint32_t ch = stride == 2 ? rd16(data + i * stride) : rd8(data + i);
+    if (!ch || ch > 127) return false;
+    if (ch >= 'A' && ch <= 'Z') ch += 'a' - 'A';
+    out[i] = char(ch);
+  }
+  return (stride == 2 ? rd16(data + length * stride) : rd8(data + length)) == 0;
+}
+
+void input(const PopModApi *api, pop_cpu_v1 *cpu, PopHookInvocation *inv, void *) {
+  static unsigned reports = 0;
+  const char *debug = recomp_env("CHEAT_DEBUG");
+  if (debug && !std::strcmp(debug,"1") && reports++ < 8 && gm_valid(cpu->esp,8)) { const uint32_t p=rd32(cpu->esp+4); if(gm_valid(p,12)) std::fprintf(stderr,"[cheats-input] handler string=%08x flags=%08x length=%u\n",rd32(p),rd32(p+4),rd32(p+8)); }
+  std::array<char, 64> code{};
+  const uint32_t text = gm_valid(cpu->esp, 8) ? rd32(cpu->esp + 4) : 0;
+  if (!phrase(text, code)) { mods_call_next(api, inv, cpu); return; }
+  std::string_view value(code.data());
+  while (!value.empty() && value.front() == ' ') value.remove_prefix(1);
+  while (!value.empty() && value.back() == ' ') value.remove_suffix(1);
+  if (value != "infinite gold" && value != "level 1000") {
+    mods_call_next(api, inv, cpu); return;
+  }
+  uint32_t world = 0, owner = 0;
+  if (!context(world, owner)) { mods_call_next(api, inv, cpu); return; }
+  if (active.world != world || active.owner != owner) active = {world, owner};
+  bool &enabled = value == "infinite gold" ? active.gold : active.levels;
+  // Use a temporary mod allocation only for the original TString setter.
+  // No guest string, actor pointer or hook CPU survives this callback.
+  uint32_t message = 0;
+  const char *reply = value == "infinite gold"
+      ? (enabled ? "Infinite gold disabled." : "Infinite gold enabled.")
+      : (enabled ? "Automatic hero leveling disabled."
+                 : "Heroes will advance to level 1000.");
+  if (mods_guest_alloc(MODS_OWNER_RUNTIME, 64, &message) != POP_OK) {
+    mods_call_next(api, inv, cpu); return;
+  }
+  for (size_t i = 0; i <= std::strlen(reply); ++i) wr8(message + uint32_t(i), reply[i]);
+  uint32_t result = 0;
+  // Runtime-owned callbacks receive the minimal built-in API; its optional
+  // guest_call tail is empty. Initialize the supported hooks API explicitly.
+  PopModApi calls{};
+  mods_fill_hooks_api(&calls);
+  const PopModStatus status = calls.guest_call(&calls, 0x004e3fc0u, text, &message, 1, &result);
+  mods_guest_free(MODS_OWNER_RUNTIME, message);
+  if (status != POP_OK) { mods_call_next(api, inv, cpu); return; }
+  enabled = !enabled;
+  std::fprintf(stderr, "[cheats] %.*s %s owner=%u\n", int(value.size()), value.data(),
+               enabled ? "enabled" : "disabled", owner);
+  // Original00480e00 is thiscall(TString*), returns recognition in EAX, pops4.
+  mods_hook_return(api, cpu, 1, 4);
+}
+
+// The original build-anything flag skips NotBuildable and prerequisite
+// checks. Exclude two internal resources at the construction-list insertion
+// site, without changing their quest definitions, existing actors or saves.
+// 00468c08 passes (out iterator, insertion node, row); the row's TString is
+// followed by its four-byte resource ID at +0c. 00469eb0 returns the iterator
+// and pops twelve bytes. Both layouts are verified in the pinned listings.
+void construction_row(const PopModApi *api, pop_cpu_v1 *cpu,
+                      PopHookInvocation *inv, void *) {
+  if (!gm_valid(cpu->esp, 16) || rd32(cpu->esp) != 0x00468c0du) {
+    mods_call_next(api, inv, cpu); return;
+  }
+  const uint32_t row = rd32(cpu->esp + 12);
+  if (!row || !gm_valid(row, 16)) {
+    mods_call_next(api, inv, cpu); return;
+  }
+  const uint32_t type = rd32(row + 12);
+  // ABA0: placeholder_building (no GPL agent); ABJ4: EvilPalace.
+  if (type != 0x30414241u && type != 0x344a4241u) {
+    mods_call_next(api, inv, cpu); return;
+  }
+  const uint32_t result = rd32(cpu->esp + 4), position = rd32(cpu->esp + 8);
+  if (!result || !position || !gm_valid(result, 4) || !gm_valid(position, 8)) {
+    mods_call_next(api, inv, cpu); return;
+  }
+  wr32(result, position); // A skipped insert leaves the original list intact.
+  mods_hook_return(api, cpu, result, 12);
+}
+
+void install() {
+  static bool attempted = false;
+  if (attempted) return;
+  attempted = true;
+  uint32_t hook = 0;
+  if (mods_hook_install_ex(MODS_OWNER_RUNTIME, 0x00480e00u, 0, input,
+       POP_HOOK_WRAP, POP_HOOK_NO_GAME_VIEW, nullptr, &hook) != POP_OK)
+    std::fprintf(stderr, "[cheats] Native cheat input unavailable\n");
+  else std::fprintf(stderr, "[cheats] Native cheat input installed\n");
+  uint32_t construction_hook = 0;
+  if (mods_hook_install_ex(MODS_OWNER_RUNTIME, 0x00469eb0u, 0, construction_row,
+       POP_HOOK_WRAP, POP_HOOK_NO_GAME_VIEW, nullptr, &construction_hook) != POP_OK)
+    std::fprintf(stderr, "[cheats] Construction safety filter unavailable\n");
+  else std::fprintf(stderr, "[cheats] Construction safety filter installed\n");
+  const char *debug = recomp_env("CHEAT_DEBUG");
+  if (debug && !std::strcmp(debug,"1")) { uint32_t id=0; mods_hook_install_ex(MODS_OWNER_RUNTIME,0x004f4a10u,0,characters,POP_HOOK_WRAP,POP_HOOK_NO_GAME_VIEW,nullptr,&id); }
+}
+
+void refill_gold(X86 *c, uint32_t factory, uint32_t owner) {
+  X86 extra = *c;
+  const uint32_t table = rd32(factory);
+  if (!table || !gm_valid(table, 0x24)) return;
+  extra.r[R_ECX] = factory;
+  const uint32_t player = guest_call(&extra, rd32(table + 0x18), owner);
+  if (!player || !gm_valid(player, 4) || !gm_valid(rd32(player), 0x24)) return;
+  extra.r[R_ECX] = player;
+  const int32_t gold = int32_t(guest_call(&extra, rd32(rd32(player) + 0x20), 0x00505041u));
+  if (gold >= gold_floor) return;
+  // Original FILL THIS BAG00495b94 uses player virtual+1c to adjust APP.
+  // Clamp the delta to signed32; the floor leaves ample headroom for rewards.
+  const int64_t delta = int64_t(gold_floor) - gold;
+  extra.r[R_ECX] = player;
+  guest_call(&extra, rd32(rd32(player) + 0x1c), 0x00505041u,
+             uint32_t(std::min<int64_t>(delta, INT32_MAX)));
+}
+
+int32_t level(X86 *c, uint32_t unit) {
+  X86 extra = *c; extra.r[R_ECX] = unit;
+  // Exact original GROW UP00495dc7..00495dd0: ExperienceLevel type11.
+  return int32_t(guest_call(&extra, 0x005a1c40u, 0x0b565041u, 0u));
+}
+
+void advance(X86 *c, uint32_t unit, int32_t target) {
+  X86 extra = *c;
+  if (extra.r[R_ESP] < STACK_LIMIT + 0x200) return;
+  extra.r[R_ESP] -= 0x100;
+  const uint32_t text = extra.r[R_ESP] + 0x80, script = extra.r[R_ESP] + 0x90;
+  for (uint32_t off = 0x80; off < 0xd0; off += 4) wr32(extra.r[R_ESP] + off, 0);
+  // Reproduce the original GROW UP script invocation00495d7c..00495dfa.
+  // advance_to_level increments levels and HP/stats; it doesn't spawn effects.
+  extra.r[R_ECX] = text; guest_call(&extra, 0x004e3520u, 0x006c0d88u);
+  extra.r[R_ECX] = script; guest_call(&extra, 0x00629910u, text);
+  extra.r[R_ECX] = text; guest_call(&extra, 0x004e3820u);
+  extra.r[R_ECX] = script; guest_call(&extra, 0x00629bf0u);
+  extra.r[R_ECX] = script; guest_call(&extra, 0x00629a20u, unit);
+  extra.r[R_ECX] = script; guest_call(&extra, 0x00629a40u, uint32_t(target));
+  extra.r[R_ECX] = script; guest_call(&extra, 0x00629c40u);
+  extra.r[R_ECX] = script; guest_call(&extra, 0x006299b0u);
+}
+
+void heroes(X86 *c, uint32_t factory, uint32_t owner) {
+  X86 extra = *c; extra.r[R_ECX] = factory;
+  // Original heal cheat00495ce4 visits native group1 through005a10b0.
+  const uint32_t group = guest_call(&extra, 0x005a10b0u, 1u);
+  if (!group || !gm_valid(group, 0x30) || rd32(group + 4) != 1) return;
+  const uint32_t count = rd32(group + 0x18), begin = rd32(group + 0x10),
+                 end = rd32(group + 0x14);
+  if (count > 4096 || !begin || !end || !gm_valid(begin, 4) || !gm_valid(end, 4)) return;
+  uint32_t node = rd32(begin), stop = rd32(end), visited = 0;
+  uint32_t next = 0, next_id = UINT32_MAX, first = 0, first_id = UINT32_MAX;
+  while (node != stop) {
+    if (visited++ >= count || !node || !gm_valid(node, 12)) return;
+    const uint32_t unit = rd32(node + 8);
+    if (!unit || !gm_valid(unit, 0x88) || rd32(unit + 0x84) != factory) return;
+    if (rd32(unit + 0x70) == owner && !(rd32(unit + 0x64) & 4u)) {
+      const uint32_t id = rd32(unit + 0x60);
+      if (id && id < first_id) { first = unit; first_id = id; }
+      if (id > active.last_hero && id < next_id) { next = unit; next_id = id; }
+    }
+    node = rd32(node);
+  }
+  if (visited != count || (!next && !first)) return;
+  if (!next) { next = first; next_id = first_id; }
+  active.last_hero = next_id; // Scalar cursor; actors are reacquired each frame.
+  extra.r[R_ECX] = next;
+  const int32_t hp = int32_t(guest_call(&extra, 0x005a1c40u, 0x00555041u, 0u));
+  const int32_t current = level(c, next);
+  if (hp <= 0 || current < 1 || current >= hero_level ||
+      !guest_call(&extra, 0x004c8ea0u, next)) return;
+  advance(c, next, std::min(hero_level, current + levels_per_frame));
+  // Progression can morph a gnome or run authored class scripts. Reacquire
+  // the actor by its original ID before inspecting the result.
+  if (rd32(0x0071c68c) != active.world || rd32(active.world + 4) != factory) {
+    active = {}; return;
+  }
+  extra.r[R_ECX] = factory;
+  const uint32_t fresh = guest_call(&extra, 0x005a10d0u, next_id);
+  if (!fresh || !gm_valid(fresh, 0x88) || rd32(fresh + 0x84) != factory ||
+      rd32(fresh + 0x70) != owner) return;
+  const int32_t after = level(c, fresh);
+  if (after <= current) {
+    active.levels = false; // A mod that caps levels cannot spin every frame.
+    std::fprintf(stderr, "[cheats] Hero advancement refused; leveling disabled\n");
+  } else if (after >= hero_level)
+    std::fprintf(stderr, "[cheats] Hero %u reached level %d\n", next_id, after);
+}
+
+void observe_phase(uint32_t state) {
+  if ((active.gold || active.levels) && state && gm_valid(state,8) &&
+      rd32(state) != 3 && rd32(state) != 7) active = {};
+}
+
+void tick(X86 *c) {
+  install();
+  if (!active.gold && !active.levels) return;
+  uint32_t world = 0, owner = 0;
+  if (!context(world, owner, false) || active.world != world || active.owner != owner) {
+    active = {}; return;
+  }
+  const uint32_t factory = rd32(world + 4);
+  if (active.gold) refill_gold(c, factory, owner);
+  // Leave a settled native pause untouched. Batches bound interpreter work.
+  const uint32_t state = rd32(0x006d7670);
+  if (active.levels && rd32(state) == 3 && !rd32(state + 4)) heroes(c, factory, owner);
+}
+} // namespace majesty_cheats
diff --git a/native_actor_profile.h b/native_actor_profile.h
new file mode 100644
index 0000000..8cd55e9
--- /dev/null
+++ b/native_actor_profile.h
@@ -0,0 +1,34 @@
+// Original class layouts for unpublished UNIT reads. Pinned DirectDraw only.
+#pragma once
+#include <cstdint>
+
+namespace majesty::actors {
+enum class StageClass : uint32_t { Vehicle, ExploreReward };
+struct StageInput {
+    uint32_t flags, parent, description, player;
+    StageClass object_class = StageClass::Vehicle;
+};
+struct StageProfile {
+    uint32_t kind, bytes, table, components;
+};
+// Profiles are chosen explicitly. Saved component counts and guest pointers
+// never select an arbitrary constructor, size or vtable.
+inline bool stage_profile(const StageInput &input, StageProfile &profile) {
+    profile = {};
+    if ((input.flags & 4) || !input.description || input.player > 8)
+        return false;
+    switch (input.object_class) {
+    case StageClass::Vehicle:
+        profile = {1, 0x164, 0x0068098c, 2};
+        return true;
+    case StageClass::ExploreReward:
+        // Current original crossing flag, with no physical parent. Other
+        // reward classes/states require their own verified restoration profile.
+        if (input.flags != 545 || input.parent || input.description != 0x34415241)
+            return false;
+        profile = {4, 0x150, 0x0068071c, 1};
+        return true;
+    }
+    return false;
+}
+} // namespace majesty::actors
diff --git a/native_actor_stage.cpp b/native_actor_stage.cpp
new file mode 100644
