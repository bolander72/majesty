+      valid, selected));
+  CHECK(read(marker) == committed && store.read().revision == 2);
+  CHECK(os_unlink(slots[0].c_str()) == 0);
+  CHECK(os_mkdir(slots[0].c_str()) == 0);
+  const auto before = writes;
