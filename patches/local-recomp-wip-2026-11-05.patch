new file mode 100644
index 0000000..522ce17
--- /dev/null
+++ b/native_order_hooks.h
@@ -0,0 +1,56 @@
+// Game-owned SDK hook scope for the guarded original UNIT order reader.
+#pragma once
+#include "native_order_allocation.h"
+#include "mods/mods_internal.h"
+
+namespace majesty::orders {
+struct HookTrace {
+    void *context = nullptr;
+    // Nonthrowing/nonallocating; never mutates controller state or calls guest code.
+    void (*allocation)(void *, bool name, const AllocationDecision &) = nullptr;
+};
+class ReaderHooks {
+  public:
+    ReaderHooks(AllocationBridge &bridge, HookTrace trace = {});
+    ReaderHooks(const ReaderHooks &) = delete;
+    ReaderHooks &operator=(const ReaderHooks &) = delete;
+    // Serialized on the reserving thread while holding the guest baton.
+    // Install four runtime-owned wrapping hooks; unrelated calls delegate.
+    // Failed installation removes its prefix;
+    // any failed removal leaves a retained handle and requires explicit retry.
+    bool install();
+    bool remove();
+    // Pinned vehicle or verified Explore reward table/reader sites only.
+    // Reward fields must match its explicit restoration profile.
+    // Native ID (+60) and world (+84)
+    // must both be zero before loading. These are necessary admission checks;
+    // the caller still proves stopped construction and absence of all aliases.
+    BankInvocationResult read_unit(X86 *cpu, uint32_t unit, uint32_t stream,
+                                   const UnitReadPoints &sites);
+    uint32_t installed_count() const;
+    bool hook_failed() const {
+        return hook_failed_;
+    }
+
+  private:
+    struct Binding {
+        ReaderHooks *owner;
+        uint32_t address, handle;
+    };
+    static void callback(const PopModApi *, pop_cpu_v1 *, PopHookInvocation *, void *);
+    void dispatch(uint32_t, pop_cpu_v1 *, PopHookInvocation *);
+    [[noreturn]] void cancel(uint32_t value);
+    void next(pop_cpu_v1 *, PopHookInvocation *);
+    static bool stream_status(uint32_t stream, uint32_t *status);
+    Journal *journal_;
+    AllocationBridge *bridge_;
+    HookTrace trace_;
+    std::array<Binding, 4> bindings_;
+    X86 *cpu_ = nullptr;
+    uint32_t stream_ = 0;
+    bool hook_failed_ = false;
+};
+// No implicit destructor: retain this object and its journal outside skipped
+// guest frames until every handle has been removed. Never release borrowed
+// graph storage before the stopped caller has detached exact UNIT bank fields.
+} // namespace majesty::orders
diff --git a/native_order_payload.h b/native_order_payload.h
new file mode 100644
index 0000000..db47b2f
--- /dev/null
+++ b/native_order_payload.h
@@ -0,0 +1,107 @@
+// Bounded storage admission for the pinned original serialized order banks.
+// Opaque targets/callbacks stay unchanged; this does not authorize actor activation.
+#pragma once
+#include "native_order_storage.h"
+
+namespace majesty::orders {
+constexpr uint32_t MAX_PAYLOAD_BYTES = 64 * 1024;
+constexpr uint32_t MAX_PAYLOAD_ENTRIES = 128;
+struct PayloadEntry {
+    uint32_t bank, index, kind, body_offset, fixed_bytes, count, cursor, capacity;
+};
+struct PayloadPlan {
+    std::array<Request, MAX_REQUESTS> requests{};
+    std::array<PayloadEntry, MAX_PAYLOAD_ENTRIES> entries{};
+    std::array<uint32_t, 3> bank_offsets{}, bank_bytes{}, bank_counts{};
+    uint32_t request_count = 0, entry_count = 0, requested_bytes = 0;
+};
+
+// Fixed host storage, no guest allocations and no input edits. Invalid data
+// leaves an empty plan. All framing/names/capacities are checked before reserve.
+inline bool plan_order_payload(const uint8_t *data, uint32_t bytes, PayloadPlan &out) {
+    out = {};
+    if (!data || bytes < 24 || bytes > MAX_PAYLOAD_BYTES || bytes % 4)
+        return false;
+    PayloadPlan plan;
+    auto word = [&](uint32_t at) {
+        return uint32_t(data[at]) | (uint32_t(data[at + 1]) << 8) |
+               (uint32_t(data[at + 2]) << 16) | (uint32_t(data[at + 3]) << 24);
+    };
+    auto add = [&](Role role, uint32_t bank, uint32_t index, uint32_t kind, uint32_t size) {
+        if (plan.request_count == MAX_REQUESTS || size > MAX_REQUEST_BYTES - plan.requested_bytes)
+            return false;
+        plan.requests[plan.request_count++] = {role, bank, index, kind, size};
+        plan.requested_bytes += size;
+        return true;
+    };
+    for (uint32_t b = 0; b < 3; ++b)
+        if (!add(Role::Bank, b, NO_INDEX, 0, 20) || !add(Role::Head, b, NO_INDEX, 0, 12))
+            return false;
+    uint32_t at = 0;
+    for (uint32_t bank = 0; bank < 3; ++bank) {
+        if (bytes - at < 8 || word(at) != 1)
+            return false;
+        plan.bank_offsets[bank] = at;
+        const uint32_t count = word(at + 4);
+        if (count > MAX_PAYLOAD_ENTRIES - plan.entry_count)
+            return false;
+        plan.bank_counts[bank] = count;
+        at += 8;
+        for (uint32_t index = 0; index < count; ++index) {
+            if (bytes - at < 8 || word(at) != 1)
+                return false;
+            const uint32_t kind = word(at + 4);
+            at += 8;
+            uint32_t fixed = 0, version = 1, object = 0, leaf = NO_INDEX;
+            switch (kind) {
+            case 1: fixed = 132; version = 2; object = 88; break;
+            case 2: fixed = 176; version = 2; object = 92; leaf = 30; break;
+            case 4: fixed = 140; version = 5; object = 100; break;
+            case 5: fixed = 176; object = 92; leaf = 29; break;
+            case 6: fixed = 176; object = 92; leaf = 30; break;
+            case 7: fixed = 112; object = 72; break;
+            case 9: fixed = 96; object = 52; break;
+            case 10: fixed = 120; object = 76; break;
+            case 11: fixed = 200; object = 112; leaf = 30; break;
+            case 12: fixed = 116; object = 72; break; // Frame writer005e38a0.
+            case 13: fixed = 188; object = 100; leaf = 30; break; // Inherited writer005f9460.
+            default: return false;
+            }
+            const bool inherited = kind == 11 || kind == 13;
+            const uint32_t base = inherited ? 2 : 1;
+            if (bytes - at < fixed || word(at) != version ||
+                (inherited && word(at + 4) != 1) || word(at + base * 4) != 1 ||
+                word(at + (base + 1) * 4) != 2 || word(at + (base + 2) * 4) != kind)
+                return false;
+            // Original empty string copier still allocates its one-byte NUL.
+            // Refuse a leading NUL with an opaque nonzero suffix as well.
+            for (uint32_t n = 0; n < 8; ++n)
+                if (word(at + (base + 15 + n) * 4) ||
+                    (leaf != NO_INDEX && word(at + (leaf + 6 + n) * 4)))
+                    return false;
+            PayloadEntry entry{bank, index, kind, at, fixed, 0, 0, 0};
+            if (kind == 4 || kind == 7) {
+                entry.count = word(at + (kind == 4 ? 136 : 108));
+                entry.cursor = word(at + (kind == 4 ? 120 : 100));
+                entry.capacity = kind == 4 ? word(at + 128) : 10;
+                if (entry.capacity > 4096 || entry.count > entry.capacity ||
+                    entry.cursor > entry.count || entry.count > (bytes - at - fixed) / 8)
+                    return false;
+            }
+            if (!add(Role::Order, bank, index, kind, object) ||
+                ((kind == 4 || kind == 7) && !add(Role::Path, bank, index, kind, entry.capacity * 8)) ||
+                !add(Role::BaseName, bank, index, kind, 1) ||
+                (leaf != NO_INDEX && !add(Role::LeafName, bank, index, kind, 1)) ||
+                !add(Role::Node, bank, index, kind, 12))
+                return false;
+            plan.entries[plan.entry_count++] = entry;
+            at += fixed + entry.count * 8;
+        }
+        plan.bank_bytes[bank] = at - plan.bank_offsets[bank];
+    }
+    if (at != bytes)
+        return false;
+    out = plan;
+    return true;
+}
+} // namespace majesty::orders
diff --git a/native_order_storage.cpp b/native_order_storage.cpp
new file mode 100644
index 0000000..c16ed52
--- /dev/null
+++ b/native_order_storage.cpp
@@ -0,0 +1,296 @@
+#include "native_order_storage.h"
+#include "runtime/memory.h"
+#include "platform/os.h"
+
+namespace majesty::orders {
+namespace {
+uint32_t allocate_heap(void *, uint32_t bytes) {
+    return heap_alloc(bytes, false);
+}
+bool free_heap(void *, uint32_t address, uint32_t) {
+    return heap_free(address);
+}
+uint32_t object_bytes(uint32_t kind) {
+    switch (kind) {
+    case 1:
+        return 88;
+    case 2:
+    case 5:
+    case 6:
+        return 92;
+    case 4:
+    case 13:
+        return 100;
+    case 7:
+    case 12:
+        return 72;
+    case 9:
+        return 52; // Pinned base-only command constructor005df030.
+    case 10:
+        return 76;
+    case 11:
+        return 112;
+    default:
+        return 0;
+    }
+}
+bool same_key(const Request &a, const Request &b) {
+    return a.role == b.role && a.bank == b.bank && a.index == b.index;
+}
+bool same(const Request &a, const Request &b) {
+    return same_key(a, b) && a.kind == b.kind && a.bytes == b.bytes;
+}
+bool tagged(const Request &r, Role role, const Request &order) {
+    return r.role == role && r.bank == order.bank && r.index == order.index && r.kind == order.kind;
+}
+} // namespace
+
+MemoryPort heap_port() {
+    return {nullptr, allocate_heap, free_heap};
+}
+bool Journal::owner_thread() const {
+    return thread_ == uint64_t(os_thread_self());
+}
+bool Journal::validate(const Request *rows, uint32_t n, bool native_names) {
+    if (!rows || n < 6 || n > (native_names ? MAX_REQUESTS : MAX_MODEL_REQUESTS))
+        return false;
+    uint64_t bytes = 0;
+    for (uint32_t i = 0; i < n; ++i) {
+        bytes += rows[i].bytes;
+        if (bytes > MAX_REQUEST_BYTES)
+            return false;
+    }
+    for (uint32_t i = 0; i < 6; ++i) {
+        const Request &r = rows[i];
+        if (r.role != (i % 2 ? Role::Head : Role::Bank) || r.bank != i / 2 || r.index != NO_INDEX ||
+            r.kind || r.bytes != (i % 2 ? 12u : 20u))
+            return false;
+    }
+    uint32_t entries = 0, next[3] = {}, last_bank = 0;
+    for (uint32_t i = 6; i < n;) {
+        const Request &order = rows[i++];
+        if (order.role != Role::Order || order.bank >= 3 || order.bank < last_bank ||
+            order.index != next[order.bank]++ || !object_bytes(order.kind) ||
+            order.bytes != object_bytes(order.kind) || ++entries > 128)
+            return false;
+        last_bank = order.bank;
+        if (order.kind == 4 || order.kind == 7) {
+            if (i == n || !tagged(rows[i], Role::Path, order))
+                return false;
+            uint32_t path = rows[i++].bytes;
+            if ((order.kind == 7 && path != 80) || (order.kind == 4 && (path % 8 || path > 32768)))
+                return false;
+        }
+        if (native_names) {
+            if (i == n || !tagged(rows[i], Role::BaseName, order) || rows[i++].bytes != 1)
+                return false;
+            if (order.kind == 2 || order.kind == 5 || order.kind == 6 || order.kind == 11 ||
+                order.kind == 13)
+                if (i == n || !tagged(rows[i], Role::LeafName, order) || rows[i++].bytes != 1)
+                    return false;
+        }
+        if (i == n || !tagged(rows[i], Role::Node, order) || rows[i++].bytes != 12)
+            return false;
+    }
+    return true;
+}
+bool Journal::reserve(const Request *rows, uint32_t n, MemoryPort port, bool native_names) {
+    if (pinned_ ||
+        (state_ != State::Empty && state_ != State::Released && state_ != State::Transferred) ||
+        !port.allocate || !port.free || revision_ == UINT64_MAX || !validate(rows, n, native_names))
+        return false;
+    ++revision_;
+    thread_ = uint64_t(os_thread_self());
+    port_ = port;
+    count_ = n;
+    native_names_ = native_names;
+    cleanup_started_ = cleanup_active_ = false;
+    pending_free_ = NO_INDEX;
+    violation_ = false;
+    untrusted_address_ = untrusted_bytes_ = 0;
+    for (uint32_t i = 0; i < n; ++i)
+        blocks_[i] = {rows[i], 0, false, false};
+    // Copy every descriptor before calling the port. Later mutation of caller
+    // input must not change the journal's identity or release sizes.
+    state_ = State::CleanupPending;
+    for (uint32_t i = 0; i < n; ++i) {
+        Block &b = blocks_[i];
+        if (!b.request.bytes)
+            continue;
+        uint32_t address = port_.allocate(port_.context, b.request.bytes);
+        if (!address) {
+            release();
+            return false;
+        }
+        bool valid = !(address % 4) &&
+                     uint64_t(address) + b.request.bytes <= UINT64_C(0x100000000) &&
+                     gm_valid(address, b.request.bytes);
+        for (uint32_t j = 0; valid && j < i; ++j) {
+            const Block &old = blocks_[j];
+            if (old.owned && address < uint64_t(old.address) + old.request.bytes &&
+                old.address < uint64_t(address) + b.request.bytes)
+                valid = false;
+        }
+        if (!valid) {
+            violation_ = true;
+            untrusted_address_ = address;
+            untrusted_bytes_ = b.request.bytes;
+            // Never guess that an invalid/overlapping returned extent can be
+            // freed. Retain its identity and clean only the trusted prefix.
+            release();
+            return false;
+        }
+        b.address = address;
+        b.owned = true;
+    }
+    state_ = State::Reserved;
+    return true;
+}
+const Block *Journal::find(Role role, uint32_t bank, uint32_t index) const {
+    if (!owner_thread())
+        return nullptr;
+    for (uint32_t i = 0; i < count_; ++i) {
+        const Block &b = blocks_[i];
+        if (b.request.role == role && b.request.bank == bank && b.request.index == index)
+            return &b;
+    }
+    return nullptr;
+}
+bool Journal::claim(const Request &r, uint32_t *address) {
+    if (!address || state_ != State::Reserved || cleanup_started_ || !owner_thread() ||
+        (pinned_ && !eligible_cookie()))
+        return false;
+    for (uint32_t i = 0; i < count_; ++i) {
+        Block &b = blocks_[i];
+        if (same_key(b.request, r)) {
+            if (!same(b.request, r) || b.claimed)
+                return false;
+            b.claimed = true;
+            *address = b.address;
+            return true;
+        }
+    }
+    return false;
+}
+bool Journal::fully_claimed() const {
+    if (state_ != State::Reserved || cleanup_started_ || !owner_thread())
+        return false;
+    for (uint32_t i = 0; i < count_; ++i)
+        if (!blocks_[i].claimed)
+            return false;
+    return true;
+}
+GuestCallGuardedResult Journal::invoke(X86 *cpu, uint32_t fn, const uint32_t *args, int nargs) {
+    return invoke_checked(cpu, fn, args, nargs, false);
+}
+GuestCallGuardedResult Journal::invoke_cleanup(X86 *cpu, uint32_t fn, const uint32_t *args,
+                                               int nargs) {
+    return invoke_checked(cpu, fn, args, nargs, true);
+}
+GuestCallGuardedResult Journal::invoke_checked(X86 *cpu, uint32_t fn, const uint32_t *args,
+                                               int nargs, bool cleanup) {
+    if (pinned_ || state_ != State::Reserved || !owner_thread() || (!cleanup && cleanup_started_) ||
+        (cleanup && !cleanup_started_ && !fully_claimed()))
+        return {0, GuestCallGuardedStatus::InvalidCall};
+    bool started = cleanup_started_;
+    cleanup_active_ = cleanup;
+    cleanup_started_ = started || cleanup;
+    cpu_ = cpu;
+    cookie_ = 0;
+    pinned_ = true;
+    auto result = guest_call_guarded(cpu, fn, args, nargs, &cookie_);
+    if (result.status == GuestCallGuardedStatus::InvalidCall)
+        cleanup_started_ = started; // no guest instruction or port call ran
+    if (pending_free_ != NO_INDEX) {
+        // A cancellation skipped the port's definitive return. Do not guess
+        // whether it freed before stopping, and never attempt a second free.
+        Block &b = blocks_[pending_free_];
+        untrusted_address_ = b.address;
+        untrusted_bytes_ = b.request.bytes;
+        b.owned = false; // untrusted extent stays explicit for reconciliation
+        violation_ = true;
+        state_ = State::AllocatorViolation;
+        pending_free_ = NO_INDEX;
+    }
+    // Original nonlocal exits that bypass this return leave the journal pinned
+    // and fail closed. They need separate graph/lifetime qualification.
+    pinned_ = false;
+    cpu_ = nullptr;
+    cookie_ = 0;
+    cleanup_active_ = false;
+    return result;
+}
+bool Journal::retire(const Request &request, uint32_t address) {
+    if (!address || state_ != State::Reserved || !cleanup_active_ || !eligible_cookie() ||
+        pending_free_ != NO_INDEX)
+        return false;
+    for (uint32_t i = 0; i < count_; ++i) {
+        Block &b = blocks_[i];
+        if (!same(b.request, request) || !b.owned || !b.claimed || b.address != address)
+            continue;
+        pending_free_ = i;
+        bool freed = port_.free(port_.context, address, b.request.bytes);
+        pending_free_ = NO_INDEX;
+        if (!freed)
+            return false;
+        b.owned = false;
+        b.address = 0;
+        return true;
+    }
+    return false;
+}
+uint64_t Journal::eligible_cookie() const {
+    return owner_thread() && pinned_ && cookie_ && guest_call_guarded_cookie(cpu_) == cookie_
+               ? cookie_
+               : 0;
+}
+bool Journal::invocation_active() const {
+    return owner_thread() && pinned_ && cookie_ && guest_call_guarded_active(cpu_, cookie_);
+}
+bool Journal::release() {
+    if (state_ == State::Empty)
+        return true;
+    if (pinned_ || !owner_thread())
+        return false;
+    if (state_ == State::Empty || state_ == State::Released || state_ == State::Transferred)
+        return true;
+    bool complete = true;
+    for (uint32_t i = count_; i-- > 0;) {
+        Block &b = blocks_[i];
+        if (!b.owned)
+            continue;
+        if (port_.free(port_.context, b.address, b.request.bytes)) {
+            b.owned = false;
+            b.address = 0;
+        } else {
+            complete = false;
+        }
+    }
+    state_ = violation_ ? State::AllocatorViolation
+             : complete ? State::Released
+                        : State::CleanupPending;
+    return complete && !violation_;
+}
+bool Journal::transfer_to_owner() {
+    if (pinned_ || pending_free_ != NO_INDEX || violation_ || !fully_claimed())
+        return false;
+    for (uint32_t i = 0; i < count_; ++i)
+        if (blocks_[i].request.bytes && !blocks_[i].owned)
+            return false;
+    // Atomic with respect to the serialized caller: no callbacks, allocation,
+    // guest instruction or free can intervene while ownership changes.
+    for (uint32_t i = 0; i < count_; ++i)
+        blocks_[i].owned = false;
+    state_ = State::Transferred;
+    return true;
+}
+uint32_t Journal::owned_request_bytes() const {
+    if (!owner_thread())
+        return 0;
+    uint32_t bytes = 0;
+    for (uint32_t i = 0; i < count_; ++i)
+        if (blocks_[i].owned)
+            bytes += blocks_[i].request.bytes;
+    return bytes;
+}
+} // namespace majesty::orders
diff --git a/native_order_storage.h b/native_order_storage.h
new file mode 100644
index 0000000..e2deb16
--- /dev/null
+++ b/native_order_storage.h
@@ -0,0 +1,102 @@
+// Fixed-capacity ownership of unpublished initial order-bank storage.
+// No actor publication or implicit RAII cleanup. Checked destruction may retire extents.
+#pragma once
+#include "runtime/guest.h"
+#include <array>
+#include <cstdint>
+
+namespace majesty::orders {
+constexpr uint32_t NO_INDEX = UINT32_MAX;
+constexpr uint32_t MAX_MODEL_REQUESTS = 390; // controlled name helpers only
+constexpr uint32_t MAX_REQUESTS = 518;       // 6 baseline + 4 * 128 native-name entries
+constexpr uint32_t MAX_REQUEST_BYTES = 64 * 1024;
+enum class Role : uint32_t { Bank, Head, Order, Path, Node, BaseName, LeafName };
+struct Request {
+    Role role;
+    uint32_t bank, index, kind, bytes;
+};
+struct Block {
+    Request request;
+    uint32_t address;
+    bool owned, claimed;
+};
+// Nonthrowing primitives: allocate returns a unique owned guest extent or
+// zero without allocating. A false free leaves that extent owned. Host
+// pointers must never be returned as guest offsets.
+struct MemoryPort {
+    void *context;
+    uint32_t (*allocate)(void *, uint32_t);
+    bool (*free)(void *, uint32_t, uint32_t);
+};
+MemoryPort heap_port();
+enum class State { Empty, Reserved, CleanupPending, Released, AllocatorViolation, Transferred };
+
+class Journal {
+  public:
+    // native_names=false is the older controlled-helper profile, NOT a complete
+    // allocation budget for the original empty-name copier. Native names require
+    // one byte per string and typed descriptors before each list node.
+    bool reserve(const Request *requests, uint32_t count, MemoryPort port,
+                 bool native_names = true);
+    bool claim(const Request &request, uint32_t *address);
+    const Block *find(Role role, uint32_t bank, uint32_t index = NO_INDEX) const;
+    bool fully_claimed() const;
+    // Own the cookie and pin extents for the entire checked invocation. An
+    // ordinary nested callback can hide eligibility but cannot unpin storage.
+    GuestCallGuardedResult invoke(X86 *cpu, uint32_t fn, const uint32_t *args, int nargs);
+    // Irreversibly enter cleanup after all claims. The caller must qualify the
+    // graph/destructor; this API supplies ownership and guard authority only.
+    GuestCallGuardedResult invoke_cleanup(X86 *cpu, uint32_t fn, const uint32_t *args, int nargs);
+    bool retire(const Request &request, uint32_t address);
+    uint64_t eligible_cookie() const;
+    bool invocation_active() const;
+    bool cleanup_started() const {
+        return cleanup_started_;
+    }
+    // Reclaims only journal-owned extents. In Transferred state success means
+    // no journal ownership remains; it does not prove engine reclamation.
+    bool release();
+    State state() const {
+        return state_;
+    }
+    uint32_t count() const {
+        return count_;
+    }
+    bool reserves_names() const {
+        return native_names_;
+    }
+    uint32_t owned_request_bytes() const;
+    uint32_t untrusted_address() const {
+        return untrusted_address_;
+    }
+    uint32_t untrusted_bytes() const {
+        return untrusted_bytes_;
+    }
+
+  private:
+    friend class AllocationBridge;
+    friend class ReaderHooks;
+    // Only the successful UNIT reader's controller may relinquish the entire
+    // graph. No port free runs; the qualified original owner now frees it.
+    bool transfer_to_owner();
+    bool owner_thread() const;
+    static bool validate(const Request *, uint32_t, bool native_names);
+    GuestCallGuardedResult invoke_checked(X86 *, uint32_t, const uint32_t *, int, bool cleanup);
+    std::array<Block, MAX_REQUESTS> blocks_{};
+    MemoryPort port_{};
+    uint32_t count_ = 0, untrusted_address_ = 0, untrusted_bytes_ = 0;
+    uint32_t pending_free_ = NO_INDEX;
+    uint64_t thread_ = 0;
+    X86 *cpu_ = nullptr;
+    uint64_t cookie_ = 0;
+    uint64_t revision_ = 0; // binds controllers to one reservation, never wraps
+    State state_ = State::Empty;
+    bool pinned_ = false, violation_ = false;
+    bool native_names_ = false;
+    bool cleanup_started_ = false, cleanup_active_ = false;
+};
+// Caller serializes access on the reserving host thread and retains this
+// journal outside every frame that a guest longjmp can skip. Release proves
+// reclamation of journal-owned extents only, not graph rollback or original nonlocal
+// exits. Allocator violations remain latched for external reconciliation.
+} // namespace majesty::orders
diff --git a/native_received_checkpoint.cpp b/native_received_checkpoint.cpp
new file mode 100644
index 0000000..a50a0a9
--- /dev/null
+++ b/native_received_checkpoint.cpp
@@ -0,0 +1,110 @@
+#include "native_received_checkpoint.h"
+#include "platform/os.h"
+#include <cstdio>
+#include <cstring>
+
+namespace majesty {
+ReceivedCheckpoint::~ReceivedCheckpoint() { abort(); }
+
+bool ReceivedCheckpoint::begin(const char *destination, uint32_t original_crc) {
+  // An overlapping BEGIN must not discard the first transfer's state. The
+  // receiver can reject the session explicitly rather than accepting DATA
+  // against another filename/checksum.
+  if (active() || !destination || !*destination)
+    return false;
+  const size_t size = std::strlen(destination);
+  if (size >= destination_.size() ||
+      size + sizeof ".incoming-XXXXXX" > staging_.size())
+    return false;
+  OsStat st{};
+  if (os_lstat(destination, &st) == 0 && (!st.is_regular || st.is_symlink))
+    return false;
+  std::memcpy(destination_.data(), destination, size + 1);
+  std::snprintf(staging_.data(), staging_.size(), "%s.incoming-XXXXXX",
+                destination);
+  // Exclusive sibling creation keeps both files on the same volume. A stale
+  // stage is never selected on restart and is never reused or truncated.
+  fd_ = os_mkstemp(staging_.data());
+  if (fd_ < 0) {
+    destination_[0] = staging_[0] = 0;
+    return false;
+  }
+  crc_ = original_crc;
+  sequence_ = 0;
+  bytes_ = 0;
+  return true;
+}
+
+bool ReceivedCheckpoint::append(uint32_t sequence, const void *data,
+                                size_t size) {
+  if (!active())
+    return false;
+  if (sequence != sequence_ || !data || !size || size > max_packet ||
+      size > max_bytes - bytes_ ||
+      os_fd_write(fd_, data, size) != int64_t(size)) {
+    abort();
+    return false;
+  }
+  bytes_ += size;
+  ++sequence_;
+  return true;
+}
+
+bool ReceivedCheckpoint::finish() {
+  if (!active())
+    return false;
+  if (!bytes_ || os_fd_fsync(fd_) != 0 ||
+      os_fd_seek(fd_, 0, OS_SEEK_SET) != 0) {
+    abort();
+    return false;
+  }
+  // Same reflected CRC-32 as pinned 00512b90: initial/final complement,
+  // polynomial edb88320. Re-read the actual file, rather than trusting bytes
+  // received in memory. At most one 4 KiB scratch span is retained.
+  std::array<uint8_t, max_packet> buffer{};
+  uint32_t crc = 0xffffffffu;
+  uint64_t read = 0;
+  for (;;) {
+    const int64_t count = os_fd_read(fd_, buffer.data(), buffer.size());
+    if (count < 0 || uint64_t(count) > bytes_ - read) {
+      abort();
+      return false;
+    }
+    if (!count)
+      break;
+    read += uint64_t(count);
+    for (int64_t i = 0; i < count; ++i) {
+      crc ^= buffer[size_t(i)];
+      for (unsigned bit = 0; bit < 8; ++bit)
+        crc = (crc >> 1) ^ ((crc & 1) ? 0xedb88320u : 0);
+    }
+  }
+  if (read != bytes_ || ~crc != crc_) {
+    abort();
+    return false;
+  }
+  const int fd = fd_;
+  fd_ = -1;
+  if (os_fd_close(fd) != 0 ||
+      os_rename(staging_.data(), destination_.data()) != 0) {
+    abort();
+    return false;
+  }
+  // Publication is one replacement operation. Until this succeeds, the
+  // previous checkpoint stays untouched. Directory power-loss durability
+  // and browser OPFS replacement still need independent qualification.
+  destination_[0] = staging_[0] = 0;
+  return true;
+}
+
+void ReceivedCheckpoint::abort() {
+  if (fd_ >= 0)
+    os_fd_close(fd_);
+  fd_ = -1;
+  if (staging_[0])
+    os_unlink(staging_.data());
+  destination_[0] = staging_[0] = 0;
+  crc_ = sequence_ = 0;
+  bytes_ = 0;
+}
+} // namespace majesty
diff --git a/native_received_checkpoint.h b/native_received_checkpoint.h
new file mode 100644
index 0000000..d122ef4
--- /dev/null
+++ b/native_received_checkpoint.h
@@ -0,0 +1,35 @@
+#pragma once
+#include <array>
+#include <cstddef>
+#include <cstdint>
+
+namespace majesty {
+// A stopped incoming save, kept beside its destination until its original
+// FILE_BEGIN CRC and DATA sequence have been verified. The caller must supply
+// a path admitted by the writable profile resolver, never an original asset,
+// and exclude other writers for the entire transfer and publication.
+// This writer does not coordinate peers or change a running kingdom.
+class ReceivedCheckpoint {
+public:
+  static constexpr uint64_t max_bytes = 64 * 1024 * 1024;
+  static constexpr size_t max_packet = 4096;
+  ReceivedCheckpoint() = default;
+  ~ReceivedCheckpoint();
+  ReceivedCheckpoint(const ReceivedCheckpoint &) = delete;
+  ReceivedCheckpoint &operator=(const ReceivedCheckpoint &) = delete;
+  bool begin(const char *destination, uint32_t original_crc);
+  bool append(uint32_t sequence, const void *data, size_t size);
+  bool finish();
+  void abort();
+  bool active() const { return fd_ >= 0; }
+  uint64_t bytes() const { return bytes_; }
+  const char *staging_path() const { return staging_.data(); }
+
+private:
+  std::array<char, 1024> destination_{};
+  std::array<char, 1024> staging_{};
+  int fd_ = -1;
+  uint32_t crc_ = 0, sequence_ = 0;
+  uint64_t bytes_ = 0;
+};
+} // namespace majesty
diff --git a/native_received_transfer.cpp b/native_received_transfer.cpp
new file mode 100644
index 0000000..0a482af
--- /dev/null
+++ b/native_received_transfer.cpp
@@ -0,0 +1,239 @@
+// Opt-in staged receiver for the pinned original FILE_BEGIN/DATA/END ABI.
+// Packet getters, owning strings and filename resolution remain original calls.
+// The outer 00456670 dispatcher retains sole packet destruction ownership.
+#include "native_received_transfer.h"
+#include "game_config.h"
+#include "native_received_checkpoint.h"
+#include "platform/os.h"
+#include "runtime/native_seam.h"
+#include <array>
+#include <cstdio>
+#include <cstring>
+
+namespace {
+struct Transfer {
+  majesty::ReceivedCheckpoint writer;
+  uint64_t epoch = 0;
+  uint32_t sender = 0;
+  bool failed = false;
+  void reject(const char *reason) {
+    writer.abort();
+    const bool first = !failed;
+    if (first)
+      std::fprintf(stderr, "[resume] Received checkpoint rejected: %s\n",
+                   reason);
+    failed = true;
+    if (recomp_network_reject_session(epoch) && first) {
+      // Category-3/kind-2 session loss only logs at original 0045523c.
+      // Request the lobby's normal leave path after its queue has drained;
+      // resetting its manager inside a packet callback would invalidate live
+      // references. A stale epoch or ordinary COM Close cannot set this flag.
+      wr32(RECOMP_GLOBAL_MULTIPLAYER_LOBBY_EXIT_ADDR, 1);
+    }
+  }
+  bool sync() {
+    const uint64_t current = recomp_network_session_epoch();
+    if (current && current != epoch) {
+      writer.abort();
+      epoch = current;
+      sender = 0;
+      failed = false;
+    } else if (!current && writer.active())
+      reject("session ended before checkpoint publication");
+    else if (!current && epoch && !failed &&
+             recomp_network_reject_session(epoch))
+      // This exact-epoch check also distinguishes natural loss after a
+      // completed transfer from normal Close or an already replaced session.
+      // Rejection is idempotent; reject() then requests original lobby exit.
+      reject("session connection lost");
+    return current && current == epoch && !failed;
+  }
+};
+Transfer transfer;
+
+struct Packet {
+  X86 extra;
+  uint32_t object = 0, table = 0, scratch = 0;
+  explicit Packet(X86 *cpu) : extra(*cpu) {
+    const uint32_t sp = cpu->r[R_ESP];
+    if (sp < 32768 || !gm_valid(sp, 8) || !gm_valid(sp - 32768, 32768))
+      return;
+    object = rd32(sp + 4);
+    if (!object || !gm_valid(object, 0x4c)) {
+      object = 0;
+      return;
+    }
+    table = rd32(object);
+    if (!table || !gm_valid(table, 0x44)) {
+      object = 0;
+      return;
+    }
+    scratch = sp - 16384;
+    extra.r[R_ESP] -= 32768;
+  }
+  uint32_t type() {
+    extra.r[R_ECX] = object;
+    return guest_call(&extra, rd32(table + 0x40));
+  }
+  uint32_t category() {
+    extra.r[R_ECX] = object;
+    return guest_call(&extra, rd32(table + 0x24));
+  }
+  uint32_t sender() {
+    // The original transport assigns the source reference through packet +4;
+    // its getter is virtual +8. The source player's virtual +10 returns its
+    // DirectPlay ID (the upper network layer uses the same getter at 0058964a).
+    // Packet +48 is rewritten by 004546e0 with the manager's protocol word.
+    extra.r[R_ECX] = object;
+    const uint32_t reference = guest_call(&extra, rd32(table + 8));
+    if (!reference || !gm_valid(reference, 8))
+      return 0;
+    const uint32_t source = rd32(reference);
+    if (!source || !gm_valid(source, 4))
+      return 0;
+    const uint32_t source_table = rd32(source);
+    if (!source_table || !gm_valid(source_table, 0x14))
+      return 0;
+    extra.r[R_ECX] = source;
+    return guest_call(&extra, rd32(source_table + 0x10));
+  }
+  uint32_t body(uint32_t &length) {
+    wr32(scratch, 0xffffffffu);
+    extra.r[R_ECX] = object;
+    const uint32_t data = guest_call(&extra, rd32(table + 0x38), scratch);
+    length = rd32(scratch);
+    return data;
+  }
+  bool destination(uint32_t body, char *out, size_t cap) {
+    // BEGIN contains one CRC word followed by 80 UTF-16 code units. Bound
+    // the owning constructor's terminator before calling it on borrowed data.
+    bool terminated = false;
+    for (unsigned i = 0; i < 80; ++i)
+      if (!rd16(body + 4 + i * 2)) {
+        terminated = i != 0;
+        break;
+      }
+    if (!terminated)
+      return false;
+    const uint32_t name = scratch + 32, path = scratch + 48;
+    extra.r[R_ECX] = name;
+    guest_call(&extra, 0x004e3430, body + 4);
+    extra.r[R_ECX] = path;
+    guest_call(&extra, 0x004e3340);
+    const uint32_t manager = guest_call(&extra, 0x00435d00);
+    bool accepted = false;
+    if (manager && gm_valid(manager, 4) && gm_valid(rd32(manager), 0x50)) {
+      extra.r[R_ECX] = manager;
+      guest_call(&extra, rd32(rd32(manager) + 0x4c), path, name);
+      const uint32_t text = rd32(path), length = rd32(path + 8);
+      const bool wide = (rd32(path + 4) & 0x01000000u) != 0;
+      if (text && length && length <= 512 &&
+          gm_valid(text, (length + 1) * (wide ? 2 : 1))) {
+        const std::string guest =
+            wide ? gm_wstr(text, length) : gm_str(text, length);
+        accepted =
+            !guest.empty() && recomp_writable_path(guest.c_str(), out, cap);
+      }
+    }
+    extra.r[R_ECX] = path;
+    guest_call(&extra, 0x004e3820);
+    extra.r[R_ECX] = name;
+    guest_call(&extra, 0x004e3820);
+    return accepted;
+  }
+};
+} // namespace
+
+bool majesty_received_transfer_enabled() {
+  static const bool enabled = [] {
+    const char *flag = recomp_env("BROWSER_RECEIVED_CHECKPOINT");
+    return flag && !std::strcmp(flag, "staged-v1");
+  }();
+  return enabled;
+}
+void majesty_received_transfer_poll() {
+  if (majesty_received_transfer_enabled())
+    transfer.sync();
+}
+bool majesty_received_transfer_blocks_dispatch(X86 *cpu) {
+  if (!majesty_received_transfer_enabled())
+    return false;
+  transfer.sync();
+  if (transfer.failed) {
+    // Category 0x100 is the original gameplay/file packet. Category 3 carries
+    // system notifications, including the session loss queued by rejection.
+    // Let those reach the original notification handler and outer packet
+    // destructor. The lobby exit flag separately requests room teardown.
+    Packet packet(cpu);
+    return !packet.object || packet.category() == 0x100;
+  }
+  if (transfer.writer.active()) {
+    Packet packet(cpu);
+    if (!packet.object || (packet.category() == 0x100 && packet.type() == 3)) {
+      transfer.reject("game start before checkpoint publication");
+      return true;
+    }
+  }
+  return false;
+}
+void majesty_received_transfer_packet(X86 *cpu) {
+  // Configured entry is cdecl RET, with packet cleanup in its caller. Neither
+  // successful nor rejected receives delete a packet or modify its payload.
+  const uint32_t sp = cpu->r[R_ESP];
+  if (!gm_valid(sp, 4)) {
+    transfer.reject("invalid receiver stack");
+    return;
+  }
+  auto complete = [&] {
+    cpu->eip = rd32(sp);
+    cpu->r[R_ESP] = sp + 4;
+  };
+  if (!transfer.sync()) {
+    transfer.reject("no current joined session");
+    complete();
+    return;
+  }
+  Packet packet(cpu);
+  if (!packet.object) {
+    transfer.reject("invalid packet object");
+    complete();
+    return;
+  }
+  const uint32_t type = packet.type();
+  uint32_t length = 0;
+  const uint32_t data = packet.body(length);
+  const uint32_t sender = packet.sender();
+  if (!sender || length > majesty::ReceivedCheckpoint::max_packet + 4 ||
+      (length && (!data || !gm_valid(data, length)))) {
+    transfer.reject("invalid packet payload");
+  } else if (type == 0x16) {
+    std::array<char, 1024> destination{};
+    if (length != 164 || transfer.writer.active() ||
+        !packet.destination(data, destination.data(), destination.size()) ||
+        !transfer.writer.begin(destination.data(), rd32(data)))
+      transfer.reject("checkpoint BEGIN unavailable");
+    else {
+      transfer.sender = sender;
+      std::fprintf(stderr, "[resume] Received checkpoint BEGIN staged\n");
+    }
+  } else if (!transfer.writer.active() || sender != transfer.sender) {
+    transfer.reject("checkpoint DATA/END outside its transfer");
+  } else if (type == 0x17) {
+    if (length <= 4 ||
+        !transfer.writer.append(rd32(data), g_mem + data + 4, length - 4))
+      transfer.reject("checkpoint DATA sequence or write failed");
+  } else if (type == 0x18) {
+    const uint64_t bytes = transfer.writer.bytes();
+    if (length || !transfer.writer.finish())
+      transfer.reject("checkpoint END verification or publication failed");
+    else {
+      recomp_invalidate_file_paths();
+      transfer.sender = 0;
+      std::fprintf(stderr,
+                   "[resume] Received checkpoint END committed bytes=%llu\n",
+                   static_cast<unsigned long long>(bytes));
+    }
+  } else
+    transfer.reject("unsupported checkpoint packet");
+  complete();
+}
