+          "\"},{\"size\":" + std::to_string(p.source_size) + ",\"sha256\":\"" + p.source_digest + "\"}]";
+      accepted = marker == expected && loader_hash_file((p.directory + "/Frontier_Revision.checkpoint").c_str()) == lines[2] &&
+          loader_hash_file(state_path.c_str()) == lines[4] &&
