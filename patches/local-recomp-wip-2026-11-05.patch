+        agents[i] = guest_call(&extra, 0x006236b0u, ids[i]);
+        if (!gm_valid(agents[i], 0x34) || rd32(agents[i] + 0x10) != ids[i] ||
+            rd8(agents[i] + 0x28) || rd32(agents[i] + 0x20) != (i ? 0u : 469u))
+            std::abort();
