new file mode 100644
index 0000000..cdca023
--- /dev/null
+++ b/campaign_objective.h
@@ -0,0 +1,36 @@
+#pragma once
+#include <array>
+#include <cstdint>
+
+namespace majesty {
+// One replicated-state observation, with no retained actors or tick history.
+// Owners are playable network slots, not DirectPlay connection identifiers.
+struct CampaignObjective {
+  int chapter = 0;
+  int participants = 0;
+  std::array<uint32_t, 4> owners{};
+  std::array<int32_t, 4> gold{};
+  std::array<uint32_t, 4> buildings{};
+  bool buildings_readable = false;
+};
+
+inline int32_t campaign_gold_target(int chapter) {
+  return chapter == 2 ? 30100 : chapter == 3 ? 35000 : chapter == 4 ? 25000 : 0;
+}
+
+inline bool campaign_objective_ready(const CampaignObjective &state) {
+  const int32_t target = campaign_gold_target(state.chapter);
+  if (!target || state.participants < 2 || state.participants > 4 ||
+      (state.chapter == 4 && !state.buildings_readable))
+    return false;
+  for (int i = 0; i < state.participants; ++i) {
+    if (state.owners[i] >= 4 || state.gold[i] < target ||
+        (state.chapter == 4 && state.buildings[i] != 3))
+      return false;
+    for (int j = 0; j < i; ++j)
+      if (state.owners[j] == state.owners[i])
+        return false;
+  }
+  return true;
+}
+} // namespace majesty
diff --git a/coop_checkpoint.h b/coop_checkpoint.h
new file mode 100644
index 0000000..b5bba9c
--- /dev/null
+++ b/coop_checkpoint.h
@@ -0,0 +1,661 @@
+#pragma once
+#include "coop_transition.h"
+#include "platform/os.h"
+#include "runtime/loader.h"
+#include <array>
+#include <limits>
+#include <string>
+
+namespace majesty {
+struct CoopCheckpointIdentity {
+  std::array<char, 41> world{};
+  std::array<char, 130> content{};
+  std::array<char, 65> rules{};
+  int32_t x = 0, y = 0;
+};
+// Once Begin selects the host source revision, a later pause-save must not
+// republish it. A recipient still needs one local source capture before Ready;
+// after retention or commit neither role may replace the selected source.
+inline bool coop_source_checkpoint_writable(
+    const recomp_network_session_v1 &party,
+    const recomp_network_barrier_v1 &barrier, bool retained_this_proposal) {
+  if (party.host > 1 || party.player_count < 2 || party.player_count > 4 ||
+      !party.local_player || !party.players[0] ||
+      !std::is_sorted(party.players, party.players + party.player_count) ||
+      std::adjacent_find(party.players, party.players + party.player_count) !=
+          party.players + party.player_count ||
+      !std::binary_search(party.players, party.players + party.player_count,
+                          party.local_player) || barrier.stage > 4)
+    return false;
+  if (barrier.stage != 1 && barrier.stage != 2) return true;
+  if (!barrier.serial || barrier.player_count != party.player_count ||
+      !std::equal(party.players, party.players + party.player_count,
+                  barrier.players) || !barrier.descriptor_bytes ||
+      barrier.descriptor_bytes > sizeof barrier.descriptor)
+    return false;
+  return barrier.stage == 1 && !party.host && !retained_this_proposal;
+}
+// Win32's writable overlay creates the original save hierarchy while resolving
+// its path. Admit every existing directory below the exact selected profile,
+// not just a direct child: shell SaveGame can be under Documents/My Games.
+// The caller excludes concurrent replacement; lstat is not a filesystem lease.
+inline bool coop_checkpoint_parent(std::string_view profile,
+                                   std::string_view parent) {
+  if (profile.empty() || profile.size() >= 1024 || parent.size() >= 1024 ||
+      profile.find('\0') != profile.npos || parent.find('\0') != parent.npos ||
+      !parent.starts_with(std::string(profile) + "/"))
+    return false;
+  const auto relative = parent.substr(profile.size() + 1);
+  // Check the whole spelling before inspecting any descendant.
+  for (size_t offset = 0; offset < relative.size();) {
+    const auto end = relative.find('/', offset);
+    const auto part = relative.substr(
+        offset, end == relative.npos ? relative.size() - offset : end - offset);
+    if (part.empty() || part == "." || part == ".." ||
+        part.find('\\') != part.npos)
+      return false;
+    if (end == relative.npos)
+      break;
+    offset = end + 1;
+  }
+  if (relative.empty() || relative.back() == '/')
+    return false;
+  OsStat directory{};
+  std::string path(profile);
+  if (os_lstat(path.c_str(), &directory) != 0 || !directory.is_dir ||
+      directory.is_symlink)
+    return false;
+  for (size_t end = profile.size(); end < parent.size();) {
+    end = parent.find('/', end + 1);
+    if (end == parent.npos)
+      end = parent.size();
+    path.assign(parent.substr(0, end));
+    if (os_lstat(path.c_str(), &directory) != 0 || !directory.is_dir ||
+        directory.is_symlink)
+      return false;
+  }
+  return true;
+}
+// One writer owns these paths while its exact cooperative world is paused.
+// Filesystem flush/rename is not a promise of directory power-loss or OPFS
+// durability. The game adapter supplies the original serializer and rechecks
+// epoch, roster, world, frame and clock through the Guard before publication.
+class CoopCheckpointStore {
+public:
+  static constexpr uint64_t maximum_bytes = 64u * 1024u * 1024u;
+  enum class Status { missing, valid, invalid };
+  enum class ImportPolicy { monotonic, shared_target };
+  struct Record {
+    Status status = Status::invalid;
+    int slot = -1;
+    uint64_t revision = 0, bytes = 0;
+    uint32_t frame = 0, clock = 0;
+    std::array<char, 65> digest{};
+  };
+  CoopCheckpointStore(std::string manifest, std::array<std::string, 2> slots,
+                      CoopCheckpointIdentity identity)
+      : manifest_(std::move(manifest)), slots_(std::move(slots)),
+        identity_(identity) {}
+  static bool valid_identity(const CoopCheckpointIdentity &i) {
+    using namespace coop_detail;
+    const auto world = text(i.world), content = text(i.content);
+    return !world.empty() &&
+           std::all_of(world.begin(), world.end(),
+                       [](char c) {
+                         return (c >= 'a' && c <= 'z') ||
+                                (c >= '0' && c <= '9') || c == '-';
+                       }) &&
+           content.size() == 129 && content[64] == ':' &&
+           digest(content.substr(0, 64)) && digest(content.substr(65)) &&
+           digest(text(i.rules)) && i.x >= -1000000 && i.x <= 1000000 &&
+           i.y >= -1000000 && i.y <= 1000000;
+  }
+  Record read() const {
+    Record out;
+    if (!valid_paths() || !valid_identity(identity_))
+      return out;
+    OsStat named{};
+    if (os_lstat(manifest_.c_str(), &named) != 0) {
+      struct Search {
+        std::string_view name;
+        bool found = false;
+      } search;
+      const auto slash = manifest_.find_last_of("/\\");
+      if (slash == manifest_.npos)
+        return out;
+      search.name = std::string_view(manifest_).substr(slash + 1);
+      const auto visit = +[](const char *name, void *p) {
+        auto &s = *static_cast<Search *>(p);
+        if (s.name == name)
+          s.found = true;
+        return 0;
+      };
+      if (os_listdir(manifest_.substr(0, slash).c_str(), visit, &search) == 0 &&
+          !search.found)
+        out.status = Status::missing;
+      return out;
+    }
+    if (!named.is_regular || named.is_symlink || !named.size ||
+        named.size >= 768)
+      return out;
+    const int fd = os_fd_open(manifest_.c_str(), OS_O_RDONLY);
+    if (fd < 0)
+      return out;
+    std::array<char, 768> bytes{};
+    size_t used = 0;
+    bool valid = true;
+    while (used < bytes.size()) {
+      const auto n = os_fd_read(fd, bytes.data() + used, bytes.size() - used);
+      if (n < 0 || uint64_t(n) > bytes.size() - used) {
+        valid = false;
+        break;
+      }
+      if (!n)
+        break;
+      used += size_t(n);
+    }
+    const bool closed = os_fd_close(fd) == 0;
+    if (!valid || !closed || used != named.size)
+      return out;
+    std::string_view wire(bytes.data(), used);
+    if (wire.back() != '\n' || wire.find('\0') != wire.npos)
+      return out;
+    std::array<std::string_view, 12> f{};
+    for (auto &field : f) {
+      const auto at = wire.find('\n');
+      if (at == wire.npos)
+        return out;
+      field = wire.substr(0, at);
+      wire.remove_prefix(at + 1);
+    }
+    using namespace coop_detail;
+    int32_t x = 0, y = 0;
+    if (!wire.empty() || f[0] != "majesty-coop-checkpoint-v1" ||
+        (f[1] != "0" && f[1] != "1") || f[2] != text(identity_.world) ||
+        f[3] != text(identity_.content) || f[4] != text(identity_.rules) ||
+        !number(f[5], x) || !number(f[6], y) || x != identity_.x ||
+        y != identity_.y || !number(f[7], out.frame) ||
+        !number(f[8], out.clock) || !number(f[9], out.revision) ||
+        !out.revision || !number(f[10], out.bytes) || !out.bytes ||
+        out.bytes > maximum_bytes || !digest(f[11]) || !copy(f[11], out.digest))
+      return {};
+    out.slot = f[1][0] - '0';
+    const auto &path = slots_[out.slot];
+    if (os_lstat(path.c_str(), &named) != 0 || !named.is_regular ||
+        named.is_symlink || named.size != out.bytes ||
+        loader_hash_file_bounded(path.c_str(), out.bytes) != f[11])
+      return {};
+    out.status = Status::valid;
+    return out;
+  }
+  // Missing metadata alone does not mean unvisited: an interrupted save can
+  // leave either slot or its staging output. Never replace those kingdoms by
+  // fresh generation. The caller owns this directory against other writers.
+  bool unvisited() const {
+    if (!valid_paths() || !valid_identity(identity_) ||
+        read().status != Status::missing)
+      return false;
+    OsStat named{};
+    // Also catch names resolved by a case-insensitive native filesystem.
+    if (os_lstat(slots_[0].c_str(), &named) == 0 ||
+        os_lstat(slots_[1].c_str(), &named) == 0 ||
+        os_lstat((manifest_ + ".tmp").c_str(), &named) == 0)
+      return false;
+    const auto slash = manifest_.find_last_of('/');
+    if (slash == manifest_.npos ||
+        slots_[0].substr(0, slots_[0].find_last_of('/')) != manifest_.substr(0, slash) ||
+        slots_[1].substr(0, slots_[1].find_last_of('/')) != manifest_.substr(0, slash))
+      return false;
+    struct Search {
+      std::array<std::string_view, 3> names;
+      bool found = false;
+    } search{{std::string_view(manifest_).substr(slash + 1),
+              std::string_view(slots_[0]).substr(slash + 1),
+              std::string_view(slots_[1]).substr(slash + 1)}};
+    const auto visit = +[](const char *raw, void *user) {
+      auto &s = *static_cast<Search *>(user);
+      const std::string_view name(raw);
+      for (const auto base : s.names)
+        if (name == base || (name.starts_with(base) && name.size() > base.size() &&
+                            name[base.size()] == '.'))
+          s.found = true;
+      return 0;
+    };
+    return os_listdir(manifest_.substr(0, slash).c_str(), visit, &search) == 0 &&
+           !search.found;
+  }
+  // A newly started session may capture only a genuinely unvisited region.
+  // Existing progress belongs to an admitted live world (a captured source
+  // or a completed shared restore), never merely to a matching URL/name.
+  bool capture_allowed(bool admitted_live_world) const {
+    const auto current = read();
+    if (current.status == Status::valid)
+      return admitted_live_world;
+    return current.status == Status::missing && unvisited();
+  }
+  // Writer must close the inactive output. Guard may pump transport; it must
+  // reject loss, roster/world changes or resumed/advanced simulation. No new
+  // revision is selected unless the write, hash, manifest flush and final
+  // boundary recheck all succeed. A failed attempt never overwrites old.slot.
+  template <class Writer, class Guard>
+  bool commit(uint32_t frame, uint32_t clock, Writer writer, Guard guard,
+              Record &out,
+              int (*publish)(const char *, const char *) = os_rename) const {
+    return commit_selected(frame, clock, writer, guard, out, publish, nullptr);
+  }
+  // Import an authenticated host revision without deriving a different local
+  // revision. The caller admits incoming under its private profile and owns all
+  // paths exclusively; a receiver's CRC alone is not the agreement's SHA-256.
+  // Bytes are streamed into the inactive slot; the source is never renamed or
+  // removed. Ready must wait for this publication and a fresh agreement check.
+  template <class Guard>
+  bool import_file(std::string_view incoming, const Record &agreed, Guard guard,
+                   Record &out,
+                   int (*publish)(const char *,
+                                  const char *) = os_rename,
+                   ImportPolicy policy = ImportPolicy::monotonic) const {
+    const Record request = agreed;
+    out = {};
+    if ((policy != ImportPolicy::monotonic && policy != ImportPolicy::shared_target) ||
+        (policy == ImportPolicy::shared_target && request.frame != 0) ||
+        incoming.empty() || incoming.size() >= 1024 ||
+        incoming.find('\0') != incoming.npos || incoming == manifest_ ||
+        incoming == manifest_ + ".tmp" || incoming == slots_[0] ||
+        incoming == slots_[1])
+      return false;
+    const std::string path(incoming);
+    const auto copy = [&](int slot) {
+      OsStat named{};
+      if (os_lstat(path.c_str(), &named) != 0 || !named.is_regular ||
+          named.is_symlink || named.size != request.bytes)
+        return false;
+      const int source = os_fd_open(path.c_str(), OS_O_RDONLY);
+      if (source < 0)
+        return false;
+      OsStat opened{};
+      if (os_fd_stat(source, &opened) != 0 || !opened.is_regular ||
+          opened.size != request.bytes) {
+        os_fd_close(source);
+        return false;
+      }
+      // Exclusive sibling output also avoids truncating a hard-linked active
+      // slot or the incoming file through an existing inactive filename.
+      std::string staging = slots_[slot] + ".import-XXXXXX";
+      const int destination = os_mkstemp(staging.data());
+      if (destination < 0) {
+        os_fd_close(source);
+        return false;
+      }
+      std::array<uint8_t, 16384> scratch{};
+      uint64_t copied = 0;
+      bool valid = true;
+      while (copied < request.bytes) {
+        const size_t span =
+            size_t(std::min<uint64_t>(scratch.size(), request.bytes - copied));
+        const auto n = os_fd_read(source, scratch.data(), span);
+        if (n <= 0 || uint64_t(n) > span) {
+          valid = false;
+          break;
+        }
+        size_t written = 0;
+        while (written < size_t(n)) {
+          const auto w = os_fd_write(destination, scratch.data() + written,
+                                     size_t(n) - written);
+          if (w <= 0 || uint64_t(w) > size_t(n) - written) {
+            valid = false;
+            break;
+          }
+          written += size_t(w);
+        }
+        if (!valid)
+          break;
+        copied += uint64_t(n);
+      }
+      uint8_t overflow = 0;
+      valid = valid && copied == request.bytes &&
+              os_fd_read(source, &overflow, 1) == 0;
+      const bool source_closed = os_fd_close(source) == 0;
+      const bool destination_closed = os_fd_close(destination) == 0;
+      const bool installed =
+          valid && source_closed && destination_closed &&
+          os_rename(staging.c_str(), slots_[slot].c_str()) == 0;
+      if (!installed)
+        os_unlink(staging.c_str());
+      return installed;
+    };
+    return commit_selected(request.frame, request.clock, copy, guard, out,
+                           publish, &request, policy == ImportPolicy::shared_target);
+  }
+
+private:
+  template <class Writer, class Guard>
+  bool commit_selected(uint32_t frame, uint32_t clock, Writer writer,
+                       Guard guard, Record &out,
+                       int (*publish)(const char *, const char *),
+                       const Record *agreed, bool shared_target = false) const {
+    out = {};
+    if (agreed && (agreed->status != Status::valid || !agreed->revision ||
+                   !agreed->bytes || agreed->bytes > maximum_bytes ||
+                   !coop_detail::digest(coop_detail::text(agreed->digest))))
+      return false;
+    const Record old = read();
+    if (old.status == Status::invalid || !publish || !guard())
+      return false;
+    if (agreed) {
+      if (old.status == Status::valid && old.revision >= agreed->revision) {
+        if (old.revision != agreed->revision || old.clock != clock)
+          return false;
+        const bool exact_bytes = old.bytes == agreed->bytes && old.digest == agreed->digest;
+        if (exact_bytes && (old.frame == frame || shared_target)) {
+          out = old; // Exact bytes: preserve local frame metadata on a shared retry.
+          return true;
+        }
+        if (!shared_target)
+          return false;
+        // A shared return selects the host's authenticated full save. Local
+        // view/name data can differ at the same region revision and clock;
+        // target frame is absent on the wire. Keep the old active file, copy
+        // into the other slot, and publish only after SHA/guard checks pass.
+      }
+    } else if (old.revision == UINT64_MAX)
+      return false;
+    const int next = old.slot == 0 ? 1 : 0;
+    OsStat named{};
+    if (os_lstat(slots_[next].c_str(), &named) == 0 &&
+        (!named.is_regular || named.is_symlink))
+      return false;
+    if (!writer(next) || !guard())
+      return false;
+    if (os_lstat(slots_[next].c_str(), &named) != 0 || !named.is_regular ||
+        named.is_symlink || !named.size || named.size > maximum_bytes)
+      return false;
+    const int fd = os_fd_open(slots_[next].c_str(), OS_O_RDWR);
+    if (fd < 0)
+      return false;
+    OsStat opened{};
+    const bool flushed = os_fd_stat(fd, &opened) == 0 && opened.is_regular &&
+                         opened.size == named.size && os_fd_fsync(fd) == 0;
+    const bool closed = os_fd_close(fd) == 0;
+    if (!flushed || !closed)
+      return false;
+    const auto hash =
+        loader_hash_file_bounded(slots_[next].c_str(), named.size);
+    if (!coop_detail::digest(hash) ||
+        (agreed && (named.size != agreed->bytes ||
+                    hash != coop_detail::text(agreed->digest))))
+      return false;
+    Record selected;
+    selected.status = Status::valid;
+    selected.slot = next;
+    selected.revision = agreed ? agreed->revision : old.revision + 1;
+    selected.bytes = named.size;
+    selected.frame = frame;
+    selected.clock = clock;
+    coop_detail::copy(hash, selected.digest);
+    using coop_detail::text;
+    const std::string wire =
+        "majesty-coop-checkpoint-v1\n" + std::to_string(next) + "\n" +
+        std::string(text(identity_.world)) + "\n" +
+        std::string(text(identity_.content)) + "\n" +
+        std::string(text(identity_.rules)) + "\n" +
+        std::to_string(identity_.x) + "\n" + std::to_string(identity_.y) +
+        "\n" + std::to_string(frame) + "\n" + std::to_string(clock) + "\n" +
+        std::to_string(selected.revision) + "\n" +
+        std::to_string(selected.bytes) + "\n" + hash + "\n";
+    if (wire.size() >= 768)
+      return false;
+    const std::string temporary = manifest_ + ".tmp";
+    if (os_lstat(temporary.c_str(), &named) == 0 &&
+        (!named.is_regular || named.is_symlink))
+      return false;
+    const int stage =
+        os_fd_open(temporary.c_str(), OS_O_WRONLY | OS_O_CREAT | OS_O_TRUNC);
+    if (stage < 0)
+      return false;
+    size_t done = 0;
+    while (done < wire.size()) {
+      const auto n = os_fd_write(stage, wire.data() + done, wire.size() - done);
+      if (n <= 0 || uint64_t(n) > wire.size() - done)
+        break;
+      done += size_t(n);
+    }
+    const bool ready = done == wire.size() && os_fd_fsync(stage) == 0;
+    const bool stage_closed = os_fd_close(stage) == 0;
+    const bool committed = ready && stage_closed && guard() &&
+                           publish(temporary.c_str(), manifest_.c_str()) == 0;
+    if (!committed)
+      os_unlink(temporary.c_str());
+    else
+      out = selected;
+    return committed;
+  }
+
+  bool valid_paths() const {
+    return !manifest_.empty() && manifest_.size() < 1020 &&
+           !slots_[0].empty() && slots_[0].size() < 1024 &&
+           !slots_[1].empty() && slots_[1].size() < 1024 &&
+           slots_[0] != slots_[1] && manifest_ != slots_[0] &&
+           manifest_ != slots_[1] && manifest_ + ".tmp" != slots_[0] &&
+           manifest_ + ".tmp" != slots_[1] &&
+           manifest_.find('\0') == manifest_.npos &&
+           slots_[0].find('\0') == slots_[0].npos &&
+           slots_[1].find('\0') == slots_[1].npos;
+  }
+  std::string manifest_;
+  std::array<std::string, 2> slots_;
+  CoopCheckpointIdentity identity_;
+};
+// An owned checkpoint stream, never a whole-file buffer. The caller excludes
+// concurrent replacement/writes and supplies its frozen paused-world guard.
+// Incoming files are exclusive profile siblings, retained after verification
+// only until the caller imports them. Destruction/cancel removes partial input.
+class CoopCheckpointTransferFile {
+public:
+  static constexpr uint32_t chunk_bytes = 16384;
+  CoopCheckpointTransferFile() = default;
+  CoopCheckpointTransferFile(const CoopCheckpointTransferFile &) = delete;
+  CoopCheckpointTransferFile &
+  operator=(const CoopCheckpointTransferFile &) = delete;
+  ~CoopCheckpointTransferFile() { reset(); }
+  void reset() {
+    if (fd_ >= 0)
+      os_fd_close(fd_);
+    if (incoming_ && !path_.empty())
+      os_unlink(path_.c_str());
+    fd_ = -1;
+    path_.clear();
+    profile_.clear();
+    parent_.clear();
+    incoming_ = complete_ = false;
+    bytes_ = offset_ = 0;
+    sequence_ = 1;
+    digest_ = {};
+  }
+  const std::string &path() const { return path_; }
+  uint64_t bytes() const { return bytes_; }
+  uint64_t offset() const { return offset_; }
+  uint32_t sequence() const { return sequence_; }
+  bool complete() const { return complete_; }
+  bool active() const { return !path_.empty(); }
+  template <class Guard>
+  bool open_source(std::string_view profile, std::string_view path,
+                   uint64_t bytes, const std::array<char, 65> &digest,
+                   Guard guard) {
+    if (active() || !valid(bytes, digest) || !admitted(profile, path) ||
+        !guard())
+      return false;
+    const std::string source(path);
+    OsStat named{};
+    if (os_lstat(source.c_str(), &named) || !named.is_regular ||
+        named.is_symlink || named.size != bytes ||
+        loader_hash_file_bounded(source.c_str(), bytes) !=
+            coop_detail::text(digest) ||
+        !guard())
+      return false;
+    const int fd = os_fd_open(source.c_str(), OS_O_RDONLY);
+    OsStat opened{};
+    if (fd < 0)
+      return false;
+    if (os_fd_stat(fd, &opened) || !opened.is_regular || opened.size != bytes ||
+        !guard()) {
+      os_fd_close(fd);
+      return false;
+    }
+    fd_ = fd;
+    path_ = source;
+    bytes_ = bytes;
+    digest_ = digest;
+    return true;
+  }
+  template <class Guard>
+  bool open_receiver(std::string_view profile, std::string_view parent,
+                     uint64_t bytes, const std::array<char, 65> &digest,
+                     Guard guard) {
+    if (active() || !valid(bytes, digest) || parent.size() > 990 ||
+        !coop_checkpoint_parent(profile, parent) || !guard())
+      return false;
+    std::string path = std::string(parent) + "/.CoopReceived-XXXXXX";
+    const int fd = os_mkstemp(path.data());
+    if (fd < 0)
+      return false;
+    fd_ = fd;
+    incoming_ = true;
+    path_ = std::move(path);
+    profile_ = profile;
+    parent_ = parent;
+    bytes_ = bytes;
+    digest_ = digest;
+    if (!guard()) {
+      reset();
+      return false;
+    }
+    return true;
+  }
+  template <class Guard>
+  bool read_chunk(uint32_t sequence, void *data, uint32_t capacity,
+                  uint32_t &size, Guard guard) {
+    size = 0;
+    const uint32_t span =
+        uint32_t(std::min<uint64_t>(chunk_bytes, bytes_ - offset_));
+    if (fd_ < 0 || incoming_ || complete_ || sequence != sequence_ || !data ||
+        !span || capacity < span || !guard())
+      return fail();
+    uint32_t used = 0;
+    while (used < span) {
+      const auto n =
+          os_fd_read(fd_, static_cast<uint8_t *>(data) + used, span - used);
+      if (n <= 0 || uint64_t(n) > span - used)
+        return fail();
+      used += uint32_t(n);
+    }
+    if (!guard())
+      return fail();
+    offset_ += span;
+    sequence_++;
+    size = span;
+    return true;
+  }
+  template <class Guard>
+  bool write_chunk(uint32_t sequence, const void *data, uint32_t size,
+                   Guard guard) {
+    const uint32_t span =
+        uint32_t(std::min<uint64_t>(chunk_bytes, bytes_ - offset_));
+    if (fd_ < 0 || !incoming_ || complete_ || sequence != sequence_ || !data ||
+        !size || size != span || !guard())
+      return fail();
+    uint32_t used = 0;
+    while (used < size) {
+      const auto n = os_fd_write(fd_, static_cast<const uint8_t *>(data) + used,
+                                 size - used);
+      if (n <= 0 || uint64_t(n) > size - used)
+        return fail();
+      used += uint32_t(n);
+    }
+    if (!guard())
+      return fail();
+    offset_ += size;
+    sequence_++;
+    return true;
+  }
+  template <class Guard> bool finish(Guard guard) {
+    if (fd_ < 0 || complete_ || offset_ != bytes_ || !guard())
+      return fail();
+    OsStat opened{};
+    bool valid = os_fd_stat(fd_, &opened) == 0 && opened.is_regular &&
+                 opened.size == bytes_;
+    if (incoming_)
+      valid = valid && os_fd_fsync(fd_) == 0;
+    else {
+      uint8_t overflow = 0;
+      valid = valid && os_fd_read(fd_, &overflow, 1) == 0;
+    }
+    const bool closed = os_fd_close(fd_) == 0;
+    fd_ = -1;
+    if (!valid || !closed ||
+        (incoming_ && (!coop_checkpoint_parent(profile_, parent_) ||
+                       loader_hash_file_bounded(path_.c_str(), bytes_) !=
+                           coop_detail::text(digest_))) ||
+        !guard())
+      return fail();
+    complete_ = true;
+    return true;
+  }
+
+private:
+  bool fail() {
+    reset();
+    return false;
+  }
+  static bool valid(uint64_t bytes, const std::array<char, 65> &digest) {
+    return bytes && bytes <= CoopCheckpointStore::maximum_bytes &&
+           coop_detail::digest(coop_detail::text(digest));
+  }
+  static bool admitted(std::string_view profile, std::string_view path) {
+    const auto slash = path.find_last_of('/');
+    return !path.empty() && path.size() < 1024 &&
+           path.find('\0') == path.npos && slash != path.npos &&
+           slash + 1 < path.size() &&
+           path.substr(slash + 1).find('\\') == path.npos &&
+           coop_checkpoint_parent(profile, path.substr(0, slash));
+  }
+  int fd_ = -1;
+  bool incoming_ = false, complete_ = false;
+  uint64_t bytes_ = 0, offset_ = 0;
+  uint32_t sequence_ = 1;
+  std::array<char, 65> digest_{};
+  std::string path_, profile_, parent_;
+};
+// Freeze the trusted launch identity before enqueueing a transition pause.
+// The browser locks content/session fingerprints to imported bytes; native
+// callers must supply the same trusted identities, not a claimed mod version.
+inline bool
+coop_checkpoint_identity(std::string_view world, std::string_view region,
+                         std::string_view content, std::string_view session,
+                         std::string_view image, CoopCheckpointIdentity &out) {
+  out = {};
+  CoopCheckpointIdentity next;
+  const auto split = region.find('_');
+  if (session.size() != 194 || session[64] != ':' || session[129] != ':' ||
+      !coop_detail::digest(session.substr(0, 64)) || content.size() != 129 ||
+      content.substr(0, 64) != image || session.substr(65, 64) != image ||
+      split == region.npos || !coop_detail::copy(world, next.world) ||
+      !coop_detail::copy(content, next.content) ||
+      !coop_detail::copy(session.substr(130), next.rules) ||
+      !coop_detail::number(region.substr(0, split), next.x) ||
+      !coop_detail::number(region.substr(split + 1), next.y) ||
+      !CoopCheckpointStore::valid_identity(next))
+    return false;
+  out = next;
+  return true;
+}
+} // namespace majesty
+
+extern "C" bool
+majesty_browser_coop_checkpoint(X86 *, uint64_t epoch, uint32_t owner,
+                                const majesty::CoopCheckpointIdentity &,
+                                const struct recomp_network_session_v1 &,
+                                majesty::CoopCheckpointStore::Record &);
+extern "C" bool majesty_browser_coop_checkpoint_capture_allowed(X86 *, uint64_t);
+extern "C" void majesty_browser_coop_checkpoint_captured(
+    uint64_t, const majesty::CoopCheckpointIdentity &);
+extern "C" void majesty_browser_coop_fresh_campaign();
diff --git a/coop_connected.h b/coop_connected.h
new file mode 100644
index 0000000..bfe9ca4
--- /dev/null
+++ b/coop_connected.h
@@ -0,0 +1,58 @@
+#pragma once
+#include "runtime/guest.h"
+#include "runtime/memory.h"
+#include <cstdint>
+
+namespace majesty {
+// Version1 terrain is addressed in world coordinates. Saved interiors may
+// contain foundations and other original edits; only shared edges are fixed.
+inline int32_t coop_connected_height(int64_t x, int64_t y) {
+  const int64_t ax = x >= 0 ? x / 16 : (x - 15) / 16;
+  const int64_t ay = y >= 0 ? y / 16 : (y - 15) / 16;
+  const int64_t rx = x - ax * 16, ry = y - ay * 16;
+  const auto corner = [](int64_t px, int64_t py) -> int64_t {
+    uint32_t hash = (71201u ^ uint32_t(px)) * 0x045d9f3bu ^
+                    uint32_t(py) * 0x27d4eb2du;
+    hash ^= hash >> 16;
+    hash *= 0x045d9f3bu;
+    hash ^= hash >> 16;
+    return int64_t(hash % 9u) - 4;
+  };
+  return int32_t((corner(ax, ay) * (16 - rx) * (16 - ry) +
+                  corner(ax + 1, ay) * rx * (16 - ry) +
+                  corner(ax, ay + 1) * (16 - rx) * ry +
+                  corner(ax + 1, ay + 1) * rx * ry) * 256);
+}
+
+// Admission for an original deserialized context, before source disposal.
+// This does not load, resize, repair, bind or grant a network barrier vote.
+// Work is bounded by 516 edge samples, with no retained map or actor list.
+inline bool coop_connected_context(uint32_t context, int32_t x, int32_t y) {
+  if (x < -1000000 || x > 1000000 || y < -1000000 || y > 1000000 ||
+      !context || !gm_valid(context, 0x11c) || rd32(context) != 0x00682950u)
+    return false;
+  const uint32_t terrain = rd32(context + 0x80), grid = rd32(context + 0x88);
+  if (!terrain || !gm_valid(terrain, 0x54) || rd32(terrain) != 0x0068b660u ||
+      rd32(terrain + 0x30) != 128 || rd32(terrain + 0x34) != 128 ||
+      rd32(terrain + 0x38) != 129 || rd32(terrain + 0x3c) != 129 ||
+      !grid || !gm_valid(grid, 0x50) || rd32(grid) != 0x0068a25cu ||
+      rd32(grid + 0x48) != 256 || rd32(grid + 0x4c) != 256)
+    return false;
+  const uint32_t vertices = rd32(terrain + 0x4c), paths = rd32(grid + 0x14),
+                 actors = rd32(grid + 0x18);
+  if (!vertices || !paths || !actors ||
+      !gm_valid(vertices, 129u * 129u * 24u) ||
+      !gm_valid(paths, 256u * 256u * 4u) ||
+      !gm_valid(actors, 256u * 256u * 4u))
+    return false;
+  const int64_t ox = int64_t(x) * 128, oy = int64_t(y) * 128;
+  const auto matches = [&](uint32_t px, uint32_t py) {
+    return int32_t(rd32(vertices + (py * 129 + px) * 24)) ==
+           coop_connected_height(ox + px, oy + py);
+  };
+  for (uint32_t i = 0; i <= 128; ++i)
+    if (!matches(0, i) || !matches(128, i) || !matches(i, 0) || !matches(i, 128))
+      return false;
+  return true;
+}
+} // namespace majesty
diff --git a/coop_lobby_resume.h b/coop_lobby_resume.h
new file mode 100644
index 0000000..3eefeae
--- /dev/null
+++ b/coop_lobby_resume.h
@@ -0,0 +1,92 @@
+#pragma once
+#include "coop_checkpoint.h"
+
+namespace majesty {
+// A launch hint selects a file; it does not admit a live world. The adapter
+// must observe the pinned original reader, hash its input and bind its output
+// to the current room, profile and attached world before granting ownership.
+struct CoopLobbyResume {
+  CoopCheckpointIdentity identity;
+  CoopCheckpointStore::Record record;
+  uint32_t chapter = 0;
+  int32_t initial_x = 0, initial_y = 0;
+  std::string label() const {
+    return "WorldResume_" + std::string(coop_detail::text(identity.world)) +
+           "_" + std::to_string(identity.x) + "_" +
+           std::to_string(identity.y) + "_" +
+           std::string(coop_detail::text(record.digest).substr(0, 16));
+  }
+};
+inline bool coop_lobby_resume_parse(std::string_view wire, CoopLobbyResume &out) {
+  out = {};
+  if (wire.empty() || wire.size() > 512 || wire.find('\0') != wire.npos)
+    return false;
+  std::array<std::string_view, 14> f{};
+  for (size_t i = 0; i < f.size(); ++i) {
+    const auto end = wire.find('|');
+    if ((i + 1 == f.size()) != (end == wire.npos)) return false;
+    f[i] = wire.substr(0, end);
+    if (end != wire.npos) wire.remove_prefix(end + 1);
+  }
+  using namespace coop_detail;
+  CoopLobbyResume parsed;
+  if (f[0] != "v2" || !number(f[1], parsed.chapter) ||
+      parsed.chapter < 1 || parsed.chapter > 4 ||
+      !copy(f[2], parsed.identity.world) ||
+      !number(f[3], parsed.identity.x) || !number(f[4], parsed.identity.y) ||
+      !number(f[5], parsed.initial_x) || !number(f[6], parsed.initial_y) ||
+      parsed.initial_x < -1000000 || parsed.initial_x > 1000000 ||
+      parsed.initial_y < -1000000 || parsed.initial_y > 1000000 ||
+      !number(f[7], parsed.record.frame) || !number(f[8], parsed.record.clock) ||
+      !number(f[9], parsed.record.revision) || !parsed.record.revision ||
+      !number(f[10], parsed.record.bytes) || !parsed.record.bytes ||
+      parsed.record.bytes > CoopCheckpointStore::maximum_bytes ||
+      !digest(f[11]) || !copy(f[11], parsed.record.digest) ||
+      !copy(f[12], parsed.identity.content) || !copy(f[13], parsed.identity.rules) ||
+      !CoopCheckpointStore::valid_identity(parsed.identity)) return false;
+  parsed.record.status = CoopCheckpointStore::Status::valid;
+  out = parsed;
+  return true;
+}
+inline bool coop_lobby_resume_valid(const CoopLobbyResume &request) {
+  return CoopCheckpointStore::valid_identity(request.identity) &&
+      request.chapter >= 1 && request.chapter <= 4 &&
+      request.initial_x >= -1000000 && request.initial_x <= 1000000 &&
+      request.initial_y >= -1000000 && request.initial_y <= 1000000 &&
+      request.record.status == CoopCheckpointStore::Status::valid &&
+      request.record.revision && request.record.bytes &&
+      request.record.bytes <= CoopCheckpointStore::maximum_bytes &&
+      coop_detail::digest(coop_detail::text(request.record.digest));
+}
+// Before the original loader, only inspect the SDK roster. The original
+// current-game IDs and local kingdom selection are not populated yet.
+inline bool coop_lobby_resume_start_ready(
+    const CoopLobbyResume &request, const recomp_network_session_v1 &party,
+    std::string_view selected_label) {
+  return coop_lobby_resume_valid(request) && request.label() == selected_label &&
+      party.host <= 1 && party.player_count >= 2 && party.player_count <= 4 &&
+      party.local_player && party.players[0] &&
+      std::is_sorted(party.players, party.players + party.player_count) &&
+      std::adjacent_find(party.players, party.players + party.player_count) ==
+          party.players + party.player_count &&
+      std::binary_search(party.players, party.players + party.player_count,
+                         party.local_player);
+}
+inline bool coop_lobby_resume_local(const CoopLobbyResume &request,
+                                   const CoopCheckpointStore &store,
+                                   bool host) {
+  if (!coop_lobby_resume_valid(request)) return false;
+  const auto local = store.read();
+  if (local.status == CoopCheckpointStore::Status::invalid) return false;
+  if (local.status == CoopCheckpointStore::Status::missing)
+    return !host && store.unvisited();
+  const auto &incoming = request.record;
+  if (host)
+    return local.revision == incoming.revision && local.bytes == incoming.bytes &&
+           local.frame == incoming.frame && local.clock == incoming.clock &&
+           local.digest == incoming.digest;
+  // The original lobby may transfer a host snapshot to a new or older guest
+  // profile. Never roll a newer committed local world back through this hint.
+  return local.revision <= incoming.revision && local.clock <= incoming.clock;
+}
+} // namespace majesty
diff --git a/coop_pause.h b/coop_pause.h
new file mode 100644
index 0000000..5f30ec5
--- /dev/null
+++ b/coop_pause.h
@@ -0,0 +1,237 @@
+#pragma once
+#include "mods/mods_internal.h"
+#include "runtime/guest.h"
+#include "runtime/memory.h"
+#include "runtime/native_seam.h"
+#include "runtime/win32.h"
+#include <algorithm>
+#include <array>
+#include <cstdint>
+
+namespace majesty {
+struct CoopPauseBoundary {
+  uint32_t frame = 0, clock = 0, owner = 0;
+};
+struct CoopPlayerBinding {
+  uint32_t slot = UINT32_MAX, player = UINT32_MAX;
+};
+// Original00417730 prepares the command queues with005a4250 before calling
+// the frame/input seam at004179a9, then transmits through005a4600. Keep new
+// controls in that prepared batch; graphics and idle polling can still observe
+// settled pauses, but must not consume actions into the previous batch.
+inline bool coop_prepared_input(X86 *c) {
+  const uint32_t state = rd32(0x006d7670);
+  return c && sched_holds_baton() && !mods_hook_depth() &&
+         gm_valid(c->r[R_ESP], 4) && rd32(c->r[R_ESP]) == 0x004179a9u &&
+         gm_valid(state, 0x50) && c->r[R_ECX] == state;
+}
+// 00497cc0 returns manager+8c's network player ID; 004bb7f0 maps that ID
+// through settings+344 to a kingdom slot. 004169a0 selects a slot at state+24.
+// Pause owners are network IDs, not indices into the four playable kingdoms.
+// Retain this mapping across a shared read instead of inheriting the host's
+// saved local kingdom. The caller binds the exact joined epoch separately.
+inline bool coop_player_binding(const recomp_network_session_v1 &expected,
+                                CoopPlayerBinding &out) {
+  out = {};
+  if (!sched_holds_baton() || expected.host > 1 || expected.player_count < 2 ||
+      expected.player_count > 4 || !expected.local_player ||
+      expected.local_player == UINT32_MAX)
+    return false;
+  for (uint32_t i = 0; i < 4; ++i)
+    if (i < expected.player_count
+            ? !expected.players[i] || expected.players[i] == UINT32_MAX ||
+                  (i && expected.players[i - 1] >= expected.players[i])
+            : expected.players[i] != 0)
+      return false;
+  const uint32_t state = rd32(0x006d7670), manager = rd32(0x006d8568),
+                 settings = rd32(0x006d87a0);
+  if (!state || !manager || !settings || !gm_valid(state, 0x50) ||
+      !gm_valid(manager, 0x2b0) || !gm_valid(settings, 0x4f8) ||
+      rd32(manager + 0x8c) != expected.local_player)
+    return false;
+  const uint32_t slot = rd32(state + 0x24);
+  if (slot >= 4 || rd32(settings + 0x344 + slot * 4) != expected.local_player)
+    return false;
+  std::array<uint32_t, 4> players{};
+  uint32_t count = 0;
+  for (uint32_t i = 0; i < 4; ++i) {
+    const uint32_t id = rd32(settings + 0x344 + i * 4);
+    if (id != UINT32_MAX)
+      players[count++] = id;
+  }
+  std::sort(players.begin(), players.begin() + count);
+  if (count != expected.player_count ||
+      players != std::to_array(expected.players))
+    return false;
+  out = {slot, expected.local_player};
+  return true;
+}
+// +218 is the original match type, copied from settings+6c at004bc18d:
+//1 freestyle,2 saved/readback,3 saved network. Original005a4600 refuses send
+// in mode2 while current frame<=the replay terminal frame at+21c. At rebuilt
+// frame0 this would strand a queued resume. Admit live modes1/3; callers
+// separately bind the exact joined provider/party.
+inline bool coop_match_type(uint32_t manager) {
+  if (!manager || !gm_valid(manager, 0x21c)) return false;
+  const uint32_t type = rd32(manager + 0x218);
+  return type == 1 || type == 3;
+}
+// A settled pause, not a pending phase7 at the end of the still-running tick.
+// Caller binds the joined room epoch/roster and loaded cooperative world.
+inline bool coop_pause_boundary(uint32_t owner, CoopPauseBoundary &out) {
+  out = {};
+  if (!sched_holds_baton() || owner == UINT32_MAX)
+    return false;
+  const uint32_t state = rd32(0x006d7670), manager = rd32(0x006d8568),
+                 world = rd32(0x0071c68c);
+  if (!state || !manager || !world || !gm_valid(world, 0x18) ||
+      !gm_valid(state, 0x50) || !gm_valid(manager, 0x2b0) || rd32(state) != 7 ||
+      rd32(state + 4) || !coop_match_type(manager) ||
+      rd32(manager + 0x27c) != owner)
+    return false;
+  out = {rd32(state + 0x28), rd32(0x0071c6a8), owner};
+  return true;
+}
+
+// Read-only guest UI observation. It neither creates a checkpoint nor grants
+// the guest permission to save, travel or resume the shared simulation.
+inline bool coop_guest_pause_boundary(const recomp_network_session_v1 &party,
+                                      CoopPauseBoundary &out) {
+  out = {};
+  CoopPlayerBinding binding;
+  if (party.host || !coop_player_binding(party, binding))
+    return false;
+  const uint32_t manager = rd32(0x006d8568);
+  if (!manager || !gm_valid(manager, 0x2b0))
+    return false;
+  const uint32_t owner = rd32(manager + 0x27c);
+  if (owner == party.local_player ||
+      std::find(party.players, party.players + party.player_count, owner) ==
+          party.players + party.player_count)
+    return false;
+  return coop_pause_boundary(owner, out);
+}
+
+// Only the game coordinator calls this after checking its exact room epoch,
+// participant roster and loaded world. Use the original control-record ctor
+// and pause sender, which transfer ownership into the original command queue.
+// This never writes a phase, saves a world or grants load/resume permission.
+inline bool enqueue_coop_pause(X86 *c, uint32_t owner) {
+  if (!c || !sched_holds_baton() || mods_hook_depth())
+    return false;
+  const uint32_t state = rd32(0x006d7670), manager = rd32(0x006d8568),
+                 world = rd32(0x0071c68c);
+  if (!state || !manager || !world || !gm_valid(state, 0x50) ||
+      !gm_valid(manager, 0x2b0) || !gm_valid(world, 0x18) || rd32(state) != 3 ||
+      rd32(state + 4) || !coop_match_type(manager) || owner == UINT32_MAX ||
+      rd32(manager + 0x8c) != owner || c->r[R_ESP] < STACK_LIMIT + 65536 ||
+      c->r[R_ESP] > STACK_TOP)
+    return false;
+  const uint32_t queue = rd32(manager + 0x34);
+  if (!queue || !gm_valid(queue, 0x10))
+    return false;
+  const uint32_t deque = rd32(queue + 8);
+  if (!deque || !gm_valid(deque, 0x30) || rd32(deque + 0x2c) >= 4096)
+    return false;
+  X86 extra = *c;
+  extra.r[R_ESP] -= 32768;
+  const uint32_t message = guest_call(&extra, 0x0064c616, 0x28u);
+  if (!message)
+    return false;
+  extra = *c;
+  extra.r[R_ESP] -= 32768;
+  extra.r[R_ECX] = message;
+  guest_call(&extra, 0x005a38c0);
+  wr32(message + 8, 0);
+  wr32(message + 12, owner);
+  wr32(message + 0x1c, 0);
+  wr32(message + 0x20, rd32(0x006c066c));
+  wr32(message + 0x24, rd32(0x006d8548));
+  extra = *c;
+  extra.r[R_ESP] -= 32768;
+  extra.r[R_ECX] = manager;
+  guest_call(&extra, 0x005a46a0, message);
+  // The sender's original ref-count pair owns the record from this point.
+  // Do not retain, inspect or free the message after handing it off.
+  return true;
+}
+
+// Resume uses original005a4820's secondary queue at manager+44. Only the
+// original pause owner sends it. After a shared read the caller must first
+// verify exact-epoch Complete permission and its own successful Loaded vote.
+// Before Begin, an unavailable destination may resume its unchanged captured
+// source only with coop_source_abort_permission and the exact live binding.
+inline bool enqueue_coop_resume(X86 *c, uint32_t owner) {
+  if (!c || !sched_holds_baton() || mods_hook_depth() ||
+      c->r[R_ESP] < STACK_LIMIT + 65536 || c->r[R_ESP] > STACK_TOP)
+    return false;
+  CoopPauseBoundary boundary;
+  if (!coop_pause_boundary(owner, boundary))
+    return false;
+  const uint32_t manager = rd32(0x006d8568);
+  if (rd32(manager + 0x8c) != owner)
+    return false;
+  const uint32_t queue = rd32(manager + 0x44);
+  if (!queue || !gm_valid(queue, 0x10))
+    return false;
+  const uint32_t deque = rd32(queue + 8);
+  if (!deque || !gm_valid(deque, 0x30) || rd32(deque + 0x2c) >= 4096)
+    return false;
+  X86 extra = *c;
+  extra.r[R_ESP] -= 32768;
+  const uint32_t message = guest_call(&extra, 0x0064c616, 0x28u);
+  if (!message)
+    return false;
+  extra = *c;
+  extra.r[R_ESP] -= 32768;
+  extra.r[R_ECX] = message;
+  guest_call(&extra, 0x005a38c0);
+  wr32(message + 8, 1);
+  wr32(message + 12, owner);
+  wr32(message + 0x1c, 0);
+  wr32(message + 0x20, rd32(0x006c066c));
+  wr32(message + 0x24, rd32(0x006d8548));
+  extra = *c;
+  extra.r[R_ESP] -= 32768;
+  extra.r[R_ECX] = manager;
+  guest_call(&extra, 0x005a4820, message);
+  return true; // The original queue owns the record/ref pair.
+}
+
+// Original004359c0 assigns its label to the personal Save UI default CYString
+// at006d7ce4. Preserve its value through the real string operations, including
+// a failed private serializer attempt; never restore a borrowed/freed pointer.
+template <class Writer>
+inline bool coop_preserve_save_name(X86 *c, Writer writer) {
+  if (!c || !sched_holds_baton() || mods_hook_depth() ||
+      c->r[R_ESP] < STACK_LIMIT + 65536 || c->r[R_ESP] > STACK_TOP)
+    return false;
+  const uint32_t text = rd32(0x006d7ce4), flags = rd32(0x006d7ce8),
+                 length = rd32(0x006d7cec);
+  if (length > 1023 || (flags & 0xffffff) < length || !text ||
+      !gm_valid(text, (length + 1) * ((flags & 0x1000000) ? 2 : 1)))
+    return false;
+  const uint32_t remembered = heap_alloc(12, true);
+  if (!remembered)
+    return false;
+  X86 extra = *c;
+  extra.r[R_ESP] -= 32768;
+  extra.r[R_ECX] = remembered;
+  guest_call(&extra, 0x004e3340);
+  extra = *c;
+  extra.r[R_ESP] -= 32768;
+  extra.r[R_ECX] = remembered;
+  guest_call(&extra, 0x004e4180, 0x006d7ce4u);
+  const bool saved = writer();
+  extra = *c;
+  extra.r[R_ESP] -= 32768;
+  extra.r[R_ECX] = 0x006d7ce4;
+  guest_call(&extra, 0x004e4180, remembered);
+  extra = *c;
+  extra.r[R_ESP] -= 32768;
+  extra.r[R_ECX] = remembered;
+  guest_call(&extra, 0x004e3820);
+  heap_free(remembered);
+  return saved;
+}
