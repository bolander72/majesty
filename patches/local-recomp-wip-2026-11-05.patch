+        const uint32_t bucket = rd32(buckets + cell * 4);
+        if (!bucket)
+            continue;
+        if (!gm_valid(bucket, 32)) {
+            physical = false;
+            break;
+        }
+        for (uint32_t slot = 0; slot < 8 && rd32(bucket + slot * 4); ++slot)
+            physical_matches += rd32(bucket + slot * 4) == unit;
+    }
