+static void save_name(X86 *c) {
+  const uint32_t buffer = alloc(c, 128);
+  CHECK(invoke(c, 0x004e3340, 0x006d7ce4) == 0x006d7ce4);
+  const auto assign = [&](const char *name) {
+    const auto length = uint32_t(std::strlen(name));
+    CHECK(length < 128);
+    std::memcpy(gm_ptr(buffer), name, length + 1);
+    const auto label = alloc(c, 12);
+    const uint32_t args[] = {buffer, length};
+    CHECK(invoke(c, 0x004e3590, label, args, 2) == label);
+    const uint32_t copy[] = {label};
+    CHECK(invoke(c, 0x004e4180, 0x006d7ce4, copy, 1) == 0x006d7ce4);
+    invoke(c, 0x004e3820, label);
+    const uint32_t release[] = {label};
+    invoke(c, 0x00645bc0, 0, release, 1);
+  };
+  for (const auto *name :
+       {"", "Personal Save", "Personal save with a longer name"}) {
+    assign(name);
+    for (bool successful : {false, true}) {
+      const X86 before = *c;
+      const auto heap = heap_stats();
+      CHECK(majesty::coop_preserve_save_name(c, [&] {
+              // The original serializer uses assignment004e4180. Construct a
+              // real private label, assign it by that same operation, then
+              // destroy it.
+              const auto label = alloc(c, 12);
+              constexpr char private_name[] = "CoopTransitions_shared/0_0_0";
+              std::memcpy(gm_ptr(buffer), private_name, sizeof private_name);
+              const uint32_t args[] = {buffer, sizeof private_name - 1};
+              CHECK(invoke(c, 0x004e3590, label, args, 2) == label);
+              const uint32_t copy[] = {label};
+              CHECK(invoke(c, 0x004e4180, 0x006d7ce4, copy, 1) == 0x006d7ce4);
+              invoke(c, 0x004e3820, label);
+              const uint32_t release[] = {label};
+              invoke(c, 0x00645bc0, 0, release, 1);
+              return successful;
+            }) == successful);
+      CHECK(std::memcmp(c, &before, sizeof before) == 0);
+      const auto value = rd32(0x006d7ce4), length = rd32(0x006d7cec);
+      CHECK(length == std::strlen(name) && gm_valid(value, length + 1));
+      CHECK(!std::memcmp(gm_ptr(value), name, length + 1));
+      const auto after = heap_stats();
+      CHECK(after.used_blocks == heap.used_blocks &&
+            after.used_bytes == heap.used_bytes &&
+            after.req_bytes == heap.req_bytes);
+      CHECK(heap_check().empty() && !mods_hook_depth() &&
+            !recomp_callback_depth());
+    }
+  }
+  invoke(c, 0x004e3820, 0x006d7ce4);
+  const uint32_t release[] = {buffer};
+  invoke(c, 0x00645bc0, 0, release, 1);
+}
+// Compare network IDs and kingdom slots through the original getters and the
+// production admission helper. The roster/state is explicit fixture metadata,
+// not a loaded world or a fabricated local-player virtual dispatcher.
+static void player_bindings(X86 *c, uint32_t state, uint32_t manager) {
+  const uint32_t settings = invoke(c, 0x004ba7e0, 0);
+  CHECK(settings && gm_valid(settings, 0x4f8));
+  const uint32_t old_slot = rd32(state + 0x24),
+                 old_player = rd32(manager + 0x8c),
+                 old_count = rd32(settings + 0x4d4);
+  std::array<uint32_t, 4> original{};
+  for (uint32_t i = 0; i < 4; ++i)
+    original[i] = rd32(settings + 0x344 + i * 4);
+  const std::array<std::array<uint32_t, 4>, 3> layouts = {
+      {{7, 8, UINT32_MAX, UINT32_MAX},
+       {900, UINT32_MAX, UINT32_MAX, 7},
+       {1, 0xfffffffeu, 17, 8}}};
+  for (const auto &layout : layouts) {
+    recomp_network_session_v1 expected{};
+    for (uint32_t i = 0; i < 4; ++i) {
+      wr32(settings + 0x344 + i * 4, layout[i]);
+      if (layout[i] != UINT32_MAX)
+        expected.players[expected.player_count++] = layout[i];
+    }
+    std::sort(expected.players, expected.players + expected.player_count);
+    wr32(settings + 0x4d4, 4);
+    for (uint32_t slot = 0; slot < 4; ++slot) {
+      if (layout[slot] == UINT32_MAX)
+        continue;
+      expected.host = slot == 0;
+      expected.local_player = layout[slot];
+      wr32(manager + 0x8c, layout[slot]);
+      wr32(state + 0x24, slot);
+      const uint32_t id_args[] = {layout[slot]};
+      CHECK(invoke(c, 0x00497cc0, manager) == layout[slot]);
+      CHECK(invoke(c, 0x004bb7f0, settings, id_args, 1) == slot);
+      const X86 before = *c;
+      const auto heap = heap_stats();
+      majesty::CoopPlayerBinding binding;
+      CHECK(majesty::coop_player_binding(expected, binding));
+      CHECK(binding.slot == slot && binding.player == layout[slot]);
+      CHECK(std::memcmp(c, &before, sizeof before) == 0);
+      // Observe an acknowledged remote pause without queueing commands or
+      // allocating/serializing a world. Metadata-only fixture, as above.
+      const uint32_t prior_world = rd32(0x0071c68c), prior_phase = rd32(state),
+                     prior_pending = rd32(state + 4), prior_type = rd32(manager + 0x218),
+                     prior_owner = rd32(manager + 0x27c);
+      const uint32_t remote = expected.players[0] == expected.local_player
+                                  ? expected.players[1] : expected.players[0];
+      wr32(0x0071c68c, settings); // Existing valid storage, never read as a world.
+      wr32(state, 7); wr32(state + 4, 0);
+      wr32(manager + 0x218, 3); wr32(manager + 0x27c, remote);
+      majesty::CoopPauseBoundary observed;
+      CHECK(majesty::coop_guest_pause_boundary(expected, observed) == !expected.host);
+      if (!expected.host) CHECK(observed.owner == remote);
+      wr32(manager + 0x27c, expected.local_player);
+      CHECK(!majesty::coop_guest_pause_boundary(expected, observed));
+      wr32(manager + 0x27c, UINT32_MAX);
+      CHECK(!majesty::coop_guest_pause_boundary(expected, observed));
+      wr32(manager + 0x27c, remote); wr32(state + 4, 1);
+      CHECK(!majesty::coop_guest_pause_boundary(expected, observed));
+      wr32(state + 4, 0); wr32(manager + 0x218, 2);
+      CHECK(!majesty::coop_guest_pause_boundary(expected, observed));
+      wr32(0x0071c68c, prior_world); wr32(state, prior_phase);
+      wr32(state + 4, prior_pending); wr32(manager + 0x218, prior_type);
+      wr32(manager + 0x27c, prior_owner);
+      auto refused = [&](recomp_network_session_v1 bad) {
+        binding = {123, 456};
+        CHECK(!majesty::coop_player_binding(bad, binding));
+        CHECK(binding.slot == UINT32_MAX && binding.player == UINT32_MAX);
+      };
+      auto bad = expected;
+      bad.host = 2;
+      refused(bad);
+      bad = expected;
+      bad.player_count = 1;
+      refused(bad);
+      bad.player_count = 5;
+      refused(bad);
+      bad = expected;
+      bad.local_player = 0;
+      refused(bad);
+      bad.local_player = UINT32_MAX;
+      refused(bad);
+      bad = expected;
+      std::swap(bad.players[0], bad.players[1]);
+      refused(bad);
+      bad = expected;
+      bad.players[1] = bad.players[0];
+      refused(bad);
+      if (expected.player_count < 4) {
+        bad = expected;
+        bad.players[expected.player_count] = 999;
+        refused(bad);
+      }
+      wr32(state + 0x24, 4);
+      refused(expected);
+      wr32(state + 0x24, (slot + 1) % 4);
+      refused(expected);
+      wr32(state + 0x24, slot);
+      wr32(manager + 0x8c, layout[slot] ^ 0x40000000u);
+      refused(expected);
+      wr32(manager + 0x8c, layout[slot]);
+      wr32(settings + 0x344 + slot * 4, UINT32_MAX);
+      refused(expected);
+      wr32(settings + 0x344 + slot * 4, layout[slot]);
+      for (const auto address : {0x006d7670u, 0x006d8568u, 0x006d87a0u}) {
+        const auto p = rd32(address);
+        wr32(address, UINT32_MAX);
+        refused(expected);
+        wr32(address, p);
+      }
+      sched_set_guest_thread(false);
+      refused(expected);
+      sched_set_guest_thread(true);
+      const auto after = heap_stats();
+      CHECK(after.used_bytes == heap.used_bytes &&
+            after.used_blocks == heap.used_blocks &&
+            after.total_allocs == heap.total_allocs &&
+            after.total_frees == heap.total_frees);
+      CHECK(rd32(state + 0x24) == slot && rd32(manager + 0x8c) == layout[slot]);
+    }
+  }
+  wr32(state + 0x24, old_slot);
+  wr32(manager + 0x8c, old_player);
+  wr32(settings + 0x4d4, old_count);
+  for (uint32_t i = 0; i < 4; ++i)
+    wr32(settings + 0x344 + i * 4, original[i]);
+}
+// Preserve explicit live-party metadata across a simulated saved roster
+// overwrite. No context constructor, graph reader, world or network is claimed
+// here.
+static void canceled_source_boundary(X86 *c, uint32_t state, uint32_t manager) {
+  const uint32_t settings = rd32(0x006d87a0), prior_world = rd32(0x0071c68c),
+                 prior_clock = rd32(0x0071c6a8);
+  std::array<uint8_t, 0x50> state_before{};
+  std::array<uint8_t, 0x2b0> manager_before{};
+  std::array<uint8_t, 0x4f8> settings_before{};
+  std::memcpy(state_before.data(), g_mem + state, state_before.size());
+  std::memcpy(manager_before.data(), g_mem + manager, manager_before.size());
+  std::memcpy(settings_before.data(), g_mem + settings, settings_before.size());
+  // Private metadata blocks only, not constructed game worlds. Test the same
+  // source admission used before canceled travel can queue original resume.
+  const uint32_t world = alloc(c, 0x20), context = alloc(c, 0x11c),
+                 registry = alloc(c, 0x118);
+  wr32(world, 0x0067f85c); wr32(world + 4, context); wr32(world + 0x10, registry);
+  wr32(context, 0x00682950); wr32(0x0071c68c, world);
+  wr32(state, 7); wr32(state + 4, 0); wr32(state + 0x28, 199);
+  wr32(manager + 0x218, 3); wr32(0x0071c6a8, 9950);
+  wr32(settings + 0x344, 7); wr32(settings + 0x348, 8);
+  wr32(settings + 0x34c, UINT32_MAX); wr32(settings + 0x350, UINT32_MAX);
+  for (uint32_t slot : {0u, 1u}) {
+    recomp_network_session_v1 party{slot == 0, 7 + slot, 2, {7, 8, 0, 0}};
+    wr32(state + 0x24, slot); wr32(manager + 0x8c, party.local_player);
+    const majesty::CoopSourceResumeBoundary source{
+        world, context, registry, state, manager, settings, 3, 199, 9950,
+        {slot, party.local_player}};
+    const auto memory = heap_stats();
+    CHECK(source.matches(party));
+    for (uint32_t address : {0x0071c68cu, 0x006d7670u, 0x006d8568u, 0x006d87a0u,
+                             world + 4, world + 0x10}) {
+      const uint32_t old = rd32(address);
+      for (uint32_t bad : {0u, UINT32_MAX, uint32_t(GUEST_SIZE - 1)}) {
+        wr32(address, bad);
+        CHECK(!source.matches(party)); CHECK(rd32(address) == bad);
+      }
+      wr32(address, old);
+    }
+    for (uint32_t address : {world, context, state + 0x28, 0x0071c6a8u,
+                             manager + 0x218, manager + 0x8c, state + 0x24,
+                             settings + 0x344, settings + 0x348}) {
+      const uint32_t old = rd32(address);
+      wr32(address, old ^ 0x40000000u);
+      CHECK(!source.matches(party)); CHECK(rd32(address) == (old ^ 0x40000000u));
+      wr32(address, old);
+    }
+    auto replaced = source; ++replaced.clock;
+    CHECK(!replaced.matches(party));
+    replaced = source; ++replaced.frame;
+    CHECK(!replaced.matches(party));
+    replaced = source; replaced.binding.slot = slot ^ 1u;
+    CHECK(!replaced.matches(party));
+    replaced = source; replaced.world = 0;
+    CHECK(!replaced.matches(party));
+    replaced = source; replaced.match_type = 2;
+    wr32(manager + 0x218, 2);
+    CHECK(!replaced.matches(party));
+    wr32(manager + 0x218, 3);
+    CHECK(source.matches(party));
+    const auto after = heap_stats();
+    CHECK(after.used_bytes == memory.used_bytes && after.used_blocks == memory.used_blocks &&
+          after.total_allocs == memory.total_allocs && after.total_frees == memory.total_frees);
+  }
+  wr32(0x0071c68c, prior_world); wr32(0x0071c6a8, prior_clock);
+  std::memcpy(g_mem + state, state_before.data(), state_before.size());
+  std::memcpy(g_mem + manager, manager_before.data(), manager_before.size());
+  std::memcpy(g_mem + settings, settings_before.data(), settings_before.size());
+  for (uint32_t p : {registry, context, world}) heap_free(p);
+  CHECK(heap_check().empty());
+}
+static void live_party_metadata(X86 *c, uint32_t state, uint32_t manager) {
+  const uint32_t settings = rd32(0x006d87a0);
+  CHECK(settings && gm_valid(settings, 0x4f8));
+  if (failures)
+    return;
+  std::array<uint8_t, 0x198> original{}, live{}, overwritten{};
+  std::memcpy(original.data(), g_mem + settings + 0x344, original.size());
+  const uint32_t phase = rd32(state), pending = rd32(state + 4),
+                 slot = rd32(state + 0x24), player = rd32(manager + 0x8c),
+                 startup_mode = rd32(settings + 0x6c);
+  for (uint32_t local = 0; local < 2 && !failures; ++local) {
+    recomp_network_session_v1 expected{local == 0, 7 + local, 2, {7, 8, 0, 0}};
+    wr32(settings + 0x344, 7);
+    wr32(settings + 0x348, 8);
+    wr32(settings + 0x34c, UINT32_MAX);
+    wr32(settings + 0x350, UINT32_MAX);
+    wr32(settings + 0x4d4, 2);
+    wr32(state, 7);
+    wr32(state + 4, 0);
+    wr32(state + 0x24, local);
+    wr32(manager + 0x8c, expected.local_player);
+    // Distinct inline names prove retention of the full live metadata block.
+    std::memset(g_mem + settings + 0x364, 'A' + local, 8 * 0x2e);
+    std::memcpy(live.data(), g_mem + settings + 0x344, live.size());
+    const X86 before = *c;
+    const auto heap = heap_stats();
+    majesty::CoopLiveParty party;
+    CHECK(!party.restore(expected));
+    CHECK(party.capture(expected));
+    CHECK(party.binding().slot == local && party.binding().player == 7 + local);
+    std::memset(g_mem + settings + 0x344, 0x55, live.size());
+    CHECK(party.restore(expected));
+    CHECK(!std::memcmp(live.data(), g_mem + settings + 0x344, live.size()));
+    // The reader's temporary mode1 must not replace a retained startup
+    // selector. Exercise selector retention for each local kingdom with
+    // a live manager, without a native world or serializer.
+    for (uint32_t mode : {2u, 3u}) {
+      wr32(settings + 0x6c, mode);
+      CHECK(party.capture(expected));
+      wr32(settings + 0x6c, 1);
+      std::memset(g_mem + settings + 0x344, 0x55, live.size());
+      CHECK(party.restore(expected));
+      CHECK(rd32(settings + 0x6c) == mode);
+      CHECK(!std::memcmp(live.data(), g_mem + settings + 0x344, live.size()));
+      CHECK(rd32(manager + 0x218) >= 1 && rd32(manager + 0x218) <= 3);
+    }
+    CHECK(!party.restore(expected));
+    CHECK(rd32(state + 0x24) == local &&
+          rd32(manager + 0x8c) == expected.local_player &&
+          !std::memcmp(live.data(), g_mem + settings + 0x344, live.size()));
+    sched_set_guest_thread(false);
+    CHECK(!party.capture(expected));
+    sched_set_guest_thread(true);
+    // Wrong epoch/roster is represented by changed provider metadata here;
+    // the actual coordinator must separately query the joined epoch.
+    CHECK(party.capture(expected));
+    std::memset(g_mem + settings + 0x344, 0x66, live.size());
+    std::memcpy(overwritten.data(), g_mem + settings + 0x344, live.size());
+    auto other = expected;
+    other.host ^= 1;
+    wr32(settings + 0x6c, 1);
+    CHECK(!party.restore(other));
+    CHECK(rd32(settings + 0x6c) == 1);
+    CHECK(!std::memcmp(overwritten.data(), g_mem + settings + 0x344,
+                       live.size()));
+    CHECK(!party.restore(expected)); // Refusal consumes the retained block.
+    std::memcpy(g_mem + settings + 0x344, live.data(), live.size());
+    for (const auto root : {0x006d7670u, 0x006d8568u, 0x006d87a0u}) {
+      CHECK(party.capture(expected));
+      const auto saved = rd32(root);
+      wr32(settings + 0x6c, 2);
+      wr32(root, UINT32_MAX);
+      CHECK(!party.restore(expected));
+      wr32(root, saved);
+      CHECK(rd32(settings + 0x6c) == 2);
+      CHECK(!std::memcmp(live.data(), g_mem + settings + 0x344, live.size()));
+    }
+    wr32(state + 4, 3);
+    CHECK(!party.capture(expected));
+    wr32(state + 4, 0);
+    CHECK(party.capture(expected));
+    wr32(state, 3);
+    CHECK(!party.restore(expected));
+    wr32(state, 7);
+    CHECK(!std::memcmp(live.data(), g_mem + settings + 0x344, live.size()));
+    CHECK(std::memcmp(c, &before, sizeof before) == 0);
+    const auto after = heap_stats();
+    CHECK(after.used_bytes == heap.used_bytes &&
+          after.used_blocks == heap.used_blocks &&
+          after.total_allocs == heap.total_allocs &&
+          after.total_frees == heap.total_frees);
+    CHECK(heap_check().empty() && !mods_hook_depth() &&
+          !recomp_callback_depth());
+  }
+  std::memcpy(g_mem + settings + 0x344, original.data(), original.size());
+  wr32(state, phase);
+  wr32(state + 4, pending);
+  wr32(state + 0x24, slot);
+  wr32(manager + 0x8c, player);
+  wr32(settings + 0x6c, startup_mode);
+}
+static void attached_rebuild_transition(X86 *c, uint32_t state, uint32_t manager) {
+  const uint32_t settings = rd32(0x006d87a0);
+  std::array<uint8_t, 0x50> saved_state{};
+  std::array<uint8_t, 0x2b0> saved_manager{};
+  std::array<uint8_t, 0x198> saved_party{};
+  std::memcpy(saved_state.data(), g_mem + state, saved_state.size());
+  std::memcpy(saved_manager.data(), g_mem + manager, saved_manager.size());
+  std::memcpy(saved_party.data(), g_mem + settings + 0x344, saved_party.size());
+  const uint32_t old_world = rd32(0x0071c68c), old_clock = rd32(0x0071c6a8);
+  const uint32_t context = heap_alloc(0x11c, true), world = heap_alloc(0x20, true);
+  CHECK(context && world);
+  if (!context || !world) return;
+  for (uint32_t local : {0u, 1u}) for (bool saved : {false, true}) {
+    majesty::CoopTransition target;
+    majesty::coop_detail::copy("shared-kingdom", target.world);
+    majesty::coop_detail::copy(std::string(64, 'a') + ":" + std::string(64, 'b'), target.content);
+    majesty::coop_detail::copy(std::string(64, 'c'), target.rules);
+    majesty::coop_detail::copy(std::string(64, 'd'), target.source_digest);
+    target.source_revision = 3; target.source_bytes = 500;
+    target.target_x = 1; target.frame = 123; target.clock = 6150;
+    target.target_saved = saved;
+    if (saved) {
+      majesty::coop_detail::copy(std::string(64, 'e'), target.target_digest);
+      target.target_revision = 2; target.target_bytes = 600;
+      target.target_clock = 5000; target.target_gpl_seed = 123; target.target_game_seed = 456;
+    }
+    majesty::CoopTransitionWire wire;
+    CHECK(majesty::encode_coop_transition(target, wire));
+    const recomp_network_session_v1 party{local == 0, 7 + local, 2, {7, 8, 0, 0}};
+    recomp_network_barrier_v1 barrier{19, 2, 2, {7, 8, 0, 0}, uint32_t(wire.size), {}};
+    std::memcpy(barrier.descriptor, wire.bytes.data(), wire.size);
+    wr32(settings + 0x344, 7); wr32(settings + 0x348, 8);
+    wr32(settings + 0x34c, UINT32_MAX); wr32(settings + 0x350, UINT32_MAX);
+    wr32(state, 7); wr32(state + 4, 0); wr32(state + 0x24, local);
+    wr8(state + 0x4c, 0);
+    wr32(state + 0x28, target.frame); wr32(manager + 0x8c, party.local_player);
+    wr32(manager + 0xc0, context); wr32(manager + 0x218, saved ? 3 : 1);
+    wr32(manager + 0x27c, 7); wr32(context, 0x00682950);
+    wr32(context + 0x24, local); wr32(world, 0x0067f85c);
+    wr32(world + 4, context); wr32(world + 0x10, context);
+    wr32(0x0071c68c, world); wr32(0x0071c6a8, target.target_clock);
+    const uint32_t request[] = {2};
+    invoke(c, 0x00416050, state, request, 1);
+    CHECK(rd32(state) == 7 && rd32(state + 4) == 5);
+    const X86 before = *c;
+    const auto heap = heap_stats();
+    const auto apply = [&](const recomp_network_barrier_v1 &b, uint32_t owner = 7) {
+      return majesty::coop_queue_attached_rebuild(c, context, owner, b, party, 19, target);
+    };
+    for (uint32_t stage : {0u, 1u, 3u, 4u}) {
+      auto invalid = barrier; invalid.stage = stage;
+      CHECK(!apply(invalid) && rd32(state + 4) == 5);
+    }
+    auto invalid = barrier; invalid.serial++;
+    CHECK(!apply(invalid) && rd32(state + 4) == 5);
+    invalid = barrier; invalid.descriptor[0] ^= 1;
+    CHECK(!apply(invalid) && rd32(state + 4) == 5);
+    CHECK(!apply(barrier, 9) && rd32(state + 4) == 5);
+    for (uint8_t flag : {uint8_t(1), uint8_t(2), uint8_t(255)}) {
+      wr8(state + 0x4c, flag);
+      CHECK(!apply(barrier) && rd32(state + 4) == 5 &&
+            rd8(state + 0x4c) == flag);
+    }
+    wr8(state + 0x4c, 0);
+    for (const uint32_t address : {state, state + 4, state + 0x24, state + 0x28,
+         manager + 0x8c, manager + 0xc0, manager + 0x218, manager + 0x27c,
+         context, context + 0x24, world, world + 4, world + 0x10,
+         0x0071c68cu, 0x0071c6a8u, 0x006d7670u, 0x006d8568u, 0x006d87a0u}) {
+      const uint32_t original = rd32(address); wr32(address, UINT32_MAX);
+      CHECK(!apply(barrier));
+      CHECK(rd32(state + 4) == (address == state + 4 ? UINT32_MAX : 5));
+      CHECK(rd32(address) == UINT32_MAX); wr32(address, original);
+    }
+    sched_set_guest_thread(false); CHECK(!apply(barrier)); sched_set_guest_thread(true);
+    CHECK(rd32(state + 4) == 5);
+    CHECK(apply(barrier));
+    CHECK(rd32(state) == 7 && rd32(state + 4) == 2);
+    CHECK(rd8(state + 0x4c) == (saved ? 0 : 1));
+    CHECK(!apply(barrier) && rd32(state + 4) == 2);
+    CHECK(rd32(manager + 0x27c) == 7 && rd32(state + 0x28) == target.frame &&
+          rd32(0x0071c6a8) == target.target_clock && !std::memcmp(c, &before, sizeof before));
+    const auto after = heap_stats();
+    CHECK(after.used_bytes == heap.used_bytes && after.used_blocks == heap.used_blocks &&
+          after.total_allocs == heap.total_allocs && after.total_frees == heap.total_frees);
+  }
+  std::memcpy(g_mem + state, saved_state.data(), saved_state.size());
+  std::memcpy(g_mem + manager, saved_manager.data(), saved_manager.size());
+  std::memcpy(g_mem + settings + 0x344, saved_party.data(), saved_party.size());
+  wr32(0x0071c68c, old_world); wr32(0x0071c6a8, old_clock);
+  heap_free(world); heap_free(context);
+}
+static void committed_read_permission() {
+  majesty::CoopTransition target;
+  majesty::coop_detail::copy("shared-kingdom", target.world);
+  majesty::coop_detail::copy(std::string(64, 'a') + ":" + std::string(64, 'b'),
+                             target.content);
+  majesty::coop_detail::copy(std::string(64, 'c'), target.rules);
+  majesty::coop_detail::copy(std::string(64, 'd'), target.source_digest);
+  majesty::coop_detail::copy(std::string(64, 'e'), target.target_digest);
+  target.target_x = 1;
+  target.source_revision = 3;
+  target.source_bytes = 500;
+  target.target_saved = true;
+  target.target_revision = 2;
+  target.target_bytes = 600;
+  target.target_clock = 5000;
+  target.target_gpl_seed = 123;
+  target.target_game_seed = 456;
+  majesty::CoopTransitionWire wire;
+  CHECK(majesty::encode_coop_transition(target, wire));
+  const recomp_network_session_v1 party{0, 8, 2, {7, 8, 0, 0}};
+  recomp_network_barrier_v1 barrier{19, 2, 2, {7, 8, 0, 0}, uint32_t(wire.size),
+                                    {}};
+  std::memcpy(barrier.descriptor, wire.bytes.data(), wire.size);
+  CHECK(majesty::coop_committed_read(barrier, party, 19, target));
+  CHECK(!majesty::coop_committed_read(barrier, party, 0, target));
+  CHECK(!majesty::coop_committed_read(barrier, party, 18, target));
+  auto proposed = barrier;
+  proposed.stage = 1;
+  CHECK(majesty::coop_ready_permission(proposed, party, 19, target, true));
+  CHECK(!majesty::coop_ready_permission(proposed, party, 19, target, false));
+  CHECK(!majesty::coop_ready_permission(proposed, party, 0, target, true));
+  CHECK(!majesty::coop_ready_permission(proposed, party, 18, target, true));
+  CHECK(!majesty::coop_committed_read(proposed, party, 19, target));
+  CHECK(!majesty::coop_resume_permission(proposed, party, 19, target, true));
+  for (const auto stage : {0u, 2u, 3u, 4u, UINT32_MAX}) {
+    auto bad = proposed;
+    bad.stage = stage;
+    CHECK(!majesty::coop_ready_permission(bad, party, 19, target, true));
+  }
+  for (size_t i = 0; i < wire.size; ++i) {
+    auto bad = proposed;
+    bad.descriptor[i] ^= 1;
+    CHECK(!majesty::coop_ready_permission(bad, party, 19, target, true));
+  }
+  for (const auto length : {0u, uint32_t(wire.size - 1),
+                            uint32_t(wire.size + 1), 1025u, UINT32_MAX}) {
+    auto bad = proposed;
+    bad.descriptor_bytes = length;
+    CHECK(!majesty::coop_ready_permission(bad, party, 19, target, true));
+  }
+  for (unsigned mutation = 0; mutation < 7; ++mutation) {
+    auto bad = party;
+    if (mutation == 0)
+      bad.host = 2;
+    if (mutation == 1)
+      bad.local_player = 9;
+    if (mutation == 2)
+      bad.player_count = 1;
+    if (mutation == 3)
+      bad.players[1] = bad.players[0];
+    if (mutation == 4)
+      std::swap(bad.players[0], bad.players[1]);
+    if (mutation == 5)
+      bad.players[2] = 9;
+    if (mutation == 6)
+      bad.local_player = UINT32_MAX;
+    CHECK(!majesty::coop_ready_permission(proposed, bad, 19, target, true));
+  }
+  for (unsigned mutation = 0; mutation < 4; ++mutation) {
+    auto bad = proposed;
+    if (mutation == 0)
+      bad.player_count = 1;
+    if (mutation == 1)
+      bad.players[1] = 9;
+    if (mutation == 2)
+      bad.players[2] = 9;
+    if (mutation == 3)
+      --bad.serial;
+    CHECK(!majesty::coop_ready_permission(bad, party, 19, target, true));
+  }
+  auto complete = barrier;
+  complete.stage = 3;
+  CHECK(majesty::coop_resume_permission(complete, party, 19, target, true));
+  CHECK(!majesty::coop_resume_permission(complete, party, 19, target, false));
+  CHECK(!majesty::coop_resume_permission(complete, party, 18, target, true));
+  CHECK(!majesty::coop_resume_permission(barrier, party, 19, target, true));
+  for (const auto stage : {0u, 1u, 2u, 4u, UINT32_MAX}) {
+    auto changed = complete;
+    changed.stage = stage;
+    CHECK(!majesty::coop_resume_permission(changed, party, 19, target, true));
+  }
+  for (size_t i = 0; i < wire.size; ++i) {
+    auto changed = complete;
+    changed.descriptor[i] ^= 1;
+    CHECK(!majesty::coop_resume_permission(changed, party, 19, target, true));
+  }
+  for (uint32_t size = 0; size < wire.size; ++size) {
+    auto changed = complete;
+    changed.descriptor_bytes = size;
+    CHECK(!majesty::coop_resume_permission(changed, party, 19, target, true));
+  }
+  for (const auto size : {uint32_t(wire.size + 1), 1025u, UINT32_MAX}) {
+    auto changed = complete;
+    changed.descriptor_bytes = size;
+    CHECK(!majesty::coop_resume_permission(changed, party, 19, target, true));
+  }
+  for (const auto id : {0u, 6u, UINT32_MAX}) {
+    auto wrong = party;
+    wrong.local_player = id;
+    CHECK(!majesty::coop_resume_permission(complete, wrong, 19, target, true));
+    CHECK(!majesty::coop_committed_read(barrier, wrong, 19, target));
+  }
+  for (const auto count : {0u, 1u, 5u, UINT32_MAX}) {
+    auto wrong = party;
+    wrong.player_count = count;
+    CHECK(!majesty::coop_resume_permission(complete, wrong, 19, target, true));
+  }
+  for (unsigned i = 0; i < 4; ++i) {
+    auto changed = complete;
+    changed.players[i] ^= 1;
+    CHECK(!majesty::coop_resume_permission(changed, party, 19, target, true));
+  }
+  auto bad_party = party;
+  bad_party.host = 2;
+  CHECK(
+      !majesty::coop_resume_permission(complete, bad_party, 19, target, true));
+  bad_party = party;
+  bad_party.players[1] = bad_party.players[0];
+  CHECK(
+      !majesty::coop_resume_permission(complete, bad_party, 19, target, true));
+  bad_party = party;
+  std::swap(bad_party.players[0], bad_party.players[1]);
+  CHECK(
+      !majesty::coop_resume_permission(complete, bad_party, 19, target, true));
+  bad_party = party;
+  bad_party.players[2] = 9;
+  CHECK(
+      !majesty::coop_resume_permission(complete, bad_party, 19, target, true));
+  for (const auto stage : {0u, 1u, 3u, 4u, UINT32_MAX}) {
+    auto changed = barrier;
+    changed.stage = stage;
+    CHECK(!majesty::coop_committed_read(changed, party, 19, target));
+  }
+  for (const auto length : {0u, uint32_t(wire.size - 1),
+                            uint32_t(wire.size + 1), 1025u, UINT32_MAX}) {
+    auto changed = barrier;
+    changed.descriptor_bytes = length;
+    CHECK(!majesty::coop_committed_read(changed, party, 19, target));
+  }
+  auto changed = barrier;
+  changed.descriptor[wire.size / 2] ^= 1;
+  CHECK(!majesty::coop_committed_read(changed, party, 19, target));
+  changed = barrier;
+  changed.players[1] = 9;
+  CHECK(!majesty::coop_committed_read(changed, party, 19, target));
+  changed = barrier;
+  changed.players[3] = 9;
+  CHECK(!majesty::coop_committed_read(changed, party, 19, target));
+  changed = barrier;
+  changed.player_count = 3;
+  CHECK(!majesty::coop_committed_read(changed, party, 19, target));
+  auto wrong = target;
+  ++wrong.target_revision;
+  CHECK(!majesty::coop_committed_read(barrier, party, 19, wrong));
+  wrong = target;
+  wrong.world_seed = 71202;
+  CHECK(!majesty::coop_committed_read(barrier, party, 19, wrong));
+  wrong = target;
+  wrong.target_saved = false;
+  CHECK(!majesty::coop_committed_read(barrier, party, 19, wrong));
+  // Fresh and saved agreements must never authorize each other's operation.
+  auto fresh = target;
+  fresh.target_saved = false;
+  fresh.target_revision = fresh.target_bytes = 0;
+  fresh.target_clock = fresh.target_gpl_seed = fresh.target_game_seed = 0;
+  fresh.target_digest = {};
+  majesty::CoopTransitionWire fresh_wire;
+  CHECK(majesty::encode_coop_transition(fresh, fresh_wire));
+  auto fresh_barrier = barrier;
+  fresh_barrier.descriptor_bytes = uint32_t(fresh_wire.size);
+  std::memcpy(fresh_barrier.descriptor, fresh_wire.bytes.data(), fresh_wire.size);
+  CHECK(majesty::coop_committed_generate(fresh_barrier, party, 19, fresh));
+  CHECK(!majesty::coop_committed_read(fresh_barrier, party, 19, fresh));
+  CHECK(!majesty::coop_committed_generate(barrier, party, 19, target));
+  CHECK(!majesty::coop_committed_generate(fresh_barrier, party, 18, fresh));
+  CHECK(!majesty::coop_resume_permission(fresh_barrier, party, 19, fresh, true));
+  fresh_barrier.stage = 1;
+  CHECK(majesty::coop_ready_permission(fresh_barrier, party, 19, fresh, true));
+  CHECK(!majesty::coop_ready_permission(fresh_barrier, party, 19, fresh, false));
+  CHECK(!majesty::coop_committed_generate(fresh_barrier, party, 19, fresh));
+  fresh_barrier.stage = 3;
+  CHECK(!majesty::coop_resume_permission(fresh_barrier, party, 19, fresh, false));
+  CHECK(majesty::coop_resume_permission(fresh_barrier, party, 19, fresh, true));
+  CHECK(!majesty::coop_committed_generate(fresh_barrier, party, 19, fresh));
+}
+// Exercise the original formatter against independent expected names.
+// No serializer or personal profile is used.
+static void checkpoint_names(X86 *c) {
+  char profile[1024];
+  std::snprintf(profile, sizeof profile, "%s/majesty-coop-path-XXXXXX",
+                os_temp_dir());
+  CHECK(os_mkdtemp(profile) == 0);
+  if (failures)
+    return;
+  mods_overlay_set_profile_dir(profile);
+  mods_overlay_reset();
+  const uint32_t buffer = alloc(c, 256), name = alloc(c, 12),
+                 output = alloc(c, 12);
+  const char root[] = "Documents\\My Games\\MajestyHD\\SaveGame";
+  std::memcpy(g_mem + buffer, root, sizeof root);
+  const uint32_t root_args[] = {buffer, sizeof root - 1};
+  invoke(c, 0x004e3590, 0x006d8370, root_args, 2);
+  const uint32_t serializer = invoke(c, 0x00435d00, 0);
+  CHECK(serializer && gm_valid(serializer, 12) &&
+        rd32(serializer) == 0x00680c60 &&
+        rd32(rd32(serializer) + 0x4c) == 0x00435c60);
+  for (const char *label : {"CoopTransitions_shared-kingdom_0_0_0",
+                            "CoopTransitions_shared-kingdom_-1_0_1",
+                            "CoopTransitions_shared-kingdom_1000000_-1000000_0",
+                            "CoopTransitions_shared-kingdom/0_0_0"}) {
+    const uint32_t length = uint32_t(std::strlen(label));
+    std::memcpy(g_mem + buffer, label, length + 1);
+    const uint32_t init_name[] = {buffer, length};
+    invoke(c, 0x004e3590, name, init_name, 2);
+    invoke(c, 0x004e3340, output);
+    const uint32_t args[] = {output, name};
+    invoke(c, 0x00435c60, serializer, args, 2);
+    const uint32_t text = rd32(output), size = rd32(output + 8);
+    CHECK(text && size && size < 1024 && gm_valid(text, size));
+    if (text && size && size < 1024 && gm_valid(text, size)) {
+      std::string path(reinterpret_cast<const char *>(g_mem + text), size);
+      for (auto &ch : path)
+        if (ch == '\\')
+          ch = '/';
+      std::fprintf(stderr, "checkpoint name: %s\n", path.c_str());
+      const auto basename = std::strrchr(label, '/');
+      const std::string expected =
+          std::string("Documents/My Games/MajestyHD/SaveGame/") +
+          (basename ? basename + 1 : label) + ".GMP";
+      CHECK(path == expected);
+      const auto host_path = win32_host_path_op(path, WIN32_FILE_WRITE);
+      CHECK(host_path == std::string(profile) + "/" + expected);
+      const auto parent = host_path.substr(0, host_path.find_last_of('/'));
+      CHECK(majesty::coop_checkpoint_parent(profile, parent));
+      CHECK(parent.substr(0, parent.find_last_of('/')) != profile);
+      CHECK(std::string(reinterpret_cast<const char *>(g_mem + rd32(name)),
+                        rd32(name + 8)) == label);
+    }
+    invoke(c, 0x004e3820, output);
+    invoke(c, 0x004e3820, name);
+  }
+  invoke(c, 0x004e3820, 0x006d8370);
+  for (auto address : {buffer, name, output}) {
+    const uint32_t release[] = {address};
+    invoke(c, 0x00645bc0, 0, release, 1);
+  }
+  win32_set_file_ops(nullptr, nullptr);
+  for (const char *part :
+       {"Documents/My Games/MajestyHD/SaveGame", "Documents/My Games/MajestyHD",
+        "Documents/My Games", "Documents"})
+    CHECK(os_rmdir((std::string(profile) + "/" + part).c_str()) == 0);
+  CHECK(os_rmdir(profile) == 0);
+}
+// Independently laid out metadata chunks, not a fabricated native context or
+// a loadable game graph. Exercise the same bounded reader used by host Begin.
+static void saved_metadata() {
+  char folder[1024];
+  std::snprintf(folder, sizeof folder, "%s/majesty-coop-metadata-XXXXXX",
+                os_temp_dir());
+  CHECK(os_mkdtemp(folder) == 0);
+  if (failures)
+    return;
+  const std::string path = std::string(folder) + "/metadata.GMP";
+  std::array<uint8_t, 408> data{};
+  const auto word = [](auto &bytes, unsigned at, uint32_t value) {
+    for (unsigned i = 0; i < 4; ++i)
+      bytes[at + i] = uint8_t(value >> (8 * i));
+  };
+  std::memcpy(data.data(), "VERS", 4);
+  word(data, 4, 256);
+  word(data, 8, 1);
+  std::memcpy(data.data() + 272, "SVGD", 4);
+  word(data, 276, 64);
+  word(data, 280, 10);
+  std::memcpy(data.data() + 288, "save\0quest\0", 11);
+  word(data, 299, 71820);
+  word(data, 327, 0x23456789);
+  std::memcpy(data.data() + 352, "GPL ", 4);
+  word(data, 356, 40);
+  word(data, 360, 1);
+  word(data, 368, 40);
+  word(data, 372, 3);
+  word(data, 376, 0x12345678);
+  word(data, 404, UINT32_MAX);
+  const auto write = [&](const auto &bytes, size_t size) {
+    const int fd =
+        os_fd_open(path.c_str(), OS_O_WRONLY | OS_O_CREAT | OS_O_TRUNC);
+    CHECK(fd >= 0);
+    if (fd < 0)
+      return false;
+    const bool done = os_fd_write(fd, bytes.data(), size) == int64_t(size);
+    return os_fd_close(fd) == 0 && done;
+  };
+  uint32_t clock = 0, seed = 0, game = 0;
+  CHECK(write(data, data.size()));
+  CHECK(majesty_browser_coop_saved_metadata(path.c_str(), clock, seed, game));
+  CHECK(clock == 71820 && seed == 0x12345678 && game == 0x23456789);
+  for (size_t n = 0; n < data.size(); ++n) {
+    CHECK(write(data, n));
+    clock = seed = game = 99;
+    CHECK(
+        !majesty_browser_coop_saved_metadata(path.c_str(), clock, seed, game));
+    CHECK(!clock && !seed && !game);
+  }
+  for (unsigned mutation = 0; mutation < 11; ++mutation) {
+    auto bad = data;
+    if (mutation == 0)
+      bad[0] = 'v';
+    if (mutation == 1)
+      word(bad, 4, UINT32_MAX);
+    if (mutation == 2)
+      word(bad, 280, 11);
+    if (mutation == 3)
+      bad[288] = 0;
+    if (mutation == 4)
+      word(bad, 327, 0);
+    if (mutation == 5)
+      word(bad, 360, 2);
+    if (mutation == 6)
+      word(bad, 368, 39);
+    if (mutation == 7)
+      word(bad, 372, 4);
+    if (mutation == 8)
+      word(bad, 376, 0);
+    if (mutation == 9)
+      word(bad, 400, 1);
+    if (mutation == 10)
+      word(bad, 404, 0);
+    CHECK(write(bad, bad.size()));
+    clock = seed = game = 99;
+    CHECK(
+        !majesty_browser_coop_saved_metadata(path.c_str(), clock, seed, game));
+    CHECK(!clock && !seed && !game);
+  }
+  CHECK(!majesty_browser_coop_saved_metadata(nullptr, clock, seed, game));
+  CHECK(!majesty_browser_coop_saved_metadata("", clock, seed, game));
+  CHECK(!majesty_browser_coop_saved_metadata(std::string(1024, 'a').c_str(),
+                                             clock, seed, game));
+  CHECK(!clock && !seed && !game);
+  CHECK(os_unlink(path.c_str()) == 0);
+  CHECK(os_rmdir(folder) == 0);
+}
