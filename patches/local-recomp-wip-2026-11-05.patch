+            cross_destination ? binding.destination_bytes : c.unit_bytes;
+        const uint32_t source = guest_call(&extra, 0x005a10d0, preserved_id);
+        passed = source && gm_valid(source, 0x164) && rd32(source) == 0x0068098c;
