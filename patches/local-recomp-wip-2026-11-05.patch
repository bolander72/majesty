+static Slot *slot(uint32_t role, uint32_t bank, uint32_t index = UINT32_MAX) {
+    for (uint32_t i = 0; i < s.input->count; ++i) {
+        Slot &r = s.input->slots[i];
+        if (r.role == role && r.bank == bank && r.index == index)
+            return &r;
+    }
+    return nullptr;
+}
+static uint32_t reserve_heap(void *, uint32_t bytes) {
+    return heap_alloc(bytes, false);
+}
+static bool release_heap(void *, uint32_t address, uint32_t) {
+    if (!s.free_inv)
+        return heap_free(address); // stopped whole-journal rollback
+    REQUIRE(s.phase == Destroying && s.free_cpu && heap_owns(address));
+    REQUIRE(api.call_next(&api, s.free_inv, s.free_cpu) == POP_OK);
+    return !heap_owns(address); // definitive original CRT free outcome
+}
+static bool extent(uint32_t at, uint32_t n, uint32_t start, uint32_t size) {
+    return at >= start && uint64_t(at) + n <= uint64_t(start) + size;
+}
+static bool owned(uint32_t at, uint32_t n) {
+    for (uint32_t i = 0; i < s.input->count; ++i) {
+        Slot &r = s.input->slots[i];
+        if (r.address && extent(at, n, r.address, r.bytes))
+            return true;
+    }
+    return false;
+}
+static bool stack(uint32_t at, uint32_t n) {
+    return extent(at, n, s.stack_lo, s.stack_hi - s.stack_lo);
+}
+static bool allow_claim(void *, const majesty::orders::Request &request) {
+    Slot *r = slot(static_cast<uint32_t>(request.role), request.bank, request.index);
+    REQUIRE(r && !r->claimed && r->kind == request.kind && r->bytes == request.bytes &&
+            (r->address || !r->bytes));
+    if (request.role == majesty::orders::Role::BaseName ||
+        request.role == majesty::orders::Role::LeafName) {
+        REQUIRE(r->bytes == 1);
+        if (static_cast<uint32_t>(request.role) == s.reject_name) {
+            s.name_rejected = true;
+            s.rejected_name_address = r->address;
+            return false;
+        }
+    }
+    if (uint32_t(r - s.input->slots) == s.reject_slot) {
+        // Deterministic controller refusal of this owned allocation. The
+        // guest never receives its reservation, and the rejecting statement's
+        // successor must not execute. This is not a real allocator OOM.
+        s.rejected = true;
+        return false;
+    }
+    r->claimed = true;
+    if (r->role == Order)
