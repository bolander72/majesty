+static void connected_return_geometry() {
+  const uint32_t context = heap_alloc(0x11c, true), terrain = heap_alloc(0x54, true),
+                 grid = heap_alloc(0x50, true), vertices = heap_alloc(129u * 129u * 24u, true),
+                 paths = heap_alloc(256u * 256u * 4u, true),
+                 actors = heap_alloc(256u * 256u * 4u, true);
+  CHECK(context && terrain && grid && vertices && paths && actors);
+  if (!context || !terrain || !grid || !vertices || !paths || !actors) return;
+  wr32(context, 0x00682950u); wr32(context + 0x80, terrain); wr32(context + 0x88, grid);
+  wr32(terrain, 0x0068b660u); wr32(terrain + 0x30, 128); wr32(terrain + 0x34, 128);
+  wr32(terrain + 0x38, 129); wr32(terrain + 0x3c, 129); wr32(terrain + 0x4c, vertices);
+  wr32(grid, 0x0068a25cu); wr32(grid + 0x48, 256); wr32(grid + 0x4c, 256);
+  wr32(grid + 0x14, paths); wr32(grid + 0x18, actors);
+  const auto populate = [&](int32_t x, int32_t y) {
+    for (uint32_t py = 0; py <= 128; ++py)
+      for (uint32_t px = 0; px <= 128; ++px)
+        wr32(vertices + (py * 129 + px) * 24,
+             uint32_t(majesty::coop_connected_height(int64_t(x) * 128 + px,
+                                                     int64_t(y) * 128 + py)));
+  };
+  const auto edge_hash = [&](uint32_t x) {
+    uint32_t hash = 2166136261u;
+    for (uint32_t y = 0; y <= 128; ++y) {
+      const uint32_t h = rd32(vertices + (y * 129 + x) * 24);
+      for (unsigned byte = 0; byte < 4; ++byte)
+        hash = (hash ^ ((h >> (byte * 8)) & 255u)) * 16777619u;
+    }
+    return hash;
+  };
+  // Golden edges measured from the two original generated native383 worlds.
+  populate(0, 0); CHECK(edge_hash(0) == 0xa7aad629u); CHECK(edge_hash(128) == 0x6abcc3b9u);
+  populate(1, 0); CHECK(edge_hash(0) == 0x6abcc3b9u); CHECK(edge_hash(128) == 0x95ec81cbu);
+  for (const auto coordinate : std::array<std::array<int32_t, 2>, 6>{{
+           {{0, 0}}, {{1, 0}}, {{-1, -1}}, {{-1, 1}},
+           {{1000000, -1000000}}, {{-1000000, 1000000}}}}) {
+    const auto x = coordinate[0], y = coordinate[1];
+    populate(x, y);
+    CHECK(majesty::coop_connected_context(context, x, y));
+    // Original foundations and occupied spatial rows survive admission.
+    const uint32_t interior = vertices + (64 * 129 + 64) * 24;
+    wr32(interior, 0x7fffffffu); wr32(paths + 400, context); wr32(actors + 400, context);
+    CHECK(majesty::coop_connected_context(context, x, y));
+    CHECK(rd32(interior) == 0x7fffffffu && rd32(paths + 400) == context && rd32(actors + 400) == context);
+    // A damaged edge, including every corner, is refused without repair.
+    for (uint32_t i = 0; i <= 128; ++i)
+      for (const uint32_t index : {i * 129, i * 129 + 128, i, 128 * 129 + i}) {
+        const uint32_t address = vertices + index * 24, previous = rd32(address);
+        wr32(address, previous ^ 1u);
+        CHECK(!majesty::coop_connected_context(context, x, y));
+        CHECK(rd32(address) == (previous ^ 1u));
+        wr32(address, previous);
+      }
+    CHECK(!majesty::coop_connected_context(context, x == 1000000 ? x - 1 : x + 1, y));
+  }
+  populate(0, 0);
+  for (const uint32_t address : {context, terrain, grid, terrain + 0x30, terrain + 0x34,
+                                 terrain + 0x38, terrain + 0x3c, grid + 0x48, grid + 0x4c}) {
+    const uint32_t previous = rd32(address);
+    wr32(address, previous + 1);
+    CHECK(!majesty::coop_connected_context(context, 0, 0));
+    CHECK(rd32(address) == previous + 1);
+    wr32(address, previous);
+  }
+  for (const uint32_t address : {context + 0x80, context + 0x88, terrain + 0x4c, grid + 0x14, grid + 0x18}) {
+    const uint32_t previous = rd32(address);
+    for (const uint32_t invalid : {0u, UINT32_MAX, uint32_t(GUEST_SIZE - 1)}) {
+      wr32(address, invalid);
+      CHECK(!majesty::coop_connected_context(context, 0, 0));
+      CHECK(rd32(address) == invalid);
+    }
+    wr32(address, previous);
+  }
+  CHECK(!majesty::coop_connected_context(0, 0, 0));
+  CHECK(!majesty::coop_connected_context(UINT32_MAX, 0, 0));
+  CHECK(!majesty::coop_connected_context(context, 1000001, 0));
+  CHECK(!majesty::coop_connected_context(context, 0, -1000001));
+  CHECK(majesty::coop_connected_context(context, 0, 0));
+  for (const uint32_t p : {actors, paths, vertices, grid, terrain, context}) heap_free(p);
+  CHECK(heap_check().empty());
+}
