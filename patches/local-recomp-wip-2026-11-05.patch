+               counter_same = rd32(runtime + 0x34) == counter,
+               registrations_same = rd32(manager + 0x34) == registrations,
+               clock_same = rd32(0x0071c6a8) == clock,
+               hooks_same = mods_hooks_installed_count() == hooks;
