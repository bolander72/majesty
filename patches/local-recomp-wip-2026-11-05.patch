+                        ? s.lifecycle_constructing && !rd32(cpu->esp + 4)
+                        : !s.lifecycle_constructing && cpu->ecx == unit && rd32(cpu->esp + 4) == 1);
+            if (fn == VEHICLE_CREATE)
