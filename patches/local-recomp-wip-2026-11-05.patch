+            CHECK(!bridge.handoff_unit_orders(unit + 4));
+            ++transfer_refusals;
+            wr32(unit, UNIT_TABLE + 4);
+            CHECK(!bridge.handoff_unit_orders(unit));
+            ++transfer_refusals;
+            wr32(unit, UNIT_TABLE);
+            for (uint32_t bank = 0; bank < 3; ++bank) {
+                uint32_t field = unit + UNIT_BANKS + bank * 4;
+                uint32_t saved = rd32(field);
+                wr32(field, 0);
+                CHECK(!bridge.handoff_unit_orders(unit));
+                ++transfer_refusals;
+                CHECK(journal.state() == majesty::orders::State::Reserved &&
+                      journal.fully_claimed());
+                wr32(field, saved);
+            }
+            CHECK(bridge.handoff_unit_orders(unit));
+            s.engine_owned = journal.state() == majesty::orders::State::Transferred;
+            CHECK(s.engine_owned && !bridge.complete() && !journal.fully_claimed());
+            CHECK(!bridge.handoff_unit_orders(unit));
+            CHECK(journal.owned_request_bytes() == 0 && journal.release() &&
+                  journal.state() == majesty::orders::State::Transferred);
+            CHECK(heap_stats().used_bytes == before.used_bytes &&
+                  heap_stats().used_blocks == before.used_blocks);
+            CHECK(journal.invoke_cleanup(cpu, UNIT_CLEAR, nullptr, 0).status ==
+                  GuestCallGuardedStatus::InvalidCall);
