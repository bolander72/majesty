+  // the writer is never called while committed metadata cannot be trusted.
+  for (size_t n = 0; n < committed.size(); ++n) {
+    CHECK(write(marker, std::string_view(committed).substr(0, n)));
+    CHECK(store.read().status == CoopCheckpointStore::Status::invalid);
+  }
+  CHECK(write(marker, committed));
+  for (auto changed : std::vector<std::string>{committed + "extra\n",
+                                               committed + std::string(1, '\0'),
+                                               std::string(768, 'a')}) {
+    CHECK(write(marker, changed));
+    const auto prior = writes;
+    CHECK(!store.commit(0, 0, writer, valid, selected));
+    CHECK(writes == prior);
+  }
+  CHECK(write(marker, committed));
+  for (unsigned field = 0; field < 6; ++field) {
+    auto bad = identity;
+    if (field == 0)
+      coop_detail::copy("other", bad.world);
+    if (field == 1)
+      bad.content[0] = 'd';
+    if (field == 2)
+      bad.rules[0] = 'd';
+    if (field == 3)
+      bad.x = 1;
+    if (field == 4)
+      bad.y = 1;
+    if (field == 5)
+      bad.world.back() = 'a';
+    const CoopCheckpointStore foreign(marker, slots, bad);
+    CHECK(foreign.read().status == CoopCheckpointStore::Status::invalid);
+    const auto prior = writes;
+    CHECK(!foreign.commit(0, 0, writer, valid, selected));
+    CHECK(writes == prior);
+  }
+  const CoopCheckpointStore alias(marker, {marker, slots[1]}, identity);
+  CHECK(!alias.commit(0, 0, writer, valid, selected));
+  const CoopCheckpointStore repeated(marker, {slots[0], slots[0]}, identity);
+  CHECK(!repeated.commit(0, 0, writer, valid, selected));
+  std::string exhausted = committed;
+  const auto revision = exhausted.find("\n2\n3\n");
+  CHECK(revision != exhausted.npos);
+  exhausted.replace(revision, 5, "\n18446744073709551615\n3\n");
+  CHECK(write(marker, exhausted));
+  CHECK(store.read().revision == UINT64_MAX);
+  const auto count = writes;
+  CHECK(!store.commit(0, 0, writer, valid, selected));
+  CHECK(writes == count);
+  CHECK(write(marker, committed));
+  for (unsigned i = 0; i < 20; ++i) {
+    CHECK(store.commit(20001 + i, 31900 + 50 * i, writer, valid, selected));
+    const auto observed = CoopCheckpointStore(marker, slots, identity).read();
+    CHECK(observed.status == CoopCheckpointStore::Status::valid &&
+          observed.slot == int(i % 2) && observed.revision == 3 + i &&
+          observed.frame == 20001 + i && observed.clock == 31900 + 50 * i);
+    CHECK(absent(marker + ".tmp"));
+  }
+  test_import(root, identity);
+  test_lobby_resume(root, identity);
+  test_shared_target_import(root, identity);
+  test_transfer_file(root, hierarchy.back(), identity);
+  const auto slot = store.read().slot;
+  CHECK(write(slots[slot], "abd"));
+  CHECK(store.read().status == CoopCheckpointStore::Status::invalid);
+  CHECK(!store.capture_allowed(false) && !store.capture_allowed(true));
+  CHECK(!store.commit(0, 0, writer, valid, selected));
+  for (const auto &path : slots)
+    CHECK(os_unlink(path.c_str()) == 0);
+  CHECK(os_unlink(marker.c_str()) == 0);
+  for (auto it = hierarchy.rbegin(); it != hierarchy.rend(); ++it)
+    CHECK(os_rmdir(it->c_str()) == 0);
+  CHECK(os_rmdir(directory) == 0);
+  std::printf("%u cooperative checkpoint store checks, %u failures\n", checks,
+              failures);
+  return failures ? 1 : 0;
+}
