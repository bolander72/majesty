+  int64_t y = std::clamp(s.arrival_source_y, int64_t(0), camera.max_y);
+  if (s.arrival_direction == 0) x = camera.max_x;
+  if (s.arrival_direction == 3) x = 0;
+  if (s.arrival_direction == 1) y = camera.max_y;
+  if (s.arrival_direction == 2) y = 0;
