+        stderr,
+        "[coop-rebuild-fixture] Hold load=%u region=%s step=%s context=%08x "
+        "phase=%u pending=%u owner=%u frame=%u clock=%u gameplay-ticks=%u "
+        "cpu-same=1 original=1 record-frees=%u,%u hooks-same=1 network=0 "
+        "result=pass\n",
