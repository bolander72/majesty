+    }
+    if (s.engine_owned && s.engine_cookie && guest_call_guarded_cookie(s.cpu) == s.engine_cookie) {
+        REQUIRE(s.phase == Destroying && journal.state() == majesty::orders::State::Transferred &&
+                !journal.invocation_active() && !journal.eligible_cookie());
+        REQUIRE(fn != ALLOC); // process managers must be initialized before owned cleanup
+        if (fn == CRT_FREE && rd32(cpu->esp + 4)) {
+            uint32_t address = rd32(cpu->esp + 4);
+            Slot *matched = nullptr;
+            for (uint32_t i = 0; i < s.input->count; ++i)
+                if (s.input->slots[i].address == address)
+                    matched = &s.input->slots[i];
+            REQUIRE(matched && matched->claimed && !matched->freed && heap_owns(address));
+            REQUIRE(a->call_next(a, inv, cpu) == POP_OK && !heap_owns(address));
+            matched->freed = true;
+            ++transferred_free_calls;
+            return;
+        }
+        if (fn == 0x00523420) {
+            REQUIRE(owned(rd32(cpu->esp + 4), 16));
+            ++name_clear_calls;
+        }
+        REQUIRE(a->call_next(a, inv, cpu) == POP_OK);
+        return;
+    }
+    if (fn == 0x004ad190 && journal.invocation_active() && !journal.eligible_cookie()) {
+        ++nested_hidden_checks;
+        CHECK(!journal.release());
+        CHECK(s.hooks && !s.hooks->remove() && s.hooks->installed_count() == 4);
+        uint32_t ignored = 0;
+        const auto *b = journal.find(majesty::orders::Role::Head, 0);
+        CHECK(b && !journal.claim(b->request, &ignored));
+        CHECK(s.bridge->observe_unit_bank(s.cpu, CTOR, slot(Bank, 0)->address, unit, 0, false)
+                  .action == majesty::orders::AllocationAction::Delegate);
+        CHECK(a->call_next(a, inv, cpu) == POP_OK && cpu->eax == 0x00683148);
+        return;
+    }
+    if (!journal.eligible_cookie()) {
+        if (fn == GPL_RUNTIME_DELETE) {
+            CHECK(rd32(GPL_RESOURCE_GLOBAL) && !rd32(cpu->esp + 4));
+            ++resource_delete_entries;
+            CHECK(a->call_next(a, inv, cpu) == POP_OK && !rd32(GPL_RESOURCE_GLOBAL));
+            return;
+        }
+        CHECK(a->call_next(a, inv, cpu) == POP_OK);
+        return;
+    }
+    REQUIRE(journal.invocation_active() && !journal.release());
+    REQUIRE(!s.bridge->handoff_unit_orders(unit));
+    if (fn == CTOR || fn == READ || fn == ALLOC || fn == 0x0064d59f) {
+        REQUIRE(s.phase == Reading && s.hooks);
+        if (fn == CTOR || fn == READ) {
+            X86 foreign = *s.cpu;
+            REQUIRE(
+                s.bridge->observe_unit_bank(&foreign, fn, cpu->ecx, rd32(cpu->esp + 4), 0, false)
+                    .action == majesty::orders::AllocationAction::Delegate);
+        }
+        if (fn == 0x0064d59f)
+            REQUIRE(s.name_target && cpu->ebx == s.name_target);
+        // Observe only: the game-owned runtime hook handles all owned claims.
+        REQUIRE(a->call_next(a, inv, cpu) == POP_OK);
+        return;
+    } else if (fn == FREE || fn == CRT_FREE) {
+        REQUIRE(s.phase == Destroying && journal.cleanup_started());
+        if (fn == FREE || !rd32(cpu->esp + 4)) {
+            REQUIRE(a->call_next(a, inv, cpu) == POP_OK);
+            return;
+        }
+        uint32_t address = rd32(cpu->esp + 4);
+        Slot *matched = nullptr;
+        for (uint32_t i = 0; i < s.input->count; ++i)
+            if (s.input->slots[i].address == address)
+                matched = &s.input->slots[i];
+        REQUIRE(matched && !s.free_inv);
+        const auto *b = journal.find(static_cast<majesty::orders::Role>(matched->role),
+                                     matched->bank, matched->index);
+        REQUIRE(b && b->owned && b->claimed && b->address == address);
+        s.free_inv = inv;
+        s.free_cpu = cpu;
+        REQUIRE(journal.retire(b->request, address));
+        s.free_inv = nullptr;
+        s.free_cpu = nullptr;
+        ++original_free_calls;
+        return; // port ran the original body and its return; no second RET/free
+    } else if (fn == 0x00523420 || fn == 0x00523450) {
+        REQUIRE(s.phase == Reading || s.phase == Destroying);
+        uint32_t target = rd32(cpu->esp + 4);
+        REQUIRE(owned(target, 16));
+        if (fn == 0x00523450) {
+            REQUIRE(s.phase == Reading && rd32(target) == 0);
+            uint32_t source = rd32(cpu->esp + 8);
+            static const uint8_t zeros[32] = {};
+            REQUIRE(stack(source, 32) && !std::memcmp(g_mem + source, zeros, 32));
+            REQUIRE(!s.name_target);
+            s.name_target = target;
+            // Original copier scans/copies into a pre-reserved one-byte extent.
+            REQUIRE(a->call_next(a, inv, cpu) == POP_OK);
+            REQUIRE(cpu->eax == 1 && rd32(target) && gm_valid(rd32(target), 1) &&
+                    !rd8(rd32(target)));
+            s.name_target = 0;
+            ++name_copy_calls;
+        } else {
+            REQUIRE(a->call_next(a, inv, cpu) == POP_OK && rd32(target) == 0);
+            ++name_clear_calls;
+        }
+        return; // original helper supplies its own return/register behavior
+    } else {
+        REQUIRE(cpu->ecx == stream);
+        bool scalar_read = one_of(fn, 0x004ef790, 0x004ef740, 0x004ef880, 0x004ef920);
+        bool scalar_write = one_of(fn, 0x004eed10, 0x004eec70, 0x004eecc0, 0x004eee50);
+        if (scalar_read || fn == 0x004ef700) {
+            REQUIRE(s.phase == Reading);
+            if (!nested_checked) {
+                nested_checked = true;
+                X86 saved = *s.cpu;
+                s.cpu->r[R_ECX] = slot(Bank, 0)->address;
+                ++calls; // extra ordinary original callback, outside Journal::invoke
+                REQUIRE(guest_call(s.cpu, 0x004ad190) == 0x00683148);
+                *s.cpu = saved;
+                REQUIRE(journal.eligible_cookie() && journal.invocation_active());
+            }
+            uint32_t target = rd32(cpu->esp + 4);
+            uint32_t n = scalar_read ? 4 : rd32(cpu->esp + 8);
+            REQUIRE(scalar_read || n == 12 || n == 56);
+            Payload &p = s.input->banks[s.bank];
+            uint32_t offset = 0;
+            if (s.unit_stream)
+                for (uint32_t bank = 0; bank < s.bank; ++bank)
+                    offset += s.input->banks[bank].size;
+            REQUIRE(n <= p.size && s.cursor >= offset && s.cursor - offset <= p.size - n);
+            REQUIRE(owned(target, n) || stack(target, n));
+            REQUIRE(a->call_next(a, inv, cpu) == POP_OK);
+            s.cursor = rd32(stream_buffer + 0x28) - stream_data - 16;
+            s.status = cpu->eax;
+            REQUIRE(s.cursor <= s.stream_limit);
+        } else if (fn == 0x004ef6c0) {
+            REQUIRE(s.phase == Reading);
+            REQUIRE(a->call_next(a, inv, cpu) == POP_OK && cpu->eax == s.status);
+        } else if (scalar_write || fn == 0x004eef60) {
+            REQUIRE(s.phase == Writing);
+            uint32_t n = scalar_write ? 4 : rd32(cpu->esp + 8);
+            REQUIRE(scalar_write || n == 12 || n == 56);
+            REQUIRE(n <= sizeof s.output && s.output_size <= sizeof s.output - n);
+            if (!scalar_write) {
+                uint32_t source = rd32(cpu->esp + 4);
+                REQUIRE(owned(source, n) || stack(source, n));
+            }
+            REQUIRE(a->call_next(a, inv, cpu) == POP_OK && cpu->eax == 0);
+            s.output_size = rd32(stream_buffer + 0x1c) - stream_data - 16;
+            REQUIRE(s.output_size <= sizeof s.output);
+            std::memcpy(s.output, g_mem + stream_data + 16, s.output_size);
+        } else {
+            REQUIRE(fn == 0x004eeb50 && s.phase == Writing);
+            REQUIRE(a->call_next(a, inv, cpu) == POP_OK && cpu->eax == 0);
+        }
+        ++original_stream_operations;
+        return; // actual wrappers and C++ stream/buffer bodies supply the return
+    }
+}
+
+static const PopModApi *context(uint32_t owner) {
+    return owner == api.mod_index ? &api : nullptr;
+}
+// These stopped setup/teardown calls run outside journal authority. The fixed
+// stream borrows a bounded span; original destructors retain caller allocations.
+static uint32_t stream_call(uint32_t fn, uint32_t receiver, const uint32_t *args = nullptr,
+                            int n = 0) {
+    X86 saved = *s.cpu;
+    uint32_t fs = rd32(s.cpu->fs_base);
+    s.cpu->r[R_ECX] = receiver;
+    ++calls;
+    ++stream_calls;
+    auto r = guest_call_guarded(s.cpu, fn, args, n);
+    CHECK(r.status == GuestCallGuardedStatus::Returned && s.cpu->r[R_ESP] == saved.r[R_ESP] &&
+          s.cpu->eip == saved.eip && rd32(s.cpu->fs_base) == fs && recomp_callback_depth() == 0 &&
+          mods_hook_depth() == 0 && mods_view_depth() == 0);
+    *s.cpu = saved;
+    return r.eax;
+}
+static void prepare_stream(bool output) {
+    CHECK(!journal.invocation_active() && !journal.eligible_cookie());
+    std::memset(g_mem + stream_data, 0xa5, 2080);
+    uint32_t bytes = 2048;
+    if (!output && s.unit_stream) {
+        bytes = 0;
+        for (uint32_t bank = 0; bank < 3; ++bank) {
+            Payload &payload = s.input->banks[bank];
+            CHECK(payload.size <= 2048 && bytes <= 2048 - payload.size);
+            std::memcpy(g_mem + stream_data + 16 + bytes, payload.bytes, payload.size);
+            bytes += payload.size;
+        }
+        if (s.fail_bank != UINT32_MAX) {
+            bytes = s.fail_at;
+            for (uint32_t bank = 0; bank < s.fail_bank; ++bank)
+                bytes += s.input->banks[bank].size;
+        }
+    } else if (!output) {
+        bytes = s.input->banks[s.bank].size;
+        std::memcpy(g_mem + stream_data + 16, s.input->banks[s.bank].bytes, bytes);
+    }
+    s.stream_limit = bytes;
+    if (!bytes)
+        wr8(stream_data + 16, 0); // length-zero ctor uses bounded empty strlen
+    uint32_t init_buffer[] = {stream_data + 16, bytes, output ? stream_data + 16 : 0};
+    CHECK(stream_call(0x0064a97f, stream_buffer, init_buffer, 3) == stream_buffer);
+    CHECK(rd32(stream_buffer) == 0x0068c8a0 && !rd32(stream_buffer + 0x4c) &&
+          rd32(stream_buffer + 0x58) == 1);
+    uint32_t init_io[] = {stream_buffer, 1};
+    CHECK(stream_call(output ? 0x006497f3 : 0x0064b68a, stream_io, init_io, 2) == stream_io);
+    wr32(stream, stream_io);
+    wr32(stream + 4, 0);
+}
+static void close_stream(bool output) {
+    CHECK(!journal.invocation_active() && !journal.eligible_cookie());
+    uint32_t no_delete[] = {0};
+    CHECK(stream_call(output ? 0x006497c8 : 0x0064b65f, stream_io + (output ? 8 : 12), no_delete,
+                      1) == stream_io);
+    stream_call(0x0064aa1e, stream_buffer);
+    for (uint32_t i = 0; i < 16; ++i)
+        CHECK(rd8(stream_data + i) == 0xa5 && rd8(stream_data + 2064 + i) == 0xa5);
+}
+static void check_unpublished_actor_admission() {
+    if (unpublished_actor_admission_controls)
+        return;
+    const X86 before = *s.cpu;
+    const auto baseline = heap_stats();
+    uint8_t object_before[0x94];
+    std::memcpy(object_before, g_mem + unit, sizeof object_before);
+    const uint32_t count = mods_hooks_installed_count();
+    for (unsigned test = 0; test < 7; ++test) {
+        auto sites = unit_read_points;
+        if (test < 3) {
+            if (test != 1)
+                wr32(unit + 0x60, 123);
+            if (test != 0)
+                wr32(unit + 0x84, unit_storage);
+        } else if (test == 3)
+            sites.read += 4;
+        else if (test == 4)
+            sites.bank_allocate_return += 4;
+        else if (test == 5)
+            sites.table += 4;
+        else
+            sites.bank_fields += 4;
+        uint8_t attempt_before[0x94];
+        std::memcpy(attempt_before, g_mem + unit, sizeof attempt_before);
+        const auto result = s.hooks->read_unit(s.cpu, unit, stream, sites);
+        CHECK(result.guest.status == GuestCallGuardedStatus::InvalidCall && !result.complete);
+        CHECK(!std::memcmp(attempt_before, g_mem + unit, sizeof attempt_before));
+        CHECK(!std::memcmp(&before, s.cpu, sizeof before));
+        CHECK(s.bridge->failure() == majesty::orders::AllocationFailure::None);
+        CHECK(!journal.invocation_active() && !journal.eligible_cookie());
+        CHECK(s.hooks->installed_count() == 4 && mods_hooks_installed_count() == count);
+        for (uint32_t i = 0; i < s.input->count; ++i) {
+            const Slot &r = s.input->slots[i];
+            const auto *block =
+                journal.find(static_cast<majesty::orders::Role>(r.role), r.bank, r.index);
+            CHECK(block && !block->claimed && !r.claimed);
+        }
+        std::memcpy(g_mem + unit, object_before, sizeof object_before);
+        ++unpublished_actor_admission_controls;
+    }
+    CHECK(heap_stats().used_bytes == baseline.used_bytes &&
+          heap_stats().used_blocks == baseline.used_blocks);
+}
+static bool invoke_unit_reader() {
+    s.phase = Reading;
+    s.bank = 0;
+    s.unit_stream = true;
+    s.cursor = s.status = s.output_size = 0;
+    prepare_stream(false);
+    check_unpublished_actor_admission();
+    uint32_t esp = s.cpu->r[R_ESP], eip = s.cpu->eip, fs = rd32(s.cpu->fs_base);
+    s.stack_hi = esp;
+    s.stack_lo = esp - 4096;
+    ++calls;
+    ++unit_reader_calls;
+    auto loaded = s.hooks->read_unit(s.cpu, unit, stream, unit_read_points);
+    CHECK(s.cpu->r[R_ESP] == esp && s.cpu->eip == eip && rd32(s.cpu->fs_base) == fs &&
+          recomp_callback_depth() == 0 && mods_hook_depth() == 0 && mods_view_depth() == 0);
+    close_stream(false);
+    s.unit_stream = false;
+    if (s.rejected || s.name_rejected) {
+        CHECK(loaded.guest.status == GuestCallGuardedStatus::Cancelled &&
+              loaded.guest.eax == (s.name_rejected ? 0xbad00003u : 0xbad00002u));
+        CHECK(!s.failed && !s.after_rejection && !s.after_name_rejection);
+        return false;
+    }
+    CHECK(loaded.guest.status == GuestCallGuardedStatus::Returned && !s.failed);
+    if (s.fail_bank != UINT32_MAX) {
+        CHECK(loaded.guest.eax == 0x2000000a && s.cursor <= s.stream_limit && !loaded.complete &&
+              s.bridge->failure() == majesty::orders::AllocationFailure::ReadFailed);
+        s.read_failed = true;
+        return false;
+    }
+    CHECK(loaded.complete && loaded.guest.eax == 0 && s.cursor == s.stream_limit);
+    return loaded.complete && !failures;
+}
+static bool write_bank(uint32_t bank) {
+    s.bank = bank;
+    s.phase = Writing;
+    s.cursor = s.status = s.output_size = 0;
+    prepare_stream(true);
+    s.cpu->r[R_ECX] = slot(Bank, bank)->address;
+    uint32_t args[] = {stream};
+    uint32_t esp = s.cpu->r[R_ESP], eip = s.cpu->eip, fs = rd32(s.cpu->fs_base);
+    uint32_t profiles = recomp_profile_depth();
+    ++calls;
+    auto result = journal.invoke(s.cpu, WRITE, args, 1);
+    CHECK(result.status == GuestCallGuardedStatus::Returned && result.eax == 0 && !s.failed);
+    CHECK(s.cpu->r[R_ESP] == esp && s.cpu->eip == eip && rd32(s.cpu->fs_base) == fs);
+    CHECK(recomp_callback_depth() == 0 && recomp_profile_depth() == profiles);
+    CHECK(mods_hook_depth() == 0 && mods_view_depth() == 0);
+    CHECK(!std::strlen(mods_active_callback_desc()));
+    close_stream(true);
+    Payload &payload = s.input->banks[bank];
+    CHECK(s.output_size == payload.size && !std::memcmp(s.output, payload.bytes, payload.size));
+    return result.status == GuestCallGuardedStatus::Returned && !s.failed && !failures;
+}
+static bool members(uint32_t bank, bool partial = false) {
+    uint32_t head = slot(Head, bank)->address, node = rd32(head), previous = head, count = 0;
+    while (node != head && count < 4) {
+        Slot *r = slot(Node, bank, count), *order = slot(Order, bank, count);
+        CHECK(r && order && r->claimed && order->claimed && node == r->address);
+        if (!r || !order || node != r->address)
+            return false;
+        CHECK(rd32(node + 4) == previous && rd32(node + 8) == order->address);
+        if (!partial) {
+            Slot *base = slot(BaseName, bank, count), *leaf = slot(LeafName, bank, count);
+            CHECK(base && base->claimed && base->bytes == 1 &&
+                  rd32(order->address + 36) == base->address && !rd8(base->address));
+            if (leaf)
+                CHECK(leaf->claimed && leaf->bytes == 1 &&
+                      rd32(order->address + (order->kind == 2 || order->kind == 6 ? 76 : 72)) ==
+                          leaf->address &&
+                      !rd8(leaf->address));
+        }
+        previous = node;
+        node = rd32(node);
+        ++count;
+    }
+    uint32_t expected;
+    std::memcpy(&expected, s.input->banks[bank].bytes + 4, 4);
+    CHECK(node == head && (partial ? count <= expected : count == expected) &&
+          rd32(head + 4) == previous);
+    CHECK(rd32(slot(Bank, bank)->address + 16) == count);
+    return node == head && (partial ? count <= expected : count == expected);
+}
+// The partial UNIT is private and already stopped; attaching these fields
+// does not register a live actor or transfer journal ownership. Original getters
+// must return the preloaded banks without allocating replacements.
+static uint32_t unit_call(uint32_t fn, const uint32_t *args, int nargs) {
+    X86 saved = *s.cpu;
+    uint32_t fs = rd32(s.cpu->fs_base), profiles = recomp_profile_depth();
+    s.cpu->r[R_ECX] = unit;
+    ++calls;
+    auto result = journal.invoke(s.cpu, fn, args, nargs);
+    CHECK(result.status == GuestCallGuardedStatus::Returned && !s.failed &&
+          s.cpu->r[R_ESP] == saved.r[R_ESP] && s.cpu->eip == saved.eip &&
+          rd32(s.cpu->fs_base) == fs && recomp_callback_depth() == 0 &&
+          recomp_profile_depth() == profiles && mods_hook_depth() == 0 && mods_view_depth() == 0);
+    *s.cpu = saved;
+    return result.eax;
+}
+static bool attach_unit_and_write() {
+    CHECK(journal.fully_claimed() && !journal.invocation_active());
+    uint32_t total = 0;
+    for (uint32_t bank = 0; bank < 3; ++bank) {
+        CHECK(rd32(unit + UNIT_BANKS + bank * 4) == slot(Bank, bank)->address);
+        CHECK(rd32(slot(Bank, bank)->address + 4) == unit);
+        total += s.input->banks[bank].size;
+    }
+    CHECK(total <= sizeof s.output);
+    if (failures)
+        return false;
+    s.phase = Writing;
+    HeapStats baseline = heap_stats();
+    unsigned allocated_before = allocation_calls;
+    for (uint32_t bank = 0; bank < 3; ++bank) {
+        CHECK(unit_call(UNIT_GET, &bank, 1) == slot(Bank, bank)->address);
+        ++unit_get_calls;
+    }
+    CHECK(allocation_calls == allocated_before &&
+          heap_stats().used_blocks == baseline.used_blocks &&
+          heap_stats().used_bytes == baseline.used_bytes);
+    s.bank = 0;
+    s.cursor = s.status = s.output_size = 0;
+    prepare_stream(true);
+    uint32_t args[] = {stream};
+    CHECK(unit_call(UNIT_WRITE, args, 1) == 0);
+    ++unit_writer_calls;
+    close_stream(true);
+    CHECK(s.output_size == total);
+    uint32_t offset = 0;
+    for (uint32_t bank = 0; bank < 3; ++bank) {
+        Payload &payload = s.input->banks[bank];
+        CHECK(!std::memcmp(s.output + offset, payload.bytes, payload.size));
+        CHECK(rd32(unit + UNIT_BANKS + bank * 4) == slot(Bank, bank)->address);
+        offset += payload.size;
+    }
+    ++unit_attached_graphs;
+    return !failures;
+}
+static bool destroy(uint32_t fn, uint32_t bank, uint32_t argument) {
+    s.phase = Destroying;
+    s.bank = bank;
+    s.cpu->r[R_ECX] = fn == UNIT_CLEAR ? unit : slot(Bank, bank)->address;
+    uint32_t esp = s.cpu->r[R_ESP], eip = s.cpu->eip, fs = rd32(s.cpu->fs_base);
+    uint32_t profiles = recomp_profile_depth();
+    ++calls;
+    ++destruction_calls;
+    auto result = s.engine_owned ? guest_call_guarded(s.cpu, fn, fn == DRAIN ? nullptr : &argument,
+                                                      fn == DRAIN ? 0 : 1, &s.engine_cookie)
+                                 : journal.invoke_cleanup(s.cpu, fn, &argument, 1);
+    s.engine_cookie = 0;
+    // Clear callback context even when an interrupted free bypassed its return.
+    s.free_inv = nullptr;
+    s.free_cpu = nullptr;
+    CHECK(result.status == GuestCallGuardedStatus::Returned && !s.failed);
+    CHECK(s.cpu->r[R_ESP] == esp && s.cpu->eip == eip && rd32(s.cpu->fs_base) == fs);
+    CHECK(recomp_callback_depth() == 0 && recomp_profile_depth() == profiles &&
+          mods_hook_depth() == 0 && mods_view_depth() == 0);
+    if (fn == UNIT_CLEAR) {
+        CHECK(!rd32(unit + UNIT_BANKS + bank * 4));
+        ++unit_clear_calls;
+    }
+    return result.status == GuestCallGuardedStatus::Returned && !s.failed && !failures;
+}
+static void check_unit_preconditions() {
+    if (precondition_checks)
+        return;
+    X86 before = *s.cpu;
+    HeapStats baseline = heap_stats();
+    for (uint32_t test = 0; test < 5; ++test) {
+        auto sites = unit_read_points;
+        if (test == 0)
+            wr32(unit, UNIT_TABLE + 4);
+        else if (test == 1)
+            wr32(unit + UNIT_BANKS, slot(Bank, 0)->address);
+        else if (test == 2)
+            sites.bank_fields = UINT32_MAX - 3;
+        else if (test == 3)
+            sites.bank_allocate_return = entry_points.allocate_return[0];
+        majesty::orders::AllocationBridge probe(journal, entry_points);
+        auto result = probe.read_unit(test == 4 ? nullptr : s.cpu, unit, stream, sites);
+        CHECK(result.guest.status == GuestCallGuardedStatus::InvalidCall && !result.complete);
+        CHECK(probe.failure() == (test == 3 ? majesty::orders::AllocationFailure::InvalidSites
+                                            : majesty::orders::AllocationFailure::InvalidSequence));
+        CHECK(!std::memcmp(&before, s.cpu, sizeof before));
+        CHECK(!journal.invocation_active() && !journal.eligible_cookie());
+        for (uint32_t i = 0; i < s.input->count; ++i) {
+            Slot &r = s.input->slots[i];
+            const auto *block =
+                journal.find(static_cast<majesty::orders::Role>(r.role), r.bank, r.index);
+            CHECK(block && !block->claimed && !r.claimed);
+        }
+        wr32(unit, UNIT_TABLE);
+        wr32(unit + UNIT_BANKS, 0);
+        ++precondition_checks;
+    }
+    CHECK(heap_stats().used_blocks == baseline.used_blocks &&
+          heap_stats().used_bytes == baseline.used_bytes);
+}
+static bool run(Case *input, X86 *cpu, uint8_t poison, uint32_t reject_slot = UINT32_MAX,
+                uint32_t fail_bank = UINT32_MAX, uint32_t fail_at = 0,
+                uint32_t reject_name = UINT32_MAX, bool handoff = false) {
+    s = {};
+    s.input = input;
+    s.cpu = cpu;
+    s.reject_slot = reject_slot;
+    s.fail_bank = fail_bank;
+    s.fail_at = fail_at;
+    s.reject_name = reject_name;
+    CHECK(rd32(unit) == UNIT_TABLE);
+    for (uint32_t bank = 0; bank < 3; ++bank)
+        CHECK(!rd32(unit + UNIT_BANKS + bank * 4));
+    HeapStats baseline = heap_stats();
+    uint32_t small_block_baseline = small_block_live_count();
+    uint8_t vehicle_before[VEHICLE_BYTES] = {};
+    if (handoff) {
+        lifecycle_extent_count = 0;
+        lifecycle_live_bytes = 0;
+        s.lifecycle_constructing = true;
+        uint32_t factory = 0; // original constructor; no registration or world lease
+        uint32_t esp = cpu->r[R_ESP], eip = cpu->eip, fs = rd32(cpu->fs_base);
+        ++calls;
+        ++lifecycle_calls;
+        auto constructed =
+            guest_call_guarded(cpu, VEHICLE_CREATE, &factory, 1, &s.lifecycle_cookie);
+        s.lifecycle_cookie = 0;
+        s.lifecycle_constructing = false;
+        CHECK(constructed.status == GuestCallGuardedStatus::Returned && constructed.eax &&
+              !s.failed);
+        if (constructed.status != GuestCallGuardedStatus::Returned || !constructed.eax || s.failed)
+            return false;
+        unit = constructed.eax;
+        CHECK(gm_valid(unit, VEHICLE_BYTES) && rd32(unit) == UNIT_TABLE);
+        CHECK(lifecycle_extent_count && lifecycle_extents[0].address == unit &&
+              lifecycle_extents[0].bytes == VEHICLE_BYTES && !lifecycle_extents[0].freed);
+        CHECK(!rd32(unit + 0x60) && !rd32(unit + 0x84)); // unregistered, no factory
+        CHECK(cpu->r[R_ESP] == esp && cpu->eip == eip && rd32(cpu->fs_base) == fs &&
+              !recomp_callback_depth() && !mods_hook_depth() && !mods_view_depth());
+        ++vehicle_constructions;
+        uint64_t bytes = heap_stats().used_bytes - baseline.used_bytes;
+        CHECK(bytes <= 4096);
+        if (bytes > max_vehicle_heap_bytes)
+            max_vehicle_heap_bytes = bytes;
+        std::memcpy(vehicle_before, g_mem + unit, VEHICLE_BYTES);
+    }
+    HeapStats journal_baseline = heap_stats();
+    majesty::orders::Request requests[32];
+    for (uint32_t i = 0; i < input->count; ++i) {
+        Slot &r = input->slots[i];
+        requests[i] = {static_cast<majesty::orders::Role>(r.role), r.bank, r.index, r.kind,
+                       r.bytes};
+    }
+    bool ok = journal.reserve(requests, input->count, {nullptr, reserve_heap, release_heap});
+    CHECK(ok);
+    majesty::orders::AllocationBridge bridge(journal, entry_points, {nullptr, allow_claim});
+    s.bridge = &bridge;
+    majesty::orders::ReaderHooks hooks(bridge, {nullptr, allocation_trace});
+    s.hooks = &hooks;
+    const uint32_t hooks_before = mods_hooks_installed_count();
+    CHECK(hooks.installed_count() == 0 && !hooks.hook_failed());
+    CHECK(hooks.read_unit(cpu, unit, stream, unit_read_points).guest.status ==
+          GuestCallGuardedStatus::InvalidCall);
+    if (!reader_hook_install_rollback_controls) {
+        auto invalid_sites = entry_points;
+        invalid_sites.construct += 4;
+        majesty::orders::AllocationBridge invalid_bridge(journal, invalid_sites);
+        majesty::orders::ReaderHooks invalid_hooks(invalid_bridge);
+        CHECK(!invalid_hooks.install() && invalid_hooks.installed_count() == 0);
+        CHECK(mods_hooks_installed_count() == hooks_before);
+        sched_set_guest_thread(false);
+        CHECK(!hooks.install() && !hooks.remove() && hooks.installed_count() == 0);
+        CHECK(hooks.read_unit(cpu, unit, stream, unit_read_points).guest.status ==
+              GuestCallGuardedStatus::InvalidCall);
+        sched_set_guest_thread(true);
+        uint32_t temporary[32] = {}, n = 0;
+        PopModStatus status = POP_OK;
+        while (n < 32 && status == POP_OK) {
+            status =
+                mods_hook_install_ex(MODS_OWNER_FIRST_MOD + 1, 0x0064d59f, 0, capacity_observer,
+                                     POP_HOOK_WRAP, POP_HOOK_NO_GAME_VIEW, nullptr, &temporary[n]);
+            if (status == POP_OK)
+                ++n;
+        }
+        CHECK(n && n < 32 && status == POP_E_LIMIT);
+        const uint32_t full_chain_count = mods_hooks_installed_count();
+        // Core malloc installs first; the full name chain refuses second.
+        // Installation must remove its published prefix and allow clean retry.
+        CHECK(!hooks.install() && hooks.installed_count() == 0 && !hooks.hook_failed());
+        CHECK(mods_hooks_installed_count() == full_chain_count && !bridge.complete());
+        while (n)
+            CHECK(mods_hook_remove(MODS_OWNER_FIRST_MOD + 1, temporary[--n]) == POP_OK);
+        CHECK(mods_hooks_installed_count() == hooks_before);
+        ++reader_hook_install_rollback_controls;
+    }
+    CHECK(hooks.install() && hooks.installed_count() == 4);
+    CHECK(!hooks.install() && mods_hooks_installed_count() == hooks_before + 4);
+    CHECK(hooks.read_unit(nullptr, unit, stream, unit_read_points).guest.status ==
+          GuestCallGuardedStatus::InvalidCall);
+    CHECK(!bridge.handoff_unit_orders(unit)); // no original read yet
+    for (uint32_t i = 0; i < input->count; ++i) {
+        Slot &r = input->slots[i];
+        r.claimed = false;
+        r.freed = false;
+        const auto *b = journal.find(static_cast<majesty::orders::Role>(r.role), r.bank, r.index);
+        r.address = b ? b->address : 0;
+        if (r.bytes && !r.address) {
+            CHECK(false);
+            ok = false;
+            break;
+        }
+        if (r.address)
+            std::memset(g_mem + r.address, poison, r.bytes);
+    }
+    uint64_t extra = heap_stats().used_bytes - journal_baseline.used_bytes;
+    CHECK(extra <= 4096);
+    if (extra > max_guest_bytes)
+        max_guest_bytes = extra;
+    if (handoff) {
+        uint64_t total = heap_stats().used_bytes - baseline.used_bytes;
+        CHECK(total <= 8192);
+        if (total > max_vehicle_and_order_heap_bytes)
+            max_vehicle_and_order_heap_bytes = total;
+        uint32_t requested = lifecycle_live_bytes + journal.owned_request_bytes();
+        if (requested > max_vehicle_and_order_requested_bytes)
+            max_vehicle_and_order_requested_bytes = requested;
+    }
+    // Every reservation exists before the first original UNIT instruction.
+    if (ok)
+        check_unit_preconditions();
+    if (ok)
+        ok = invoke_unit_reader();
+    if (ok && handoff)
+        for (uint32_t i = 0; i < VEHICLE_BYTES; ++i)
+            if (i < UNIT_BANKS || i >= UNIT_BANKS + 12)
+                CHECK(rd8(unit + i) == vehicle_before[i]);
+    for (uint32_t b = 0; ok && b < 3; ++b)
