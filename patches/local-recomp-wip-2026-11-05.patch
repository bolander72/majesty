+bool joint_departure(X86 &extra, uint32_t unit, uint32_t agent, uint32_t factory, uint32_t runtime,
+                     uint32_t unit_id, uint32_t agent_id, uint32_t extent = 256) {
+#ifdef __EMSCRIPTEN__
+    return false;
