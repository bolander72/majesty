@@ -0,0 +1,232 @@
+// Original pinned bank construction through actual generated calls and mod
+// hooks. No entry point, mission, renderer, browser or actor is started.
+#include "../kit/mods/mods_internal.h"
+#include "../kit/runtime/guest.h"
+#include "../kit/runtime/loader.h"
+#include "../kit/runtime/memory.h"
+#include "../kit/runtime/mods_seam.h"
+#include "../kit/runtime/profile.h"
+#include "../kit/runtime/seh.h"
+#include "../kit/runtime/win32.h"
+#include <cstdio>
+#include <cstring>
+
+static constexpr uint32_t BANK_CTOR = 0x004abcc0u;
+static constexpr uint32_t ALLOCATOR = 0x0064c616u;
+static constexpr uint32_t HEAD_RETURN_PC = 0x005e4c71u;
+static constexpr uint32_t BANK_TABLE = 0x00683148u;
+static constexpr uint32_t OWNER = 0x12345678u;
+static constexpr uint32_t STOP_RESULT = 0x0badcafeu;
+static constexpr const char *PIN =
+    "654365fd1bdefa6d7f2349d162869f255388fadcb1bb8db9f7db2f3468dd5542";
+
+static int checks, failures;
+static uint64_t max_trial_guest_bytes;
+#define CHECK(x)                                                                                   \
+    do {                                                                                           \
+        ++checks;                                                                                  \
+        if (!(x)) {                                                                                \
+            ++failures;                                                                            \
+            fprintf(stderr, "FAIL line %d: %s\n", __LINE__, #x);                                   \
+        }                                                                                          \
+    } while (0)
+
+struct Trial {
+    X86 *cpu;
+    uint64_t cookie;
+    uint32_t bank, head, expected_bytes;
+    unsigned requests, root_before, root_after, after_phase, after_cancel;
+    bool claimed, ordinary;
+};
+static Trial trial;
+static PopModApi api;
+
+static const PopModApi *context(uint32_t owner) {
+    return owner == api.mod_index ? &api : nullptr;
+}
+
+static void allocation(const PopModApi *a, pop_cpu_v1 *cpu, PopHookInvocation *inv, void *) {
+    // Ordinary calls are enabled only by this isolated fixture's explicit
+    // trial. Production allocation scopes still require a guarded cookie.
+    if (!trial.ordinary &&
+        (!trial.cookie || guest_call_guarded_cookie(trial.cpu) != trial.cookie)) {
+        CHECK(a->call_next(a, inv, cpu) == POP_OK);
+        return;
+    }
+    ++trial.requests;
+    CHECK(mods_hook_depth() >= 1 && mods_view_depth() >= 1);
+    CHECK(std::strstr(mods_active_callback_desc(), "fixture.order-bank") != nullptr);
+    uint32_t caller = rd32(cpu->esp), bytes = rd32(cpu->esp + 4);
+    if (caller != HEAD_RETURN_PC || bytes != trial.expected_bytes || cpu->esi != trial.bank ||
+        trial.claimed) {
+        if (trial.ordinary) {
+            CHECK(false); // ordinary trials never inject a rejected request
+        } else {
+            guest_call_guarded_cancel(trial.cpu, trial.cookie, STOP_RESULT);
+            ++trial.after_cancel;
+        }
+        // If the stop unexpectedly refuses, return owned storage so a failed
+        // test cannot turn into a null dereference in the original constructor.
+    } else {
+        trial.claimed = true;
+    }
+    CHECK(a->hook_return(a, cpu, trial.head, 0) == POP_OK); // cdecl
+}
+
+static void root_wrap(const PopModApi *a, pop_cpu_v1 *cpu, PopHookInvocation *inv, void *) {
+    ++trial.root_before;
+    uint32_t depth = recomp_callback_depth();
+    CHECK(mods_hooks_callback_return_defer(trial.cpu, cpu->esp, depth));
+    CHECK(!mods_hooks_callback_return_defer(trial.cpu, cpu->esp + 4, depth));
+    CHECK(!mods_hooks_callback_return_defer(trial.cpu, cpu->esp, depth + 1));
+    CHECK(!mods_hooks_callback_return_defer(nullptr, cpu->esp, depth));
+    CHECK(!mods_hooks_callback_return_defer(trial.cpu, cpu->esp, 0));
+    X86 foreign{};
+    CHECK(!mods_hooks_callback_return_defer(&foreign, cpu->esp, depth));
+    CHECK(a->call_next(a, inv, cpu) == POP_OK);
+    ++trial.root_after;
+}
+
+static void root_after(const PopModApi *, pop_cpu_v1 *cpu, PopHookInvocation *, void *) {
+    ++trial.after_phase;
+    CHECK(cpu->phase == POP_PHASE_AFTER && cpu->eax == trial.bank);
+}
+
+static void run_trial(X86 *c, bool reject, bool wrap_root, bool ordinary = false) {
+    trial = {};
+    trial.cpu = c;
+    trial.ordinary = ordinary;
+    HeapStats before_heap = heap_stats();
+    trial.bank = heap_alloc(20, false);
+    trial.head = heap_alloc(12, false);
+    trial.expected_bytes = reject ? 16 : 12;
+    if (!trial.bank || !trial.head) {
+        CHECK(false);
+        if (trial.bank)
+            heap_free(trial.bank);
+        if (trial.head)
+            heap_free(trial.head);
+        return;
+    }
+    HeapStats reserved_heap = heap_stats();
+    CHECK(reserved_heap.used_blocks == before_heap.used_blocks + 2);
+    uint64_t extra_bytes = reserved_heap.used_bytes - before_heap.used_bytes;
+    CHECK(extra_bytes <= 128); // includes the runtime's rounded block sizes
+    if (extra_bytes > max_trial_guest_bytes)
+        max_trial_guest_bytes = extra_bytes;
+    std::memset(g_mem + trial.bank, 0xa5, 20);
+    std::memset(g_mem + trial.head, 0x5a, 12);
+    uint32_t root_hook = 0, after_hook = 0;
+    if (wrap_root) {
+        CHECK(mods_hook_install_ex(api.mod_index, BANK_CTOR, 0, root_wrap, POP_HOOK_WRAP,
+                                   POP_HOOK_NO_GAME_VIEW, nullptr, &root_hook) == POP_OK);
+        CHECK(mods_hook_install_ex(api.mod_index, BANK_CTOR, 0, root_after, POP_HOOK_AFTER,
+                                   POP_HOOK_NO_GAME_VIEW, nullptr, &after_hook) == POP_OK);
+    }
+    // An inherited view is deliberately retained across the checked call.
+    mods_view_push_disabled();
+    uint32_t views = mods_view_depth(), profiles = recomp_profile_depth();
+    X86 before = *c;
+    c->r[R_ECX] = trial.bank;
+    uint32_t args[] = {OWNER};
+    auto result = ordinary ? GuestCallGuardedResult{guest_call(c, BANK_CTOR, args, 1),
+                                                    GuestCallGuardedStatus::Returned}
+                           : guest_call_guarded(c, BANK_CTOR, args, 1, &trial.cookie);
+    CHECK(trial.requests == 1 && trial.after_cancel == 0);
+    CHECK(c->r[R_ESP] == before.r[R_ESP] && c->eip == before.eip);
+    CHECK(rd32(c->fs_base) == 0xffffffffu && recomp_callback_depth() == 0);
+    CHECK(mods_hook_depth() == 0 && mods_view_depth() == views);
+    CHECK(std::strlen(mods_active_callback_desc()) == 0);
+    CHECK(recomp_profile_depth() == profiles);
+    if (reject) {
+        CHECK(result.status == GuestCallGuardedStatus::Cancelled && result.eax == STOP_RESULT);
+        CHECK(!trial.claimed && rd32(trial.head) == 0x5a5a5a5au);
+        CHECK(rd32(trial.head + 4) == 0x5a5a5a5au && rd32(trial.head + 8) == 0x5a5a5a5au);
+        // The earlier flag write remains in owned storage: cancellation stops
+        // execution but does not roll back guest memory. Cleanup is separate.
+        CHECK(rd8(trial.bank + 8) == (uint8_t)OWNER);
+        CHECK(rd32(trial.bank) == 0xa5a5a5a5u && rd32(trial.bank + 12) == 0xa5a5a5a5u);
+        CHECK(trial.root_after == 0);
+        CHECK(trial.after_phase == 0);
+    } else {
+        CHECK(result.status == GuestCallGuardedStatus::Returned && result.eax == trial.bank);
+        CHECK(trial.claimed && rd32(trial.bank) == BANK_TABLE);
+        CHECK(rd32(trial.bank + 4) == OWNER && rd32(trial.bank + 12) == trial.head);
+        CHECK(rd8(trial.bank + 8) == (uint8_t)OWNER);
+        CHECK(rd32(trial.bank + 16) == 0);
+        CHECK(rd32(trial.head) == trial.head && rd32(trial.head + 4) == trial.head);
+        // The constructor initializes sentinel links, not its unused payload.
+        CHECK(rd32(trial.head + 8) == 0x5a5a5a5au);
+        CHECK(trial.root_after == (wrap_root ? 1u : 0u));
+        CHECK(trial.after_phase == (wrap_root ? 1u : 0u));
+    }
+    CHECK(trial.root_before == (wrap_root ? 1u : 0u));
+    // Test-only recovery if a normal callback left a stale root hook. Stop
+    // before the next trial and preserve the inherited view in either case.
+    mods_hooks_unwind_to_esp(before.r[R_ESP]);
+    CHECK(mods_hook_depth() == 0 && mods_view_depth() == views);
+    mods_view_pop();
+    if (root_hook)
+        CHECK(mods_hook_remove(api.mod_index, root_hook) == POP_OK);
+    if (after_hook)
+        CHECK(mods_hook_remove(api.mod_index, after_hook) == POP_OK);
+    trial.cookie = 0;
+    *c = before;
+    // These are private empty-name constructor extents, never published.
+    // Raw journal cleanup does not invoke a destructor or claim actor rollback.
+    CHECK(heap_free(trial.head));
+    CHECK(heap_free(trial.bank));
+}
+
+int main() {
+    sched_set_guest_thread(true);
+    mem_init();
+    if (!loader_load(nullptr)) {
+        std::fprintf(stderr, "Pinned original executable could not be mapped\n");
+        mem_shutdown();
+        return 1;
+    }
+    CHECK(std::strcmp(loader_exe_sha256(), PIN) == 0);
+    CHECK(mods_symbols_load(MAJESTY_HOOK_TEST_SYMBOLS));
+    CHECK(mods_symbol_hookable(ALLOCATOR) && mods_symbol_hookable(BANK_CTOR));
+    if (failures) {
+        mem_shutdown();
+        return 1;
+    }
+    api.version = POP_MOD_API_VERSION;
+    api.size = sizeof api;
+    api.mod_index = MODS_OWNER_FIRST_MOD;
+    api.mod_id = "fixture.order-bank";
+    mods_set_context_provider(context);
+    mods_fill_hooks_api(&api);
+    mods_hooks_set_load_order(api.mod_index, 0);
+    mods_hooks_set_cpu_size(api.mod_index, POP_CPU_V1_BASELINE_SIZE);
+    uint32_t hook = 0;
+    CHECK(mods_hook_install_ex(api.mod_index, ALLOCATOR, 0, allocation, POP_HOOK_WRAP,
+                               POP_HOOK_NO_GAME_VIEW, nullptr, &hook) == POP_OK);
+    CHECK(hook && recomp_hooked[recomp_index_of(ALLOCATOR)]);
+    if (failures) {
+        mods_hooks_reset();
+        mem_shutdown();
+        return 1;
+    }
+    X86 c;
+    loader_init_context(&c);
+    HeapStats baseline = heap_stats();
+    for (bool wrap_root : {false, true}) {
+        run_trial(&c, false, wrap_root);
+        run_trial(&c, true, wrap_root);
+        run_trial(&c, false, wrap_root, true);
+        CHECK(heap_stats().used_blocks == baseline.used_blocks);
+        CHECK(heap_stats().used_bytes == baseline.used_bytes);
+    }
+    CHECK(mods_hook_remove(api.mod_index, hook) == POP_OK);
+    CHECK(mods_hooks_installed_count() == 0 && mods_view_depth() == 0);
+    mods_set_context_provider(nullptr);
+    mods_hooks_reset();
+    mem_shutdown();
+    std::printf("%d original bank hook checks, %d failures\n", checks, failures);
+    std::printf("maximum private trial guest heap delta: %llu rounded bytes\n",
+                (unsigned long long)max_trial_guest_bytes);
+    return failures ? 1 : 0;
+}
