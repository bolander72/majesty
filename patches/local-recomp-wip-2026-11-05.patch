+    expected_queues.omitted = 0;
+    const uint32_t entries = rd32(manager + 0x34),
+                   queued = rd32(manager + 0x18) + rd32(manager + 0x24),
+                   counter = rd32(factory + 0x28), script_counter = rd32(runtime + 0x34),
+                   hooks = mods_hooks_installed_count();
