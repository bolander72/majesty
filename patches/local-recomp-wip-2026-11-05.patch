+static void network_buffer_retirement(X86 *c, uint32_t state, uint32_t manager) {
+  const uint32_t settings = invoke(c, 0x004ba7e0, 0), scratch = alloc(c, 32),
+                 players = alloc(c, 8), header = alloc(c, 32);
+  std::array<uint8_t, 0x50> saved_state{};
+  std::memcpy(saved_state.data(), g_mem + state, saved_state.size());
+  std::array<uint32_t, 4> saved_ids{};
+  std::memcpy(saved_ids.data(), g_mem + settings + 0x344, 16);
+  constexpr std::array<uint32_t, 13> offsets{
+      0x94, 0x98, 0x9c, 0x5c, 0x8c, 0xc0, 0xc4, 0xc8, 0xcc,
+      0x78, 0x218, 0x27c, 0x280};
+  std::array<uint32_t, offsets.size()> saved{};
+  for (uint32_t i = 0; i < offsets.size(); ++i) saved[i] = rd32(manager + offsets[i]);
+  const uint32_t recording = rd32(0x006cd2a4), clock = rd32(0x0071c6a8);
+  std::array<uint32_t, 2> nodes{};
+  for (uint32_t i = 0; i < 2; ++i) {
+    wr32(players + i * 4, 7 + i); wr32(scratch + 16, 7 + i);
+    const uint32_t insert[] = {scratch, scratch + 16};
+    invoke(c, 0x004a2d00, manager + 0x4c, insert, 2);
+    nodes[i] = rd32(scratch);
+    CHECK(nodes[i] && !rd32(nodes[i] + 0x10));
+    wr32(settings + 0x344 + i * 4, 7 + i);
+  }
+  CHECK(rd32(manager + 0x58) == 2);
+  wr32(settings + 0x34c, UINT32_MAX); wr32(settings + 0x350, UINT32_MAX);
+  wr32(manager + 0x94, players); wr32(manager + 0x98, players + 8);
+  wr32(manager + 0x9c, players + 8); wr32(0x006cd2a4, 1);
+  std::memset(g_mem + header, 0, 32);
+  const auto baseline = heap_stats();
+  for (uint32_t cycle = 0; cycle < 8 && !failures; ++cycle) {
+    const auto packet_count = packet_frees, ref_count = reference_frees;
+    for (uint32_t node : nodes) {
+      const uint32_t ring = alloc(c, 0x30);
+      invoke(c, 0x0049fc00, ring); wr32(node + 0x10, ring);
+    }
+    const uint32_t shared = alloc(c, 0x30);
+    invoke(c, 0x0049fc00, shared); wr32(manager + 0x5c, shared);
+    wr32(state, 7); wr32(state + 4, 0); wr32(state + 0x24, 0);
+    wr32(state + 0x28, 1000 + cycle); wr32(0x0071c6a8, 3750 + cycle);
+    wr32(manager + 0x218, cycle % 2 ? 3 : 1); wr32(manager + 0x8c, 7);
+    wr32(manager + 0x27c, 7); wr32(manager + 0xc0, 0);
+    // Retain an ordinary outgoing source batch in the latter four cases,
+    // as a real pause can leave the last playing frame's batch owned.
+    wr32(manager + 0xc4, cycle >= 4 ? 0 : 1);
+    wr32(manager + 0xc8, 0); wr32(manager + 0xcc, 0);
+    wr32(0x0071c68c, header);
+    const uint32_t prepare[] = {1000 + cycle};
+    invoke(c, 0x005a4250, manager, prepare, 1);
+    if (cycle >= 4) {
+      wr32(state, 3); CHECK(majesty::enqueue_coop_pause(c, 7)); wr32(state, 7);
+    }
+    wr32(manager + 0xc4, 1);
+    CHECK(majesty::enqueue_coop_resume(c, 7));
+    const uint32_t batch = rd32(manager + 0x44), deque = rd32(batch + 8),
+                   first = rd32(deque + 0xc);
+    tracked_packet = rd32(first); tracked_reference = rd32(first + 4);
+    CHECK(tracked_packet && tracked_reference);
+    invoke(c, 0x005a4600, manager);
+    CHECK(rd32(rd32(nodes[0] + 0x10) + 0x2c) == 1);
+    // Retain an additional original owning copy in alternating cycles.
+    // A dequeued batch may still be held outside its ring/outgoing pair.
+    // Original005d9cf0 leaves nonzero upper EAX even when AL says shared.
+    const bool held = cycle % 2;
+    const uint32_t held_pair = scratch + 24;
+    if (held) {
+      wr32(held_pair, batch);
+      const uint32_t copy[] = {manager + 0x48};
+      invoke(c, 0x005d9cb0, held_pair + 4, copy, 1);
+      CHECK(rd32(held_pair + 4) == rd32(manager + 0x48));
+      CHECK(rd32(rd32(held_pair + 4)) > 1);
+      const uint32_t unique = invoke(c, 0x005d9cf0, held_pair + 4);
+      CHECK(unique != 0 && (unique & 0xffu) == 0);
+    }
+    const uint32_t local = (cycle / 2) % 2;
+    recomp_network_session_v1 party{local == 0, 7 + local, 2, {7, 8, 0, 0}};
+    wr32(state + 0x24, local); wr32(manager + 0x8c, 7 + local);
+    // Metadata-only provider marker: no provider is opened or dereferenced.
+    wr32(manager + 0xc8, 0x12345678); wr32(manager + 0xcc, 1);
+    const majesty::CoopPauseBoundary source{1000 + cycle, 3750 + cycle, 7};
+    auto refused = [&] {
+      const auto heap = heap_stats();
+      CHECK(!majesty::coop_retire_network_buffers(c, party, source));
+      const auto after = heap_stats();
+      CHECK(after.used_bytes == heap.used_bytes && after.used_blocks == heap.used_blocks &&
+            after.total_allocs == heap.total_allocs && after.total_frees == heap.total_frees);
+      CHECK(rd32(manager + 0x5c) == shared && rd32(manager + 0x44) == batch &&
+            tracked_packet && tracked_reference);
+    };
+    refused(); // A source graph is still present, even though it is paused.
+    wr32(0x0071c68c, 0);
+    for (const auto guard : std::to_array<std::array<uint32_t, 2>>({
+           {state, 3}, {state + 4, 3}, {state + 0x28, source.frame + 1},
+           {0x0071c6a8, source.clock + 1},
+           {manager + 0xc0, header}, {manager + 0x218, 2},
+           {manager + 0x27c, 8}, {manager + 0x8c, 99},
+           {manager + 0x58, 3}, {players, 99},
+           {rd32(nodes[0] + 0x10) + 0x2c, 4097},
+           {nodes[1] + 0x10, rd32(nodes[0] + 0x10)}})) {
+      const uint32_t previous = rd32(guard[0]); wr32(guard[0], guard[1]);
+      refused(); wr32(guard[0], previous);
+    }
+    std::array<uint8_t, 0x50> before_state{};
+    std::array<uint8_t, 0x2b0> before_manager{};
+    std::array<uint8_t, 0x4f8> before_settings{};
+    std::memcpy(before_state.data(), g_mem + state, before_state.size());
+    std::memcpy(before_manager.data(), g_mem + manager, before_manager.size());
+    std::memcpy(before_settings.data(), g_mem + settings, before_settings.size());
+    const bool retired = majesty::coop_retire_network_buffers(c, party, source);
+    CHECK(retired);
+    CHECK(!std::memcmp(before_state.data(), g_mem + state, before_state.size()));
+    CHECK(!std::memcmp(before_settings.data(), g_mem + settings, before_settings.size()));
+    // Only retired buffer owners and their replacement references may change.
+    // Party, phase, provider, counters and every other manager byte survive.
+    for (uint32_t byte = 0; byte < before_manager.size(); ++byte)
+      if (!(byte >= 0x34 && byte < 0x4c) && !(byte >= 0x5c && byte < 0x60))
+        CHECK(before_manager[byte] == rd8(manager + byte));
+    CHECK(rd32(players) == 7 && rd32(players + 4) == 8);
+    if (held) {
+      // Retirement must leave the original shared graph intact until its
+      // last independent owner is released, without any premature free.
+      CHECK(tracked_packet && tracked_reference && packet_frees == packet_count &&
+            reference_frees == ref_count);
+      CHECK(rd32(batch) == 0x00682d04 && rd32(rd32(held_pair + 4)) == 1);
+      CHECK((invoke(c, 0x005d9cf0, held_pair + 4) & 0xffu) == 1);
+      const uint32_t deleting[] = {1};
+      invoke(c, rd32(rd32(batch)), batch, deleting, 1);
+      invoke(c, 0x005d9cd0, held_pair + 4);
+      wr32(held_pair, 0); wr32(held_pair + 4, 0);
+    }
+    CHECK(!tracked_packet && !tracked_reference && packet_frees == packet_count + 1 &&
+          reference_frees == ref_count + 1);
+    CHECK(!rd32(nodes[0] + 0x10) && !rd32(nodes[1] + 0x10) && !rd32(manager + 0x5c));
+    CHECK(!rd32(manager + 0x34) && !rd32(manager + 0x3c) && !rd32(manager + 0x44));
+    for (uint32_t offset : {0x38u, 0x40u, 0x48u})
+      CHECK(rd32(manager + offset) && rd32(rd32(manager + offset)) == 1);
+    CHECK(rd32(state) == 7 && !rd32(state + 4) && rd32(manager + 0x27c) == 7 &&
+          rd32(state + 0x28) == source.frame && rd32(0x0071c6a8) == source.clock &&
+          rd32(manager + 0xc8) == 0x12345678 && rd32(manager + 0xcc) == 1);
+    const auto after = heap_stats();
+    CHECK(after.used_bytes == baseline.used_bytes && after.used_blocks == baseline.used_blocks &&
+          heap_check().empty());
+    CHECK(majesty::coop_retire_network_buffers(c, party, source));
+  }
+  std::memcpy(g_mem + state, saved_state.data(), saved_state.size());
+  std::memcpy(g_mem + settings + 0x344, saved_ids.data(), 16);
+  for (uint32_t i = 0; i < offsets.size(); ++i) wr32(manager + offsets[i], saved[i]);
+  wr32(0x006cd2a4, recording); wr32(0x0071c6a8, clock); wr32(0x0071c68c, 0);
+  for (uint32_t p : {scratch, players, header}) {
+    const uint32_t free[] = {p}; invoke(c, 0x00645bc0, 0, free, 1);
+  }
+}
