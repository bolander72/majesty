+      if (rd32(unit + 0x70) || rd32(unit + 0x84) != factory ||
+          (rd32(unit + 0x6c) & 0xffffffu) != kind || (rd32(unit + 0x64) & 4u))
+        std::abort();
+      extra.r[R_ECX] = unit;
+      if (int32_t(guest_call(&extra, 0x005a1c40u, 0x00555041u, 0u)) <= 0)
+        std::abort();
+      extra.r[R_ECX] = unit;
+      if (guest_call(&extra, 0x005a1c40u, 0x01425041u, 0u) != 1)
+        std::abort();
+    }
