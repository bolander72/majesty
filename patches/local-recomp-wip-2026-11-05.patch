+          return gm_valid(address, 4) ? rd32(address) : UINT32_MAX;
+        };
+        std::fprintf(stderr,
+            "[frontier] Construction refusal captured=%u world-valid=%u "
+            "world-table=%08x grid=%08x cell-width=%u terrain=%08x "
+            "terrain-table=%08x cells=%u,%u vertices=%u,%u "
