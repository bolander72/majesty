+            ++cleaned_graphs;
+        }
+    }
+    if (reject_slot != UINT32_MAX) {
+        CHECK(!ok && s.rejected && !s.failed);
+        Slot &r = input->slots[reject_slot];
+        CHECK(!r.claimed && r.address);
+        if (r.address)
+            for (uint32_t i = 0; i < r.bytes; ++i)
+                CHECK(g_mem[r.address + i] == poison);
+        ++rejection_trials;
+        if (r.role == Bank)
+            bank_rejection_mask |= 1u << r.bank;
+    }
+    if (reject_name != UINT32_MAX) {
+        CHECK(!ok && s.name_rejected && !s.failed && !s.after_name_rejection);
+        CHECK(s.rejected_name_address && rd8(s.rejected_name_address) == poison);
+        CHECK(bridge.failure() == majesty::orders::AllocationFailure::PolicyRefused);
+        ++name_rejection_trials;
+        name_rejection_mask |=
+            1u << (reject_name - static_cast<uint32_t>(majesty::orders::Role::BaseName));
+    }
+    if (fail_bank != UINT32_MAX) {
+        CHECK(!ok && s.read_failed && !s.failed && !s.output_size);
+        CHECK(members(fail_bank, true));
+        if (fail_at == 16) {
+            Slot *r = slot(Path, fail_bank, 0);
+            CHECK(s.failed_zero_path && r && r->bytes && !r->claimed);
+            if (r && r->address)
+                for (uint32_t i = 0; i < r->bytes; ++i)
+                    CHECK(g_mem[r->address + i] == poison);
+        }
+        ++stream_failure_trials;
+    }
+    if (!ok) {
+        CHECK(!bridge.handoff_unit_orders(unit));
+        // Stopped private failure rollback: only detach pointers that exactly
+        // borrow claimed owned banks. Do not traverse unsafe partial orders.
+        CHECK(!journal.invocation_active() && !journal.eligible_cookie());
+        for (uint32_t bank = 0; bank < 3; ++bank) {
+            uint32_t value = rd32(unit + UNIT_BANKS + bank * 4);
+            if (value) {
+                const auto *b = journal.find(majesty::orders::Role::Bank, bank);
+                CHECK(b && b->owned && b->claimed && value == b->address);
+                wr32(unit + UNIT_BANKS + bank * 4, 0);
+                ++detached_partial_fields;
+            }
+        }
+    }
+    for (uint32_t bank = 0; bank < 3; ++bank)
+        CHECK(!rd32(unit + UNIT_BANKS + bank * 4));
+    for (uint32_t i = 0; i < 16; ++i)
+        CHECK(rd8(unit_storage + i) == 0xa5 && rd8(partial_unit + 0x94 + i) == 0xa5);
+    // Private canonical-name graphs publish nothing and allocate only from
+    // this journal. Release raw extents after every invocation has stopped;
+    // this does not qualify live destructors or complete actor rollback.
+    CHECK(!journal.invocation_active() && !journal.eligible_cookie());
+    CHECK(journal.release() &&
+          journal.state() == (s.engine_owned ? majesty::orders::State::Transferred
+                                             : majesty::orders::State::Released));
+    CHECK(journal.owned_request_bytes() == 0);
+    if (s.engine_owned && !stale_controller_refusals) {
+        // Even matching UNIT fields and fully claimed replacement storage must
+        // not let the previous reader certify a new reservation's unread graph.
+        CHECK(journal.reserve(requests, input->count, {nullptr, reserve_heap, release_heap}));
+        for (uint32_t i = 0; i < input->count; ++i) {
+            uint32_t address = 0;
+            CHECK(journal.claim(requests[i], &address));
+            if (requests[i].role == majesty::orders::Role::Bank)
+                wr32(unit + UNIT_BANKS + requests[i].bank * 4, address);
+        }
+        CHECK(journal.fully_claimed() && !bridge.complete() && !bridge.handoff_unit_orders(unit));
+        CHECK(journal.state() == majesty::orders::State::Reserved &&
+              journal.owned_request_bytes() > 0);
+        for (uint32_t bank = 0; bank < 3; ++bank)
+            wr32(unit + UNIT_BANKS + bank * 4, 0);
+        CHECK(journal.release());
+        ++stale_controller_refusals;
+    }
+    for (uint32_t i = input->count; i-- > 0;) {
+        Slot &r = input->slots[i];
+        r.address = 0;
+    }
+    if (handoff) {
+        CHECK(ok && s.engine_owned);
+        uint32_t esp = cpu->r[R_ESP], eip = cpu->eip, fs = rd32(cpu->fs_base);
+        uint32_t deleting = 1, address = unit;
+        cpu->r[R_ECX] = unit;
+        ++calls;
+        ++lifecycle_calls;
+        auto deleted = guest_call_guarded(cpu, VEHICLE_DELETE, &deleting, 1, &s.lifecycle_cookie);
+        s.lifecycle_cookie = 0;
+        CHECK(deleted.status == GuestCallGuardedStatus::Returned && !s.failed &&
+              lifecycle_extents[0].address == address && lifecycle_extents[0].freed);
+        CHECK(cpu->r[R_ESP] == esp && cpu->eip == eip && rd32(cpu->fs_base) == fs &&
+              !recomp_callback_depth() && !mods_hook_depth() && !mods_view_depth());
+        for (unsigned i = 0; i < lifecycle_extent_count; ++i)
+            CHECK(lifecycle_extents[i].freed);
+        ++vehicle_deletions;
+        CHECK(lifecycle_live_bytes == 0);
+        unit = partial_unit;
+    }
+    CHECK(heap_stats().used_blocks == baseline.used_blocks);
+    CHECK(heap_stats().used_bytes == baseline.used_bytes);
+    uint32_t small_block_after = small_block_live_count();
+    if (small_block_after != small_block_baseline)
+        std::fprintf(stderr, "small-block occupancy changed: trial=%u full=%u before=%u after=%u\n",
+                     trials, unsigned(handoff), small_block_baseline, small_block_after);
+    CHECK(small_block_after == small_block_baseline);
+    CHECK(!hooks.hook_failed());
+    CHECK(hooks.remove() && hooks.installed_count() == 0);
+    CHECK(hooks.remove() && mods_hooks_installed_count() == hooks_before);
+    ++reader_hook_scope_trials;
+    s.hooks = nullptr;
+    s.bridge = nullptr;
+    ++trials;
+    return (ok || s.rejected || s.name_rejected || s.read_failed) && !failures;
+}
+
+static unsigned rejection_site(const Slot &r) {
+    if (r.role == Head)
+        return 1u;
+    if (r.role == Node)
+        return 1u << 11;
+    if (r.role == Path)
+        return 1u << (r.kind == 4 ? 9 : 10);
+    static constexpr uint32_t kinds[] = {1, 2, 4, 5, 6, 7, 10, 11};
+    if (r.role == Order)
+        for (unsigned i = 0; i < 8; ++i)
+            if (r.kind == kinds[i])
+                return 1u << (i + 1);
+    return 0;
+}
+static bool word(FILE *f, uint32_t *v) {
+    uint8_t b[4];
+    if (std::fread(b, 1, 4, f) != 4)
+        return false;
+    *v = uint32_t(b[0]) | (uint32_t(b[1]) << 8) | (uint32_t(b[2]) << 16) | (uint32_t(b[3]) << 24);
+    return true;
+}
+static bool read_case(FILE *f, Case *c) {
+    *c = {};
+    if (!word(f, &c->count) || c->count < 6 || c->count > 32)
+        return false;
+    uint32_t total = 0;
+    for (uint32_t i = 0; i < c->count; ++i) {
+        Slot &r = c->slots[i];
+        if (!word(f, &r.role) || !word(f, &r.bank) || !word(f, &r.index) || !word(f, &r.kind) ||
+            !word(f, &r.bytes) || r.role > LeafName || r.bank >= 3 || r.bytes > 2048)
+            return false;
+        if (i < 6 && (r.role != i % 2 || r.bank != i / 2 || r.index != UINT32_MAX || r.kind ||
+                      r.bytes != (i % 2 ? 12u : 20u)))
+            return false;
+        for (uint32_t j = 0; j < i; ++j)
+            if (c->slots[j].role == r.role && c->slots[j].bank == r.bank &&
+                c->slots[j].index == r.index)
+                return false;
+        total += r.bytes;
+    }
+    if (total > 2048)
+        return false;
+    uint32_t payload_total = 0;
+    for (Payload &p : c->banks) {
+        if (!word(f, &p.size) || p.size < 8 || p.size > sizeof p.bytes || p.size % 4 ||
+            payload_total > 2048 - p.size || std::fread(p.bytes, 1, p.size, f) != p.size)
+            return false;
+        payload_total += p.size;
+    }
+    return true;
+}
+// Independently derive native reservations from complete serialized banks,
+// rather than trusting the fixture's JavaScript-provided request descriptors.
+static bool payload_plan_matches(const Case &c) {
+    uint8_t bytes[2048];
+    uint32_t size = 0;
+    for (const auto &bank : c.banks) {
+        if (bank.size > sizeof bytes - size) return false;
+        std::memcpy(bytes + size, bank.bytes, bank.size); size += bank.size;
+    }
+    majesty::orders::PayloadPlan plan;
+    if (!majesty::orders::plan_order_payload(bytes, size, plan) || plan.request_count != c.count)
+        return false;
+    for (uint32_t i = 0; i < c.count; ++i) {
+        const auto &r = plan.requests[i]; const auto &s = c.slots[i];
+        if (uint32_t(r.role) != s.role || r.bank != s.bank || r.index != s.index ||
+            r.kind != s.kind || r.bytes != s.bytes) return false;
+    }
+    for (uint32_t bank = 0; bank < 3; ++bank)
+        if (plan.bank_bytes[bank] != c.banks[bank].size) return false;
+    return true;
+}
+static bool read_outdoor_case(FILE *f, Case &c, uint32_t requested, uint32_t expected_entries,
+                               uint32_t first_kind) {
+    c = {};
+    uint32_t size = 0; uint8_t payload[2048];
+    if (!word(f, &size) || size > sizeof payload || std::fread(payload, 1, size, f) != size)
+        return false;
+    majesty::orders::PayloadPlan plan;
+    if (!majesty::orders::plan_order_payload(payload, size, plan) || plan.request_count > 32 ||
+        plan.requested_bytes != requested || plan.entry_count != expected_entries ||
+        plan.entries[0].kind != first_kind)
+        return false;
+    c.count = plan.request_count;
+    for (uint32_t i = 0; i < c.count; ++i) {
+        const auto &r = plan.requests[i];
+        c.slots[i] = {uint32_t(r.role),r.bank,r.index,r.kind,r.bytes,0,false,false};
+    }
+    for (uint32_t bank = 0; bank < 3; ++bank) {
+        c.banks[bank].size = plan.bank_bytes[bank];
+        std::memcpy(c.banks[bank].bytes, payload + plan.bank_offsets[bank], plan.bank_bytes[bank]);
+    }
+    return payload_plan_matches(c);
+}
+static bool crt_call(X86 *cpu, uint32_t fn, const uint32_t *args, int n, bool one = false) {
+    uint32_t esp = cpu->r[R_ESP], eip = cpu->eip, fs = rd32(cpu->fs_base);
+    ++calls;
+    ++crt_calls;
+    auto result = guest_call_guarded(cpu, fn, args, n);
+    CHECK(result.status == GuestCallGuardedStatus::Returned && (!one || result.eax == 1));
+    CHECK(cpu->r[R_ESP] == esp && cpu->eip == eip && rd32(cpu->fs_base) == fs &&
+          recomp_callback_depth() == 0);
+    return result.status == GuestCallGuardedStatus::Returned && (!one || result.eax == 1);
+}
+static uint32_t manager_call(X86 *cpu, uint32_t fn) {
+    uint32_t esp = cpu->r[R_ESP], eip = cpu->eip, fs = rd32(cpu->fs_base);
+    ++calls;
+    ++manager_calls;
+    auto result = guest_call_guarded(cpu, fn, nullptr, 0);
+    CHECK(result.status == GuestCallGuardedStatus::Returned);
+    CHECK(cpu->r[R_ESP] == esp && cpu->eip == eip && rd32(cpu->fs_base) == fs &&
+          recomp_callback_depth() == 0);
+    return result.eax;
+}
+static uint32_t resource_call(X86 *cpu, uint32_t fn, const uint32_t *args = nullptr, int n = 0) {
+    uint32_t esp = cpu->r[R_ESP], eip = cpu->eip, fs = rd32(cpu->fs_base);
+    ++calls;
+    ++resource_calls;
+    auto result = guest_call_guarded(cpu, fn, args, n);
+    CHECK(result.status == GuestCallGuardedStatus::Returned);
+    CHECK(cpu->r[R_ESP] == esp && cpu->eip == eip && rd32(cpu->fs_base) == fs &&
+          !recomp_callback_depth());
+    return result.eax;
+}
+static bool registry_valid() {
+    CHECK(manager && gm_valid(manager, 20) && rd32(manager) == MANAGER_TABLE);
+    if (!manager || !gm_valid(manager, 20))
+        return false;
+    uint32_t begin = rd32(manager + 8), end = rd32(manager + 12), capacity = rd32(manager + 16);
+    CHECK(begin && end >= begin && end - begin == 16 * 8 && capacity >= end &&
+          capacity - begin <= 256 && gm_valid(begin, capacity - begin));
+    if (!begin || end < begin || end - begin != 16 * 8 || capacity < end ||
+        capacity - begin > 256 || !gm_valid(begin, capacity - begin))
+        return false;
+    CHECK(!std::memcmp(g_mem + begin, g_mem + REGISTRY, 16 * 8));
+    CHECK(!rd32(REGISTRY + 16 * 8) && rd32(MANAGER_GLOBAL) == manager);
+    return !failures;
+}
+int main() {
+    FILE *f = std::fopen(MAJESTY_ORDER_HOOK_FIXTURE, "rb");
+    if (!f) {
+        std::fprintf(stderr, "Prepare the bounded private order-hook fixture first\n");
+        return 1;
+    }
+    char magic[4];
+    uint32_t count = 0;
+    if (std::fread(magic, 1, 4, f) != 4 || std::memcmp(magic, "NBO2", 4) || !word(f, &count) ||
+        count != 90) {
+        std::fclose(f);
+        return 1;
+    }
+    sched_set_guest_thread(true);
+    mem_init();
+    CHECK(loader_load(nullptr));
+    CHECK(!std::strcmp(loader_exe_sha256(), PIN));
+    CHECK(mods_symbols_load(MAJESTY_HOOK_TEST_SYMBOLS));
+    if (failures) {
+        std::fclose(f);
+        mem_shutdown();
+        return 1;
+    }
+    X86 cpu;
+    loader_init_context(&cpu);
+    uint32_t init[] = {1};
+    CHECK(crt_call(&cpu, 0x00654670, init, 1, true));
+    crt_mode = rd32(0x00723a8c);
+    CHECK(crt_mode == 3);
+    // Warm original CRT locks/pool before controlled owned invocations. Their
+    // persistent storage belongs to the process baseline, not an actor journal.
+    uint32_t field = heap_alloc(16, true), empty_name = heap_alloc(32, true);
+    CHECK(field && empty_name);
+    uint32_t copy[] = {field, empty_name}, clear[] = {field};
+    CHECK(crt_call(&cpu, 0x00523450, copy, 2, true));
+    CHECK(crt_call(&cpu, 0x00523420, clear, 1) && !rd32(field));
+    CHECK(heap_free(field) && heap_free(empty_name));
+    CHECK(!rd32(MANAGER_GLOBAL));
+    // Initialize the actual singleton and vector before installing owned-read
+    // allocation hooks. Original registry allocation is process-owned storage.
+    manager = manager_call(&cpu, GET_MANAGER);
+    CHECK(registry_valid());
+    CHECK(!rd32(GPL_RESOURCE_GLOBAL));
+    resource_live_before = small_block_live_count();
+    uint32_t runtime = resource_call(&cpu, GPL_RUNTIME_GET);
+    CHECK(runtime && gm_valid(runtime, 56) && rd32(GPL_RESOURCE_GLOBAL) &&
+          rd32(rd32(GPL_RESOURCE_GLOBAL) + 16) == runtime);
+    resource_live_after_setup = small_block_live_count();
+    for (unsigned i = 0; i < 3; ++i) {
+        CHECK(resource_call(&cpu, GPL_RUNTIME_GET) == runtime);
+        CHECK(small_block_live_count() == resource_live_after_setup);
+    }
+    HeapStats manager_baseline = heap_stats();
+    for (unsigned i = 0; i < 8 && !failures; ++i) {
+        CHECK(manager_call(&cpu, GET_MANAGER) == manager && registry_valid());
+        CHECK(heap_stats().used_blocks == manager_baseline.used_blocks &&
+              heap_stats().used_bytes == manager_baseline.used_bytes);
+    }
+    api.version = POP_MOD_API_VERSION;
+    api.size = sizeof api;
+    api.mod_index = MODS_OWNER_FIRST_MOD;
+    api.mod_id = "fixture.bank-read";
+    mods_set_context_provider(context);
+    mods_fill_hooks_api(&api);
+    mods_hooks_set_load_order(api.mod_index, 0);
+    mods_hooks_set_cpu_size(api.mod_index, POP_CPU_V1_BASELINE_SIZE);
+    for (Binding &b : bindings) {
+        CHECK(mods_symbol_hookable(b.address));
+        CHECK(mods_hook_install_ex(api.mod_index, b.address, 0, helper, POP_HOOK_REPLACE,
+                                   POP_HOOK_NO_GAME_VIEW, &b, &b.handle) == POP_OK);
+    }
+    stream = heap_alloc(16, true);
+    stream_buffer = heap_alloc(100, true);
+    stream_io = heap_alloc(92, true);
+    stream_data = heap_alloc(2080, true);
+    unit_storage = heap_alloc(0x94 + 32, false);
+    unit = partial_unit = unit_storage + 16;
+    CHECK(manager && stream && stream_buffer && stream_io && stream_data && unit_storage);
+    std::memset(g_mem + unit_storage, 0xa5, 0x94 + 32);
+    wr32(unit, UNIT_TABLE);
+    wr32(unit + 0x60, 0);
+    wr32(unit + 0x84, 0);
+    for (uint32_t bank = 0; bank < 3; ++bank)
+        wr32(unit + UNIT_BANKS + bank * 4, 0);
+    if (!failures) {
+        Case current;
+        for (uint32_t i = 0; i < count && !failures; ++i) {
+            bool valid = read_case(f, &current);
+            CHECK(valid);
+            if (!valid)
+                break;
+            CHECK(payload_plan_matches(current));
+            for (uint8_t poison : {uint8_t(0x5a), uint8_t(0xc3)})
+                if (!run(&current, &cpu, poison, UINT32_MAX, UINT32_MAX, 0, UINT32_MAX,
+                         poison == 0xc3))
+                    break;
+            for (uint32_t role : {static_cast<uint32_t>(majesty::orders::Role::BaseName),
+                                  static_cast<uint32_t>(majesty::orders::Role::LeafName)}) {
+                unsigned bit =
+                    1u << (role - static_cast<uint32_t>(majesty::orders::Role::BaseName));
+                if (name_rejection_mask & bit)
+                    continue;
+                for (uint32_t j = 0; j < current.count && !failures; ++j) {
+                    const Slot &r = current.slots[j];
+                    if (r.role == Order &&
+                        (role == static_cast<uint32_t>(majesty::orders::Role::BaseName) ||
+                         r.kind == 2 || r.kind == 5 || r.kind == 6 || r.kind == 11)) {
+                        run(&current, &cpu, 0x5a, UINT32_MAX, UINT32_MAX, 0, role);
+                        break;
+                    }
+                }
+            }
+            for (uint32_t j = 0; j < 6 && !failures; j += 2)
+                if (!(bank_rejection_mask & (1u << current.slots[j].bank)))
+                    run(&current, &cpu, 0x5a, j);
+            for (uint32_t j = 0; j < current.count && !failures; ++j) {
+                unsigned site = rejection_site(current.slots[j]);
+                if (!current.slots[j].bytes || !site || (rejection_sites & site))
+                    continue;
+                if (run(&current, &cpu, 0x5a, j))
+                    rejection_sites |= site;
+            }
+            if (!stream_failure_trials && !failures) {
+                for (uint32_t j = 0; j < current.count; ++j) {
+                    Slot &r = current.slots[j];
+                    if (r.role != Path || r.kind != 4 || r.index || !r.bytes)
+                        continue;
+                    for (uint8_t poison : {uint8_t(0x5a), uint8_t(0xc3)})
+                        for (uint32_t limit : {16u, current.banks[r.bank].size - 4})
+                            if (!run(&current, &cpu, poison, UINT32_MAX, r.bank, limit))
+                                break;
+                    break;
+                }
+            }
+        }
+        CHECK(std::fgetc(f) == EOF);
+        CHECK(trials == 201 && rejection_trials == 15 && rejection_sites == 0xfff &&
+              bank_rejection_mask == 7 && unit_reader_calls == 201 && precondition_checks == 5);
+        CHECK(cleaned_graphs == 180 && destruction_calls == 965);
+        CHECK(transferred_graphs == 90 && transfer_refusals == 450 && transferred_free_calls > 0);
+        CHECK(stale_controller_refusals == 1);
+        CHECK(reader_hook_scope_trials == 201 && reader_hook_install_rollback_controls == 1);
+        CHECK(unpublished_actor_admission_controls == 7);
+        CHECK(vehicle_constructions == 90 && vehicle_deletions == 90 && lifecycle_calls == 180);
+        CHECK(vehicle_constructor_entries == 90 && vehicle_deleting_entries == 90);
+        CHECK(lifecycle_allocations == lifecycle_frees);
+        CHECK(unit_attached_graphs == 180 && unit_get_calls == 540 && unit_writer_calls == 180 &&
+              unit_clear_calls == 540);
+        CHECK(name_rejection_trials == 2 && name_rejection_mask == 3);
+        CHECK(stream_failure_trials == 4);
+        CHECK(failed_zero_requests == 2);
+        CHECK(nested_hidden_checks == 1);
+        CHECK(kinds_seen == ((1u << 1) | (1u << 2) | (1u << 4) | (1u << 5) | (1u << 6) | (1u << 7) |
+                             (1u << 10) | (1u << 11)));
+    }
+    unsigned outdoor_payloads = 0, outdoor_trials = 0, kind_nine_rejection = 0;
+    if (!failures) {
+        FILE *outdoor = std::fopen(MAJESTY_OUTDOOR_ORDER_FIXTURE, "rb");
+        CHECK(outdoor);
+        char magic[4]; uint32_t count = 0;
+        bool valid = outdoor && std::fread(magic,1,4,outdoor) == 4 &&
+                     !std::memcmp(magic,"NOP1",4) && word(outdoor,&count) && count == 4;
+        CHECK(valid);
+        constexpr uint32_t requested[] = {454,202,161,161}, first_kind[] = {4,5,9,9};
+        for (uint32_t i = 0; valid && i < count && !failures; ++i) {
+            Case current;
+            valid = read_outdoor_case(outdoor,current,requested[i],i == 0 ? 2 : 1,first_kind[i]);
+            CHECK(valid);
+            if (!valid) break;
+            for (uint8_t poison : {uint8_t(0x5a),uint8_t(0xc3)}) {
+                CHECK(run(&current,&cpu,poison,UINT32_MAX,UINT32_MAX,0,UINT32_MAX,poison == 0xc3));
+                ++outdoor_trials;
+            }
+            if (i == 2 && !failures) {
+                CHECK(current.slots[6].kind == 9 && current.slots[6].role == Order);
+                CHECK(run(&current,&cpu,0x5a,6));
+                ++kind_nine_rejection;
+            }
+            ++outdoor_payloads;
+        }
+        CHECK(outdoor_payloads == 4 && outdoor_trials == 8 && kind_nine_rejection == 1);
+        CHECK(transferred_graphs == 94 && vehicle_constructions == 94 && vehicle_deletions == 94);
+        CHECK(kinds_seen == ((1u << 1) | (1u << 2) | (1u << 4) | (1u << 5) | (1u << 6) |
+                            (1u << 7) | (1u << 9) | (1u << 10) | (1u << 11)));
+        if (outdoor) { CHECK(std::fgetc(outdoor) == EOF); CHECK(std::fclose(outdoor) == 0); }
+    }
+    uint32_t reset_resource = 0;
+    resource_call(&cpu, GPL_RUNTIME_DELETE, &reset_resource, 1);
+    CHECK(!rd32(GPL_RESOURCE_GLOBAL) && resource_delete_entries == 1);
+    resource_live_after_delete = small_block_live_count();
+    CHECK(resource_live_after_delete == resource_live_before);
+    for (Binding &b : bindings)
+        if (b.handle)
+            CHECK(mods_hook_remove(api.mod_index, b.handle) == POP_OK);
+    CHECK(mods_hooks_installed_count() == 0 && mods_hook_depth() == 0 && mods_view_depth() == 0);
+    if (stream)
+        CHECK(heap_free(stream));
+    CHECK(heap_free(stream_buffer) && heap_free(stream_io) && heap_free(stream_data));
+    CHECK(heap_free(unit_storage));
+    mods_set_context_provider(nullptr);
+    mods_hooks_reset();
+    CHECK(registry_valid());
+    manager_call(&cpu, DELETE_MANAGER);
+    CHECK(!rd32(MANAGER_GLOBAL));
+    CHECK(crt_call(&cpu, 0x006546cd, nullptr, 0));
+    mem_shutdown();
+    std::fclose(f);
+    std::printf(
+        "%u bank read hook checks, %u failures; %u trials, %u native calls, %u allocation hooks\n",
+        checks, failures, trials, calls, allocation_calls);
+    std::printf("outdoor source payloads: %u, positive trials: %u, kind9 allocation refusals: %u\n",
+                outdoor_payloads,outdoor_trials,kind_nine_rejection);
+    std::printf("unpublished actor admission controls: %u\n", unpublished_actor_admission_controls);
+    std::printf("game-owned reader hook scopes: %u trials, %u partial-install rollback controls\n",
+                reader_hook_scope_trials, reader_hook_install_rollback_controls);
+    std::printf("maximum private actor journal delta: %llu rounded guest heap bytes\n",
+                (unsigned long long)max_guest_bytes);
+    std::printf("owned allocation rejection trials: %u, site mask: %03x\n", rejection_trials,
+                rejection_sites);
+    std::printf("sticky stream failure trials: %u\n", stream_failure_trials);
+    std::printf("failed kind-4 zero requests: %u\n", failed_zero_requests);
+    std::printf("original name helpers: %u copies, %u clears, %u malloc hooks, %u refusal trials\n",
+                name_copy_calls, name_clear_calls, name_allocation_calls, name_rejection_trials);
+    std::printf("original destruction: %u graphs, %u calls, %u tracked CRT frees\n", cleaned_graphs,
+                destruction_calls, original_free_calls);
+    std::printf("engine ownership handoff: %u graphs, %u original CRT frees, %u changed-owner "
+                "refusals\n",
+                transferred_graphs, transferred_free_calls, transfer_refusals);
+    std::printf("original CRT bootstrap/termination: %u calls, selected mode %u\n", crt_calls,
+                crt_mode);
+    std::printf(
+        "original factory manager: %u setup/cache/teardown calls, 16 matched registry entries\n",
+        manager_calls);
+    std::printf("original fixed streams: %u setup/teardown calls, %u observed operations\n",
+                stream_calls, original_stream_operations);
+    std::printf("private UNIT attachment: %u graphs, %u getters, %u writers, %u clears\n",
+                unit_attached_graphs, unit_get_calls, unit_writer_calls, unit_clear_calls);
+    std::printf("guarded original UNIT readers: %u calls, bank refusal mask %x, %u partial "
+                "pointers detached\n",
+                unit_reader_calls, bank_rejection_mask, detached_partial_fields);
+    std::printf("UNIT precondition refusal controls: %u\n", precondition_checks);
+    std::printf("stale reader reservation refusal controls: %u\n", stale_controller_refusals);
+    std::printf("original private vehicle lifecycle: %u constructions, %u deletions, %u calls, "
+                "%u allocations, %u frees\n",
+                vehicle_constructions, vehicle_deletions, lifecycle_calls, lifecycle_allocations,
+                lifecycle_frees);
+    std::printf("private vehicle heap peaks: %llu constructor bytes, %llu with order journal\n",
+                (unsigned long long)max_vehicle_heap_bytes,
+                (unsigned long long)max_vehicle_and_order_heap_bytes);
+    std::printf("original vehicle maximum live requested bytes: %u\n", max_vehicle_requested_bytes);
+    std::printf("original vehicle plus reserved orders maximum requested bytes: %u\n",
+                max_vehicle_and_order_requested_bytes);
+    std::printf("original GPL resources: %u calls, small-block live counts %u / %u / %u\n",
+                resource_calls, resource_live_before, resource_live_after_setup,
+                resource_live_after_delete);
+    std::printf("original lifecycle entry observers: %u constructors, %u deleting destructors, "
+                "%u GPL resource deletes\n",
+                vehicle_constructor_entries, vehicle_deleting_entries, resource_delete_entries);
+    return failures ? 1 : 0;
+}
diff --git a/tests/native_order_crt_name_tests.cpp b/tests/native_order_crt_name_tests.cpp
new file mode 100644
index 0000000..2ea3516
--- /dev/null
+++ b/tests/native_order_crt_name_tests.cpp
@@ -0,0 +1,166 @@
+// Original CRT initialization, name copy/replacement/clear and heap termination.
+// No allocator hooks, game entry, actor publication or browser. One private CPU.
+#include "../kit/runtime/guest.h"
+#include "../kit/runtime/loader.h"
+#include "../kit/runtime/memory.h"
+#include "../kit/runtime/profile.h"
+#include "../kit/runtime/win32.h"
+#include <cstdio>
+#include <cstring>
+
+static constexpr uint32_t HEAP_INIT = 0x00654670, HEAP_TERM = 0x006546cd;
+static constexpr uint32_t COPY = 0x00523450, CLEAR = 0x00523420, HEAP_MODE = 0x00723a8c;
+static constexpr unsigned NAMES = 128, CYCLES = 8;
+static constexpr uint64_t MAX_CRT_DELTA = 2 * 1024 * 1024;
+static const char *PIN = "654365fd1bdefa6d7f2349d162869f255388fadcb1bb8db9f7db2f3468dd5542";
+static unsigned checks, failures, calls, heap_port_clears, recycled_names;
+static uint64_t peak_delta, retained_delta, retained_blocks;
+static uint32_t mode;
+#define CHECK(x)                                                                                   \
+    do {                                                                                           \
+        ++checks;                                                                                  \
+        if (!(x)) {                                                                                \
+            ++failures;                                                                            \
+            std::fprintf(stderr, "FAIL line %d: %s\n", __LINE__, #x);                              \
+        }                                                                                          \
+    } while (0)
+
+// Normal guarded calls retain guest register/heap changes. Check caller stack,
+// SEH and cdecl preserved registers, then restore our CPU for the next trial.
+// The field array and source belong to this caller, never skipped frames.
+static bool invoke(X86 *cpu, uint32_t fn, const uint32_t *args, int count,
+                   bool expect_one = false) {
+    X86 before = *cpu;
+    uint32_t fs = rd32(cpu->fs_base), depth = recomp_profile_depth();
+    ++calls;
+    auto result = guest_call_guarded(cpu, fn, args, count);
+    CHECK(result.status == GuestCallGuardedStatus::Returned);
+    CHECK(cpu->r[R_ESP] == before.r[R_ESP] && cpu->eip == before.eip);
+    CHECK(cpu->r[R_EBX] == before.r[R_EBX] && cpu->r[R_ESI] == before.r[R_ESI] &&
+          cpu->r[R_EDI] == before.r[R_EDI] && cpu->r[R_EBP] == before.r[R_EBP]);
+    CHECK(rd32(cpu->fs_base) == fs && recomp_callback_depth() == 0 &&
+          recomp_profile_depth() == depth);
+    if (expect_one)
+        CHECK(result.eax == 1);
+    *cpu = before;
+    return result.status == GuestCallGuardedStatus::Returned && (!expect_one || result.eax == 1) &&
+           !failures;
+}
+
+int main() {
+    sched_set_guest_thread(true);
+    mem_init();
+    CHECK(loader_load(nullptr));
+    CHECK(!std::strcmp(loader_exe_sha256(), PIN));
+    X86 cpu;
+    loader_init_context(&cpu);
+    uint32_t fields = heap_alloc(NAMES * 16, true), source = heap_alloc(32, true);
+    CHECK(fields && source && !rd32(HEAP_MODE));
+    if (failures) {
+        mem_shutdown();
+        return 1;
+    }
+    HeapStats baseline = heap_stats();
+    uint32_t init[] = {1};
+    bool ok = invoke(&cpu, HEAP_INIT, init, 1, true);
+    mode = rd32(HEAP_MODE);
+    // Qualify the original selected small-block mode, not a forced bypass mode.
+    CHECK(mode == 3);
+    uint32_t previously_cleared[NAMES] = {};
+    for (unsigned cycle = 0; cycle < CYCLES && ok && !failures; ++cycle) {
+        for (unsigned pass = 0; pass < 2 && ok; ++pass) {
+            for (unsigned i = 0; i < NAMES && ok; ++i) {
+                uint32_t field = fields + 16 * i, args[] = {field, source};
+                if (!pass)
+                    CHECK(!rd32(field));
+                else
+                    CHECK(rd32(field)); // copy must clear an existing positive pointer
+                ok = invoke(&cpu, COPY, args, 2, true);
+                uint32_t name = rd32(field);
+                CHECK(name && gm_valid(name, 1) && !rd8(name));
+                if (!pass && cycle) {
+                    bool recycled = false;
+                    for (uint32_t old : previously_cleared)
+                        recycled = recycled || old == name;
+                    // A flat backing-pool total alone could hide leaked small
+                    // blocks. Every fresh name must reuse the prior cleared set.
+                    CHECK(recycled);
+                    if (recycled)
+                        ++recycled_names;
+                }
+                // During replacement, later fields still own their old strings.
+                // Check every other live field, not just this pass's earlier ones.
+                for (unsigned j = 0; j < NAMES; ++j)
+                    if (j != i && rd32(fields + 16 * j))
+                        CHECK(name != rd32(fields + 16 * j));
+            }
+            auto now = heap_stats();
+            CHECK(now.used_bytes >= baseline.used_bytes);
+            uint64_t delta = now.used_bytes - baseline.used_bytes;
+            CHECK(delta <= MAX_CRT_DELTA);
+            if (delta > peak_delta)
+                peak_delta = delta;
+        }
+        for (unsigned i = 0; i < NAMES && ok; ++i) {
+            uint32_t args[] = {fields + 16 * i};
+            previously_cleared[i] = rd32(args[0]);
+            ok = invoke(&cpu, CLEAR, args, 1);
+            CHECK(!rd32(args[0]));
+        }
+        auto after = heap_stats();
+        CHECK(after.used_bytes >= baseline.used_bytes && after.used_blocks >= baseline.used_blocks);
+        if (!cycle) {
+            retained_delta = after.used_bytes - baseline.used_bytes;
+            retained_blocks = after.used_blocks - baseline.used_blocks;
+        } else {
+            // CRT pools may retain backing storage. After one complete cycle,
+            // these exact workload metrics must plateau rather than grow.
+            CHECK(after.used_bytes == baseline.used_bytes + retained_delta);
+            CHECK(after.used_blocks == baseline.used_blocks + retained_blocks);
+        }
+        CHECK(!std::memcmp(g_mem + source, "\0\0\0\0\0\0\0\0", 8));
+    }
+    if (ok && !failures) {
+        // The journal's current heap_port allocates standalone runtime extents.
+        // Original CRT mode 3 must identify these as outside its small-block
+        // pages and pass them to HeapFree, rather than corrupt its own pool.
+        HeapStats before = heap_stats();
+        uint32_t addresses[NAMES] = {};
+        for (unsigned i = 0; i < NAMES; ++i) {
+            addresses[i] = heap_alloc(1, false);
+            CHECK(addresses[i] && heap_owns(addresses[i]));
+            if (!addresses[i]) {
+                ok = false;
+                break;
+            }
+            wr8(addresses[i], 0);
+            wr32(fields + 16 * i, addresses[i]);
+        }
+        for (unsigned i = 0; i < NAMES && ok && !failures; ++i) {
+            uint32_t args[] = {fields + 16 * i};
+            ok = invoke(&cpu, CLEAR, args, 1);
+            CHECK(!rd32(args[0]) && !heap_owns(addresses[i]));
+            ++heap_port_clears;
+        }
+        CHECK(heap_stats().used_bytes == before.used_bytes &&
+              heap_stats().used_blocks == before.used_blocks);
+        uint32_t zero[] = {0}, empty[] = {fields};
+        CHECK(invoke(&cpu, CLEAR, zero, 1));
+        CHECK(invoke(&cpu, CLEAR, empty, 1));
+        CHECK(invoke(&cpu, HEAP_TERM, nullptr, 0));
+    }
+    CHECK(heap_free(fields) && heap_free(source));
+    CHECK(recycled_names == (CYCLES - 1) * NAMES);
+    std::printf("%u original CRT name checks, %u failures; %u calls, heap mode %u\n", checks,
+                failures, calls, mode);
+    std::printf(
+        "name workload: %u cycles, %u simultaneous names, copy then replacement then clear\n",
+        CYCLES, NAMES);
+    std::printf("CRT guest pool delta: peak %llu bytes, retained %llu bytes / %llu blocks\n",
+                (unsigned long long)peak_delta, (unsigned long long)retained_delta,
+                (unsigned long long)retained_blocks);
+    std::printf("runtime heap-port extents released by original clear: %u\n", heap_port_clears);
+    std::printf("fresh names reusing the prior cleared set: %u\n", recycled_names);
+    mem_shutdown();
+    return failures || !ok ? 1 : 0;
+}
diff --git a/tests/native_order_payload_tests.cpp b/tests/native_order_payload_tests.cpp
new file mode 100644
index 0000000..814744d
--- /dev/null
+++ b/tests/native_order_payload_tests.cpp
@@ -0,0 +1,98 @@
+// Storage admission controls; no executable, world or guest allocation.
+#include "../native_order_payload.h"
+#include <cstdio>
+#include <cstdlib>
+#include <vector>
+using namespace majesty::orders;
+static unsigned checks, failures;
+extern "C" void recomp_call(X86 *, uint32_t) { std::abort(); }
+extern "C" void recomp_jump(X86 *, uint32_t) { std::abort(); }
+#define CHECK(x) do { ++checks; if (!(x)) { ++failures; std::fprintf(stderr, "FAIL %d: %s\n", __LINE__, #x); } } while (0)
+static void put(std::vector<uint8_t> &p, uint32_t at, uint32_t v) {
+    for (uint32_t i = 0; i < 4; ++i) p[at + i] = uint8_t(v >> (i * 8));
+}
+static std::vector<uint8_t> one(uint32_t kind, uint32_t fixed, uint32_t version,
+                                uint32_t capacity = 0, uint32_t count = 0, uint32_t cursor = 0) {
+    std::vector<uint8_t> p(32 + fixed + count * 8);
+    put(p, 0, 1); put(p, 4, 1); put(p, 8, 1); put(p, 12, kind);
+    const uint32_t base = (kind == 11 || kind == 13) ? 2 : 1;
+    put(p, 16, version);
+    if (kind == 11 || kind == 13) put(p, 20, 1);
+    put(p, 16 + base * 4, 1); put(p, 20 + base * 4, 2); put(p, 24 + base * 4, kind);
+    if (kind == 4) {
+        put(p, 16 + 128, capacity); put(p, 16 + 136, count); put(p, 16 + 120, cursor);
+    } else if (kind == 7) {
+        put(p, 16 + 108, count); put(p, 16 + 100, cursor);
+    }
+    put(p, uint32_t(p.size()) - 16, 1); put(p, uint32_t(p.size()) - 8, 1);
+    return p;
+}
+static void refused(const std::vector<uint8_t> &p) {
+    PayloadPlan plan; plan.request_count = 1; plan.entry_count = 1; plan.requested_bytes = 99;
+    CHECK(!plan_order_payload(p.data(), uint32_t(p.size()), plan));
+    CHECK(!plan.request_count && !plan.entry_count && !plan.requested_bytes);
+}
+int main() {
+    PayloadPlan plan;
+    std::vector<uint8_t> empty(24);
+    for (uint32_t b = 0; b < 3; ++b) put(empty, b * 8, 1);
+    CHECK(plan_order_payload(empty.data(), uint32_t(empty.size()), plan));
+    CHECK(plan.entry_count == 0 && plan.request_count == 6 && plan.requested_bytes == 96);
+    CHECK(!plan_order_payload(nullptr, 24, plan));
+    CHECK(!plan_order_payload(empty.data(), UINT32_MAX, plan));
+    struct Layout {uint32_t kind, fixed, version, object, leaf;};
+    for (const auto &l : {Layout{1,132,2,88,NO_INDEX}, {2,176,2,92,30}, {4,140,5,100,NO_INDEX},
+                         {5,176,1,92,29}, {6,176,1,92,30}, {7,112,1,72,NO_INDEX},
+                         {9,96,1,52,NO_INDEX}, {10,120,1,76,NO_INDEX}, {11,200,1,112,30},
+                         {12,116,1,72,NO_INDEX}, {13,188,1,100,30}}) {
+        auto p = one(l.kind, l.fixed, l.version, l.kind == 4 ? 128 : 0,
+                     l.kind == 4 || l.kind == 7 ? 2 : 0, l.kind == 4 || l.kind == 7 ? 1 : 0);
+        const auto original = p;
+        CHECK(plan_order_payload(p.data(), uint32_t(p.size()), plan));
+        CHECK(p == original && plan.entry_count == 1 && plan.entries[0].kind == l.kind);
+        CHECK(plan.requests[6].bytes == l.object);
+        CHECK(plan.requested_bytes == 96 + l.object + 13 + (l.leaf != NO_INDEX ? 1 : 0) +
+              (l.kind == 4 ? 1024 : l.kind == 7 ? 80 : 0));
+        for (uint32_t end = 0; end < p.size(); ++end) {
+            CHECK(!plan_order_payload(p.data(), end, plan));
+            CHECK(plan.request_count == 0 && plan.entry_count == 0);
+        }
+        auto bad = p; bad.push_back(0); refused(bad);
+        bad.resize(p.size() + 4); refused(bad);
+        for (const uint32_t at : {0u, 8u, 12u, 16u}) {
+            bad = p; put(bad, at, UINT32_MAX); refused(bad);
+        }
+        const uint32_t base = (l.kind == 11 || l.kind == 13) ? 2 : 1;
+        if (base == 2) {bad = p; put(bad, 20, 2); refused(bad);}
+        for (uint32_t n = 0; n < 8; ++n) {
+            bad = p; put(bad, 16 + (base + 15 + n) * 4, 1); refused(bad);
+            if (l.leaf != NO_INDEX) {bad = p; put(bad, 16 + (l.leaf + 6 + n) * 4, 1); refused(bad);}
+        }
+        if (l.kind == 4 || l.kind == 7) {
+            bad = p; put(bad, 16 + (l.kind == 4 ? 136 : 108), UINT32_MAX); refused(bad);
+            bad = p; put(bad, 16 + (l.kind == 4 ? 120 : 100), 3); refused(bad);
+        }
+    }
+    auto zero = one(4, 140, 5); CHECK(plan_order_payload(zero.data(), uint32_t(zero.size()), plan));
+    CHECK(plan.requests[7].role == Role::Path && plan.requests[7].bytes == 0);
+    auto max = one(4, 140, 5, 4096, 4096, 4096);
+    CHECK(plan_order_payload(max.data(), uint32_t(max.size()), plan));
+    put(max, 16 + 128, 4097); refused(max);
+    auto short_path = one(7, 112, 1, 0, 11); refused(short_path);
+    // Two full path allocations exceed the shared 64 KiB reservation budget.
+    auto large = one(4,140,5,4096); const uint32_t first_end = uint32_t(large.size()) - 16;
+    auto second = large;
+    large.insert(large.begin() + first_end, second.begin() + 8, second.end() - 16);
+    put(large, 4, 2); refused(large);
+    // 128 entries fit in bounded descriptor storage; 129 do not.
+    auto unit = one(9, 96, 1);
+    std::vector<uint8_t> many(8); put(many, 0, 1); put(many, 4, 128);
+    for (uint32_t i = 0; i < 128; ++i) many.insert(many.end(), unit.begin() + 8, unit.end() - 16);
+    const uint32_t end = uint32_t(many.size()); many.resize(end + 16);
+    put(many, end, 1); put(many, end + 8, 1);
+    CHECK(plan_order_payload(many.data(), uint32_t(many.size()), plan));
+    CHECK(plan.entry_count == 128 && plan.request_count == 390 && plan.requested_bytes == 8416);
+    put(many, 4, 129); refused(many);
+    std::printf("%u order payload checks, %u failures\n", checks, failures);
+    return failures ? 1 : 0;
+}
