+extern "C" void majesty_browser_inventory_audit(X86 *c) {
+  const char *debug = recomp_env("BROWSER_INVENTORY_DEBUG");
+  if (!enabled() || !debug || std::strcmp(debug, "1") != 0)
+    return;
