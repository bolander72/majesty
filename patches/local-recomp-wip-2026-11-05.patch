+  CHECK(state && gm_valid(state, 0x50) && manager && gm_valid(manager, 0x2b0));
+  CHECK(rd32(manager) == 0x00682bc4 &&
+        rd32(rd32(manager) + 0x90) == 0x004a5130);
+  CHECK(!rd32(0x0071c68c) && !rd32(0x006d84dc));
+  const uint32_t initial_type = rd32(manager + 0x218);
+  for (uint32_t type : {0u, 1u, 2u, 3u, 4u, UINT32_MAX}) {
+    wr32(manager + 0x218, type);
+    CHECK(majesty::coop_match_type(manager) == (type == 1 || type == 3));
+  }
+  wr32(manager + 0x218, initial_type);
+  uint32_t pause_hook = 0, free_hook = 0;
+  CHECK(mods_hook_install_ex(MODS_OWNER_RUNTIME, 0x004a5c00, 0, no_modal,
+                             POP_HOOK_WRAP, POP_HOOK_NO_GAME_VIEW, nullptr,
+                             &pause_hook) == POP_OK);
+  CHECK(mods_hook_install_ex(MODS_OWNER_RUNTIME, 0x00645bc0, 0, free_observer,
+                             POP_HOOK_WRAP, POP_HOOK_NO_GAME_VIEW, nullptr,
+                             &free_hook) == POP_OK);
+  for (unsigned cycle = 0; cycle < 20 && !failures; ++cycle) {
+    wr32(state, 3);
+    wr32(state + 4, 0);
+    wr32(state + 0x28, 19999 + cycle);
+    wr32(0x0071c6a8, 31800 + 50 * cycle);
+    const uint32_t frame = rd32(state + 0x28), clock = rd32(0x0071c6a8),
+                   owner = 7 + cycle % 2;
+    // Invoke the original readback handlers directly; cooperative admission
+    // is tested separately and must refuse this mode before queuing pause.
+    wr32(manager + 0x218, 2);
+    command(&cpu, manager, 0, owner, 1, 0);
+    CHECK(rd32(state) == 3 && rd32(state + 4) == 7 &&
+          rd32(manager + 0x27c) == owner);
+    CHECK(rd32(state + 0x28) == frame && rd32(0x0071c6a8) == clock &&
+          !rd32(0x0071c68c));
+    // Emulate only the outer dispatcher's documented deferred phase copy.
+    // No original tick is executed and no replicated boundary is claimed.
+    wr32(state, rd32(state + 4));
+    wr32(state + 4, 0);
+    const auto old_pauses = pauses;
+    command(&cpu, manager, 0, owner + 1, 1,
+            0); // Duplicate pause leaves current owner.
+    CHECK(pauses == old_pauses + 1 && rd32(manager + 0x27c) == owner &&
+          rd32(state) == 7 && !rd32(state + 4));
+    command(&cpu, manager, 1, owner, 11 + cycle, 500 + cycle);
+    CHECK(rd32(state) == 7 && rd32(state + 4) == 3 &&
+          rd32(manager + 0x27c) == 0xffffffff);
+    CHECK(rd32(manager + 0x88) == 11 + cycle &&
+          rd32(0x006c066c) == 11 + cycle && rd32(0x006d8548) == 500 + cycle &&
+          rd8(manager + 0x280) == 1);
+    CHECK(rd32(state + 0x28) == frame && rd32(0x0071c6a8) == clock &&
+          !rd32(0x0071c68c));
+    CHECK(mods_hook_depth() == 0 && recomp_callback_depth() == 0 &&
+          heap_check().empty());
+  }
+  if (!failures)
+    queued_pause(&cpu, state, manager);
+  if (!failures)
+    prepared_transmit(&cpu, state, manager);
+  if (!failures)
+    network_buffer_retirement(&cpu, state, manager);
+  if (!failures)
+    save_name(&cpu);
+  if (!failures)
+    player_bindings(&cpu, state, manager);
+  if (!failures)
+    live_party_metadata(&cpu, state, manager);
+  if (!failures)
+    canceled_source_boundary(&cpu, state, manager);
+  if (!failures)
+    committed_read_permission();
+  if (!failures)
+    attached_rebuild_transition(&cpu, state, manager);
+  if (!failures)
+    checkpoint_names(&cpu);
+  if (!failures)
+    saved_metadata();
+  if (!failures)
+    connected_return_geometry();
+  if (!failures)
+    saved_script_reset(&cpu);
+  CHECK(mods_hook_remove(MODS_OWNER_RUNTIME, pause_hook) == POP_OK);
+  CHECK(mods_hook_remove(MODS_OWNER_RUNTIME, free_hook) == POP_OK);
+  // As in region travel, the silent sound manager stays alive across every
+  // phase transition. This fixture never opens the normal resource libraries;
+  // their lookup-dependent global sound shutdown is outside this test. The
+  // owned guest arena is released by mem_shutdown below, without a sound
+  // device.
+  wr32(0x006d8f68, 0);
+  std::printf("%u original co-op pause checks, %u failures, %u guarded calls; "
+              "pauses=%u packet-frees=%u ref-frees=%u\n",
+              checks, failures, calls, pauses, packet_frees, reference_frees);
+  mem_shutdown();
+  return failures ? 1 : 0;
+}
diff --git a/tests/native_coop_transition_tests.cpp b/tests/native_coop_transition_tests.cpp
new file mode 100644
index 0000000..18b944f
--- /dev/null
+++ b/tests/native_coop_transition_tests.cpp
@@ -0,0 +1,299 @@
+#include "../coop_transition.h"
+#include "../coop_source_abort.h"
+#include <cstdio>
+#include <limits>
+#include <string>
+#include <vector>
+static unsigned checks, failures;
+#define CHECK(x)                                                               \
+  do {                                                                         \
+    ++checks;                                                                  \
+    if (!(x)) {                                                                \
+      ++failures;                                                              \
+      std::fprintf(stderr, "FAIL %d: %s\n", __LINE__, #x);                     \
+    }                                                                          \
+  } while (0)
+using namespace majesty;
+static CoopTransition example(bool saved) {
+  CoopTransition t;
+  coop_detail::copy("shared-kingdom", t.world);
+  coop_detail::copy(std::string(64, 'a') + ":" + std::string(64, 'b'),
+                    t.content);
+  coop_detail::copy(std::string(64, 'c'), t.rules);
+  coop_detail::copy(std::string(64, 'd'), t.source_digest);
+  t.source_x = -1;
+  t.target_x = 0;
+  t.source_revision = 1;
+  t.source_bytes = 336981;
+  t.frame = 19999;
+  t.clock = 31800;
+  t.target_saved = saved;
+  if (saved) {
+    t.target_revision = 2;
+    t.target_bytes = 336981;
+    t.target_clock = 1550;
+    t.target_gpl_seed = 17;
+    t.target_game_seed = 23;
+    coop_detail::copy(std::string(64, 'e'), t.target_digest);
+  }
+  return t;
+}
+static std::vector<std::string> lines(std::string_view wire) {
+  std::vector<std::string> out;
+  while (!wire.empty()) {
+    auto n = wire.find('\n');
+    out.emplace_back(wire.substr(0, n));
+    wire.remove_prefix(n + 1);
+  }
+  return out;
+}
+static std::string join(const std::vector<std::string> &lines) {
+  std::string s;
+  for (auto &l : lines)
+    s += l + '\n';
+  return s;
+}
+int main() {
+  // Only an exact pre-commit Canceled proposal can authorize source recovery.
+  // Target read/generation/Loaded permissions remain separate and refuse4.
+  for (bool saved : {false, true}) {
+    const auto target = example(saved);
+    CoopTransitionWire wire;
+    CHECK(encode_coop_transition(target, wire));
+    for (uint32_t local : {1u, 3u}) {
+      recomp_network_session_v1 party{local == 1, local, 2, {1, 3, 0, 0}};
+      recomp_network_barrier_v1 canceled{};
+      canceled.stage = 4; canceled.serial = 17;
+      canceled.player_count = party.player_count;
+      std::memcpy(canceled.players, party.players, sizeof party.players);
+      canceled.descriptor_bytes = uint32_t(wire.size);
+      std::memcpy(canceled.descriptor, wire.bytes.data(), wire.size);
+      CHECK(coop_canceled_source_permission(canceled, party, 17, target, 1));
+      CHECK(!coop_committed_read(canceled, party, 17, target));
+      CHECK(!coop_committed_generate(canceled, party, 17, target));
+      CHECK(!coop_resume_permission(canceled, party, 17, target, true));
+      for (uint32_t stage : {0u, 1u, 2u, 3u, 5u, UINT32_MAX}) {
+        auto changed = canceled; changed.stage = stage;
+        CHECK(!coop_canceled_source_permission(changed, party, 17, target, 1));
+      }
+      for (uint32_t owner : {0u, 3u, 5u, UINT32_MAX})
+        CHECK(!coop_canceled_source_permission(canceled, party, 17, target, owner));
+      CHECK(!coop_canceled_source_permission(canceled, party, 18, target, 1));
+      auto changed = canceled; changed.descriptor[0] ^= 1;
+      CHECK(!coop_canceled_source_permission(changed, party, 17, target, 1));
+      changed = canceled; changed.players[1] = 5;
+      CHECK(!coop_canceled_source_permission(changed, party, 17, target, 1));
+      changed = canceled; changed.players[2] = 5;
+      CHECK(!coop_canceled_source_permission(changed, party, 17, target, 1));
+      auto wrong = target; ++wrong.source_revision;
+      CHECK(!coop_canceled_source_permission(canceled, party, 17, wrong, 1));
+      auto other = party; other.host ^= 1;
+      CHECK(!coop_canceled_source_permission(canceled, other, 17, target, 1));
+      other = party; other.local_player = 5;
+      CHECK(!coop_canceled_source_permission(canceled, other, 17, target, 1));
+    }
+  }
+  // Aborting before Begin must not authorize a prepared, committed, replaced
+  // or malformed agreement. No original graph, game process or I/O is used.
+  recomp_network_barrier_v1 empty{};
+  CHECK(coop_source_abort_permission(empty, empty));
+  for (uint32_t stage : {1u, 2u, 5u, UINT32_MAX}) {
+    auto pending = empty;
+    pending.stage = stage;
+    CHECK(!coop_source_abort_permission(pending, pending));
+    CHECK(!coop_source_abort_permission(empty, pending));
+  }
+  for (uint32_t stage : {3u, 4u}) {
+    CoopTransitionWire wire;
+    CHECK(encode_coop_transition(example(true), wire));
+    auto terminal = empty;
+    terminal.serial = 17;
+    terminal.stage = stage;
+    terminal.player_count = 2;
+    terminal.players[0] = 1;
+    terminal.players[1] = 3;
+    terminal.descriptor_bytes = uint32_t(wire.size);
+    std::memcpy(terminal.descriptor, wire.bytes.data(), wire.size);
+    CHECK(coop_source_abort_permission(terminal, terminal));
+    CHECK(!coop_source_abort_permission(terminal, empty));
+    auto changed = terminal;
+    ++changed.serial;
+    CHECK(!coop_source_abort_permission(terminal, changed));
+    changed = terminal;
+    changed.descriptor[0] ^= 1;
+    CHECK(!coop_source_abort_permission(terminal, changed));
+    CHECK(!coop_source_abort_permission(changed, changed));
+    for (auto field : {&recomp_network_barrier_v1::serial,
+                       &recomp_network_barrier_v1::player_count,
+                       &recomp_network_barrier_v1::descriptor_bytes}) {
+      changed = terminal;
+      changed.*field = 0;
+      CHECK(!coop_source_abort_permission(changed, changed));
+    }
+    for (uint32_t count : {1u, 5u, UINT32_MAX}) {
+      changed = terminal;
+      changed.player_count = count;
+      CHECK(!coop_source_abort_permission(changed, changed));
+    }
+    for (uint32_t bytes : {1025u, UINT32_MAX}) {
+      changed = terminal;
+      changed.descriptor_bytes = bytes;
+      CHECK(!coop_source_abort_permission(changed, changed));
+    }
+    for (uint32_t id : {0u, 1u, UINT32_MAX}) {
+      changed = terminal;
+      changed.players[1] = id;
+      CHECK(!coop_source_abort_permission(changed, changed));
+    }
+    changed = terminal;
+    changed.players[2] = 7;
+    CHECK(!coop_source_abort_permission(changed, changed));
+  }
+  for (auto field : {&recomp_network_barrier_v1::serial,
+                     &recomp_network_barrier_v1::player_count,
+                     &recomp_network_barrier_v1::descriptor_bytes}) {
+    auto dirty = empty;
+    dirty.*field = 1;
+    CHECK(!coop_source_abort_permission(dirty, dirty));
+  }
+  auto dirty = empty;
+  dirty.descriptor[17] = 1;
+  CHECK(!coop_source_abort_permission(dirty, dirty));
+  for (bool saved : {false, true}) {
+    auto t = example(saved);
+    CoopTransitionWire w, again;
+    CoopTransition decoded;
+    CHECK(encode_coop_transition(t, w));
+    CHECK(w.size <= 1024);
+    CHECK(w.view().find('\0') == w.view().npos);
+    CHECK(decode_coop_transition(w.view(), decoded));
+    CHECK(encode_coop_transition(decoded, again));
+    CHECK(w.view() == again.view());
+    // A separately specified wire fixture protects field order and version.
+    std::string expected =
+        "majesty-coop-region-v1\nshared-kingdom\n-1\n0\n0\n0\n71201\n1\n" +
+        std::string(64, 'a') + ":" + std::string(64, 'b') + "\n" +
+        std::string(64, 'c') + "\n19999\n31800\n1\n336981\n" +
+        std::string(64, 'd') + "\n" +
+        (saved ? "1\n2\n1550\n336981\n" + std::string(64, 'e') + "\n17\n23\n"
+               : "0\n0\n0\n0\n-\n0\n0\n");
+    CHECK(w.view() == expected);
+    for (size_t size = 0; size < w.size; ++size)
+      CHECK(!decode_coop_transition(w.view().substr(0, size), decoded));
+    CHECK(!decode_coop_transition(std::string(w.view()) + "extra\n", decoded));
+    CHECK(!decode_coop_transition(std::string(w.view()) + std::string(1, '\0'),
+                                  decoded));
+    auto f = lines(w.view());
+    for (unsigned i : {2u, 3u, 4u, 5u, 6u, 7u, 10u, 11u, 12u, 13u, 15u, 16u,
+                       17u, 18u, 20u, 21u}) {
+      for (auto bad :
+           {"", "+1", "01", "-0", " 1", "1 ", "1\r", "18446744073709551616"}) {
+        auto a = f;
+        a[i] = bad;
+        CHECK(!decode_coop_transition(join(a), decoded));
+      }
+    }
+    for (unsigned i : {8u, 9u, 14u})
+      for (auto bad : {"A", "../file", "garbage"}) {
+        auto a = f;
+        a[i] = bad;
+        CHECK(!decode_coop_transition(join(a), decoded));
+      }
+    for (auto bad : std::vector<std::string>{
+             "", "Uppercase", "../world", "with space", std::string(41, 'a')}) {
+      auto a = f;
+      a[1] = bad;
+      CHECK(!decode_coop_transition(join(a), decoded));
+    }
+    for (unsigned i : {6u, 7u}) {
+      auto a = f;
+      a[i] = "2";
+      CHECK(!decode_coop_transition(join(a), decoded));
+    }
+    for (unsigned i : {12u, 13u}) {
+      auto a = f;
+      a[i] = "0";
+      CHECK(!decode_coop_transition(join(a), decoded));
+    }
+    auto a = f;
+    a[13] = "67108865";
+    CHECK(!decode_coop_transition(join(a), decoded));
+    a = f;
+    a[2] = "-1000001";
+    CHECK(!decode_coop_transition(join(a), decoded));
+    a = f;
+    a[4] = "-1";
+    CHECK(!decode_coop_transition(join(a), decoded)); // Same region.
+    a = f;
+    a[4] = "1";
+    CHECK(!decode_coop_transition(join(a), decoded)); // Nonadjacent.
+    a = f;
+    a[5] = "1";
+    CHECK(!decode_coop_transition(join(a), decoded)); // Diagonal.
+    if (saved)
+      for (unsigned i : {16u, 18u, 20u, 21u}) {
+        a = f;
+        a[i] = "0";
+        CHECK(!decode_coop_transition(join(a), decoded));
+      }
+    else
+      for (unsigned i : {16u, 17u, 18u, 20u, 21u}) {
+        a = f;
+        a[i] = "1";
+        CHECK(!decode_coop_transition(join(a), decoded));
+      }
+    for (unsigned i :
+         {6u, 7u, 10u, 11u, 12u, 13u, 15u, 16u, 17u, 18u, 20u, 21u}) {
+      a = f;
+      a[i] = "-1";
+      CHECK(!decode_coop_transition(join(a), decoded));
+    }
+    for (unsigned i : {8u, 9u, 14u}) {
+      a = f;
+      a[i][0] = 'A';
+      CHECK(!decode_coop_transition(join(a), decoded));
+    }
+    a = f;
+    a[19] = saved ? std::string(64, 'A') : std::string(64, 'a');
+    CHECK(!decode_coop_transition(join(a), decoded));
+    auto dirty = example(saved);
+    dirty.target_digest.fill('a');
+    if (!saved)
+      CHECK(!encode_coop_transition(dirty, again));
+    dirty = example(saved);
+    dirty.world[39] = 'a';
+    CHECK(!encode_coop_transition(dirty,
+                                  again)); // Hidden bytes after terminator.
+    auto huge = std::string(1025, 'x');
+    CHECK(!decode_coop_transition(huge, decoded));
+    // The frame, checkpoint and rules are identity, even when the route
+    // matches.
+    t = example(saved);
+    t.frame++;
+    CHECK(encode_coop_transition(t, again));
+    CHECK(w.view() != again.view());
+    t = example(saved);
+    t.source_digest[0] = 'f';
+    CHECK(encode_coop_transition(t, again));
+    CHECK(w.view() != again.view());
+    t = example(saved);
+    t.rules[0] = 'f';
+    CHECK(encode_coop_transition(t, again));
+    CHECK(w.view() != again.view());
+    t = example(saved);
+    t.source_revision = UINT64_MAX;
+    t.frame = UINT32_MAX;
+    t.clock = UINT32_MAX;
+    t.source_bytes = 64u * 1024u * 1024u;
+    CHECK(encode_coop_transition(t, again));
+    CHECK(decode_coop_transition(again.view(), decoded));
+    t.world.fill('a');
+    again.size = 100;
+    CHECK(!encode_coop_transition(t, again));
+    CHECK(again.size == 0);
+    CHECK(!decode_coop_transition("invalid", decoded));
+    CHECK(decoded.world[0] == 0);
+  }
+  std::printf("%u co-op transition checks, %u failures\n", checks, failures);
+  return failures ? 1 : 0;
+}
diff --git a/tests/native_order_allocation_tests.cpp b/tests/native_order_allocation_tests.cpp
new file mode 100644
index 0000000..5086c92
--- /dev/null
+++ b/tests/native_order_allocation_tests.cpp
@@ -0,0 +1,506 @@
+// Scoped native claim decisions with controlled dispatch, no PE or map.
+#include "../native_order_allocation.h"
+#include "../kit/runtime/memory.h"
+#include "../kit/runtime/win32.h"
+#include <cstdio>
+#include <type_traits>
+using namespace majesty::orders;
+static_assert(std::is_trivially_destructible_v<AllocationBridge>);
+static unsigned checks, failures, dispatches, past_stop;
+#define CHECK(x)                                                                                   \
+    do {                                                                                           \
+        ++checks;                                                                                  \
+        if (!(x)) {                                                                                \
+            ++failures;                                                                            \
+            std::fprintf(stderr, "FAIL %d: %s\n", __LINE__, #x);                                   \
+        }                                                                                          \
+    } while (0)
+static constexpr EntryPoints points{0x01cff010,
+                                    0x01cff020,
+                                    {0x01cfe010, 0x01cfe020, 0x01cfe030, 0x01cfe040, 0x01cfe050,
+                                     0x01cfe060, 0x01cfe070, 0x01cfe080, 0x01cfe090, 0x01cfe0a0,
+                                     0x01cfe0b0, 0x01cfe0c0},
+                                    0x01cfd010};
+static constexpr uint32_t CHILD = 0x01cff030;
+static constexpr UnitReadPoints unit_points{0x01cff040, 0x01cfc010, 0x12345678, 0x88};
+static uint32_t unit_address;
+static unsigned unit_trial;
+enum Trial {
+    Healthy,
+    Unknown,
+    BadSize,
+    BadHead,
+    DuplicateHead,
+    BadKind,
+    NoPath,
+    BadPath,
+    BadNode,
+    DuplicatePath,
+    NoNode,
+    NoOrder,
+    Policy,
+    ReadFailed,
+    HiddenFailure,
+    BadReturn
+};
+static Trial trial;
+static uint32_t bank;
+static unsigned name_trial;
+static constexpr uint32_t KIND_NINE_PC = 0x01cfc020;
+static constexpr uint32_t KIND_TWELVE_PC = 0x01cfc030;
+static constexpr uint32_t KIND_THIRTEEN_PC = 0x01cfc050;
+static uint32_t optional_kind = 9;
+static bool base_only;
+static unsigned base_trial;
+static Journal *journal;
+static AllocationBridge *bridge;
+static uint32_t allocation(X86 *cpu, uint32_t site, uint32_t bytes, uint32_t receiver,
+                           uint32_t status = 0) {
+    auto result = bridge->intercept(cpu, site, bytes, receiver, status);
+    if (result.action == AllocationAction::Stop) {
+        guest_call_guarded_cancel(cpu, journal->eligible_cookie(), 0xbadc0de);
+        ++past_stop;
+    }
+    CHECK(result.action == AllocationAction::Return);
+    return result.address;
+}
+static bool policy(void *, const Request &r) {
+    return !(trial == Policy && r.role == Role::Order) &&
+           !(name_trial == 6 && r.role == Role::BaseName);
+}
+static void name_allocation(X86 *cpu, uint32_t field, uint32_t pc, uint32_t bytes) {
+    auto result = bridge->intercept_name(cpu, pc, bytes, field);
+    if (result.action == AllocationAction::Stop) {
+        guest_call_guarded_cancel(cpu, journal->eligible_cookie(), 0xbadc0de);
+        ++past_stop;
+    }
+    CHECK(result.action == AllocationAction::Return && result.address &&
+          gm_valid(result.address, 1));
+}
+static void observe(X86 *cpu, uint32_t fn, uint32_t receiver, uint32_t argument, uint32_t result,
+                    bool returning) {
+    auto decision = bridge->observe_unit_bank(cpu, fn, receiver, argument, result, returning);
+    if (decision.action == AllocationAction::Stop) {
+        guest_call_guarded_cancel(cpu, journal->eligible_cookie(), 0xbadc0de);
+        ++past_stop;
+    }
+    CHECK(decision.action == AllocationAction::Return);
+}
+extern "C" void recomp_call(X86 *cpu, uint32_t fn) {
+    ++dispatches;
+    CHECK(journal && journal->invocation_active() && !journal->release());
+    CHECK(!bridge->handoff_unit_orders(unit_address));
+    if (fn == CHILD) {
+        CHECK(!journal->eligible_cookie());
+        CHECK(bridge->intercept_name(cpu, points.name_allocate_return, 1, 0).action ==
+              AllocationAction::Delegate);
+        CHECK(bridge->intercept(cpu, points.allocate_return[0], 12, 0).action ==
+              AllocationAction::Delegate);
+        cpu->r[R_EAX] = 17;
+        return;
+    }
+    CHECK(journal->eligible_cookie());
+    if (fn == unit_points.read) {
+        CHECK(cpu->r[R_ECX] == unit_address);
+        if (unit_trial == 7) {
+            cpu->r[R_EAX] = 0;
+            return; // false-success reader must fail final claim/sequence checks
+        }
+        for (bank = 0; bank < 3; ++bank) {
+            uint32_t storage =
+                allocation(cpu, unit_trial == 2 ? 0 : unit_points.bank_allocate_return, 20,
+                           unit_trial == 1 ? 0 : unit_address);
+            observe(cpu, points.construct, storage, unit_trial == 3 ? 0 : unit_address, 0, false);
+            cpu->r[R_ECX] = storage;
+            recomp_call(cpu, points.construct);
+            observe(cpu, points.construct, storage, unit_address, cpu->r[R_EAX], true);
+            wr32(unit_address + unit_points.bank_fields + bank * 4, storage);
+            observe(cpu, points.read, storage, unit_trial == 4 ? 0 : 42, 0, false);
+            cpu->r[R_ECX] = storage;
+            recomp_call(cpu, points.read);
+            uint32_t result = cpu->r[R_EAX];
+            if (unit_trial != 5)
+                observe(cpu, points.read, storage, 42, result, true);
+            if (result) {
+                cpu->r[R_EAX] = result;
+                return;
+            }
+        }
+        cpu->r[R_EAX] = 0;
+        return;
+    }
+    uint32_t storage = journal->find(Role::Bank, bank)->address;
+    uint32_t head = journal->find(Role::Head, bank)->address;
+    CHECK(cpu->r[R_ECX] == storage);
+    if (fn == points.construct) {
+        if (trial == Healthy && !bank) {
+            X86 foreign{};
+            CHECK(bridge->intercept(&foreign, points.allocate_return[0], 12, storage).action ==
+                  AllocationAction::Delegate);
+            CHECK(guest_call(cpu, CHILD) == 17);
+            CHECK(journal->eligible_cookie() && journal->invocation_active());
+        }
+        uint32_t pc = trial == Unknown ? 0xdeadbeef : points.allocate_return[0];
+        CHECK(allocation(cpu, pc, trial == BadSize ? 16 : 12, trial == BadHead ? 0 : storage) ==
+              head);
+        if (trial == DuplicateHead)
+            allocation(cpu, pc, 12, storage);
+        cpu->r[R_EAX] = trial == BadReturn ? 0 : storage;
+        return;
+    }
+    CHECK(fn == points.read);
+    if (base_only) {
+        if (!bank) {
+            const uint32_t bytes = optional_kind == 9 ? 52 : optional_kind == 12 ? 72 : 100;
+            uint32_t order = allocation(cpu, optional_kind == 9 ? KIND_NINE_PC : optional_kind == 12 ? KIND_TWELVE_PC : KIND_THIRTEEN_PC,
+                                        base_trial == 2 ? bytes + 1 : bytes, 0);
+            CHECK(order == journal->find(Role::Order, 0, 0)->address);
+            if (base_trial != 3) {
+                name_allocation(cpu, order + 36, points.name_allocate_return, 1);
+                if (optional_kind == 13 && base_trial != 5)
+                    name_allocation(cpu, order + 72, points.name_allocate_return, 1);
+            }
+            CHECK(allocation(cpu, points.allocate_return[11], 12, head) ==
+                  journal->find(Role::Node, 0, 0)->address);
+        }
+        cpu->r[R_EAX] = 0;
+        return;
+    }
+    if (journal->reserves_names() && name_trial == 7)
+        name_allocation(cpu, 0, points.name_allocate_return, 1);
+    if (trial == NoOrder) {
+        cpu->r[R_EAX] = 0;
+        return;
+    }
+    const Block *entry = journal->find(Role::Order, bank, 0);
+    uint32_t factory_site = bank == 0 ? 3 : bank == 1 ? 2 : 6;
+    uint32_t order = allocation(cpu, points.allocate_return[trial == BadKind ? 1 : factory_site],
+                                entry->request.bytes, 0, trial == HiddenFailure ? 7 : 0);
+    CHECK(order == entry->address);
+    if (trial == NoPath)
+        allocation(cpu, points.allocate_return[11], 12, head);
+    if (bank != 1) {
+        const Block *path = journal->find(Role::Path, bank, 0);
+        uint32_t pc = points.allocate_return[bank == 0 ? 9 : 10];
+        if (trial == ReadFailed) {
+            auto zero = bridge->intercept(cpu, pc, 0, order, 7);
+            CHECK(zero.action == AllocationAction::Return && zero.address == 0 &&
+                  zero.failed_zero_path);
+            CHECK(!path->claimed); // positive path still belongs to the journal
+        } else {
+            CHECK(allocation(cpu, pc, path->request.bytes, trial == BadPath ? head : order) ==
+                  path->address);
+            if (trial == DuplicatePath)
+                allocation(cpu, pc, path->request.bytes, order);
+        }
+    }
+    if (journal->reserves_names() && name_trial != 1) {
+        uint32_t field = name_trial == 4 ? order + 4 : order + 36;
+        uint32_t pc = name_trial == 5 ? 0 : points.name_allocate_return;
+        name_allocation(cpu, field, pc, name_trial == 3 ? 2 : 1);
+        if (name_trial == 2)
+            name_allocation(cpu, field, pc, 1);
+        if (bank == 1)
+            name_allocation(cpu, order + 76, pc, 1);
+    }
+    if (trial != NoNode)
+        CHECK(allocation(cpu, points.allocate_return[11], 12, trial == BadNode ? order : head,
+                         trial == ReadFailed ? 7 : 0) ==
+              journal->find(Role::Node, bank, 0)->address);
+    cpu->r[R_EAX] = trial == ReadFailed ? 7 : 0;
+}
+extern "C" void recomp_jump(X86 *cpu, uint32_t fn) {
+    recomp_call(cpu, fn);
+}
+
+static void requests(Request *rows) {
+    for (uint32_t i = 0; i < 3; ++i) {
+        rows[i * 2] = {Role::Bank, i, NO_INDEX, 0, 20};
+        rows[i * 2 + 1] = {Role::Head, i, NO_INDEX, 0, 12};
+    }
+    rows[6] = {Role::Order, 0, 0, 4, 100};
+    rows[7] = {Role::Path, 0, 0, 4, 16};
+    rows[8] = {Role::Node, 0, 0, 4, 12};
+    rows[9] = {Role::Order, 1, 0, 2, 92};
+    rows[10] = {Role::Node, 1, 0, 2, 12};
+    rows[11] = {Role::Order, 2, 0, 7, 72};
+    rows[12] = {Role::Path, 2, 0, 7, 80};
+    rows[13] = {Role::Node, 2, 0, 7, 12};
+}
+int main() {
+    sched_set_guest_thread(true);
+    mem_init();
+    HeapStats before = heap_stats();
+    Request rows[14];
+    requests(rows);
+    X86 cpu{};
+    cpu.fs_base = TEB_BASE;
+    cpu.r[R_ESP] = STACK_TOP - 128;
+    wr32(cpu.fs_base, UINT32_MAX);
+    const AllocationFailure expected[] = {
+        AllocationFailure::None,           AllocationFailure::UnknownCaller,
+        AllocationFailure::WrongSize,      AllocationFailure::WrongReceiver,
+        AllocationFailure::WrongPhase,     AllocationFailure::WrongEntry,
+        AllocationFailure::WrongEntry,     AllocationFailure::WrongReceiver,
+        AllocationFailure::WrongReceiver,  AllocationFailure::WrongEntry,
+        AllocationFailure::IncompleteRead, AllocationFailure::IncompleteRead,
+        AllocationFailure::PolicyRefused,  AllocationFailure::ReadFailed,
+        AllocationFailure::ReadFailed,     AllocationFailure::InvalidReturn};
+    for (unsigned t = Healthy; t <= BadReturn; ++t) {
+        trial = static_cast<Trial>(t);
+        Journal owned;
+        CHECK(owned.reserve(rows, 14, heap_port(), false));
+        EntryPoints copied = points;
+        AllocationBridge controller(owned, copied, {nullptr, policy});
+        copied.allocate_return[0] = 0; // immutable copied site configuration
+        journal = &owned;
+        bridge = &controller;
+        CHECK(!controller.complete());
+        CHECK(controller.intercept(&cpu, 0, 0, 0).action == AllocationAction::Delegate);
+        BankInvocationResult result{};
+        bool ok = true;
+        for (bank = 0; ok && bank < 3; ++bank) {
+            result = controller.construct(&cpu, bank, 42);
+            ok = result.complete;
+        }
+        for (bank = 0; ok && bank < 3; ++bank) {
+            result = controller.read(&cpu, bank, 42);
+            ok = result.complete;
+        }
+        CHECK(controller.failure() == expected[t]);
+        CHECK(ok == (trial == Healthy));
+        CHECK(controller.complete() == ok);
+        if (trial == Unknown || trial == BadSize || trial == BadHead || trial == DuplicateHead ||
+            trial == BadKind || trial == NoPath || trial == BadPath || trial == BadNode ||
+            trial == DuplicatePath || trial == Policy)
+            CHECK(result.guest.status == GuestCallGuardedStatus::Cancelled &&
+                  result.guest.eax == 0xbadc0de);
+        else
+            CHECK(result.guest.status == GuestCallGuardedStatus::Returned);
+        if (trial == Policy)
+            CHECK(!owned.find(Role::Order, 0, 0)->claimed);
+        if (trial != Healthy) {
+            unsigned old_dispatches = dispatches;
+            CHECK(!controller.read(&cpu, 0, 42).complete && dispatches == old_dispatches);
+        }
+        CHECK(!owned.invocation_active() && !owned.eligible_cookie() && !past_stop);
+        CHECK(cpu.r[R_ESP] == STACK_TOP - 128 && rd32(cpu.fs_base) == UINT32_MAX);
+        CHECK(owned.release());
+        CHECK(heap_stats().used_blocks == before.used_blocks &&
+              heap_stats().used_bytes == before.used_bytes);
+    }
+    // Reject invalid sites and out-of-order calls before guest dispatch/claims.
+    Journal owned;
+    CHECK(owned.reserve(rows, 14, heap_port(), false));
+    for (unsigned bad = 0; bad < 3; ++bad) {
+        EntryPoints sites = points;
+        if (!bad)
+            sites.construct = 0;
+        else if (bad == 1)
+            sites.read = sites.construct;
+        else
+            sites.allocate_return[1] = sites.allocate_return[0];
+        AllocationBridge invalid(owned, sites);
+        CHECK(invalid.failure() == AllocationFailure::InvalidSites);
+        unsigned old_dispatches = dispatches;
+        CHECK(!invalid.construct(&cpu, 0, 42).complete && dispatches == old_dispatches);
+        CHECK(!owned.find(Role::Bank, 0)->claimed);
+    }
+    AllocationBridge early(owned, points);
+    CHECK(early.read(&cpu, 0, 42).guest.status == GuestCallGuardedStatus::InvalidCall);
+    CHECK(!owned.find(Role::Bank, 0)->claimed);
+    CHECK(owned.release());
+    // Both wrong bank order and duplicate construction refuse dispatch.
+    for (unsigned sequence = 0; sequence < 2; ++sequence) {
+        Journal ordered;
+        CHECK(ordered.reserve(rows, 14, heap_port(), false));
+        AllocationBridge controller(ordered, points);
+        journal = &ordered;
+        bridge = &controller;
+        trial = Healthy;
+        bank = 0;
+        if (sequence)
+            CHECK(controller.construct(&cpu, 0, 42).complete);
+        unsigned old_dispatches = dispatches;
+        auto refused = controller.construct(&cpu, sequence ? 0 : 1, 42);
+        CHECK(refused.guest.status == GuestCallGuardedStatus::InvalidCall && !refused.complete);
+        CHECK(controller.failure() == AllocationFailure::InvalidSequence &&
+              dispatches == old_dispatches);
+        CHECK(!ordered.find(Role::Bank, 1)->claimed);
+        CHECK(ordered.release());
+    }
+    CHECK(heap_stats().used_blocks == before.used_blocks &&
+          heap_stats().used_bytes == before.used_bytes);
+    // Real-name scopes require typed storage, identify exact fields and keep
+    // missing names from reaching a successful node/read completion.
+    Request named[18];
+    unsigned n = 0;
+    requests(rows);
+    for (const auto &r : rows) {
+        if (r.role == Role::Node) {
+            named[n++] = {Role::BaseName, r.bank, r.index, r.kind, 1};
+            if (r.kind == 2)
+                named[n++] = {Role::LeafName, r.bank, r.index, r.kind, 1};
+        }
+        named[n++] = r;
+    }
+    CHECK(n == 18);
+    const AllocationFailure name_expected[] = {
+        AllocationFailure::None,          AllocationFailure::WrongEntry,
+        AllocationFailure::ClaimRefused,  AllocationFailure::WrongSize,
+        AllocationFailure::WrongReceiver, AllocationFailure::UnknownCaller,
+        AllocationFailure::PolicyRefused, AllocationFailure::WrongPhase};
+    for (name_trial = 0; name_trial < 8; ++name_trial) {
+        Journal storage;
+        CHECK(storage.reserve(named, n, heap_port(), true));
+        AllocationBridge controller(storage, points, {nullptr, policy});
+        journal = &storage;
+        bridge = &controller;
+        trial = Healthy;
+        bool ok = true;
+        BankInvocationResult result{};
+        for (bank = 0; ok && bank < 3; ++bank) {
+            result = controller.construct(&cpu, bank, 42);
+            ok = result.complete;
+        }
+        for (bank = 0; ok && bank < 3; ++bank) {
+            result = controller.read(&cpu, bank, 42);
+            ok = result.complete;
+        }
+        CHECK(controller.failure() == name_expected[name_trial] && ok == !name_trial);
+        CHECK(controller.complete() == ok && !past_stop);
+        if (name_trial)
+            CHECK(result.guest.status == GuestCallGuardedStatus::Cancelled);
+        CHECK(storage.release());
+        CHECK(heap_stats().used_blocks == before.used_blocks &&
+              heap_stats().used_bytes == before.used_bytes);
+    }
+    // Whole-UNIT scope rejects bad lineage/order and false successful readers.
+    // The fields borrow journal storage; detach them only after the guard stops.
+    unit_address = heap_alloc(148, true);
+    CHECK(unit_address);
+    wr32(unit_address, unit_points.table);
+    HeapStats unit_baseline = heap_stats();
+    const AllocationFailure unit_expected[] = {
+        AllocationFailure::None,          AllocationFailure::WrongReceiver,
+        AllocationFailure::UnknownCaller, AllocationFailure::WrongReceiver,
+        AllocationFailure::WrongReceiver, AllocationFailure::UnknownCaller,
+        AllocationFailure::ReadFailed,    AllocationFailure::IncompleteRead};
+    for (unit_trial = 0; unit_trial < 8; ++unit_trial) {
+        Journal storage;
+        CHECK(storage.reserve(rows, 14, heap_port(), false));
+        AllocationBridge controller(storage, points);
+        journal = &storage;
+        bridge = &controller;
+        trial = unit_trial == 6 ? ReadFailed : Healthy;
+        name_trial = 0;
+        bank = 0;
+        auto result = controller.read_unit(&cpu, unit_address, 42, unit_points);
+        CHECK(controller.failure() == unit_expected[unit_trial]);
+        CHECK(result.complete == (unit_trial == 0) && controller.complete() == result.complete);
+        CHECK(result.guest.status == (unit_trial >= 1 && unit_trial <= 5
+                                          ? GuestCallGuardedStatus::Cancelled
+                                          : GuestCallGuardedStatus::Returned));
+        CHECK(!storage.invocation_active() && !storage.eligible_cookie() && !past_stop);
+        CHECK(
+            !controller.handoff_unit_orders(unit_address)); // controlled-name budget or failed read
+        CHECK(cpu.r[R_ESP] == STACK_TOP - 128 && rd32(cpu.fs_base) == UINT32_MAX);
+        for (uint32_t index = 0; index < 3; ++index) {
+            uint32_t value = rd32(unit_address + unit_points.bank_fields + index * 4);
+            if (value) {
+                const Block *b = storage.find(Role::Bank, index);
+                CHECK(b && b->owned && b->claimed && value == b->address);
+                wr32(unit_address + unit_points.bank_fields + index * 4, 0);
+            }
+        }
+        if (unit_trial == 3)
+            CHECK(!storage.find(Role::Head, 0)->claimed);
+        if (unit_trial == 4)
+            CHECK(!storage.find(Role::Order, 0, 0)->claimed);
+        CHECK(storage.release());
+        CHECK(heap_stats().used_blocks == unit_baseline.used_blocks &&
+              heap_stats().used_bytes == unit_baseline.used_bytes);
+    }
+    CHECK(heap_free(unit_address));
+    base_only = true;
+    trial = Healthy;
+    name_trial = 0;
+    const AllocationFailure base_expected[] = {AllocationFailure::None,
+        AllocationFailure::UnknownCaller, AllocationFailure::WrongSize,
+        AllocationFailure::WrongEntry, AllocationFailure::WrongEntry,
+        AllocationFailure::WrongEntry};
+    for (const uint32_t selected_kind : {9u,12u,13u}) {
+      optional_kind = selected_kind;
+      for (base_trial = 0; base_trial < (selected_kind == 13 ? 6u : 5u); ++base_trial) {
+        Request base_rows[10];
+        for (uint32_t i = 0; i < 3; ++i) {
+            base_rows[i * 2] = {Role::Bank, i, NO_INDEX, 0, 20};
+            base_rows[i * 2 + 1] = {Role::Head, i, NO_INDEX, 0, 12};
+        }
+        const uint32_t kind = base_trial == 4 ? 1 : selected_kind;
+        base_rows[6] = {Role::Order, 0, 0, kind, kind == 9 ? 52u : kind == 12 ? 72u : kind == 13 ? 100u : 88u};
+        base_rows[7] = {Role::BaseName, 0, 0, kind, 1};
+        const uint32_t row_count = kind == 13 ? 10 : 9;
+        if (kind == 13) base_rows[8] = {Role::LeafName, 0, 0, kind, 1};
+        base_rows[row_count - 1] = {Role::Node, 0, 0, kind, 12};
+        Journal storage;
+        CHECK(storage.reserve(base_rows, row_count, heap_port(), true));
+        EntryPoints configured = points;
+        if (selected_kind == 9) configured.kind_nine_allocate_return = base_trial == 1 ? 0 : KIND_NINE_PC;
+        else if (selected_kind == 12) configured.kind_twelve_allocate_return = base_trial == 1 ? 0 : KIND_TWELVE_PC;
+        else configured.kind_thirteen_allocate_return = base_trial == 1 ? 0 : KIND_THIRTEEN_PC;
+        AllocationBridge controller(storage, configured);
+        journal = &storage; bridge = &controller;
+        for (bank = 0; bank < 3; ++bank) CHECK(controller.construct(&cpu, bank, 55).complete);
+        bank = 0;
+        auto result = controller.read(&cpu, 0, 42);
+        CHECK(controller.failure() == base_expected[base_trial]);
+        if (!base_trial) {
+            CHECK(result.complete);
+            for (bank = 1; bank < 3; ++bank) CHECK(controller.read(&cpu, bank, 42).complete);
+            CHECK(controller.complete() && storage.fully_claimed());
+            CHECK(storage.owned_request_bytes() == (selected_kind == 9 ? 161u : selected_kind == 12 ? 181u : 210u));
+        } else {
+            CHECK(!result.complete && result.guest.status == GuestCallGuardedStatus::Cancelled);
+            CHECK(!controller.complete() && !storage.fully_claimed());
+            CHECK(storage.find(Role::Order, 0, 0)->claimed == (base_trial == 3 || base_trial == 5));
+        }
+        CHECK(!storage.invocation_active() && !storage.eligible_cookie() && !past_stop);
+        CHECK(storage.release());
+        CHECK(heap_stats().used_blocks == before.used_blocks && heap_stats().used_bytes == before.used_bytes);
+      }
+    }
+    for (uint32_t duplicate : {points.allocate_return[0], points.name_allocate_return}) {
+        Journal storage; requests(rows); CHECK(storage.reserve(rows, 14, heap_port(), false));
+        EntryPoints configured = points; configured.kind_nine_allocate_return = duplicate;
+        AllocationBridge controller(storage, configured);
+        CHECK(!controller.complete() && controller.failure() == AllocationFailure::InvalidSites);
+        CHECK(storage.release());
+    }
+    for (const uint32_t duplicate : {points.allocate_return[0], points.name_allocate_return, KIND_NINE_PC}) {
+        Journal storage; requests(rows); CHECK(storage.reserve(rows, 14, heap_port(), false));
+        EntryPoints configured = points;
+        configured.kind_nine_allocate_return = KIND_NINE_PC;
+        configured.kind_twelve_allocate_return = duplicate;
+        AllocationBridge controller(storage, configured);
+        CHECK(!controller.complete() && controller.failure() == AllocationFailure::InvalidSites);
+        CHECK(storage.release());
+    }
+    for (const uint32_t duplicate : {points.allocate_return[0], points.name_allocate_return,
+                                    KIND_NINE_PC, KIND_TWELVE_PC}) {
+        Journal storage; requests(rows); CHECK(storage.reserve(rows, 14, heap_port(), false));
+        EntryPoints configured = points;
+        configured.kind_nine_allocate_return = KIND_NINE_PC;
+        configured.kind_twelve_allocate_return = KIND_TWELVE_PC;
+        configured.kind_thirteen_allocate_return = duplicate;
+        AllocationBridge controller(storage, configured);
+        CHECK(!controller.complete() && controller.failure() == AllocationFailure::InvalidSites);
+        CHECK(storage.release());
+    }
+    CHECK(heap_stats().used_blocks == before.used_blocks &&
+          heap_stats().used_bytes == before.used_bytes);
+    mem_shutdown();
+    std::printf("%u native allocation bridge checks, %u failures; 32 dispatch trials\n", checks,
+                failures);
+    return failures ? 1 : 0;
+}
diff --git a/tests/native_order_bank_hook_tests.cpp b/tests/native_order_bank_hook_tests.cpp
