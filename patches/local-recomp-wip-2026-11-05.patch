index 0000000..db0f5a6
--- /dev/null
+++ b/tests/native_order_storage_tests.cpp
@@ -0,0 +1,342 @@
+// Native ownership/validation/failure controls. No original executable or map.
+#include "../native_order_storage.h"
+#include "../kit/runtime/memory.h"
+#include "../kit/runtime/win32.h"
+#include <cstdio>
+#include <type_traits>
+using namespace majesty::orders;
+static_assert(std::is_trivially_destructible_v<Journal>);
+static unsigned checks, failures;
+#define CHECK(x)                                                                                   \
+    do {                                                                                           \
+        ++checks;                                                                                  \
+        if (!(x)) {                                                                                \
+            ++failures;                                                                            \
+            std::fprintf(stderr, "FAIL line %d: %s\n", __LINE__, #x);                              \
+        }                                                                                          \
+    } while (0)
+struct Port {
+    unsigned allocations, frees, fail_at, refuse_once, overlap_at;
+    uint32_t first;
+    unsigned cancel_free;
+};
+static Journal *running;
+static X86 *retirement_cpu;
+static unsigned returned_past_free_cancel;
+static uint32_t alloc(void *p, uint32_t n) {
+    auto &c = *static_cast<Port *>(p);
+    ++c.allocations;
+    if (c.allocations == c.fail_at)
+        return 0;
+    if (c.allocations == c.overlap_at)
+        return c.first; // no new allocation: deliberately invalid alias
+    uint32_t address = heap_alloc(n, false);
+    if (!c.first)
+        c.first = address;
+    return address;
+}
+static bool free_block(void *p, uint32_t address, uint32_t) {
+    auto &c = *static_cast<Port *>(p);
+    ++c.frees;
+    if (c.refuse_once) {
+        c.refuse_once = 0;
+        return false;
+    }
+    if (c.cancel_free) {
+        const Block *other = running->find(Role::Head, 0);
+        CHECK(other && !running->retire(other->request, other->address));
+        if (c.cancel_free == 2)
+            CHECK(heap_free(address));
+        guest_call_guarded_cancel(retirement_cpu, running->eligible_cookie(), 99);
+        ++returned_past_free_cancel;
+    }
+    return heap_free(address);
+}
+static MemoryPort port(Port &p) {
+    return {&p, alloc, free_block};
+}
+static void baseline(HeapStats before) {
+    CHECK(heap_stats().used_blocks == before.used_blocks);
+    CHECK(heap_stats().used_bytes == before.used_bytes);
+}
+static void minimal(Request *r) {
+    for (uint32_t b = 0; b < 3; ++b) {
+        r[b * 2] = {Role::Bank, b, NO_INDEX, 0, 20};
+        r[b * 2 + 1] = {Role::Head, b, NO_INDEX, 0, 12};
+    }
+}
+static constexpr uint32_t ROOT_FN = 0x01cff010, CHILD_FN = 0x01cff020;
+static constexpr uint32_t CLEAN_FN = 0x01cff030, CLEAN_CHILD = 0x01cff040;
+static unsigned returned_past_cancel;
+extern "C" void recomp_call(X86 *cpu, uint32_t fn) {
+    CHECK(running && running->invocation_active());
+    CHECK(!running->release());
+    if (fn == CLEAN_CHILD) {
+        const Block *b = running->find(Role::Bank, 0);
+        CHECK(b && !running->eligible_cookie() && !running->retire(b->request, b->address));
+        cpu->r[R_EAX] = 19;
+        return;
+    }
+    if (fn == CLEAN_FN) {
+        CHECK(running->cleanup_started() && running->eligible_cookie());
+        CHECK(guest_call(cpu, CLEAN_CHILD) == 19);
+        const Block *b = running->find(Role::Bank, 0);
+        CHECK(b && b->owned && b->claimed);
+        Request wrong = b->request;
+        ++wrong.bytes;
+        uint32_t address = b->address;
+        CHECK(!running->retire(wrong, address));
+        CHECK(!running->retire(b->request, address + 4));
+        retirement_cpu = cpu;
+        if (!running->retire(b->request, address)) {
+            guest_call_guarded_cancel(cpu, running->eligible_cookie(), 88);
+            ++returned_past_free_cancel;
+        }
+        CHECK(!b->owned && !b->address && !running->retire(b->request, address));
+        cpu->r[R_EAX] = 29;
+        return;
+    }
+    if (fn == CHILD_FN) {
+        CHECK(running->eligible_cookie() == 0);
+        CHECK(running->invoke(cpu, ROOT_FN, nullptr, 0).status ==
+              GuestCallGuardedStatus::InvalidCall);
+        const Block *b = running->find(Role::Head, 0);
+        uint32_t address = 0;
+        CHECK(b && !running->claim(b->request, &address));
+        cpu->r[R_EAX] = 17;
+        return;
+    }
+    CHECK(fn == ROOT_FN && running->eligible_cookie());
+    CHECK(guest_call(cpu, CHILD_FN) == 17);
+    CHECK(running->eligible_cookie() && running->invocation_active());
+    guest_call_guarded_cancel(cpu, running->eligible_cookie(), 23);
+    ++returned_past_cancel;
+}
+extern "C" void recomp_jump(X86 *cpu, uint32_t fn) {
+    recomp_call(cpu, fn);
+}
+int main() {
+    sched_set_guest_thread(true);
+    mem_init();
+    HeapStats start = heap_stats();
+    Request rows[MAX_REQUESTS]{};
+    minimal(rows);
+    Port p{};
+    Journal journal;
+    X86 cpu{};
+    CHECK(journal.release());
+    CHECK(journal.invoke(&cpu, ROOT_FN, nullptr, 0).status == GuestCallGuardedStatus::InvalidCall);
+    CHECK(!journal.reserve(nullptr, 6, port(p)));
+    CHECK(!journal.reserve(rows, 5, port(p)));
+    CHECK(!journal.reserve(rows, MAX_REQUESTS + 1, port(p)));
+    rows[0].bytes = 21;
+    CHECK(!journal.reserve(rows, 6, port(p)) && p.allocations == 0);
+    minimal(rows);
+    CHECK(journal.reserve(rows, 6, port(p)));
+    CHECK(journal.owned_request_bytes() == 96);
+    rows[0].bytes = 777; // descriptors were copied before allocation
+    const Block *b = journal.find(Role::Bank, 0);
+    CHECK(b && b->request.bytes == 20);
+    uint32_t address = 0x12345678;
+    CHECK(!journal.claim(rows[0], &address) && address == 0x12345678);
+    CHECK(b && journal.claim(b->request, &address) && address == b->address);
+    CHECK(!journal.claim(b->request, &address));
+    CHECK(!journal.fully_claimed());
+    cpu.fs_base = TEB_BASE;
+    cpu.r[R_ESP] = STACK_TOP - 128;
+    wr32(cpu.fs_base, UINT32_MAX);
+    running = &journal;
+    auto result = journal.invoke(&cpu, ROOT_FN, nullptr, 0);
+    CHECK(result.status == GuestCallGuardedStatus::Cancelled && result.eax == 23);
+    CHECK(!returned_past_cancel && !journal.invocation_active() && !journal.eligible_cookie());
+    CHECK(journal.release());
+    CHECK(journal.invoke(&cpu, ROOT_FN, nullptr, 0).status == GuestCallGuardedStatus::InvalidCall);
+    unsigned freed = p.frees;
+    CHECK(journal.release() && p.frees == freed && journal.owned_request_bytes() == 0);
+    baseline(start);
+
+    // Six baseline + kind-4 zero path + kind-7 positive path: 11 actual
+    // allocations and one zero descriptor. Reject each positive prefix slot.
+    minimal(rows);
+    rows[6] = {Role::Order, 0, 0, 4, 100};
+    rows[7] = {Role::Path, 0, 0, 4, 0};
+    rows[8] = {Role::Node, 0, 0, 4, 12};
+    rows[9] = {Role::Order, 0, 1, 7, 72};
+    rows[10] = {Role::Path, 0, 1, 7, 80};
+    rows[11] = {Role::Node, 0, 1, 7, 12};
+    for (unsigned at = 1; at <= 11; ++at) {
+        Port failure{};
+        failure.fail_at = at;
+        Journal j;
+        CHECK(!j.reserve(rows, 12, port(failure), false));
+        CHECK(j.state() == State::Released && j.owned_request_bytes() == 0);
+        CHECK(failure.allocations == at && failure.frees == at - 1);
+        baseline(start);
+    }
+    Port retry{};
+    Journal pending;
+    CHECK(pending.reserve(rows, 12, port(retry), false));
+    retry.refuse_once = 1;
+    CHECK(!pending.release() && pending.state() == State::CleanupPending);
+    CHECK(pending.owned_request_bytes() == 12); // last node remains owned
+    CHECK(!pending.reserve(rows, 12, port(retry), false));
+    CHECK(!pending.claim(rows[11], &address));
+    CHECK(pending.release() && pending.owned_request_bytes() == 0);
+    baseline(start);
+    Port alias{};
+    alias.overlap_at = 2;
+    Journal violation;
+    CHECK(!violation.reserve(rows, 12, port(alias), false));
+    CHECK(violation.state() == State::AllocatorViolation &&
+          violation.untrusted_address() == alias.first);
+    CHECK(violation.untrusted_bytes() == 12 && violation.owned_request_bytes() == 0);
+    CHECK(alias.allocations == 2 && alias.frees == 1);
+    CHECK(!violation.release() && !violation.reserve(rows, 12, port(alias), false));
+    baseline(start);
+
+    // The public admission limit itself, without executing a native graph.
+    minimal(rows);
+    for (uint32_t i = 0; i < 128; ++i) {
+        rows[6 + i * 3] = {Role::Order, 0, i, 4, 100};
+        rows[7 + i * 3] = {Role::Path, 0, i, 4, 0};
+        rows[8 + i * 3] = {Role::Node, 0, i, 4, 12};
+    }
+    Journal maximum;
+    CHECK(maximum.reserve(rows, MAX_MODEL_REQUESTS, heap_port(), false));
+    for (uint32_t i = 0; i < MAX_MODEL_REQUESTS; ++i)
+        CHECK(maximum.claim(rows[i], &address));
+    CHECK(maximum.fully_claimed() && maximum.count() == 390);
+    CHECK(maximum.release());
+    baseline(start);
+    // Real empty names still allocate one byte. All 128 kind-4 entries have
+    // a path descriptor, a name descriptor and a node: 518 descriptors.
+    minimal(rows);
+    for (uint32_t i = 0; i < 128; ++i) {
+        rows[6 + i * 4] = {Role::Order, 0, i, 4, 100};
+        rows[7 + i * 4] = {Role::Path, 0, i, 4, 0};
+        rows[8 + i * 4] = {Role::BaseName, 0, i, 4, 1};
+        rows[9 + i * 4] = {Role::Node, 0, i, 4, 12};
+    }
+    Journal names;
+    CHECK(names.reserve(rows, MAX_REQUESTS, heap_port(), true));
+    CHECK(names.reserves_names() && names.count() == 518 && names.owned_request_bytes() == 14560);
+    for (uint32_t i = 0; i < MAX_REQUESTS; ++i)
+        CHECK(names.claim(rows[i], &address));
+    CHECK(names.fully_claimed() && names.release());
+    baseline(start);
+    Port malformed{};
+    Journal invalid_names;
+    rows[8].bytes = 0;
+    CHECK(!invalid_names.reserve(rows, MAX_REQUESTS, port(malformed), true) &&
+          !malformed.allocations);
+    rows[8].bytes = 1;
+    CHECK(!invalid_names.reserve(rows, MAX_REQUESTS, port(malformed), false) &&
+          !malformed.allocations);
+    // Refuse the name allocation itself after the seven earlier positives.
+    Port name_failure{};
+    name_failure.fail_at = 8;
+    Journal prefix;
+    CHECK(!prefix.reserve(rows, 10, port(name_failure), true));
+    CHECK(prefix.state() == State::Released && prefix.owned_request_bytes() == 0);
+    CHECK(name_failure.allocations == 8 && name_failure.frees == 7);
+    baseline(start);
+    // Two-name types cannot omit their typed leaf descriptor.
+    minimal(rows);
+    rows[6] = {Role::Order, 0, 0, 2, 92};
+    rows[7] = {Role::BaseName, 0, 0, 2, 1};
+    rows[8] = {Role::Node, 0, 0, 2, 12};
+    CHECK(!invalid_names.reserve(rows, 9, port(malformed), true) && !malformed.allocations);
+    rows[7] = {Role::Node, 0, 0, 2, 12};
+    CHECK(!invalid_names.reserve(rows, 8, port(malformed)) && !malformed.allocations);
+    CHECK(invalid_names.release());
+    // A two-path plan can exceed 64 KiB even though each path is permitted.
+    minimal(rows);
+    for (uint32_t i = 0; i < 2; ++i) {
+        rows[6 + i * 3] = {Role::Order, 0, i, 4, 100};
+        rows[7 + i * 3] = {Role::Path, 0, i, 4, 32768};
+        rows[8 + i * 3] = {Role::Node, 0, i, 4, 12};
+    }
+    Port oversized{};
+    Journal refused;
+    CHECK(!refused.reserve(rows, 12, port(oversized), false) && !oversized.allocations);
+    baseline(start);
+
+    // Successful retirement, definite refusal/retry, and cancellation before
+    // or after a free's side effect. Unknown outcomes must never be freed twice.
+    for (unsigned mode = 0; mode < 4; ++mode) {
+        minimal(rows);
+        Port cleanup_port{};
+        Journal cleanup;
+        CHECK(cleanup.reserve(rows, 6, port(cleanup_port)));
+        running = &cleanup;
+        const Block *first = cleanup.find(Role::Bank, 0);
+        uint32_t first_address = first->address;
+        CHECK(!cleanup.retire(first->request, first_address) && !cleanup_port.frees);
+        CHECK(cleanup.invoke_cleanup(&cpu, CLEAN_FN, nullptr, 0).status ==
+              GuestCallGuardedStatus::InvalidCall);
+        CHECK(!cleanup.cleanup_started());
+        for (unsigned i = 0; i < 6; ++i)
+            CHECK(cleanup.claim(rows[i], &address));
+        CHECK(cleanup.fully_claimed());
+        CHECK(cleanup.invoke_cleanup(nullptr, CLEAN_FN, nullptr, 0).status ==
+              GuestCallGuardedStatus::InvalidCall);
+        CHECK(!cleanup.cleanup_started() && cleanup.fully_claimed());
+        if (mode == 1)
+            cleanup_port.refuse_once = 1;
+        if (mode >= 2)
+            cleanup_port.cancel_free = mode - 1;
+        auto retired = cleanup.invoke_cleanup(&cpu, CLEAN_FN, nullptr, 0);
+        CHECK(cleanup.cleanup_started() && !cleanup.invocation_active() &&
+              !cleanup.eligible_cookie() && !cleanup.fully_claimed());
+        CHECK(!cleanup.claim(rows[1], &address));
+        CHECK(cleanup.invoke(&cpu, ROOT_FN, nullptr, 0).status ==
+              GuestCallGuardedStatus::InvalidCall);
+        CHECK(!cleanup.retire(rows[1], cleanup.find(Role::Head, 0)->address));
+        cleanup_port.cancel_free = 0;
+        if (mode >= 2) {
+            CHECK(retired.status == GuestCallGuardedStatus::Cancelled && retired.eax == 99);
+            CHECK(cleanup.state() == State::AllocatorViolation &&
+                  cleanup.untrusted_address() == first_address && cleanup.untrusted_bytes() == 20);
+            CHECK(!cleanup.release() && cleanup.owned_request_bytes() == 0);
+            CHECK(cleanup_port.frees == 6 && !cleanup.release() && cleanup_port.frees == 6);
+            CHECK(heap_owns(first_address) == (mode == 2));
+            if (mode == 2)
+                CHECK(heap_free(first_address)); // explicit fixture-only reconciliation
+        } else {
+            if (mode == 1) {
+                CHECK(retired.status == GuestCallGuardedStatus::Cancelled && retired.eax == 88);
+                CHECK(cleanup.owned_request_bytes() == 96 && heap_owns(first_address));
+                retired = cleanup.invoke_cleanup(&cpu, CLEAN_FN, nullptr, 0);
+            }
+            CHECK(retired.status == GuestCallGuardedStatus::Returned && retired.eax == 29);
+            CHECK(!heap_owns(first_address) && cleanup.owned_request_bytes() == 76);
+            CHECK(cleanup.release() && cleanup.state() == State::Released);
+            CHECK(cleanup_port.frees == (mode == 1 ? 7u : 6u));
+        }
+        baseline(start);
+    }
+    CHECK(!returned_past_free_cancel);
+    const HeapStats kind_nine_baseline = heap_stats();
+    for (uint32_t bytes : {51u, 52u, 53u}) {
+        Request base_rows[9]; minimal(base_rows);
+        base_rows[6] = {Role::Order, 0, 0, 9, bytes};
+        base_rows[7] = {Role::BaseName, 0, 0, 9, 1};
+        base_rows[8] = {Role::Node, 0, 0, 9, 12};
+        Port base_port{}; Journal base;
+        CHECK(base.reserve(base_rows, 9, port(base_port), true) == (bytes == 52));
+        if (bytes == 52) {
+            CHECK(base.owned_request_bytes() == 161 && base.count() == 9);
+            for (const Request &row : base_rows) {
+                uint32_t address = 0;
+                CHECK(base.claim(row, &address) && address && gm_valid(address, row.bytes));
+            }
+            CHECK(base.fully_claimed());
+            CHECK(base.release() && base_port.frees == 9);
+        } else CHECK(base_port.allocations == 0 && base_port.frees == 0);
+        CHECK(heap_stats().used_blocks == kind_nine_baseline.used_blocks &&
+              heap_stats().used_bytes == kind_nine_baseline.used_bytes);
+    }
+    mem_shutdown();
+    std::printf("%u native order storage checks, %u failures\n", checks, failures);
+    return failures ? 1 : 0;
+}
