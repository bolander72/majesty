+// Synthetic deserialized graph for the production connected-return admission.
+// No original terrain construction or world attachment is claimed here.
+static void saved_script_reset(X86 *c) {
+  // Execute the actual GPL component, without a world or gameplay loop.
+  // The saved-reader lifecycle must reset its program/ID allocation while
+  // preserving the original RNG seeds and unrelated flags.
+  const uint32_t flags = rd32(0x006d16f0);
+  const uint32_t gpl = alloc(c, 0x38);
+  CHECK(invoke(c, 0x00623290, gpl) == gpl);
+  CHECK(rd32(gpl) == 0x0068c02c && gm_valid(rd32(gpl + 4), 0x4c));
+  const uint32_t seed[] = {0x12345678u};
+  invoke(c, 0x004f6710, gpl + 0x20, seed, 1);
+  const auto steady = heap_stats();
+  for (uint32_t cycle = 0; cycle < 20 && !failures; ++cycle) {
+    invoke(c, 0x00623b30, gpl);
+    invoke(c, 0x00623b30, gpl);
+    CHECK(rd32(gpl + 0x34) > 1);
+    const uint32_t selected_flags = (flags & ~0x404u) | 8u |
+                                    (cycle % 2 ? 0x400u : 0u);
+    wr32(0x006d16f0, selected_flags);
+    invoke(c, 0x00623a70, gpl);
+    CHECK(rd32(gpl + 0x34) == 1 && gm_valid(rd32(gpl + 4), 0x4c));
+    CHECK(rd32(gpl + 0x20) == seed[0] && rd32(gpl + 0x24) == seed[0]);
+    CHECK(rd32(0x006d16f0) == (selected_flags | (cycle % 2 ? 0u : 4u)));
+    const auto after = heap_stats();
+    CHECK(after.used_bytes == steady.used_bytes &&
+          after.used_blocks == steady.used_blocks && heap_check().empty());
+  }
+  invoke(c, 0x00623440, gpl);
+  const uint32_t release[] = {gpl};
+  invoke(c, 0x00645bc0, 0, release, 1);
+  wr32(0x006d16f0, flags);
+  CHECK(heap_check().empty());
+}
