+        // getter before taking the object comparison baseline.
+        extra.r[R_ECX] = agents[i];
+        const uint32_t native = guest_call(&extra, 0x00626310u);
+        if (i ? native != 0 : !gm_valid(native, 0x88) || rd32(native + 0x60) != 469u)
+            std::abort();
+    }
