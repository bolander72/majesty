+        "current-clock=%u completed-ticks=%u operation=%u accepted=%u consumed=1 world-same=1 clock-same=1 hooks-same=1 result=pass\n",
+        visit, words[2], words[3], words[4], words[5], clock, s.ticks, words[6], s.travel_accepted);
