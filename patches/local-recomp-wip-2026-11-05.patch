+  }
+  const auto after = heap_stats();
+  if (rd32(0x0071c68c) != world || rd32(0x0071c6a8) != clock ||
+      mods_hooks_installed_count() != hooks ||
+      after.used_bytes != heap.used_bytes ||
+      after.used_blocks != heap.used_blocks || !heap_check().empty())
+    std::abort();
