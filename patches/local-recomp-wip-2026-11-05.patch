+      const auto after = heap_stats();
+      CHECK(after.used_bytes == held_heap.used_bytes &&
+            after.used_blocks == held_heap.used_blocks &&
+            after.total_allocs == held_heap.total_allocs &&
+            after.total_frees == held_heap.total_frees);
+    };
+    resume_refused(nullptr, owner);
+    resume_refused(c, UINT32_MAX);
+    resume_refused(c, owner + 1);
