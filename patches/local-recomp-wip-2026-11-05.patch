+}
+static bool one_of(uint32_t value, uint32_t a, uint32_t b, uint32_t c, uint32_t d) {
+    return value == a || value == b || value == c || value == d;
+}
+// Original mode-3 small-block region geometry, pinned by the lifecycle audit.
+// The pool's group live-allocation count proves the actual free, including
+// coalescing where an old object's boundary tag can remain stale.
+static uint32_t small_block_group(uint32_t address) {
+    uint32_t count = rd32(0x00723a7c), table = rd32(0x00723a80);
+    REQUIRE(count <= 64 && gm_valid(table, count * 20));
+    for (uint32_t i = 0; i < count; ++i) {
+        uint32_t row = table + i * 20, base = rd32(row + 12);
+        if (address < base || uint64_t(address) - base >= 0x100000)
+            continue;
+        uint64_t group = uint64_t(rd32(row + 16)) + ((address - base) >> 15) * 0x204u + 0x144;
+        REQUIRE(group <= UINT32_MAX && gm_valid(uint32_t(group), 4));
+        return uint32_t(group);
+    }
+    return 0;
+}
+static uint32_t small_block_live_count() {
+    uint32_t count = rd32(0x00723a7c), table = rd32(0x00723a80), total = 0;
+    CHECK(count <= 64 && gm_valid(table, count * 20));
+    for (uint32_t i = 0; i < count && count <= 64; ++i) {
+        uint32_t control = rd32(table + i * 20 + 16);
+        CHECK(control && gm_valid(control, 0x41c4));
+        if (!control || !gm_valid(control, 0x41c4))
+            return UINT32_MAX;
+        for (uint32_t group = 0; group < 32; ++group)
+            total += rd32(control + group * 0x204 + 0x144);
+    }
+    return total;
+}
+static void helper(const PopModApi *a, pop_cpu_v1 *cpu, PopHookInvocation *inv, void *user) {
+    const uint32_t fn = static_cast<Binding *>(user)->address;
+    if (s.lifecycle_cookie && guest_call_guarded_cookie(s.cpu) == s.lifecycle_cookie) {
+        REQUIRE(!journal.invocation_active() && !journal.eligible_cookie());
+        if (fn == VEHICLE_CREATE || fn == VEHICLE_DELETE) {
