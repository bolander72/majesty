diff --git a/tests/native_actor_profile_tests.cpp b/tests/native_actor_profile_tests.cpp
new file mode 100644
index 0000000..e33e85e
--- /dev/null
+++ b/tests/native_actor_profile_tests.cpp
@@ -0,0 +1,48 @@
+// Class admission from original UNIT records; no game/guest execution.
+#include "../native_actor_profile.h"
+#include <cstdio>
+#include <initializer_list>
+using namespace majesty::actors;
+static unsigned checks, failures;
+#define CHECK(x) do { ++checks; if (!(x)) { ++failures; std::fprintf(stderr, "FAIL %d: %s\n", __LINE__, #x); } } while (0)
+static void refused(const StageInput &input) {
+    StageProfile profile{99,99,99,99};
+    CHECK(!stage_profile(input, profile));
+    CHECK(!profile.kind && !profile.bytes && !profile.table && !profile.components);
+}
+int main() {
+    StageProfile profile;
+    // Original frozen generation233 Warrior and its Explore reward.
+    StageInput warrior{512,0,0x314c5641,0};
+    CHECK(stage_profile(warrior, profile));
+    CHECK(profile.kind == 1 && profile.bytes == 356 && profile.table == 0x68098c && profile.components == 2);
+    StageInput flag{545,0,0x34415241,0,StageClass::ExploreReward};
+    CHECK(stage_profile(flag, profile));
+    CHECK(profile.kind == 4 && profile.bytes == 336 && profile.table == 0x68071c && profile.components == 1);
+    for (uint32_t player = 0; player <= 8; ++player) {
+        flag.player = player;
+        CHECK(stage_profile(flag, profile));
+        CHECK(profile.components == 1 && profile.kind == 4);
+    }
+    flag.player = 0;
+    auto wrong = flag; wrong.flags |= 4; refused(wrong);
+    wrong = flag; wrong.flags ^= 1; refused(wrong);
+    wrong = flag; wrong.flags |= 0x80; refused(wrong);
+    wrong = flag; wrong.parent = 481; refused(wrong);
+    wrong = flag; wrong.description = 0x314c5641; refused(wrong);
+    wrong = flag; wrong.description = 0; refused(wrong);
+    wrong = flag; wrong.player = 9; refused(wrong);
+    wrong = flag; wrong.player = UINT32_MAX; refused(wrong);
+    wrong = flag; wrong.object_class = StageClass(2); refused(wrong);
+    wrong = warrior; wrong.object_class = StageClass::ExploreReward; refused(wrong);
+    wrong = warrior; wrong.flags |= 4; refused(wrong);
+    wrong = warrior; wrong.description = 0; refused(wrong);
+    // The original parent-relative visual children remain Vehicle records.
+    for (uint32_t description : {0x31475241u,0x34475241u}) {
+        StageInput effect{544,481,description,0};
+        CHECK(stage_profile(effect, profile));
+        CHECK(profile.kind == 1 && profile.components == 2);
+    }
+    std::printf("Actor profile checks=%u failures=%u native-reader-executed=0\n", checks, failures);
+    return failures ? 1 : 0;
+}
diff --git a/tests/native_campaign_objective_tests.cpp b/tests/native_campaign_objective_tests.cpp
new file mode 100644
index 0000000..6d7f5e3
--- /dev/null
+++ b/tests/native_campaign_objective_tests.cpp
@@ -0,0 +1,128 @@
+#include "../campaign_objective.h"
+#include <algorithm>
+#include <climits>
+#include <cstdio>
+#include <utility>
+
+static unsigned checks, failures;
+#define CHECK(value)                                                           \
+  do {                                                                         \
+    ++checks;                                                                  \
+    if (!(value)) {                                                            \
+      ++failures;                                                              \
+      std::fprintf(stderr, "FAIL line %d: %s\n", __LINE__, #value);            \
+    }                                                                          \
+  } while (0)
+
+static majesty::CampaignObjective wardens(int participants = 2) {
+  return {4,
+          participants,
+          {0, 1, 2, 3},
+          {25000, 25000, 25000, 25000},
+          {3, 3, 3, 3},
+          true};
+}
+
+int main() {
+  using majesty::campaign_objective_ready;
+  // Either side can be the last contributor. Richer allies cannot substitute
+  // for that kingdom's missing gold or its own required buildings.
+  for (int participants : {2, 3, 4}) {
+    auto complete = wardens(participants);
+    CHECK(campaign_objective_ready(complete));
+    for (int member = 0; member < participants; ++member) {
+      auto shortfall = complete;
+      shortfall.gold.fill(INT_MAX);
+      shortfall.gold[member] = 24999;
+      CHECK(!campaign_objective_ready(shortfall));
+      shortfall.gold[member] = 25000;
+      CHECK(campaign_objective_ready(shortfall));
+      for (uint32_t mask : {0u, 1u, 2u, UINT32_MAX}) {
+        shortfall = complete;
+        shortfall.buildings[member] = mask;
+        CHECK(!campaign_objective_ready(shortfall));
+      }
+    }
+    complete.buildings_readable = false;
+    CHECK(!campaign_objective_ready(complete));
+  }
+  auto split = wardens();
+  split.buildings = {1, 2, 3, 3};
+  CHECK(!campaign_objective_ready(split)); // No pooled guild/temple ownership.
+  split = wardens();
+  split.gold = {50000, 0, 25000, 25000};
+  CHECK(!campaign_objective_ready(split)); // No pooled treasury.
+
+  // Inactive kingdom entries do not change a two-player objective. A roster
+  // containing those same entries must require their actual contribution.
+  auto absent = wardens();
+  absent.gold[2] = INT_MIN;
+  absent.buildings[2] = UINT32_MAX;
+  CHECK(campaign_objective_ready(absent));
+  absent.participants = 3;
+  CHECK(!campaign_objective_ready(absent));
+  for (int count : {-1, 0, 1, 5}) {
+    auto invalid = wardens(count);
+    CHECK(!campaign_objective_ready(invalid));
+  }
+  auto invalid = wardens();
+  invalid.owners[1] = 0;
+  CHECK(!campaign_objective_ready(invalid));
+  invalid.owners[1] = 4;
+  CHECK(!campaign_objective_ready(invalid));
+
+  // Reordering a party must preserve per-owner requirements, including a
+  // shortfall carried with its owner rather than with an array position.
+  std::array<uint32_t, 4> order{0, 1, 2, 3};
+  do {
+    auto state = wardens(4);
+    state.owners = order;
+    CHECK(campaign_objective_ready(state));
+    for (int i = 0; i < 4; ++i)
+      state.gold[i] = order[i] == 2 ? 24999 : 50000;
+    CHECK(!campaign_objective_ready(state));
+  } while (std::next_permutation(order.begin(), order.end()));
+
+  // Gold-only chapters keep their published exact thresholds and ignore
+  // construction, including unreadable construction data.
+  for (const auto [chapter, target] :
+       {std::pair{2, 30100}, std::pair{3, 35000}}) {
+    auto state = wardens();
+    state.chapter = chapter;
+    state.buildings_readable = false;
+    state.buildings.fill(UINT32_MAX);
+    state.gold.fill(target);
+    CHECK(campaign_objective_ready(state));
+    state.gold[1] = target - 1;
+    CHECK(!campaign_objective_ready(state));
+    state.gold[1] = INT_MIN;
+    CHECK(!campaign_objective_ready(state));
+    state.gold[1] = INT_MAX;
+    CHECK(campaign_objective_ready(state));
+  }
+  for (int chapter : {-1, 0, 1, 5}) {
+    auto state = wardens();
+    state.chapter = chapter;
+    CHECK(!campaign_objective_ready(state));
+  }
+
+  // A previous successful observation is not permission to win later:
+  // spending, unfinished reconstruction and failed reads must be resampled.
+  auto previous = wardens();
+  CHECK(campaign_objective_ready(previous));
+  auto now = previous;
+  now.gold[1] -= 1;
+  CHECK(!campaign_objective_ready(now));
+  now = previous;
+  now.buildings[1] = 1;
+  CHECK(!campaign_objective_ready(now));
+  now = previous;
+  now.buildings_readable = false;
+  CHECK(!campaign_objective_ready(now));
+  now = previous;
+  CHECK(campaign_objective_ready(now));
+  std::printf(
+      "campaign objective: %u checks, %u failures; rule snapshots only\n",
+      checks, failures);
+  return failures ? 1 : 0;
+}
diff --git a/tests/native_coop_checkpoint_tests.cpp b/tests/native_coop_checkpoint_tests.cpp
new file mode 100644
index 0000000..0d5a1cf
--- /dev/null
+++ b/tests/native_coop_checkpoint_tests.cpp
@@ -0,0 +1,749 @@
+// Actual temporary-file publication and recovery. No world/guest/browser runs.
+#include "../coop_checkpoint.h"
+#include "../coop_lobby_resume.h"
+#include <cstdio>
+#include <cstring>
+#include <string>
+#include <vector>
+static unsigned checks, failures;
+#define CHECK(x)                                                               \
+  do {                                                                         \
+    ++checks;                                                                  \
+    if (!(x)) {                                                                \
+      ++failures;                                                              \
+      std::fprintf(stderr, "FAIL %d: %s\n", __LINE__, #x);                     \
+    }                                                                          \
+  } while (0)
+using namespace majesty;
+static bool write(const std::string &p, std::string_view bytes) {
+  const int fd = os_fd_open(p.c_str(), OS_O_WRONLY | OS_O_CREAT | OS_O_TRUNC);
+  if (fd < 0)
+    return false;
+  const bool written =
+      os_fd_write(fd, bytes.data(), bytes.size()) == int64_t(bytes.size());
+  return os_fd_close(fd) == 0 && written;
+}
+static std::string read(const std::string &p) {
+  const int fd = os_fd_open(p.c_str(), OS_O_RDONLY);
+  if (fd < 0)
+    return {};
+  char bytes[2048];
+  const auto n = os_fd_read(fd, bytes, sizeof bytes);
+  os_fd_close(fd);
+  return n >= 0 ? std::string(bytes, size_t(n)) : std::string{};
+}
+static int reject_publish(const char *, const char *) { return -1; }
+static bool absent(const std::string &p) {
+  OsStat s{};
+  return os_lstat(p.c_str(), &s) != 0;
+}
+static void test_lobby_resume(const std::string &root,
+                              const CoopCheckpointIdentity &identity) {
+  const std::string marker = root + "/lobby.checkpoint";
+  const std::array<std::string, 2> slots{root + "/lobby0.GMP", root + "/lobby1.GMP"};
+  const CoopCheckpointStore store(marker, slots, identity);
+  CoopCheckpointStore::Record record;
+  CHECK(store.commit(42, 2000, [&](int slot) { return write(slots[slot], "abc"); },
+                     [] { return true; }, record));
+  const std::string token = "v2|3|" + std::string(coop_detail::text(identity.world)) +
+      "|" + std::to_string(identity.x) + "|" + std::to_string(identity.y) +
+      "|-8|7|42|2000|1|3|" + std::string(coop_detail::text(record.digest)) + "|" +
+      std::string(coop_detail::text(identity.content)) + "|" +
+      std::string(coop_detail::text(identity.rules));
+  CoopLobbyResume request;
+  CHECK(coop_lobby_resume_parse(token, request));
+  CHECK(request.chapter == 3 && request.record.frame == 42 &&
+        request.initial_x == -8 && request.initial_y == 7 &&
+        request.record.clock == 2000 && request.record.revision == 1 &&
+        request.record.bytes == 3 && request.record.digest == record.digest);
+  CHECK(request.label().starts_with("WorldResume_"));
+  recomp_network_session_v1 party{};
+  party.host = 1;
+  party.local_player = 11;
+  party.player_count = 2;
+  party.players[0] = 11;
+  party.players[1] = 27;
+  CHECK(coop_lobby_resume_start_ready(request, party, request.label()));
+  party.player_count = 1;
+  CHECK(!coop_lobby_resume_start_ready(request, party, request.label()));
+  party.player_count = 2;
+  CHECK(!coop_lobby_resume_start_ready(request, party, "Other_Save"));
+  party.local_player = 99;
+  CHECK(!coop_lobby_resume_start_ready(request, party, request.label()));
+  party.local_player = 27;
+  party.host = 0;
+  CHECK(coop_lobby_resume_start_ready(request, party, request.label()));
+  party.players[1] = 11;
+  CHECK(!coop_lobby_resume_start_ready(request, party, request.label()));
+  CHECK(!coop_lobby_resume_start_ready(CoopLobbyResume{}, party, request.label()));
+  CHECK(coop_lobby_resume_local(request, store, true));
+  CHECK(coop_lobby_resume_local(request, store, false));
+  auto altered = request;
+  ++altered.record.revision;
+  CHECK(!coop_lobby_resume_local(altered, store, true));
+  CHECK(coop_lobby_resume_local(altered, store, false));
+  --altered.record.clock;
+  CHECK(!coop_lobby_resume_local(altered, store, false));
+  CHECK(store.commit(43, 2050, [&](int slot) { return write(slots[slot], "abd"); },
+                     [] { return true; }, record));
+  CHECK(!coop_lobby_resume_local(request, store, true));
+  CHECK(!coop_lobby_resume_local(request, store, false));
+  for (const auto &bad : {token + "|extra", token + "\n", std::string(513, 'a'),
+                          std::string("v2|4") + token.substr(4),
+                          std::string("v2|03") + token.substr(4),
+                          std::string("v1") + token.substr(2)})
+    CHECK(!coop_lobby_resume_parse(bad, altered));
+  const std::string maximum = token.substr(0, token.find("|1|3|")) +
+      "|18446744073709551615|3|" + token.substr(token.find("|1|3|") + 5);
+  CHECK(coop_lobby_resume_parse(maximum, altered));
+  CHECK(altered.record.revision == UINT64_MAX);
+  for (const auto &origin : {"|-08|7|", "|-8|1000001|", "|-0|7|"}) {
+    auto bad = token;
+    bad.replace(bad.find("|-8|7|"), 6, origin);
+    CHECK(!coop_lobby_resume_parse(bad, altered));
+  }
+  CHECK(!coop_lobby_resume_parse(std::string("v2|3|bad|0|0|0|0|4294967296|0|1|3|") +
+      std::string(coop_detail::text(request.record.digest)) + "|" +
+      std::string(coop_detail::text(identity.content)) + "|" +
+      std::string(coop_detail::text(identity.rules)), altered));
+  for (const auto &path : slots) CHECK(os_unlink(path.c_str()) == 0);
+  CHECK(os_unlink(marker.c_str()) == 0);
+  CHECK(!coop_lobby_resume_local(request, store, true));
+  CHECK(coop_lobby_resume_local(request, store, false));
+  CHECK(!coop_lobby_resume_local(CoopLobbyResume{}, store, false));
+  for (unsigned field = 0; field < 8; ++field) {
+    auto invalid = request;
+    switch (field) {
+    case 0: invalid.record.status = CoopCheckpointStore::Status::invalid; break;
+    case 1: invalid.record.revision = 0; break;
+    case 2: invalid.record.bytes = 0; break;
+    case 3: invalid.record.bytes = CoopCheckpointStore::maximum_bytes + 1; break;
+    case 4: invalid.record.digest.fill('z'); break;
+    case 5: invalid.chapter = 4; break;
+    case 6: invalid.initial_x = -1000001; break;
+    case 7: invalid.initial_y = 1000001; break;
+    }
+    CHECK(!coop_lobby_resume_local(invalid, store, false));
+  }
+  CHECK(write(slots[0], "orphan"));
+  CHECK(!coop_lobby_resume_local(request, store, false));
+  CHECK(os_unlink(slots[0].c_str()) == 0);
+}
+static void test_import(const std::string &root,
+                        const CoopCheckpointIdentity &identity) {
+  const std::string marker = root + "/import.checkpoint",
+                    incoming = root + "/incoming.GMP";
+  const std::array<std::string, 2> slots = {root + "/import0.GMP",
+                                            root + "/import1.GMP"};
+  const CoopCheckpointStore store(marker, slots, identity);
+  auto valid = [] { return true; };
+  CoopCheckpointStore::Record out;
+  CHECK(store.commit(
+      19, 1000, [&](int slot) { return write(slots[slot], "abc"); }, valid,
+      out));
+  const auto original = read(marker);
+  std::string payload(50003, '\0');
+  for (size_t i = 0; i < payload.size(); ++i)
+    payload[i] = char((i * 17 + 3) % 251);
+  CHECK(write(incoming, payload));
+  CoopCheckpointStore::Record agreed;
+  agreed.status = CoopCheckpointStore::Status::valid;
+  agreed.revision = 17;
+  agreed.frame = 0;
+  agreed.clock = 71820;
+  agreed.bytes = payload.size();
+  coop_detail::copy(
+      "5e2b54b7081e39523b6df8f8f1fd846706f65d49be7605a5a5afe415af71c069",
+      agreed.digest);
+  CHECK(loader_hash_file_bounded(incoming.c_str(), agreed.bytes) ==
+        coop_detail::text(agreed.digest));
+  for (unsigned stop = 1; stop <= 3; ++stop) {
+    unsigned calls = 0;
+    CHECK(!store.import_file(
+        incoming, agreed, [&] { return ++calls != stop; }, out));
+    CHECK(calls == stop && out.status == CoopCheckpointStore::Status::invalid);
+    CHECK(read(marker) == original && read(slots[0]) == "abc" &&
+          store.read().revision == 1 && absent(marker + ".tmp"));
+  }
+  CHECK(!store.import_file(incoming, agreed, valid, out, reject_publish));
+  CHECK(read(marker) == original && read(slots[0]) == "abc");
+  CHECK(write(incoming, payload + "extra"));
+  CHECK(!store.import_file(incoming, agreed, valid, out));
+  CHECK(read(marker) == original && read(slots[0]) == "abc");
+  CHECK(write(incoming, payload.substr(0, payload.size() - 1)));
+  CHECK(!store.import_file(incoming, agreed, valid, out));
+  CHECK(read(marker) == original && read(slots[0]) == "abc");
+  payload[12345] ^= 1;
+  CHECK(write(incoming, payload));
+  CHECK(!store.import_file(incoming, agreed, valid, out));
+  CHECK(read(marker) == original && read(slots[0]) == "abc");
+  payload[12345] ^= 1;
+  CHECK(write(incoming, payload));
+  for (unsigned mutation = 0; mutation < 6; ++mutation) {
+    auto bad = agreed;
+    if (mutation == 0)
+      bad.status = CoopCheckpointStore::Status::invalid;
+    if (mutation == 1)
+      bad.revision = 0;
+    if (mutation == 2)
+      bad.bytes = 0;
+    if (mutation == 3)
+      bad.bytes = CoopCheckpointStore::maximum_bytes + 1;
+    if (mutation == 4)
+      bad.digest[0] = 'Z';
+    if (mutation == 5)
+      bad.digest.back() = 'a';
+    CHECK(!store.import_file(incoming, bad, valid, out));
+    CHECK(read(marker) == original && read(slots[0]) == "abc");
+  }
+  for (const auto &bad :
+       {std::string{}, marker, marker + ".tmp", slots[0], slots[1],
+        std::string(1024, 'a'), incoming + std::string("\0other", 6)})
+    CHECK(!store.import_file(bad, agreed, valid, out));
+  CHECK(store.import_file(incoming, agreed, valid, out));
+  CHECK(out.status == CoopCheckpointStore::Status::valid && out.slot == 1 &&
+        out.revision == 17 && out.frame == 0 && out.clock == 71820 &&
+        out.bytes == payload.size() && out.digest == agreed.digest);
+  CHECK(store.read().revision == 17 && read(slots[0]) == "abc");
+  CHECK(loader_hash_file_bounded(incoming.c_str(), agreed.bytes) ==
+        coop_detail::text(agreed.digest));
+  const auto imported = read(marker);
+  // An exact retry needs no second download or file rewrite. Fresh read still
+  // verifies the selected bytes, and the caller's agreement guard must pass.
+  CHECK(os_unlink(incoming.c_str()) == 0);
+  CHECK(store.import_file(incoming, agreed, valid, out));
+  CHECK(read(marker) == imported && out.slot == 1 && out.revision == 17);
+  CHECK(!store.import_file(incoming, agreed, [] { return false; }, out));
+  CHECK(read(marker) == imported &&
+        out.status == CoopCheckpointStore::Status::invalid);
+  for (unsigned mutation = 0; mutation < 6; ++mutation) {
+    auto bad = agreed;
+    if (mutation == 0)
+      --bad.revision;
+    if (mutation == 1)
+      ++bad.frame;
+    if (mutation == 2)
+      ++bad.clock;
+    if (mutation == 3)
+      --bad.bytes;
+    if (mutation == 4)
+      bad.digest[0] = bad.digest[0] == 'a' ? 'b' : 'a';
+    if (mutation == 5)
+      bad.revision = 1;
+    CHECK(!store.import_file(incoming, bad, valid, out));
+    CHECK(read(marker) == imported && store.read().revision == 17);
+  }
+  CHECK(write(incoming, payload));
+  agreed.revision = 23;
+  out = agreed;
+  CHECK(store.import_file(incoming, out, valid, out));
+  CHECK(out.slot == 0 && out.revision == 23 && store.read().revision == 23);
+  CHECK(loader_hash_file_bounded(slots[1].c_str(), agreed.bytes) ==
+        coop_detail::text(agreed.digest));
+  CHECK(absent(marker + ".tmp"));
+  CHECK(os_unlink(incoming.c_str()) == 0);
+  for (const auto &path : slots)
+    CHECK(os_unlink(path.c_str()) == 0);
+  CHECK(os_unlink(marker.c_str()) == 0);
+}
+
+static void test_shared_target_import(const std::string &root,
+                                      const CoopCheckpointIdentity &identity) {
+  const std::string marker = root + "/shared-target.checkpoint",
+                    incoming = root + "/shared-target-incoming.GMP";
+  const std::array<std::string, 2> slots = {root + "/shared-target0.GMP",
+                                           root + "/shared-target1.GMP"};
+  const CoopCheckpointStore store(marker, slots, identity);
+  const auto valid = [] { return true; };
+  const auto policy = CoopCheckpointStore::ImportPolicy::shared_target;
+  CoopCheckpointStore::Record out, agreed;
+  CHECK(store.commit(11, 550, [&](int slot) { return write(slots[slot], "local kingdom"); }, valid, out));
+  const auto original = read(marker);
+  CHECK(write(incoming, "authoritative kingdom"));
+  agreed.status = CoopCheckpointStore::Status::valid;
+  agreed.revision = 1; agreed.frame = 0; agreed.clock = 550;
+  agreed.bytes = read(incoming).size();
+  coop_detail::copy(loader_hash_file_bounded(incoming.c_str(), agreed.bytes), agreed.digest);
+  CHECK(!store.import_file(incoming, agreed, valid, out));
+  CHECK(read(marker) == original && read(slots[0]) == "local kingdom");
+  for (unsigned change = 0; change < 5; ++change) {
+    auto bad = agreed;
+    if (change == 0) bad.clock = 500;
+    if (change == 1) bad.clock = 600;
+    if (change == 2) bad.frame = 11;
+    if (change == 3) bad.bytes += 1;
+    if (change == 4) bad.digest[0] = bad.digest[0] == 'a' ? 'b' : 'a';
+    CHECK(!store.import_file(incoming, bad, valid, out, os_rename, policy));
+    CHECK(read(marker) == original && read(slots[0]) == "local kingdom");
+  }
+  for (unsigned stop = 1; stop <= 3; ++stop) {
+    unsigned calls = 0;
+    CHECK(!store.import_file(incoming, agreed, [&] { return ++calls < stop; }, out, os_rename, policy));
+    CHECK(read(marker) == original && read(slots[0]) == "local kingdom");
+  }
+  CHECK(!store.import_file(incoming, agreed, valid, out, reject_publish, policy));
+  CHECK(read(marker) == original && store.read().revision == 1 && read(slots[0]) == "local kingdom");
+  CHECK(store.import_file(incoming, agreed, valid, out, os_rename, policy));
+  CHECK(out.slot == 1 && out.revision == 1 && out.frame == 0 && out.clock == 550 && out.digest == agreed.digest);
+  CHECK(read(slots[0]) == "local kingdom" && read(slots[1]) == "authoritative kingdom");
+  const auto imported = read(marker);
+  CHECK(os_unlink(incoming.c_str()) == 0);
+  CHECK(store.import_file(incoming, agreed, valid, out, os_rename, policy));
+  CHECK(read(marker) == imported && out.slot == 1 && out.revision == 1);
+  CHECK(store.commit(29, 1450, [&](int slot) { return write(slots[slot], "later kingdom"); }, valid, out));
+  const auto later = read(marker);
+  CHECK(!store.import_file(incoming, agreed, valid, out, os_rename, policy));
+  CHECK(read(marker) == later && store.read().revision == 2);
+  // Equal authoritative bytes keep the local frame; target frame is unspecified.
+  agreed = store.read(); agreed.frame = 0;
+  CHECK(store.import_file(incoming, agreed, valid, out, os_rename, policy));
+  CHECK(read(marker) == later && out.frame == 29 && out.revision == 2);
+  for (const auto &path : slots) CHECK(os_unlink(path.c_str()) == 0);
+  CHECK(os_unlink(marker.c_str()) == 0);
+}
+
+static void test_transfer_file(const std::string &root,
+                               const std::string &parent,
+                               const CoopCheckpointIdentity &identity) {
+  const std::string source = parent + "/transfer-source.GMP";
+  std::string payload(50003, '\0');
+  for (size_t i = 0; i < payload.size(); ++i)
+    payload[i] = char((i * 17 + 3) % 251);
+  std::array<char, 65> digest{};
+  coop_detail::copy(
+      "5e2b54b7081e39523b6df8f8f1fd846706f65d49be7605a5a5afe415af71c069",
+      digest);
+  auto valid = [] { return true; };
+  CHECK(write(source, payload));
+  CoopCheckpointTransferFile sender, receiver;
+  std::array<uint8_t, 16384> scratch{};
+  CHECK(!sender.open_source(root, source, payload.size() - 1, digest, valid));
+  CHECK(!sender.open_source(root, source, 0, digest, valid));
+  CHECK(!sender.open_source(root, source, 64 * 1024 * 1024 + 1, digest, valid));
+  CHECK(!sender.open_source(root, source, payload.size(), digest,
+                            [] { return false; }));
+  CHECK(!sender.open_source(root + "-foreign", source, payload.size(), digest,
+                            valid));
+  auto wrong = digest;
+  wrong[0] = 'a';
+  CHECK(!sender.open_source(root, source, payload.size(), wrong, valid));
+  CHECK(!receiver.open_receiver(root, root, payload.size(), digest, valid));
+  CHECK(!receiver.open_receiver(root, parent + "/../SaveGame", payload.size(),
+                                digest, valid));
+  CHECK(!receiver.open_receiver(root, parent, 0, digest, valid));
+  CHECK(!receiver.open_receiver(root, parent, payload.size(), digest,
+                                [] { return false; }));
+  // Repeated real-file streams close sender handles and remove only their owned
+  // receiver siblings. The selected source remains byte-identical throughout.
+  for (unsigned cycle = 0; cycle < 20; ++cycle) {
+    CHECK(sender.open_source(root, source, payload.size(), digest, valid));
+    CHECK(receiver.open_receiver(root, parent, payload.size(), digest, valid));
+    const std::string incoming = receiver.path();
+    CHECK(incoming.starts_with(parent + "/.CoopReceived-") &&
+          !absent(incoming));
+    CHECK(!receiver.open_receiver(root, parent, payload.size(), digest, valid));
+    uint32_t size = 0;
+    while (sender.offset() < sender.bytes()) {
+      const uint32_t sequence = sender.sequence();
+      CHECK(sender.read_chunk(sequence, scratch.data(), scratch.size(), size,
+                              valid));
+      CHECK(size ==
+            std::min<uint64_t>(16384, payload.size() - receiver.offset()));
+      CHECK(!std::memcmp(scratch.data(), payload.data() + receiver.offset(),
+                         size));
+      CHECK(receiver.write_chunk(sequence, scratch.data(), size, valid));
+      CHECK(sender.offset() == receiver.offset() &&
+            sender.sequence() == receiver.sequence());
+    }
+    CHECK(sender.sequence() == 5 && receiver.sequence() == 5);
+    CHECK(sender.finish(valid) && sender.complete());
+    CHECK(receiver.finish(valid) && receiver.complete());
+    CHECK(loader_hash_file_bounded(incoming.c_str(), payload.size()) ==
+          coop_detail::text(digest));
+    if (cycle == 0) {
+      // Import the verified file, preserving host revision. Deleting our inbox
+      // afterwards does not delete the selected store's independent copy.
+      const std::string marker = parent + "/transfer.checkpoint";
+      const std::array<std::string, 2> slots = {parent + "/transfer0.GMP",
+                                                parent + "/transfer1.GMP"};
+      CoopCheckpointStore::Record agreed, selected;
+      agreed.status = CoopCheckpointStore::Status::valid;
+      agreed.revision = 9;
+      agreed.bytes = payload.size();
+      agreed.clock = 71820;
+      agreed.digest = digest;
+      const CoopCheckpointStore store(marker, slots, identity);
+      CHECK(store.import_file(incoming, agreed, valid, selected));
+      receiver.reset();
+      CHECK(absent(incoming));
+      CHECK(store.read().revision == 9 && store.read().digest == digest);
+      CHECK(os_unlink(slots[selected.slot].c_str()) == 0);
+      CHECK(os_unlink(marker.c_str()) == 0);
+    } else {
+      receiver.reset();
+      CHECK(absent(incoming));
+    }
+    sender.reset();
+    CHECK(loader_hash_file_bounded(source.c_str(), payload.size()) ==
+          coop_detail::text(digest));
+  }
+  for (unsigned failure = 0; failure < 9; ++failure) {
+    CHECK(receiver.open_receiver(root, parent, payload.size(), digest, valid));
+    const std::string incoming = receiver.path();
+    if (failure < 5) {
+      if (failure == 0)
+        CHECK(!receiver.write_chunk(2, payload.data(), 16384, valid));
+      if (failure == 1)
+        CHECK(!receiver.write_chunk(1, payload.data(), 1, valid));
+      if (failure == 2)
+        CHECK(!receiver.write_chunk(1, nullptr, 16384, valid));
+      if (failure == 3)
+        CHECK(!receiver.write_chunk(1, payload.data(), 16384,
+                                    [] { return false; }));
+      if (failure == 4) {
+        unsigned calls = 0;
+        CHECK(!receiver.write_chunk(1, payload.data(), 16384,
+                                    [&] { return ++calls < 2; }));
+        CHECK(calls ==
+              2); // loss after writing is still cleanup, not acknowledged bytes
+      }
+    } else if (failure == 5) {
+      CHECK(receiver.write_chunk(1, payload.data(), 16384, valid));
+      CHECK(!receiver.finish(valid));
+    } else {
+      while (receiver.offset() < receiver.bytes()) {
+        const uint32_t size = uint32_t(
+            std::min<uint64_t>(16384, receiver.bytes() - receiver.offset()));
+        std::memcpy(scratch.data(), payload.data() + receiver.offset(), size);
+        if (failure == 6 && receiver.offset() == 0)
+          scratch[0] ^= 1;
+        CHECK(receiver.write_chunk(receiver.sequence(), scratch.data(), size,
+                                   valid));
+      }
+      if (failure == 6)
+        CHECK(!receiver.finish(valid));
+      if (failure == 7)
+        CHECK(!receiver.finish([] { return false; }));
+      if (failure == 8) {
+        unsigned calls = 0;
+        CHECK(!receiver.finish([&] { return ++calls < 2; }));
+        CHECK(calls == 2); // loss after fsync/hash never publishes this inbox
+      }
+    }
+    CHECK(!receiver.active() && !receiver.complete() && absent(incoming));
+    CHECK(loader_hash_file_bounded(source.c_str(), payload.size()) ==
+          coop_detail::text(digest));
+  }
+  for (unsigned failure = 0; failure < 5; ++failure) {
+    CHECK(sender.open_source(root, source, payload.size(), digest, valid));
+    uint32_t size = 99;
+    if (failure == 0)
+      CHECK(!sender.read_chunk(2, scratch.data(), scratch.size(), size, valid));
+    if (failure == 1)
+      CHECK(!sender.read_chunk(1, scratch.data(), 100, size, valid));
+    if (failure == 2)
+      CHECK(!sender.read_chunk(1, scratch.data(), scratch.size(), size,
+                               [] { return false; }));
+    if (failure == 3)
+      CHECK(!sender.finish(valid));
+    if (failure == 4) {
+      unsigned calls = 0;
+      CHECK(!sender.read_chunk(1, scratch.data(), scratch.size(), size,
+                               [&] { return ++calls < 2; }));
+      CHECK(calls == 2);
+    }
+    CHECK(!sender.active() && !sender.complete() && !absent(source));
+  }
+  // Explicit cancellation and destructor both release owned partial input.
+  CHECK(receiver.open_receiver(root, parent, payload.size(), digest, valid));
+  const std::string canceled = receiver.path();
+  CHECK(receiver.write_chunk(1, payload.data(), 16384, valid));
+  receiver.reset();
+  CHECK(absent(canceled));
+  std::string destroyed;
+  {
+    CoopCheckpointTransferFile temporary;
+    CHECK(temporary.open_receiver(root, parent, payload.size(), digest, valid));
+    destroyed = temporary.path();
+    CHECK(temporary.write_chunk(1, payload.data(), 16384, valid));
+  }
+  CHECK(absent(destroyed));
+  CHECK(os_unlink(source.c_str()) == 0);
+}
+int main() {
+  recomp_network_session_v1 party{};
+  party.host = 1; party.local_player = 1; party.player_count = 2;
+  party.players[0] = 1; party.players[1] = 2;
+  recomp_network_barrier_v1 barrier{};
+  barrier.serial = 1; barrier.player_count = 2;
+  barrier.players[0] = 1; barrier.players[1] = 2;
+  barrier.descriptor_bytes = 1; barrier.descriptor[0] = 'x';
+  for (uint32_t stage = 0; stage <= 5; ++stage) {
+    barrier.stage = stage;
+    for (bool host : {false, true}) {
+      party.host = host; party.local_player = host ? 1 : 2;
+      for (bool retained : {false, true}) {
+        const bool permitted = stage <= 4 &&
+            (stage == 0 || stage == 3 || stage == 4 ||
+             (stage == 1 && !host && !retained));
+        CHECK(coop_source_checkpoint_writable(party, barrier, retained) == permitted);
+      }
+    }
+  }
+  party.host = 0; party.local_player = 2; barrier.stage = 1;
+  for (unsigned change = 0; change < 10; ++change) {
+    auto bad_party = party; auto bad_barrier = barrier;
+    if (change == 0) bad_party.host = 2;
+    if (change == 1) bad_party.player_count = 1;
+    if (change == 2) bad_party.player_count = 5;
+    if (change == 3) bad_party.players[0] = 0;
+    if (change == 4) bad_party.local_player = 3;
+    if (change == 5) bad_party.players[0] = 2;
+    if (change == 6) bad_barrier.serial = 0;
+    if (change == 7) bad_barrier.player_count = 1;
+    if (change == 8) bad_barrier.players[1] = 3;
+    if (change == 9) bad_barrier.descriptor_bytes = 0;
+    CHECK(!coop_source_checkpoint_writable(bad_party, bad_barrier, false));
+  }
+  char directory[1024];
+  std::snprintf(directory, sizeof directory,
+                "%s/majesty-coop-checkpoint-XXXXXX", os_temp_dir());
+  CHECK(os_mkdtemp(directory) == 0);
+  if (failures)
+    return 1;
+  const std::string root(directory), marker = root + "/source.checkpoint";
+  const std::array<std::string, 4> hierarchy = {
+      root + "/Documents", root + "/Documents/My Games",
+      root + "/Documents/My Games/MajestyHD",
+      root + "/Documents/My Games/MajestyHD/SaveGame"};
+  CHECK(!coop_checkpoint_parent(root, hierarchy.back()));
+  for (const auto &part : hierarchy)
+    CHECK(os_mkdir(part.c_str()) == 0);
+  CHECK(coop_checkpoint_parent(root, hierarchy.front()));
+  CHECK(coop_checkpoint_parent(root, hierarchy.back()));
+  for (const auto &bad :
+       {root, root + "/", root + "2/Documents", root + "/../Documents",
+        root + "/./Documents", root + "//Documents", root + "/Documents/",
+        root + "/Documents/../My Games", root + "/Documents\\My Games"})
+    CHECK(!coop_checkpoint_parent(root, bad));
+  CHECK(!coop_checkpoint_parent("", hierarchy.back()));
+  CHECK(!coop_checkpoint_parent(root, std::string(1024, 'a')));
+  CHECK(!coop_checkpoint_parent(root,
+                                root + std::string("/Documents\0other", 16)));
+  const std::string file_parent = root + "/NotDirectory";
+  CHECK(write(file_parent, "keep"));
+  CHECK(!coop_checkpoint_parent(root, file_parent));
+  CHECK(!coop_checkpoint_parent(root, file_parent + "/child"));
+  CHECK(read(file_parent) == "keep");
+  CHECK(os_unlink(file_parent.c_str()) == 0);
+  const std::array<std::string, 2> slots = {root + "/source0.GMP",
+                                            root + "/source1.GMP"};
+  CoopCheckpointIdentity identity;
+  coop_detail::copy("shared-kingdom", identity.world);
+  coop_detail::copy(std::string(64, 'a') + ":" + std::string(64, 'b'),
+                    identity.content);
+  coop_detail::copy(std::string(64, 'c'), identity.rules);
+  identity.x = -1;
+  identity.y = 0;
+  const std::string content = std::string(64, 'a') + ":" + std::string(64, 'b');
+  const std::string session = std::string(64, 'd') + ":" +
+                              std::string(64, 'a') + ":" + std::string(64, 'c');
+  CoopCheckpointIdentity parsed;
+  CHECK(coop_checkpoint_identity("shared-kingdom", "-1_0", content, session,
+                                 std::string(64, 'a'), parsed));
+  CHECK(parsed.world == identity.world && parsed.content == identity.content &&
+        parsed.rules == identity.rules && parsed.x == -1 && parsed.y == 0);
+  for (auto region :
+       {"", "0", "01_0", "-0_0", "1_0_0", "1000001_0", "0_-1000001"}) {
+    CHECK(!coop_checkpoint_identity("shared-kingdom", region, content, session,
+                                    std::string(64, 'a'), parsed));
+    CHECK(!parsed.world[0] && !parsed.content[0] && !parsed.rules[0] &&
+          !parsed.x && !parsed.y);
+  }
+  CHECK(!coop_checkpoint_identity("../other", "0_0", content, session,
+                                  std::string(64, 'a'), parsed));
+  CHECK(!coop_checkpoint_identity("world", "0_0", content, session,
+                                  std::string(64, 'e'), parsed));
+  CHECK(!coop_checkpoint_identity("world", "0_0", content, session.substr(1),
+                                  std::string(64, 'a'), parsed));
+  const CoopCheckpointStore store(marker, slots, identity);
+  CHECK(store.read().status == CoopCheckpointStore::Status::missing);
+  CHECK(store.unvisited());
+  CHECK(store.capture_allowed(false) && store.capture_allowed(true));
+  // A missing selector with surviving artifacts is an interrupted kingdom,
+  // not permission to generate over it. All probes are owned fixture files.
+  for (const auto &path : {slots[0], slots[1], marker + ".tmp",
+                          slots[0] + ".import-leftover", slots[1] + ".import-leftover"}) {
+    CHECK(write(path, "interrupted kingdom"));
+    CHECK(store.read().status == CoopCheckpointStore::Status::missing);
+    CHECK(!store.unvisited());
+    CHECK(!store.capture_allowed(false) && !store.capture_allowed(true));
+    CHECK(read(path) == "interrupted kingdom");
+    CHECK(os_unlink(path.c_str()) == 0);
+    CHECK(store.unvisited());
+  }
+  CoopCheckpointStore::Record selected;
+  unsigned writes = 0;
+  auto writer = [&](int slot) {
+    ++writes;
+    return write(slots[slot], "abc");
+  };
+  auto valid = [] { return true; };
+  CHECK(store.commit(19999, 31800, writer, valid, selected));
+  CHECK(!store.unvisited());
+  CHECK(selected.status == CoopCheckpointStore::Status::valid &&
+        selected.slot == 0 && selected.revision == 1 &&
+        selected.frame == 19999 && selected.clock == 31800 &&
+        selected.bytes == 3);
+  CHECK(coop_detail::text(selected.digest) ==
+        "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad");
+  const std::string golden = "majesty-coop-checkpoint-v1\n0\nshared-kingdom\n" +
+                             std::string(64, 'a') + ":" + std::string(64, 'b') +
+                             "\n" + std::string(64, 'c') +
+                             "\n-"
+                             "1\n0\n19999\n31800\n1\n3\nba7816bf8f01cfea414140d"
+                             "e5dae2223b00361a396177a9cb410ff61f20015ad\n";
+  CHECK(read(marker) == golden);
+  CHECK(!store.capture_allowed(false) && store.capture_allowed(true));
+  CHECK(read(marker) == golden && read(slots[0]) == "abc" && writes == 1);
+  CHECK(store.read().revision == 1 && writes == 1 && read(slots[0]) == "abc");
+  // A restarted reader ignores a partial inactive file and leftover stage.
+  CHECK(write(slots[1], "partial"));
+  CHECK(write(marker + ".tmp", "partial manifest"));
+  const CoopCheckpointStore restarted(marker, slots, identity);
+  CHECK(restarted.read().status == CoopCheckpointStore::Status::valid &&
+        restarted.read().slot == 0);
+  CHECK(restarted.commit(20000, 31850, writer, valid, selected));
+  CHECK(selected.slot == 1 && selected.revision == 2 &&
+        absent(marker + ".tmp"));
+  const auto committed = read(marker);
+  const auto active = read(slots[1]);
+  // Losing the pause/epoch/roster before save, after save or after flushing
+  // prevents publication. The selected file and manifest stay byte-identical.
+  for (unsigned stop = 1; stop <= 3; ++stop) {
+    unsigned calls = 0;
+    const auto before = writes;
+    CHECK(!store.commit(
+        20001, 31900, writer, [&] { return ++calls != stop; }, selected));
+    CHECK(calls == stop && writes == before + (stop == 1 ? 0 : 1));
+    CHECK(selected.status == CoopCheckpointStore::Status::invalid &&
+          !selected.revision);
+    CHECK(read(marker) == committed && read(slots[1]) == active &&
+          store.read().revision == 2);
+    CHECK(absent(marker + ".tmp"));
+  }
+  CHECK(!store.commit(
+      20001, 31900,
+      [&](int slot) {
+        CHECK(slot == 0);
+        write(slots[slot], "partial");
+        return false;
+      },
+      valid, selected));
+  CHECK(read(marker) == committed && read(slots[1]) == active);
+  CHECK(!store.commit(20001, 31900, writer, valid, selected, reject_publish));
+  CHECK(read(marker) == committed && read(slots[1]) == active &&
+        absent(marker + ".tmp"));
+  CHECK(!store.commit(
+      20001, 31900, [&](int slot) { return write(slots[slot], ""); }, valid,
