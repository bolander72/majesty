@@ -0,0 +1,123 @@
+// Original fixed strstreambuf and iostreams over bounded private guest spans.
+// No stream/allocator hooks, files, game entry, actor publication or browser.
+#include "../kit/runtime/guest.h"
+#include "../kit/runtime/loader.h"
+#include "../kit/runtime/memory.h"
+#include "../kit/runtime/profile.h"
+#include "../kit/runtime/win32.h"
+#include <cstdio>
+#include <cstring>
+
+static unsigned checks, failures, calls, cycles;
+static constexpr const char *PIN =
+    "654365fd1bdefa6d7f2349d162869f255388fadcb1bb8db9f7db2f3468dd5542";
+#define CHECK(x)                                                                                   \
+    do {                                                                                           \
+        ++checks;                                                                                  \
+        if (!(x)) {                                                                                \
+            ++failures;                                                                            \
+            std::fprintf(stderr, "FAIL line %d: %s\n", __LINE__, #x);                              \
+        }                                                                                          \
+    } while (0)
+
+static uint32_t invoke(X86 *cpu, uint32_t fn, uint32_t receiver, const uint32_t *args = nullptr,
+                       int count = 0) {
+    X86 saved = *cpu;
+    uint32_t fs = rd32(cpu->fs_base), depth = recomp_profile_depth();
+    cpu->r[R_ECX] = receiver;
+    ++calls;
+    auto result = guest_call_guarded(cpu, fn, args, count);
+    CHECK(result.status == GuestCallGuardedStatus::Returned);
+    CHECK(cpu->r[R_ESP] == saved.r[R_ESP] && cpu->eip == saved.eip && rd32(cpu->fs_base) == fs &&
+          recomp_callback_depth() == 0 && recomp_profile_depth() == depth);
+    CHECK(cpu->r[R_EBX] == saved.r[R_EBX] && cpu->r[R_ESI] == saved.r[R_ESI] &&
+          cpu->r[R_EDI] == saved.r[R_EDI] && cpu->r[R_EBP] == saved.r[R_EBP]);
+    *cpu = saved;
+    return result.eax;
+}
+
+static void trial(X86 *cpu, uint32_t bytes, bool output) {
+    HeapStats baseline = heap_stats();
+    // Maximum 2048 payload bytes, plus sentinels. Objects remain caller-owned;
+    // original constructors bind the span and initialize every stream field.
+    uint32_t data = heap_alloc(bytes + 32, false), scratch = heap_alloc(bytes + 32, false);
+    // Input stream's virtual ios base is at +12; its embedded 24-byte
+    // critical section starts at ios+56. The original file wrapper allocates
+    // 92 bytes for this complete object (output needs 88).
+    uint32_t buffer = heap_alloc(100, true), io = heap_alloc(92, true);
+    uint32_t wrapper = heap_alloc(16, true);
+    CHECK(data && scratch && buffer && io && wrapper);
+    std::memset(g_mem + data, 0xa5, bytes + 32);
+    std::memset(g_mem + scratch, 0x5a, bytes + 32);
+    for (uint32_t i = 0; i < bytes; ++i)
+        g_mem[scratch + 16 + i] = static_cast<uint8_t>(i * 37 + 11);
+    if (!output)
+        std::memcpy(g_mem + data + 16, g_mem + scratch + 16, bytes);
+    uint32_t init_buffer[] = {data + 16, bytes, output ? data + 16 : 0};
+    CHECK(invoke(cpu, 0x0064a97f, buffer, init_buffer, 3) == buffer);
+    CHECK(rd32(buffer) == 0x0068c8a0 && !rd32(buffer + 0x4c) && rd32(buffer + 0x58) == 1);
+    uint32_t init_io[] = {buffer, 1};
+    CHECK(invoke(cpu, output ? 0x006497f3 : 0x0064b68a, io, init_io, 2) == io);
+    wr32(wrapper, io); // Majesty wrapper borrows the original C++ stream.
+    uint32_t args[] = {scratch + 16, bytes};
+    if (output) {
+        CHECK(invoke(cpu, 0x004eef60, wrapper, args, 2) == 0);
+        CHECK(rd32(buffer + 0x1c) == data + 16 + bytes);
+        CHECK(!std::memcmp(g_mem + data + 16, g_mem + scratch + 16, bytes));
+        uint32_t scalar[] = {0x12345678};
+        CHECK(invoke(cpu, 0x004eed10, wrapper, scalar, 1) == 29);
+        CHECK(invoke(cpu, 0x004eeb50, wrapper) == 29);
+        CHECK(invoke(cpu, 0x004eec70, wrapper, scalar, 1) == 29);
+        CHECK(rd32(buffer + 0x1c) == data + 16 + bytes);
+        CHECK(!std::memcmp(g_mem + data + 16, g_mem + scratch + 16, bytes));
+    } else {
+        std::memset(g_mem + scratch + 16, 0x5a, bytes);
+        CHECK(invoke(cpu, 0x004ef700, wrapper, args, 2) == 0);
+        CHECK(rd32(buffer + 0x28) == data + 16 + bytes);
+        CHECK(!std::memcmp(g_mem + data + 16, g_mem + scratch + 16, bytes));
+        std::memset(g_mem + scratch + 16, 0x5a, bytes);
+        uint32_t scalar[] = {scratch + 16};
+        CHECK(invoke(cpu, 0x004ef790, wrapper, scalar, 1) == 0x2000000a);
+        CHECK(invoke(cpu, 0x004ef6c0, wrapper) == 0x2000000a);
+        CHECK(invoke(cpu, 0x004ef740, wrapper, scalar, 1) == 0x2000000a);
+        CHECK(rd32(buffer + 0x28) == data + 16 + bytes);
+        for (uint32_t i = 0; i < bytes; ++i)
+            CHECK(rd8(scratch + 16 + i) == 0x5a);
+    }
+    for (uint32_t i = 0; i < 16; ++i) {
+        CHECK(rd8(data + i) == 0xa5 && rd8(data + 16 + bytes + i) == 0xa5);
+        CHECK(rd8(scratch + i) == 0x5a && rd8(scratch + 16 + bytes + i) == 0x5a);
+    }
+    // Original stream deleting destructor with flag zero retains caller storage;
+    // it owns no buffer. Original fixed-buffer destruction also retains the span.
+    uint32_t no_delete[] = {0};
+    CHECK(invoke(cpu, output ? 0x006497c8 : 0x0064b65f, io + (output ? 8 : 12), no_delete, 1) ==
+          io);
+    invoke(cpu, 0x0064aa1e, buffer);
+    CHECK(heap_owns(data) && heap_owns(buffer) && heap_owns(io));
+    CHECK(heap_free(wrapper) && heap_free(io) && heap_free(buffer) && heap_free(scratch) &&
+          heap_free(data));
+    CHECK(heap_stats().used_blocks == baseline.used_blocks &&
+          heap_stats().used_bytes == baseline.used_bytes);
+    ++cycles;
+}
+
+int main() {
+    sched_set_guest_thread(true);
+    mem_init();
+    CHECK(loader_load(nullptr));
+    CHECK(!std::strcmp(loader_exe_sha256(), PIN));
+    X86 cpu;
+    loader_init_context(&cpu);
+    uint32_t init[] = {1};
+    CHECK(invoke(&cpu, 0x00654670, 0, init, 1) == 1);
+    for (unsigned cycle = 0; cycle < 8 && !failures; ++cycle)
+        for (uint32_t bytes : {4u, 12u, 56u, 2048u})
+            for (bool output : {false, true})
+                trial(&cpu, bytes, output);
+    invoke(&cpu, 0x006546cd, 0);
+    std::printf("%u original fixed-stream checks, %u failures; %u span trials, %u calls\n", checks,
+                failures, cycles, calls);
+    mem_shutdown();
+    return failures ? 1 : 0;
+}
diff --git a/tests/native_received_checkpoint_tests.cpp b/tests/native_received_checkpoint_tests.cpp
new file mode 100644
index 0000000..a955bc7
--- /dev/null
+++ b/tests/native_received_checkpoint_tests.cpp
@@ -0,0 +1,206 @@
+#include "../native_received_checkpoint.h"
+#include "platform/os.h"
+#include <array>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <string>
+
+static unsigned checks, failures;
+#define CHECK(value)                                                           \
+  do {                                                                         \
+    ++checks;                                                                  \
+    if (!(value)) {                                                            \
+      ++failures;                                                              \
+      std::fprintf(stderr, "FAIL line %d: %s\n", __LINE__, #value);            \
+    }                                                                          \
+  } while (0)
+static constexpr const char *sample = "123456789";
+static constexpr uint32_t sample_crc = 0xcbf43926u;
+
+static bool write_file(const char *path, const char *data, size_t length) {
+  int fd = os_fd_open(path, OS_O_WRONLY | OS_O_CREAT | OS_O_TRUNC);
+  if (fd < 0)
+    return false;
+  bool ok = os_fd_write(fd, data, length) == int64_t(length);
+  return os_fd_close(fd) == 0 && ok;
+}
+static bool contents(const char *path, const char *expected) {
+  int fd = os_fd_open(path, OS_O_RDONLY);
+  if (fd < 0)
+    return false;
+  std::array<char, 64> buffer{};
+  int64_t count = os_fd_read(fd, buffer.data(), buffer.size());
+  bool ok = count == int64_t(std::strlen(expected)) &&
+            !std::memcmp(buffer.data(), expected, size_t(count));
+  return os_fd_close(fd) == 0 && ok;
+}
+static bool absent(const char *path) {
+  OsStat stat{};
+  return os_lstat(path, &stat) != 0;
+}
+struct Stages {
+  unsigned count = 0;
+  std::string last;
+  static int visit(const char *name, void *opaque) {
+    auto &s = *static_cast<Stages *>(opaque);
+    if (std::strstr(name, ".incoming-")) {
+      ++s.count;
+      s.last = name;
+    }
+    return 0;
+  }
+};
+
+int main(int argc, char **argv) {
+  if (argc == 3 && !std::strcmp(argv[1], "--interrupt")) {
+    majesty::ReceivedCheckpoint incoming;
+    if (!incoming.begin(argv[2], sample_crc) || !incoming.append(0, sample, 4))
+      return 1;
+    // Deliberately skip destructors after a partial write. A stale stage
+    // must neither replace the old checkpoint nor block the next transfer.
+    std::_Exit(7);
+  }
+  std::string pattern =
+      std::string(os_temp_dir()) + "/majesty-received-save-XXXXXX";
+  std::array<char, 1024> directory{};
+  if (pattern.size() >= directory.size())
+    return 1;
+  std::memcpy(directory.data(), pattern.c_str(), pattern.size() + 1);
+  CHECK(os_mkdtemp(directory.data()) == 0);
+  if (failures)
+    return 1;
+  std::string path = std::string(directory.data()) + "/Coop.GMP";
+  using majesty::ReceivedCheckpoint;
+  {
+    ReceivedCheckpoint incoming;
+    CHECK(incoming.begin(path.c_str(), sample_crc));
+    CHECK(absent(path.c_str()));
+    CHECK(incoming.append(0, sample, 4));
+    CHECK(incoming.append(1, sample + 4, 5));
+    CHECK(incoming.bytes() == 9 && incoming.active());
+    CHECK(incoming.finish());
+    CHECK(!incoming.active() && !*incoming.staging_path());
+    CHECK(contents(path.c_str(), sample));
+  }
+  // Existing longer files only change after a complete verified replacement.
+  CHECK(write_file(path.c_str(), "previous complete checkpoint", 28));
+  {
+    ReceivedCheckpoint incoming;
+    CHECK(incoming.begin(path.c_str(), sample_crc));
+    CHECK(incoming.append(0, sample, 9));
+    CHECK(contents(path.c_str(), "previous complete checkpoint"));
+    CHECK(incoming.finish() && contents(path.c_str(), sample));
+  }
+  for (unsigned fault = 0; fault < 7; ++fault) {
+    CHECK(write_file(path.c_str(), "old", 3));
+    ReceivedCheckpoint incoming;
+    CHECK(incoming.begin(path.c_str(), fault == 0 ? 1 : sample_crc));
+    const std::string stage = incoming.staging_path();
+    if (fault <= 2) {
+      CHECK(incoming.append(0, sample, 9));
+      if (fault == 1)
+        CHECK(write_file(stage.c_str(), "923456789", 9));
+      if (fault == 2)
+        CHECK(write_file(stage.c_str(), "1234", 4));
+      CHECK(!incoming.finish());
+    } else if (fault == 3)
+      CHECK(!incoming.append(1, sample, 9));
+    else if (fault == 4) {
+      CHECK(incoming.append(0, sample, 4));
+      CHECK(!incoming.append(0, sample + 4, 5));
+    } else if (fault == 5)
+      CHECK(!incoming.finish());
+    else {
+      std::array<char, ReceivedCheckpoint::max_packet + 1> large{};
+      CHECK(!incoming.append(0, large.data(), large.size()));
+    }
+    CHECK(!incoming.active() && absent(stage.c_str()));
+    CHECK(contents(path.c_str(), "old"));
+  }
+  {
+    ReceivedCheckpoint incoming;
+    CHECK(incoming.begin(path.c_str(), sample_crc));
+    std::string stage = incoming.staging_path();
+    CHECK(!incoming.begin(path.c_str(), 1));
+    CHECK(incoming.active() && stage == incoming.staging_path());
+    CHECK(incoming.append(0, sample, 9));
+    CHECK(incoming.finish() && contents(path.c_str(), sample));
+  }
+  {
+    std::string stage;
+    {
+      ReceivedCheckpoint incoming;
+      CHECK(incoming.begin(path.c_str(), sample_crc));
+      stage = incoming.staging_path();
+      CHECK(incoming.append(0, sample, 4));
+    }
+    CHECK(absent(stage.c_str()) && contents(path.c_str(), sample));
+  }
+  {
+    ReceivedCheckpoint incoming;
+    CHECK(!incoming.begin(directory.data(), sample_crc));
+    const std::string missing =
+        std::string(directory.data()) + "/missing/Coop.GMP";
+    CHECK(!incoming.begin(missing.c_str(), sample_crc));
+    std::string long_path(1024, 'x');
+    CHECK(!incoming.begin(long_path.c_str(), sample_crc));
+    CHECK(!incoming.begin(nullptr, sample_crc) &&
+          !incoming.begin("", sample_crc));
+  }
+  // A denied final rename does not leave a selected half-save.
+  const std::string blocked = std::string(directory.data()) + "/blocked.GMP";
+  {
+    ReceivedCheckpoint incoming;
+    CHECK(incoming.begin(blocked.c_str(), sample_crc));
+    const std::string stage = incoming.staging_path();
+    CHECK(incoming.append(0, sample, 9));
+    CHECK(os_mkdir(blocked.c_str()) == 0);
+    CHECK(!incoming.finish() && absent(stage.c_str()));
+    OsStat st{};
+    CHECK(os_lstat(blocked.c_str(), &st) == 0 && st.is_dir);
+    CHECK(os_rmdir(blocked.c_str()) == 0);
+  }
+  // Stream up to the actual disk limit using one fixed 4 KiB payload.
+  {
+    ReceivedCheckpoint incoming;
+    CHECK(incoming.begin(path.c_str(), 0));
+    std::array<char, ReceivedCheckpoint::max_packet> block{};
+    uint32_t packets = 0;
+    bool ok = true;
+    for (; uint64_t(packets) * block.size() < ReceivedCheckpoint::max_bytes;
+         ++packets)
+      if (!incoming.append(packets, block.data(), block.size())) {
+        ok = false;
+        break;
+      }
+    CHECK(ok && incoming.bytes() == ReceivedCheckpoint::max_bytes);
+    CHECK(!incoming.append(packets, block.data(), 1));
+    CHECK(!incoming.active() && contents(path.c_str(), sample));
+  }
+  {
+    const char *child[] = {argv[0], "--interrupt", path.c_str(), nullptr};
+    int64_t pid = -1;
+    int code = -1;
+    CHECK(os_spawn(child, &pid) == 0);
+    if (pid >= 0)
+      CHECK(os_wait(pid, &code) == 0 && code == 7);
+    CHECK(contents(path.c_str(), sample));
+    Stages stale;
+    CHECK(os_listdir(directory.data(), Stages::visit, &stale) == 0 &&
+          stale.count == 1);
+    std::string orphan = std::string(directory.data()) + "/" + stale.last;
+    ReceivedCheckpoint incoming;
+    CHECK(incoming.begin(path.c_str(), sample_crc));
+    CHECK(orphan != incoming.staging_path());
+    CHECK(incoming.append(0, sample, 9) && incoming.finish());
+    CHECK(contents(path.c_str(), sample) && !absent(orphan.c_str()));
+    CHECK(os_unlink(orphan.c_str()) == 0);
+  }
+  CHECK(os_unlink(path.c_str()) == 0);
+  CHECK(os_rmdir(directory.data()) == 0);
+  std::printf("received checkpoint: %u checks, %u failures; 4 KiB scratch "
+              "and packet limit\n",
+              checks, failures);
+  return failures ? 1 : 0;
+}
diff --git a/tests/native_received_packet_tests.cpp b/tests/native_received_packet_tests.cpp
new file mode 100644
index 0000000..175b224
--- /dev/null
+++ b/tests/native_received_packet_tests.cpp
@@ -0,0 +1,779 @@
+// Original player/packet ABI and outer receive queue/destruction ownership.
+// No entry point, world, simulation, window, audio or browser is started.
+#include "../kit/dx/com.h"
+#include "../kit/dx/directplay_transport.h"
+#include "../kit/dx/dx.h"
+#include "../kit/platform/os.h"
+#include "../kit/runtime/guest.h"
+#include "../kit/runtime/loader.h"
+#include "../kit/runtime/memory.h"
+#include "../kit/runtime/native_seam.h"
+#include "../kit/runtime/profile.h"
+#include "../kit/runtime/win32.h"
+#include "../native_received_transfer.h"
+#include "game_config.h"
+#include <array>
+#include <cstdio>
+#include <cstring>
+#include <deque>
+#include <string>
+#include <vector>
+
+static unsigned checks, failures, calls;
+static uint32_t manager, local_player, packet_reference, empty_source_count;
+static std::array<uint32_t, 3> source_players{}, source_counts{};
+static std::array<uint32_t, 3> source_wrappers{}, wrapper_counts{};
+static unsigned dispatched_packets;
+static unsigned original_file_dispatches;
+static unsigned original_queue_dispatches;
+static unsigned original_loss_dispatches;
+static bool vary_protocol = true;
+static std::string destination;
+static std::string read_source;
+static bool admit_write = true;
+static constexpr const char *name = "Native_Received_Fixture";
+static constexpr const char *pin =
+    "654365fd1bdefa6d7f2349d162869f255388fadcb1bb8db9f7db2f3468dd5542";
+#define CHECK(value)                                                           \
+  do {                                                                         \
+    ++checks;                                                                  \
+    if (!(value)) {                                                            \
+      ++failures;                                                              \
+      std::fprintf(stderr, "FAIL line %d: %s\n", __LINE__, #value);            \
+    }                                                                          \
+  } while (0)
+
+// Exercise the real DirectPlay provider/session seam without network I/O.
+// The fake only answers Hello/Create/Leave RPCs; it never supplies game data.
+using Bytes = std::vector<uint8_t>;
+static std::deque<Bytes> transport_input;
+static unsigned transport_closes;
+static void put(Bytes &bytes, uint32_t value) {
+  for (unsigned i = 0; i < 4; ++i)
+    bytes.push_back(uint8_t(value >> (i * 8)));
+}
+static uint32_t word(const uint8_t *bytes, size_t at) {
+  return uint32_t(bytes[at]) | uint32_t(bytes[at + 1]) << 8 |
+         uint32_t(bytes[at + 2]) << 16 | uint32_t(bytes[at + 3]) << 24;
+}
+static OsWebSocket *open_socket(const char *, const char *) {
+  return reinterpret_cast<OsWebSocket *>(1);
+}
+static int socket_state(const OsWebSocket *) { return OS_WS_OPEN; }
+static void socket_notify(OsWebSocket *, void (*)(uintptr_t), uintptr_t) {}
+static void close_socket(OsWebSocket *) {
+  ++transport_closes;
+  transport_input.clear();
+}
+static int send_socket(OsWebSocket *, const void *data, uint32_t length) {
+  const auto *bytes = static_cast<const uint8_t *>(data);
+  if (length < 20)
+    return -1;
+  const uint32_t op = word(bytes, 8), request = word(bytes, 12);
+  Bytes response;
+  for (uint32_t value : {0x31525044u, 1u, op | 0x80000000u, request, 0u})
+    put(response, value);
+  if (op == 3) {
+    response.insert(response.end(), bytes + 20, bytes + length);
+    put(response, 0); // no players needed for stopped packet/filename tests
+  } else if (op != 1 && op != 7)
+    return -1;
+  transport_input.push_back(std::move(response));
+  return 0;
+}
+static int receive_socket(OsWebSocket *, void *out, uint32_t cap,
+                          uint32_t *length) {
+  if (transport_input.empty()) {
+    *length = 0;
+    return 0;
+  }
+  *length = uint32_t(transport_input.front().size());
+  if (cap < *length)
+    return -2;
+  std::memcpy(out, transport_input.front().data(), *length);
+  transport_input.pop_front();
+  return 1;
+}
+
+static int resolve(const char *relative, int op, char *out, size_t cap) {
+  if ((op == WIN32_FILE_WRITE && !admit_write) ||
+      !std::strstr(relative, name) || destination.size() >= cap)
+    return 0;
+  const std::string &path =
+      op == WIN32_FILE_READ && !read_source.empty() ? read_source : destination;
+  if (path.size() >= cap)
+    return 0;
+  std::memcpy(out, path.c_str(), path.size() + 1);
+  return 1;
+}
+
+static uint32_t invoke(X86 *cpu, uint32_t address, uint32_t self,
+                       const uint32_t *args = nullptr, int count = 0) {
+  X86 before = *cpu;
+  const uint32_t fs = rd32(cpu->fs_base), depth = recomp_profile_depth();
+  cpu->r[R_ECX] = self;
+  ++calls;
+  auto result = guest_call_guarded(cpu, address, args, count);
+  CHECK(result.status == GuestCallGuardedStatus::Returned);
+  CHECK(cpu->r[R_ESP] == before.r[R_ESP] && cpu->eip == before.eip);
+  CHECK(cpu->r[R_EBX] == before.r[R_EBX] && cpu->r[R_ESI] == before.r[R_ESI] &&
+        cpu->r[R_EDI] == before.r[R_EDI] && cpu->r[R_EBP] == before.r[R_EBP]);
+  CHECK(rd32(cpu->fs_base) == fs && recomp_callback_depth() == 0 &&
+        recomp_profile_depth() == depth);
+  *cpu = before;
+  return result.eax;
+}
+
+static bool contents(const char *expected) {
+  const int fd = os_fd_open(destination.c_str(), OS_O_RDONLY);
+  if (fd < 0)
+    return false;
+  std::array<char, 32> bytes{};
+  const int64_t count = os_fd_read(fd, bytes.data(), bytes.size());
+  const bool same = count == int64_t(std::strlen(expected)) &&
+                    !std::memcmp(bytes.data(), expected, size_t(count));
+  return os_fd_close(fd) == 0 && same;
+}
+
+static uint32_t original_alloc(X86 *cpu, uint32_t size) {
+  const uint32_t args[] = {size};
+  const uint32_t address = invoke(cpu, 0x0064c616, 0, args, 1);
+  CHECK(address && gm_valid(address, size));
+  return address;
+}
+
+static void original_players(X86 *cpu, uint32_t scratch) {
+  // Construct actual low-level DirectPlay players, including their original
+  // ID getter and reference-counted local wrapper. No fixture vtable or ID
+  // getter substitutes for the pinned engine's methods.
+  std::memset(g_mem + scratch, 0, 64);
+  gm_put_str(scratch + 16, "Owned peer", 32);
+  for (unsigned i = 0; i < source_players.size(); ++i) {
+    source_players[i] = original_alloc(cpu, 0x80);
+    source_counts[i] = original_alloc(cpu, 4);
+    wr32(source_counts[i], 1);
+    const uint32_t args[] = {0, scratch, i == 2 ? 0u : 7u + i, scratch + 16, 0,
+                             0, 0};
+    CHECK(invoke(cpu, 0x00592780, source_players[i], args, 7) ==
+          source_players[i]);
+    CHECK(rd32(source_players[i]) == 0x006895e0);
+    CHECK(invoke(cpu, rd32(rd32(source_players[i]) + 0x10),
+                 source_players[i]) == args[2]);
+  }
+  manager = invoke(cpu, 0x004ba7e0, 0);
+  CHECK(manager && gm_valid(manager, 0x4f8));
+  CHECK(rd32(manager + 0x50) == 0 && rd32(rd32(manager + 0x54)) == 1);
+  for (unsigned i = 0; i < source_players.size(); ++i) {
+    source_wrappers[i] = original_alloc(cpu, 0x18);
+    wrapper_counts[i] = i == 0 ? rd32(manager + 0x54) : original_alloc(cpu, 4);
+    wr32(wrapper_counts[i], 1);
+    wr32(scratch, source_players[i]);
+    wr32(scratch + 4, source_counts[i]);
+    const uint32_t wrap[] = {scratch, 0};
+    CHECK(invoke(cpu, 0x0058e0b0, source_wrappers[i], wrap, 2) ==
+          source_wrappers[i]);
+    CHECK(rd32(source_wrappers[i]) == 0x00689424);
+    CHECK(rd32(source_counts[i]) == 2);
+  }
+  empty_source_count = original_alloc(cpu, 4);
+  wr32(empty_source_count, 1);
+  local_player = source_wrappers[0];
+  // Adopt the wrapper into the real manager's empty local-player slot. Its
+  // existing owning count stays intact and is checked after every dispatch.
+  wr32(manager + 0x50, local_player);
+}
+
+static void packet(X86 *cpu, uint32_t body, uint32_t type, uint32_t length,
+                   uint32_t sender = 7, bool rejected_dispatch = false) {
+  const uint32_t bytes[] = {0x54};
+  const uint32_t p = invoke(cpu, 0x0064c616, 0, bytes, 1);
+  CHECK(p && gm_valid(p, 0x54));
+  if (!p)
+    return;
+  // The protocol byte also XOR-encodes the payload. Construct it with the
+  // manager's actual key so its later overwrite preserves payload decoding.
+  static constexpr uint32_t protocols[] = {0x31, 0, 8};
+  const uint32_t protocol =
+      vary_protocol ? protocols[dispatched_packets % 3] : 0x31;
+  ++dispatched_packets;
+  const uint32_t args[] = {type, body, length, protocol};
+  CHECK(invoke(cpu, 0x00588300, p, args, 4) == p);
+  CHECK(rd32(p) == 0x00689190);
+  const uint32_t ref = packet_reference;
+  const unsigned peer = sender == 7 || !sender ? 0 : sender == 8 ? 1 : 2;
+  if (sender) {
+    const unsigned i = sender == 7 ? 0 : sender == 8 ? 1 : 2;
+    wr32(ref, source_players[i]);
+    wr32(ref + 4, source_counts[i]);
+    const uint32_t source[] = {ref};
+    invoke(cpu, rd32(rd32(p) + 4), p, source, 1);
+    CHECK(invoke(cpu, rd32(rd32(p) + 8), p) == p + 4);
+    CHECK(rd32(p + 4) == source_players[i]);
+    CHECK(rd32(source_counts[i]) == 3);
+  }
+  // Original +c binds the high-level peer AND replaces the low-level source
+  // with that wrapper's underlying reference. Use the actual sending peer.
+  wr32(ref, source_wrappers[peer]);
+  wr32(ref + 4, wrapper_counts[peer]);
+  const uint32_t forwarder[] = {ref};
+  invoke(cpu, rd32(rd32(p) + 0xc), p, forwarder, 1);
+  CHECK(rd32(wrapper_counts[peer]) == 2);
+  if (!sender) {
+    wr32(ref, 0);
+    wr32(ref + 4, empty_source_count);
+    const uint32_t empty[] = {ref};
+    invoke(cpu, rd32(rd32(p) + 4), p, empty, 1);
+  }
+  CHECK(rd32(p + 4) == (sender ? source_players[peer] : 0));
+  if (sender)
+    CHECK(invoke(cpu, rd32(rd32(rd32(p + 4)) + 0x10), rd32(p + 4)) ==
+          (peer == 2 ? 0u : 7u + peer));
+  // The real dispatcher rewrites packet+48 from this field. Change it on
+  // consecutive same-peer packets, including zero and another peer's ID.
+  wr32(manager + 0x4f0, protocol);
+  // Prove the original dispatcher restores the key before the receiver;
+  // bytes were already encoded by the constructor and stay untouched here.
+  wr32(p + 0x48, 0xfe);
+  X86 probe = *cpu;
+  probe.r[R_ESP] -= 8;
+  wr32(probe.r[R_ESP], cpu->eip);
+  wr32(probe.r[R_ESP] + 4, p);
+  const bool blocked = majesty_received_transfer_blocks_dispatch(&probe);
+  bool destroyed_by_queue = false;
+  const uint32_t world = rd32(0x0071c68c), phase = rd32(0x006d7670);
+  if (rejected_dispatch) {
+    CHECK(blocked);
+    // Never start an uninitialized world if an earlier rejection assertion
+    // failed. A gate failure is a test failure, not permission for gameplay.
+  }
+  if (!rejected_dispatch || blocked) {
+    // Enqueue through the original deque's push_back and drain through the
+    // real outer receiver. It calls 00454560 and owns the deleting destructor;
+    // never inspect or delete the packet after that call returns.
+    CHECK(rd32(manager + 0x2c) == 0);
+    wr32(ref, p);
+    const uint32_t enqueue[] = {ref};
+    invoke(cpu, 0x0044bc50, manager, enqueue, 1);
+    CHECK(rd32(manager + 0x2c) == 1);
+    invoke(cpu, 0x00456670, 0);
+    CHECK(rd32(manager + 0x2c) == 0);
+    ++original_queue_dispatches;
+    destroyed_by_queue = true;
+    if (!blocked) {
+      if (type >= 0x16 && type <= 0x18)
+        ++original_file_dispatches;
+    }
+  }
+  CHECK(rd32(0x0071c68c) == world && rd32(0x006d7670) == phase);
+  if (!destroyed_by_queue) {
+    // Only a failed gate assertion can leave a packet with the fixture.
+    const uint32_t destroy[] = {1};
+    invoke(cpu, rd32(rd32(p)), p, destroy, 1);
+  }
+  CHECK(rd32(rd32(manager + 0x54)) == 1);
+  CHECK(rd32(empty_source_count) == 1);
+  for (unsigned i = 0; i < source_counts.size(); ++i) {
+    CHECK(rd32(source_counts[i]) == 2);
+    CHECK(rd32(wrapper_counts[i]) == 1);
+  }
+}
+
+static void loss_notification(X86 *cpu, uint32_t body) {
+  // The original system-message converter turns DPMSG_SESSIONLOST into a
+  // category-3/kind-2 notification. The original handler logs but does not
+  // exit the lobby. Its reference cleanup and outer deleting destructor must
+  // still run after rejection, without swallowing the deferred lobby flag.
+  wr32(body, 0x31);
+  const uint32_t args[] = {body};
+  const uint32_t p = invoke(cpu, 0x005934c0, 0, args, 1);
+  CHECK(p && gm_valid(p, 0x38));
+  if (!p)
+    return;
+  CHECK(rd32(p) == 0x00689308);
+  wr32(packet_reference, local_player);
+  wr32(packet_reference + 4, wrapper_counts[0]);
+  const uint32_t forwarder[] = {packet_reference};
+  invoke(cpu, rd32(rd32(p) + 0xc), p, forwarder, 1);
+  X86 probe = *cpu;
+  probe.r[R_ESP] -= 8;
+  wr32(probe.r[R_ESP], cpu->eip);
+  wr32(probe.r[R_ESP] + 4, p);
+  CHECK(!majesty_received_transfer_blocks_dispatch(&probe));
+  CHECK(rd32(p) == 0x00689308);
+  const uint32_t exit_flag = rd32(RECOMP_GLOBAL_MULTIPLAYER_LOBBY_EXIT_ADDR);
+  const uint32_t world = rd32(0x0071c68c), phase = rd32(0x006d7670);
+  CHECK(rd32(manager + 0x2c) == 0);
+  wr32(packet_reference, p);
+  const uint32_t enqueue[] = {packet_reference};
+  invoke(cpu, 0x0044bc50, manager, enqueue, 1);
+  CHECK(rd32(manager + 0x2c) == 1);
+  invoke(cpu, 0x00456670, 0);
+  CHECK(rd32(manager + 0x2c) == 0);
+  ++original_queue_dispatches;
+  ++original_loss_dispatches;
+  CHECK(rd32(RECOMP_GLOBAL_MULTIPLAYER_LOBBY_EXIT_ADDR) == exit_flag);
+  CHECK(rd32(0x0071c68c) == world && rd32(0x006d7670) == phase);
+  for (unsigned i = 0; i < source_counts.size(); ++i) {
+    CHECK(rd32(source_counts[i]) == 2);
+    CHECK(rd32(wrapper_counts[i]) == 1);
+  }
+}
+
+static uint32_t com_call(X86 *cpu, uint32_t dp, unsigned slot, uint32_t a = 0,
+                         uint32_t b = 0, unsigned extra = 0) {
+  const uint32_t args[] = {dp, a, b};
+  return invoke(cpu, rd32(rd32(dp) + slot * 4), 0, args, int(extra + 1));
+}
+static uint64_t join(X86 *cpu, uint32_t dp, uint32_t desc) {
+  // This stopped fixture reopens COM directly. Clear the previous exit request
+  // as setup; it does not execute or qualify the modal lobby's leave branch.
+  wr32(RECOMP_GLOBAL_MULTIPLAYER_LOBBY_EXIT_ADDR, 0);
+  CHECK(com_call(cpu, dp, 24, desc, 2, 2) == 0);
+  const uint64_t epoch = recomp_network_session_epoch();
+  CHECK(epoch != 0);
+  return epoch;
+}
+static void relay_loss(X86 *cpu, uint32_t dp, uint32_t body) {
+  Bytes event;
+  for (uint32_t value : {0x31525044u, 1u, 107u, 0u, 0u})
+    put(event, value);
+  transport_input.push_back(std::move(event));
+  const uint32_t count = body + 7000;
+  CHECK(com_call(cpu, dp, 17, 0, count, 2) == 0);
+  CHECK(rd32(count) == 1);
+  CHECK(recomp_network_session_epoch() == 0);
+  const unsigned closed = transport_closes;
+  majesty_received_transfer_poll();
+  CHECK(transport_closes == closed + 1);
+  CHECK(rd32(RECOMP_GLOBAL_MULTIPLAYER_LOBBY_EXIT_ADDR) == 1);
+  // Read the preserved real system notification before converting/dispatching
+  // it. The original outer queue owns the resulting guest notification.
+  wr32(count, 256);
+  const uint32_t args[] = {dp, body + 7010, body + 7014, 0, body, count};
+  CHECK(invoke(cpu, rd32(rd32(dp) + 25 * 4), 0, args, 6) == 0);
+  CHECK(rd32(body) == 0x31 && rd32(count) == 4);
+  loss_notification(cpu, body);
+  majesty_received_transfer_poll();
+  CHECK(transport_closes == closed + 1);
+  CHECK(rd32(RECOMP_GLOBAL_MULTIPLAYER_LOBBY_EXIT_ADDR) == 1);
+  CHECK(invoke(cpu, rd32(rd32(dp) + 25 * 4), 0, args, 6) == 0x88770136u);
+}
+static void begin_body(uint32_t body, uint32_t crc = 0xcbf43926u) {
+  std::memset(g_mem + body, 0, 256);
+  wr32(body, crc);
+  for (size_t i = 0; i < std::strlen(name); ++i)
+    wr16(body + 4 + uint32_t(i * 2), uint16_t(name[i]));
+}
+static void begin(X86 *cpu, uint32_t body, uint32_t crc = 0xcbf43926u) {
+  begin_body(body, crc);
+  packet(cpu, body, 0x16, 164);
+}
+static void chunk(X86 *cpu, uint32_t body, uint32_t sequence, const char *text,
+                  size_t length, uint32_t sender = 7) {
+  wr32(body, sequence);
+  std::memcpy(g_mem + body + 4, text, length);
+  packet(cpu, body, 0x17, uint32_t(length + 4), sender);
+}
+static void data(X86 *cpu, uint32_t body, uint32_t sequence = 0,
+                 uint32_t sender = 7) {
+  chunk(cpu, body, sequence, "123456789", 9, sender);
+}
+static void old_file(const char *text = "old") {
+  const int fd =
+      os_fd_open(destination.c_str(), OS_O_WRONLY | OS_O_CREAT | OS_O_TRUNC);
+  CHECK(fd >= 0);
+  if (fd >= 0) {
+    CHECK(os_fd_write(fd, text, std::strlen(text)) ==
+          int64_t(std::strlen(text)));
+    CHECK(os_fd_close(fd) == 0);
+  }
+}
+
+static uint32_t original_crc(X86 *cpu, uint32_t body) {
+  // Use the pinned file CRC routine as an independent oracle, with the real
+  // original filename string and filesystem. It never loads a game world.
+  const char *filename = "Native_Received_Fixture.GMP";
+  const uint32_t owner = heap_alloc(16, true);
+  CHECK(owner != 0);
+  if (!owner)
+    return 0;
+  gm_put_str(body, filename, 128);
+  const uint32_t make[] = {body, uint32_t(std::strlen(filename))};
+  invoke(cpu, 0x004e3590, owner, make, 2);
+  wr32(owner + 12, 0xffffffffu);
+  const uint32_t args[] = {owner, owner + 12};
+  const uint32_t crc = invoke(cpu, 0x00512b90, 0, args, 2);
+  CHECK(rd32(owner + 12) == 0);
+  invoke(cpu, 0x004e3820, owner);
+  CHECK(heap_free(owner));
+  return crc;
+}
+
+static void real_checkpoint(X86 *cpu, uint32_t dp, uint32_t desc, uint32_t body,
+                            const char *source, const char *output) {
+  // The driver copies a hash-verified owned save into a fresh build fixture.
+  // Export only alongside that copy, under an exclusive, fixed output name.
+  const std::string input(source), target(output);
+  const size_t slash = input.rfind('/');
+  const bool owned =
+      input.find("/build/actor-arrival-fixture-received-checkpoint-") !=
+          std::string::npos &&
+      slash != std::string::npos && input.substr(slash) == "/Source.GMP" &&
+      target == input.substr(0, slash) + "/Received.GMP";
+  CHECK(owned);
+  if (!owned)
+    return;
+  OsStat before{};
+  CHECK(os_lstat(source, &before) == 0 && before.is_regular &&
+        !before.is_symlink && before.size > 0 &&
+        before.size <= 64 * 1024 * 1024);
+  if (failures)
+    return;
+  read_source = source;
+  const uint32_t crc = original_crc(cpu, body);
+  read_source.clear();
+  if (failures)
+    return;
+  CHECK(com_call(cpu, dp, 4) == 0);
+  join(cpu, dp, desc);
+  old_file();
+  begin(cpu, body, crc);
+  const int in = os_fd_open(source, OS_O_RDONLY);
+  CHECK(in >= 0);
+  uint64_t total = 0;
+  uint32_t sequence = 0;
+  if (in >= 0) {
+    for (;;) {
+      const int64_t n = os_fd_read(in, g_mem + body + 4, 4096);
+      CHECK(n >= 0);
+      if (n <= 0)
+        break;
+      total += uint64_t(n);
+      CHECK(total <= before.size);
+      wr32(body, sequence++);
+      packet(cpu, body, 0x17, uint32_t(n + 4));
+      CHECK(contents("old"));
+      if (failures)
+        break;
+    }
+    CHECK(os_fd_close(in) == 0);
+  }
+  CHECK(total == before.size);
+  packet(cpu, 0, 0x18, 0);
+  CHECK(original_crc(cpu, body) == crc);
+  OsStat after{};
+  CHECK(os_lstat(source, &after) == 0 && before.size == after.size &&
+        before.mtime == after.mtime && before.ctime == after.ctime);
+  CHECK(os_lstat(destination.c_str(), &after) == 0 && after.size == total);
+  if (failures)
+    return;
+  const int received = os_fd_open(destination.c_str(), OS_O_RDONLY);
+  const int out = os_fd_open(output, OS_O_WRONLY | OS_O_CREAT | OS_O_EXCL);
+  CHECK(received >= 0 && out >= 0);
+  std::array<uint8_t, 4096> bytes{};
+  uint64_t copied = 0;
+  if (received >= 0 && out >= 0) {
+    for (;;) {
+      const int64_t n = os_fd_read(received, bytes.data(), bytes.size());
+      CHECK(n >= 0);
+      if (n <= 0)
+        break;
+      CHECK(os_fd_write(out, bytes.data(), size_t(n)) == n);
+      copied += uint64_t(n);
+    }
+    CHECK(os_fd_fsync(out) == 0);
+  }
+  if (received >= 0)
+    CHECK(os_fd_close(received) == 0);
+  if (out >= 0)
+    CHECK(os_fd_close(out) == 0);
+  CHECK(copied == total);
+  std::printf("real checkpoint: bytes=%llu packets=%u original-crc=%08x\n",
+              static_cast<unsigned long long>(total), sequence, crc);
+}
+
+int main() {
+  std::string pattern =
+      std::string(os_temp_dir()) + "/majesty-packet-receive-XXXXXX";
+  std::array<char, 1024> folder{};
+  if (pattern.size() >= folder.size())
+    return 1;
+  std::memcpy(folder.data(), pattern.c_str(), pattern.size() + 1);
+  CHECK(os_mkdtemp(folder.data()) == 0);
+  if (failures)
+    return 1;
+  destination = std::string(folder.data()) + "/Native_Received_Fixture.GMP";
+  old_file();
+  sched_set_guest_thread(true);
+  mem_init();
+  CHECK(loader_load(nullptr));
+  CHECK(!std::strcmp(loader_exe_sha256(), pin));
+  directplay_register(); // Register the provider only; no graphics/audio
+                         // startup.
+  win32_set_file_ops(resolve, nullptr);
+  X86 cpu;
+  loader_init_context(&cpu);
+  const uint32_t init[] = {1};
+  CHECK(invoke(&cpu, 0x00654670, 0, init, 1) == 1);
+  invoke(&cpu, 0x00536d40, 0);
+  CHECK(rd32(0x006d8f18) && gm_valid(rd32(0x006d8f18), 4));
+  CHECK(majesty_received_transfer_enabled());
+  const DirectPlayTransport transport = {open_socket,   socket_state,
+                                         send_socket,   receive_socket,
+                                         socket_notify, close_socket};
+  CHECK(directplay_set_transport(&transport));
+  os_setenv("RECOMP_NETWORK_URL", "ws://localhost/owned-native-fixture");
+  os_setenv("RECOMP_NETWORK_MANIFEST", "owned-native-packet-contract");
+  const uint32_t dp = com_view(com_new(K_DIRECTPLAY), IF_DIRECTPLAY4A);
+  uint32_t desc = heap_alloc(256, true), token = heap_alloc(16, false);
+  const uint8_t guid[] = {0xe0, 0x5e, 0xe9, 0x36, 0x77, 0x85, 0xcf, 0x11,
+                          0x96, 0x0c, 0,    0x80, 0xc7, 0x53, 0x4e, 0x82};
+  CHECK(dp && desc && token);
+  if (dp && desc && token) {
+    std::memcpy(g_mem + token, guid, 16);
+    CHECK(com_call(&cpu, dp, 38, token, 0, 2) == 0);
+    wr32(desc, 80);
+    wr32(desc + 40, 4);
+    wr32(desc + 48, desc + 80);
+    gm_put_str(desc + 80, "Owned native checkpoint", 64);
+    join(&cpu, dp, desc);
+  }
+  uint32_t body = heap_alloc(8192, true);
+  packet_reference = heap_alloc(8, true);
+  CHECK(body && packet_reference);
+  if (body && !failures) {
+    original_players(&cpu, body);
+    begin(&cpu, body);
+    CHECK(contents("old"));
+    loss_notification(&cpu, body);
+    data(&cpu, body);
+    CHECK(contents("old"));
+    packet(&cpu, 0, 0x18, 0);
+    CHECK(contents("123456789"));
+    // A wrong sequence or corrupt final CRC loses this session, retains the
+    // previous save and consumes already-decoded game-start packets safely.
+    for (unsigned fault = 0; fault < 11; ++fault) {
+      vary_protocol = fault != 2 && fault != 8;
+      CHECK(com_call(&cpu, dp, 4) == 0);
+      const uint64_t epoch = join(&cpu, dp, desc);
+      old_file();
+      begin(&cpu, body, fault == 1 ? 1 : 0xcbf43926u);
+      CHECK(contents("old"));
+      const unsigned closed = transport_closes;
+      if (fault == 0)
+        data(&cpu, body, 1);
+      else if (fault == 1) {
+        data(&cpu, body);
+        packet(&cpu, 0, 0x18, 0);
+      } else if (fault == 2)
+        data(&cpu, body, 0, 8);
+      else if (fault == 3)
+        begin(&cpu, body);
+      else if (fault == 4)
+        packet(&cpu, 0, 3, 0, 7, true);
+      else if (fault == 5)
+        packet(&cpu, 0, 0x18, 0);
+      else if (fault == 6) {
+        data(&cpu, body);
+        packet(&cpu, body, 0x18, 13);
+      } else if (fault == 7) {
+        data(&cpu, body);
+        data(&cpu, body); // duplicate sequence zero
+      } else if (fault == 8) {
+        data(&cpu, body);
+        packet(&cpu, 0, 0x18, 0, 8);
+      } else if (fault == 9) {
+        wr32(body, 0);
+        std::memset(g_mem + body + 4, 0xff, 4097);
+        packet(&cpu, body, 0x17, 4101);
+      } else {
+        wr32(body, 0);
+        packet(&cpu, body, 0x17, 4); // empty DATA
+      }
+      CHECK(recomp_network_session_epoch() == 0);
+      CHECK(rd32(RECOMP_GLOBAL_MULTIPLAYER_LOBBY_EXIT_ADDR) == 1);
+      CHECK(transport_closes == closed + 1);
+      CHECK(contents("old"));
+      packet(&cpu, 0, 3, 0, 7, true);
+      loss_notification(&cpu, body);
+      CHECK(recomp_network_reject_session(epoch) == 1);
+      CHECK(transport_closes == closed + 1);
+    }
+    vary_protocol = true;
+    for (unsigned fault = 0; fault < 8; ++fault) {
+      CHECK(com_call(&cpu, dp, 4) == 0);
+      const uint64_t epoch = join(&cpu, dp, desc);
+      old_file();
+      const unsigned closed = transport_closes;
+      begin_body(body);
+      if (fault == 0)
+        data(&cpu, body); // DATA before BEGIN
+      else if (fault == 1)
+        packet(&cpu, 0, 0x18, 0); // END before BEGIN
+      else if (fault == 2)
+        packet(&cpu, body, 0x16, 163);
+      else if (fault == 3) {
+        for (unsigned i = 0; i < 80; ++i)
+          wr16(body + 4 + i * 2, 'A');
+        packet(&cpu, body, 0x16, 164); // no bounded terminator
+      } else if (fault == 4) {
+        wr16(body + 4, 0);
+        packet(&cpu, body, 0x16, 164);
+      } else if (fault == 5) {
+        admit_write = false;
+        packet(&cpu, body, 0x16, 164);
+        admit_write = true;
+      } else if (fault == 6)
+        packet(&cpu, body, 0x16, 164, 0);
+      else
+        packet(&cpu, body, 0x16, 164, 9); // original source with ID zero
+      CHECK(recomp_network_session_epoch() == 0);
+      CHECK(rd32(RECOMP_GLOBAL_MULTIPLAYER_LOBBY_EXIT_ADDR) == 1);
+      CHECK(transport_closes == closed + 1);
+      CHECK(contents("old"));
+      packet(&cpu, 0, 3, 0, 7, true);
+      loss_notification(&cpu, body);
+      CHECK(recomp_network_reject_session(epoch) == 1);
+      CHECK(transport_closes == closed + 1);
+    }
+    CHECK(com_call(&cpu, dp, 4) == 0);
+    join(&cpu, dp, desc);
+    begin(&cpu, body);
+    data(&cpu, body);
+    packet(&cpu, 0, 0x18, 0);
+    CHECK(contents("123456789"));
+    // A missing destination remains absent until verified END. Two DATA
+    // packets publish the same CRC/content without retaining a whole file.
+    CHECK(os_unlink(destination.c_str()) == 0);
+    begin(&cpu, body);
+    OsStat st{};
+    CHECK(os_lstat(destination.c_str(), &st) != 0);
+    chunk(&cpu, body, 0, "1234", 4);
+    chunk(&cpu, body, 1, "56789", 5);
+    CHECK(os_lstat(destination.c_str(), &st) != 0);
+    packet(&cpu, 0, 0x18, 0);
+    CHECK(contents("123456789"));
+    const char *longer = "old-file-with-tail";
+    old_file(longer);
+    begin(&cpu, body);
+    CHECK(contents(longer));
+    data(&cpu, body);
+    CHECK(contents(longer));
+    packet(&cpu, 0, 0x18, 0);
+    CHECK(contents("123456789"));
+    // Relay loss must request original lobby exit both during a staged file
+    // and after END has committed it (there is no active writer then).
+    for (unsigned completed = 0; completed < 2; ++completed) {
+      CHECK(com_call(&cpu, dp, 4) == 0);
+      join(&cpu, dp, desc);
+      old_file();
+      begin(&cpu, body);
+      data(&cpu, body);
+      if (completed)
+        packet(&cpu, 0, 0x18, 0);
+      relay_loss(&cpu, dp, body);
+      CHECK(contents(completed ? "123456789" : "old"));
+      packet(&cpu, 0, 3, 0, 7, true);
+    }
+    // Normal Close after publication is not a rejected session and must not
+    // request lobby exit. An old lost epoch cannot reject the replacement.
+    CHECK(com_call(&cpu, dp, 4) == 0);
+    const uint64_t recovered_epoch = join(&cpu, dp, desc);
+    begin(&cpu, body);
+    data(&cpu, body);
+    CHECK(!recomp_network_reject_session(recovered_epoch - 1));
+    CHECK(rd32(RECOMP_GLOBAL_MULTIPLAYER_LOBBY_EXIT_ADDR) == 0);
+    packet(&cpu, 0, 0x18, 0);
+    CHECK(com_call(&cpu, dp, 4) == 0);
+    majesty_received_transfer_poll();
+    CHECK(rd32(RECOMP_GLOBAL_MULTIPLAYER_LOBBY_EXIT_ADDR) == 0);
+    CHECK(contents("123456789"));
+    join(&cpu, dp, desc);
+    // Explicit disconnect abandons a stage on the next native menu/frame poll.
+    old_file();
+    begin(&cpu, body);
+    data(&cpu, body);
+    CHECK(com_call(&cpu, dp, 4) == 0);
+    majesty_received_transfer_poll();
+    CHECK(contents("old"));
+    CHECK(rd32(RECOMP_GLOBAL_MULTIPLAYER_LOBBY_EXIT_ADDR) == 0);
+    packet(&cpu, 0, 3, 0, 7, true);
+    loss_notification(&cpu, body);
+    join(&cpu, dp, desc);
+    begin(&cpu, body);
+    data(&cpu, body);
+    packet(&cpu, 0, 0x18, 0);
+    CHECK(contents("123456789"));
+  }
+  const char *source = recomp_env("TEST_RECEIVED_SOURCE");
+  const char *output = recomp_env("TEST_RECEIVED_OUTPUT");
+  CHECK((source != nullptr) == (output != nullptr));
+  if (body && !failures && source && output)
+    real_checkpoint(&cpu, dp, desc, body, source, output);
+  if (dp) {
+    CHECK(com_call(&cpu, dp, 4) == 0);
+    CHECK(com_call(&cpu, dp, 2) == 0);
+  }
+  CHECK(directplay_set_transport(nullptr));
+  if (local_player) {
+    // Execute the two original cleanup components used by the lobby leave
+    // branch after all packets have drained. The stopped fixture does not run
+    // the modal loop or qualify a live room/match exit. Never inspect the freed
+    // manager, local wrapper or its old reference counter afterward.
+    CHECK(rd32(manager + 0x2c) == 0);
+    const uint32_t world = rd32(0x0071c68c), phase = rd32(0x006d7670);
+    invoke(&cpu, 0x004bbad0, manager);
+    CHECK(rd32(manager + 0x70) == 0);
+    invoke(&cpu, 0x004ba850, 0);
+    manager = invoke(&cpu, 0x004ba7e0, 0);
+    CHECK(manager && gm_valid(manager, 0x4f8));
+    CHECK(rd32(manager + 0x50) == 0 && rd32(rd32(manager + 0x54)) == 1);
+    CHECK(rd32(manager + 0x70) == 0 && rd32(manager + 0x2c) == 0);
+    CHECK(rd32(source_counts[0]) == 1);
+    CHECK(rd32(0x0071c68c) == world && rd32(0x006d7670) == phase);
+    const uint32_t destroy[] = {1};
+    for (unsigned i = 0; i < source_players.size(); ++i) {
+      if (i != 0)
+        invoke(&cpu, rd32(rd32(source_wrappers[i])), source_wrappers[i],
+               destroy, 1);
+      CHECK(rd32(source_counts[i]) == 1);
+      invoke(&cpu, rd32(rd32(source_players[i])), source_players[i], destroy,
+             1);
+      const uint32_t release[] = {source_counts[i]};
+      invoke(&cpu, 0x00645bc0, 0, release, 1);
+      if (i != 0) {
+        const uint32_t wrapper_release[] = {wrapper_counts[i]};
+        invoke(&cpu, 0x00645bc0, 0, wrapper_release, 1);
+      }
+    }
+    const uint32_t empty_release[] = {empty_source_count};
+    invoke(&cpu, 0x00645bc0, 0, empty_release, 1);
+  }
+  if (body)
+    CHECK(heap_free(body));
+  if (packet_reference)
+    CHECK(heap_free(packet_reference));
+  if (desc)
+    CHECK(heap_free(desc));
+  if (token)
+    CHECK(heap_free(token));
+  invoke(&cpu, 0x00501a30, 0);
+  win32_set_file_ops(nullptr, nullptr);
+  mem_shutdown();
+  CHECK(os_unlink(destination.c_str()) == 0);
+  CHECK(os_rmdir(folder.data()) == 0);
+  std::printf(
+      "original receive packets: %u checks, %u failures; %u guarded calls\n",
+      checks, failures, calls);
+  std::printf("original FILE dispatch: %u packets; source IDs=7,8,0; "
+              "protocol keys=49,0,8\n",
+              original_file_dispatches);
+  std::printf("original outer receive queue: %u packets\n",
+              original_queue_dispatches);
+  std::printf("original system loss dispatch: %u packets; modal lobby exit "
+              "unexecuted\n",
+              original_loss_dispatches);
+  std::printf("original lobby cleanup components: drained manager reset; local "
+              "source released\n");
+  return failures ? 1 : 0;
+}
