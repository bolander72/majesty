+  recomp_network_session_v1 party{};
+  party.host = 1; party.local_player = 11;
+  party.player_count = 2; party.players[0] = 11; party.players[1] = 27;
+  const auto label = request.label();
+  check(majesty::coop_lobby_resume_start_ready(request, party, label), "host with partner");
+  party.player_count = 1;
+  check(!majesty::coop_lobby_resume_start_ready(request, party, label), "absent partner blocks loading");
+  party.player_count = 2;
+  check(!majesty::coop_lobby_resume_start_ready(request, party, "Other_Save"), "wrong selected file");
+  party.local_player = 99;
+  check(!majesty::coop_lobby_resume_start_ready(request, party, label), "local member absent");
+  party.host = 0; party.local_player = 27;
+  check(majesty::coop_lobby_resume_start_ready(request, party, label), "guest with host");
+  // The frontend can save and invite players to Wardens (chapter 4). Its
+  // checkpoint must pass the same native admission policy as older chapters.
+  for (unsigned chapter = 1; chapter <= 4; ++chapter) {
+    auto wire = token;
+    wire[3] = static_cast<char>('0' + chapter);
+    majesty::CoopLobbyResume saved;
+    check(majesty::coop_lobby_resume_parse(wire, saved) && saved.chapter == chapter,
+          "supported chapter checkpoint parses");
+    party.host = 1; party.local_player = 11;
+    check(majesty::coop_lobby_resume_start_ready(saved, party, saved.label()),
+          "supported chapter host can resume with partner");
+    party.host = 0; party.local_player = 27;
+    check(majesty::coop_lobby_resume_start_ready(saved, party, saved.label()),
+          "supported chapter guest can resume with host");
+  }
+  for (char chapter : {'0', '5'}) {
+    auto wire = token;
+    wire[3] = chapter;
+    majesty::CoopLobbyResume invalid = request;
+    check(!majesty::coop_lobby_resume_parse(wire, invalid) && invalid.chapter == 0,
+          "unsupported chapter wire is refused and clears output");
+  }
+  party.players[1] = 11;
+  check(!majesty::coop_lobby_resume_start_ready(request, party, label), "duplicate roster");
+  party.players[0] = 27; party.players[1] = 11;
+  check(!majesty::coop_lobby_resume_start_ready(request, party, label), "unsorted roster");
+  party.players[0] = 11; party.players[1] = 27;
+  party.player_count = 5;
+  check(!majesty::coop_lobby_resume_start_ready(request, party, label), "oversized roster");
+  party.player_count = 2;
+  for (unsigned field = 0; field < 6; ++field) {
+    auto invalid = request;
+    switch (field) {
+    case 0: invalid.record.status = majesty::CoopCheckpointStore::Status::invalid; break;
+    case 1: invalid.record.revision = 0; break;
+    case 2: invalid.record.bytes = 0; break;
+    case 3: invalid.chapter = 5; break;
+    case 4: invalid.initial_x = -1000001; break;
+    case 5: invalid.record.digest.fill('z'); break;
+    }
+    check(!majesty::coop_lobby_resume_start_ready(invalid, party, invalid.label()),
+          "malformed request cannot start");
+  }
+  check(!majesty::coop_lobby_resume_start_ready({}, party, label), "empty request");
+  std::fprintf(stderr, "%u checks, %u failures; pure resume startup policy\n", checks, failures);
+  return failures ? 1 : 0;
+}
diff --git a/tests/native_coop_pause_tests.cpp b/tests/native_coop_pause_tests.cpp
new file mode 100644
index 0000000..b975de9
--- /dev/null
+++ b/tests/native_coop_pause_tests.cpp
@@ -0,0 +1,1745 @@
+// Execute the pinned control-command dispatcher and pause/resume handlers.
+// The production pause sender is also exercised through the original queue.
+// No world, tick loop, network peer, renderer, audio or browser is started.
+// The fixture suppresses only the original modal pause UI via a scoped hook.
+#include "../coop_checkpoint.h"
+#include "../coop_connected.h"
+#include "../coop_pause.h"
+#include "../coop_restore.h"
+#include "../coop_source_abort.h"
+#include "../kit/mods/mods_internal.h"
+#include "../kit/runtime/guest.h"
+#include "../kit/runtime/loader.h"
+#include "../kit/runtime/memory.h"
+#include "../kit/runtime/native_seam.h"
+#include "../kit/runtime/profile.h"
+#include "../kit/runtime/win32.h"
+#include <array>
+#include <cstdio>
+#include <cstring>
+#include <string>
+
+static unsigned checks, failures, calls, pauses, packet_frees, reference_frees;
+static uint32_t tracked_packet, tracked_reference;
+#define CHECK(x)                                                               \
+  do {                                                                         \
+    ++checks;                                                                  \
+    if (!(x)) {                                                                \
+      ++failures;                                                              \
+      std::fprintf(stderr, "FAIL %d: %s\n", __LINE__, #x);                     \
+    }                                                                          \
+  } while (0)
+static void outer_dispatch_return(X86 *original, bool rebuild) {
+  const uint32_t return_address = rebuild ? 0x00415e7fu : 0x00415e88u;
+  const auto boundary = rebuild ? majesty::coop_outer_rebuild_boundary :
+                                  majesty::coop_outer_tick_boundary;
+  const auto complete = rebuild ? majesty::coop_complete_outer_rebuild :
+                                  majesty::coop_complete_outer_tick;
+  X86 cpu = *original;
+  cpu.r[R_ESP] -= 256;
+  const uint32_t sp = cpu.r[R_ESP], first = rd32(sp), second = rd32(sp + 4);
+  wr32(sp, return_address); wr32(sp + 4, 0x00505041u);
+  const X86 before = cpu;
+  const auto unchanged = [&](const X86 &actual, const X86 &expected) {
+    CHECK(!std::memcmp(&actual, &expected, sizeof actual));
+  };
+  CHECK(boundary(&cpu));
+  CHECK(complete(&cpu));
+  X86 expected = before;
+  expected.r[R_ESP] += 4; expected.eip = return_address;
+  unchanged(cpu, expected);
+  CHECK(rd32(sp) == return_address && rd32(sp + 4) == 0x00505041u);
+  CHECK(!complete(&cpu));
+  unchanged(cpu, expected);
+  for (uint32_t caller : {0u, 0x004179a9u,
+                         rebuild ? 0x00415e88u : 0x00415e7fu, 0x00490f8du}) {
+    cpu = before; wr32(sp, caller);
+    CHECK(!boundary(&cpu));
+    CHECK(!complete(&cpu));
+    unchanged(cpu, before);
+    CHECK(rd32(sp) == caller);
+  }
+  for (uint32_t invalid : {0u, STACK_LIMIT, STACK_TOP + 4}) {
+    cpu = before; cpu.r[R_ESP] = invalid; expected = cpu;
+    CHECK(!boundary(&cpu));
+    CHECK(!complete(&cpu));
+    unchanged(cpu, expected);
+  }
+  CHECK(!boundary(nullptr));
+  CHECK(!complete(nullptr));
+  wr32(sp, first); wr32(sp + 4, second);
+}
+static uint32_t invoke(X86 *cpu, uint32_t address, uint32_t self,
+                       const uint32_t *args = nullptr, int count = 0) {
+  const X86 before = *cpu;
+  const uint32_t fs = rd32(cpu->fs_base), depth = recomp_profile_depth();
+  cpu->r[R_ECX] = self;
+  ++calls;
+  if (calls < 25)
+    std::fprintf(stderr, "pause-fixture call=%u address=%08x begin\n", calls,
+                 address);
+  auto result = guest_call_guarded(cpu, address, args, count);
+  CHECK(result.status == GuestCallGuardedStatus::Returned);
+  CHECK(cpu->r[R_ESP] == before.r[R_ESP] && cpu->eip == before.eip);
+  CHECK(cpu->r[R_EBX] == before.r[R_EBX] && cpu->r[R_ESI] == before.r[R_ESI] &&
+        cpu->r[R_EDI] == before.r[R_EDI] && cpu->r[R_EBP] == before.r[R_EBP]);
+  CHECK(rd32(cpu->fs_base) == fs && recomp_callback_depth() == 0 &&
+        recomp_profile_depth() == depth);
+  *cpu = before;
+  return result.eax;
+}
+static uint32_t alloc(X86 *c, uint32_t bytes) {
+  const uint32_t a[] = {bytes};
+  auto p = invoke(c, 0x0064c616, 0, a, 1);
+  CHECK(p && gm_valid(p, bytes));
+  return p;
+}
+static void no_modal(const PopModApi *api, pop_cpu_v1 *cpu,
+                     PopHookInvocation *inv, void *) {
+  const uint32_t sp = cpu->esp, flag = rd32(sp + 12);
+  ++pauses;
+  std::fprintf(stderr, "pause-fixture modal suppression entered\n");
+  CHECK(flag == 1);
+  wr32(sp + 12, 0);
+  CHECK(mods_call_next(api, inv, cpu) == POP_OK);
+  CHECK(cpu->esp == sp + 16);
+  wr32(sp + 12, flag);
+}
+static void free_observer(const PopModApi *api, pop_cpu_v1 *cpu,
+                          PopHookInvocation *inv, void *) {
+  const auto p = rd32(cpu->esp + 4);
+  const bool packet = p && p == tracked_packet,
+             reference = p && p == tracked_reference;
+  CHECK(mods_call_next(api, inv, cpu) == POP_OK);
+  if (packet) {
+    ++packet_frees;
+    tracked_packet = 0;
+  }
+  if (reference) {
+    ++reference_frees;
+    tracked_reference = 0;
+  }
+}
+static void command(X86 *c, uint32_t manager, uint32_t kind, uint32_t owner,
+                    uint32_t pace, uint32_t autosave) {
+  tracked_packet = alloc(c, 0x28);
+  CHECK(invoke(c, 0x005a38c0, tracked_packet) == tracked_packet);
+  CHECK(tracked_packet && gm_valid(tracked_packet, 0x28));
+  if (!tracked_packet)
+    return;
+  CHECK(rd32(tracked_packet) == 0x00682e28);
+  CHECK((invoke(c, rd32(rd32(tracked_packet) + 0x10), tracked_packet) &
+         0xffff) == 9);
+  wr32(tracked_packet + 8, kind);
+  wr32(tracked_packet + 12, owner);
+  wr32(tracked_packet + 0x1c, 0);
+  wr32(tracked_packet + 0x20, pace);
+  wr32(tracked_packet + 0x24, autosave);
+  tracked_reference = alloc(c, 4);
+  wr32(tracked_reference, 1);
+  // Original by-value object/ref pair: the dispatcher takes ownership and
+  // balances its temporary copy. No fixture vtable/dispatch/destructor.
+  const uint32_t pair[] = {tracked_packet, tracked_reference};
+  const auto old_packet_frees = packet_frees, old_ref_frees = reference_frees;
+  invoke(c, 0x005a5610, manager, pair, 2);
+  CHECK(packet_frees == old_packet_frees + 1 &&
+        reference_frees == old_ref_frees + 1);
+  CHECK(!tracked_packet && !tracked_reference);
+}
+static void queued_pause(X86 *c, uint32_t state, uint32_t manager) {
+  // The real sender reads only a wall-clock base at world+0x14. This private
+  // header is not a loaded world, actor graph, party or replicated checkpoint.
+  const auto header = alloc(c, 0x18), queue = alloc(c, 0x10),
+             secondary = alloc(c, 0x10), pair = alloc(c, 8);
+  std::memset(gm_ptr(header), 0, 0x18);
+  CHECK(invoke(c, 0x0049b7c0, queue) == queue);
+  CHECK(invoke(c, 0x0049b7c0, secondary) == secondary);
+  const uint32_t previous_secondary = rd32(manager + 0x44);
+  wr32(manager + 0x44, secondary);
+  CHECK(!rd32(manager + 0x34));
+  wr32(manager + 0x34, queue);
+  wr32(0x0071c68c, header);
+  const auto deque = rd32(queue + 8);
+  CHECK(deque && gm_valid(deque, 0x30) && !rd32(deque + 0x2c));
+  for (unsigned cycle = 0; cycle < 20 && !failures; ++cycle) {
+    const uint32_t owner = 7 + cycle % 2, frame = 30000 + cycle,
+                   clock = 60000 + 50 * cycle;
+    wr32(state, 3);
+    wr32(state + 4, 0);
+    wr32(state + 0x28, frame);
+    wr32(0x0071c6a8, clock);
+    wr32(manager + 0x218, cycle % 2 ? 3 : 1);
+    wr32(manager + 0x8c, owner);
+    const auto heap = heap_stats();
+    const X86 before = *c;
+    const auto fs = rd32(c->fs_base), depth = recomp_profile_depth();
+    majesty::CoopPauseBoundary boundary;
+    CHECK(!majesty::coop_pause_boundary(owner, boundary));
+    CHECK(!boundary.frame && !boundary.clock && !boundary.owner);
+    auto refused = [&](X86 *context, uint32_t id) {
+      CHECK(!majesty::enqueue_coop_pause(context, id));
+      CHECK(!rd32(deque + 0x2c) && !rd32(queue + 0xc));
+      const auto after = heap_stats();
+      CHECK(after.used_bytes == heap.used_bytes &&
+            after.used_blocks == heap.used_blocks &&
+            after.total_allocs == heap.total_allocs &&
+            after.total_frees == heap.total_frees);
+    };
+    refused(nullptr, owner);
+    refused(c, owner + 1);
+    refused(c, UINT32_MAX);
+    const std::array<std::array<uint32_t, 2>, 18> guards{
+        {{0x006d7670, 0},
+         {0x006d7670, UINT32_MAX},
+         {0x006d8568, 0},
+         {0x006d8568, UINT32_MAX},
+         {0x0071c68c, 0},
+         {0x0071c68c, UINT32_MAX},
+         {state, 7},
+         {state + 4, 7},
+         {manager + 0x218, 0},
+         {manager + 0x218, 2},
+         {manager + 0x34, 0},
+         {manager + 0x34, UINT32_MAX},
+         {queue + 8, 0},
+         {queue + 8, UINT32_MAX},
+         {deque + 0x2c, 4096},
+         {deque + 0x2c, UINT32_MAX},
+         {manager + 0x8c, UINT32_MAX},
+         {state, 2}}};
+    for (const auto &guard : guards) {
+      const auto previous = rd32(guard[0]);
+      wr32(guard[0], guard[1]);
+      // Restore the intentionally altered count before checking the fixture.
+      CHECK(!majesty::enqueue_coop_pause(c, owner));
+      wr32(guard[0], previous);
+      CHECK(!rd32(deque + 0x2c) && !rd32(queue + 0xc));
+      const auto after = heap_stats();
+      CHECK(after.used_bytes == heap.used_bytes &&
+            after.used_blocks == heap.used_blocks &&
+            after.total_allocs == heap.total_allocs &&
+            after.total_frees == heap.total_frees);
+    }
+    X86 bad = *c;
+    bad.r[R_ESP] = STACK_LIMIT + 65535;
+    refused(&bad, owner);
+    bad.r[R_ESP] = STACK_TOP + 4;
+    refused(&bad, owner);
+    sched_set_guest_thread(false);
+    CHECK(!majesty::enqueue_coop_pause(c, owner));
+    CHECK(!majesty::coop_pause_boundary(owner, boundary));
+    sched_set_guest_thread(true);
+    CHECK(sched_holds_baton());
+    const auto earliest = invoke(c, 0x005ecf00, header + 0x14);
+    CHECK(majesty::enqueue_coop_pause(c, owner));
+    const auto latest = invoke(c, 0x005ecf00, header + 0x14);
+    CHECK(std::memcmp(c, &before, sizeof before) == 0 &&
+          rd32(c->fs_base) == fs);
+    CHECK(recomp_profile_depth() == depth && !recomp_callback_depth() &&
+          !mods_hook_depth());
+    CHECK(rd32(deque + 0x2c) == 1 && rd32(queue + 0xc) == 1);
+    CHECK(rd32(state) == 3 && !rd32(state + 4) && rd32(state + 0x28) == frame &&
+          rd32(0x0071c6a8) == clock);
+    wr32(pair, 0);
+    CHECK(invoke(c, 0x005d9c80, pair + 4) == pair + 4);
+    const uint32_t dequeue_args[] = {pair};
+    CHECK((invoke(c, 0x005dc3b0, queue, dequeue_args, 1) & 0xff) == 1);
+    CHECK(!rd32(deque + 0x2c) && !rd32(queue + 0xc));
+    tracked_packet = rd32(pair);
+    tracked_reference = rd32(pair + 4);
+    CHECK(tracked_packet && gm_valid(tracked_packet, 0x28) &&
+          tracked_reference && gm_valid(tracked_reference, 4));
+    CHECK(rd32(tracked_packet) == 0x00682e28 &&
+          (invoke(c, rd32(rd32(tracked_packet) + 0x10), tracked_packet) &
+           0xffff) == 9);
+    CHECK(!rd32(tracked_packet + 8) && rd32(tracked_packet + 12) == owner &&
+          !rd32(tracked_packet + 0x1c) &&
+          rd32(tracked_packet + 0x20) == rd32(0x006c066c) &&
+          rd32(tracked_packet + 0x24) == rd32(0x006d8548));
+    CHECK(uint32_t(rd32(tracked_packet + 4) - earliest) <=
+          uint32_t(latest - earliest));
+    CHECK(rd32(tracked_reference) == 1);
+    const auto old_packets = packet_frees, old_refs = reference_frees;
+    const uint32_t dispatch_args[] = {tracked_packet, tracked_reference};
+    wr32(pair, 0);
+    wr32(pair + 4, 0); // Ownership moves to original dispatch.
+    invoke(c, 0x005a5610, manager, dispatch_args, 2);
+    CHECK(!tracked_packet && !tracked_reference &&
+          packet_frees == old_packets + 1 && reference_frees == old_refs + 1);
+    CHECK(rd32(state) == 3 && rd32(state + 4) == 7 &&
+          rd32(manager + 0x27c) == owner);
+    CHECK(!majesty::coop_pause_boundary(owner, boundary));
+    wr32(state, 7);
+    wr32(state + 4, 0); // Only the deferred phase copy is emulated.
+    CHECK(majesty::coop_pause_boundary(owner, boundary));
+    CHECK(boundary.frame == frame && boundary.clock == clock &&
