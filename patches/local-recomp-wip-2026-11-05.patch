+    if (stage || !session_enabled() ||
+        profile.find("/actor-arrival-fixture-session-") == profile.npos ||
+        profile.find("/native-world-restoration/frontier_") == profile.npos ||
+        !gm_valid(loaded, 0x11c) || rd32(loaded) != 0x00682950)
