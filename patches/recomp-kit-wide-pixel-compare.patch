+// Focused, allocation-bounded comparison with the previous SIMD equality loop.
+#include "../../dx/pixel_compare.h"
+#include <chrono>
+#include <cstdio>
+#include <vector>
+
+#if defined(__clang__) || defined(__GNUC__)
+#define NOINLINE __attribute__((noinline))
+#else
+#define NOINLINE
+#endif
+NOINLINE bool previous_equal(const void *left, const void *right, size_t bytes) {
+    const auto *a = static_cast<const uint8_t *>(left);
+    const auto *b = static_cast<const uint8_t *>(right);
+#ifdef __wasm_simd128__
+    while (bytes >= 16) {
+        if (wasm_v128_any_true(wasm_v128_xor(wasm_v128_load(a), wasm_v128_load(b))))
+            return false;
+        a += 16;
+        b += 16;
+        bytes -= 16;
+    }
+#endif
+    return !bytes || std::memcmp(a, b, bytes) == 0;
+}
+NOINLINE bool current_equal(const void *a, const void *b, size_t n) {
+    return pixel_bytes_equal(a, b, n);
+}
+using Compare = bool (*)(const void *, const void *, size_t);
+double measure(Compare fn, size_t length, unsigned mismatch, unsigned offset, unsigned *sum) {
+    std::vector<uint8_t> left(length + 32, 0x31), right(left);
+    if (mismatch)
+        right[offset + (mismatch == 1 ? 0 : mismatch == 2 ? length / 2 : length - 1)] ^= 1;
+    constexpr unsigned rounds = 200000;
+    unsigned count = 0;
+    const auto begin = std::chrono::steady_clock::now();
+    for (unsigned i = 0; i < rounds; ++i) {
+        // Mutate both equal bytes so the comparison cannot be loop-invariant.
+        left[offset + length / 4] = right[offset + length / 4] = uint8_t(i);
+        count += fn(left.data() + offset, right.data() + offset, length);
+    }
+    *sum = count;
+    return std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - begin)
+        .count();
+}
+int main() {
+    unsigned failed = 0;
+    for (const size_t length : {256, 1280, 2560, 7680})
+        for (const unsigned offset : {0, 1, 15})
+            for (unsigned mismatch = 0; mismatch < 4; ++mismatch) {
+                unsigned a = 0, b = 0;
+                // Alternate order to reduce a systematic warm-up advantage.
+                double oldMs, newMs;
+                if ((offset + mismatch) & 1) {
+                    newMs = measure(current_equal, length, mismatch, offset, &b);
+                    oldMs = measure(previous_equal, length, mismatch, offset, &a);
+                } else {
+                    oldMs = measure(previous_equal, length, mismatch, offset, &a);
+                    newMs = measure(current_equal, length, mismatch, offset, &b);
+                }
+                failed += a != b || a != (mismatch ? 0u : 200000u);
+                std::printf("{\"bytes\":%zu,\"offset\":%u,\"mismatch\":%u,\"oldMs\":%.3f,\"newMs\":"
+                            "%.3f,\"checksum\":%u}\n",
+                            length, offset, mismatch, oldMs, newMs, b);
+            }
+    return failed ? 1 : 0;
+}
