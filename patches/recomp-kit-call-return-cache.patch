+static void test_call_return_cache() {
+    section("immutable CALL-return cache");
+    CallReturnCache cache;
+    unsigned calls = 0;
+    auto original = [&calls](uint32_t value) {
+        ++calls;
+        return int(value == 0 || value == 0xffffffffu || (value % 7) == 3);
+    };
+    check(cache.lookup(0, original) == 1 && cache.lookup(0, original) == 1 && calls == 1,
+          "zero is a real cache key, not an empty marker");
+    check(cache.lookup(1, original) == 0 && cache.lookup(1, original) == 0 && calls == 2,
+          "negative membership results are reused exactly");
+    check(cache.lookup(0xffffffffu, original) == 1, "maximum guest address is preserved");
+    bool correct = true;
+    // Much larger than the fixed table: force replacement and false/true
+    // collisions, then revisit the same addresses in reverse order.
+    for (uint32_t i = 0; i < 65536; ++i) {
+        const uint32_t value = i * 65537u;
+        correct &= cache.lookup(value, original) ==
+                   int(value == 0 || value == 0xffffffffu || (value % 7) == 3);
+    }
+    for (uint32_t i = 65536; i-- > 0;) {
+        const uint32_t value = i * 65537u;
+        correct &= cache.lookup(value, original) ==
+                   int(value == 0 || value == 0xffffffffu || (value % 7) == 3);
+    }
+    check(correct, "collisions never return a different address's result");
+    check(cache.lookup(123, [](uint32_t) { return -1; }) == -1,
+          "future nonboolean results are preserved without cache encoding");
+    CallReturnCache independent;
+    check(independent.lookup(123, [](uint32_t) { return 1; }) == 1,
+          "separate thread caches do not share answer state");
+}
