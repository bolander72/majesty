--- /dev/null
+++ b/runtime/call_return_cache.h
@@ -0,0 +1,29 @@
+#ifndef RECOMP_CALL_RETURN_CACHE_H
+#define RECOMP_CALL_RETURN_CACHE_H
+
+#include <stdint.h>
+
+// Only for the main image's immutable CALL-continuation table. Auxiliary
+// module registration and hooks still use their original dispatch paths.
+// The caller owns one cache per thread; a collision replaces a slot, never
+// changes the answer. No allocation or locking belongs in this RET path.
+struct CallReturnCache {
+    struct Entry {
+        uint32_t address = 0, value = 0;
+    };
+    Entry slots[4096]{};
+
+    template <class Lookup> int lookup(uint32_t target, Lookup original) {
+        Entry &entry = slots[(target * 0x9e3779b1u) >> 20];
+        if (entry.value && entry.address == target)
+            return int(entry.value - 1);
+        const int result = original(target);
+        // Generated tables return 0/1. Preserve any future nonboolean answer
+        // exactly rather than encoding it into a possibly wrapping marker.
+        if (result == 0 || result == 1)
+            entry = {target, uint32_t(result + 1)};
+        return result;
+    }
+};
+
+#endif
