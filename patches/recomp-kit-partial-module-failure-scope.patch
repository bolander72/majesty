+def module_failure_scope(failures, requested, emitted):
+    """Keep errors in a partial module without making unrelated discovery fatal.
+
+    Discovery examines the full image to recover complete bodies. External
+    functions still belong to the base image; retain their diagnostics for
+    reporting, but reject a failed or missing requested module export.
+    """
+    requested, emitted = set(requested), set(emitted)
+    selected = [(addr, why) for addr, why in failures if addr in requested]
+    omitted = [(addr, why) for addr, why in failures if addr not in requested]
+    failed = {addr for addr, _ in selected}
+    selected.extend((addr, "requested module entry was not emitted")
+                    for addr in sorted(requested - emitted - failed))
+    return selected, omitted
+
