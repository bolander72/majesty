+def test_partial_module_external_failure_remains_reported_but_is_not_fatal():
+    selected, omitted = T.module_failure_scope(
+        [(0x2000, "external table boundary error")], {0x1000}, {0x1000})
+    assert selected == []
+    assert omitted == [(0x2000, "external table boundary error")]
+
+
+def test_partial_module_requested_failure_is_still_fatal():
+    selected, omitted = T.module_failure_scope(
+        [(0x1000, "selected instruction unsupported"), (0x2000, "external")],
+        {0x1000}, set())
+    assert selected == [(0x1000, "selected instruction unsupported")]
+    assert omitted == [(0x2000, "external")]
+
+
+def test_partial_module_missing_requested_export_is_fatal_without_other_error():
+    selected, omitted = T.module_failure_scope([], {0x1000, 0x1100}, {0x1000})
+    assert selected == [(0x1100, "requested module entry was not emitted")]
+    assert omitted == []
+
