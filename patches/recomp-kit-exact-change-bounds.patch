--- a/host/tests/pixel_kernel_tests.cpp
+++ b/host/tests/pixel_kernel_tests.cpp
@@ -109,0 +110,28 @@
+    const auto empty_bounds = pixel_change_bounds(nullptr, nullptr, 0, 2);
+    check(empty_bounds.begin == 0 && empty_bounds.end == 0);
+    // Single differing bytes at every position catch rounding at the two
+    // boundaries, particularly SIMD groups which split a three-byte pixel.
+    // Paired endpoints and dense interiors must return those same bounds.
+    for (unsigned bb : {1u, 2u, 3u, 4u})
+        for (size_t width : {1u, 7u, 8u, 15u, 16u, 17u, 31u, 32u, 33u, 257u, 1024u})
+            for (size_t offset = 0; offset < 16; ++offset) {
+                std::vector<uint8_t> before(width * bb + 32, 0x39), after(before);
+                const auto *a = before.data() + offset;
+                auto *b = after.data() + 15 - offset;
+                for (size_t byte = 0; byte < width * bb; ++byte) {
+                    b[byte] ^= 0x80;
+                    const auto single = pixel_change_bounds(a, b, width, bb);
+                    check(single.begin == byte / bb && single.end == byte / bb + 1);
+                    b[byte] ^= 0x80;
+                    const size_t last = width * bb - 1;
+                    b[byte] ^= 1;
+                    b[last] ^= 0x80;
+                    const auto pair = pixel_change_bounds(a, b, width, bb);
+                    check(pair.begin == byte / bb && pair.end == width);
+                    b[byte] ^= 1;
+                    b[last] ^= 0x80;
+                }
+                memset(b, 0xc6, width * bb);
+                const auto dense = pixel_change_bounds(a, b, width, bb);
+                check(dense.begin == 0 && dense.end == width);
+            }
