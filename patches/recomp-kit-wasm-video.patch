--- a/cmake/Dependencies.cmake
+++ b/cmake/Dependencies.cmake
@@ -88 +88 @@
-  if(NOT APPLE AND NOT ANDROID AND NOT CMAKE_SYSTEM_NAME STREQUAL "Linux" AND NOT WIN32)
+  if(NOT APPLE AND NOT ANDROID AND NOT CMAKE_SYSTEM_NAME STREQUAL "Linux" AND NOT WIN32 AND NOT EMSCRIPTEN)
@@ -115 +115,12 @@
-  if(IOS)
+  if(EMSCRIPTEN)
+    list(REMOVE_ITEM RECOMP_FFMPEG_CONFIGURE --enable-shared --disable-static)
+    get_filename_component(RECOMP_EM_TOOL_DIR "${CMAKE_C_COMPILER}" DIRECTORY)
+    list(APPEND RECOMP_FFMPEG_CONFIGURE
+      --disable-shared --enable-static --enable-cross-compile
+      --target-os=none --arch=wasm32 --disable-asm --enable-pthreads
+      --disable-runtime-cpudetect --disable-symver
+      --cc=${CMAKE_C_COMPILER}
+      --ar=${RECOMP_EM_TOOL_DIR}/emar --ranlib=${RECOMP_EM_TOOL_DIR}/emranlib
+      --nm=${RECOMP_EM_TOOL_DIR}/../bin/llvm-nm
+      "--extra-cflags=-pthread" "--extra-ldflags=-pthread")
+  elseif(IOS)
@@ -184 +195,4 @@
-    if(ANDROID)
+    if(EMSCRIPTEN)
+      set(filename lib${component}.a)
+      set(soname "")
+    elseif(ANDROID)
@@ -200 +214,5 @@
-    add_library(ffmpeg::${component} SHARED IMPORTED GLOBAL)
+    if(EMSCRIPTEN)
+      add_library(ffmpeg::${component} STATIC IMPORTED GLOBAL)
+    else()
+      add_library(ffmpeg::${component} SHARED IMPORTED GLOBAL)
+    endif()
--- a/dx/bink.cpp
+++ b/dx/bink.cpp
@@ -222,0 +223,3 @@
+#ifdef __EMSCRIPTEN__
+    (*context)->thread_count = 1; // Use the existing game worker for movie decoding.
+#endif
