// Original Lost Trail mission descriptions

Name =
[DOWNLOADABLE_QUEST_2]

Short Description =
[Complete two Trail Lodges, keep four Wayfinders alive, and destroy every hostile lair. Your Palace must survive.]

Long Description =
[The northern road has vanished beneath the forest, and creatures now nest along its forgotten course. Establish two Trail Lodges and recruit a company of Wayfinders to reclaim the route. Use exploration and attack rewards to guide your heroes through the wilderness. Victory requires both completed Lodges, four living Wayfinders, and no hostile lairs remaining, including those hidden by unexplored terrain.]
